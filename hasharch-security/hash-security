def main():
    a = sys.argv[1:]
    if a and a[0] == "backend":
        return cli(a[1:])
    page = "signin"
    if "--page" in a:
        i = a.index("--page")
        if i + 1 < len(a):
            page = a[i + 1]
    shot = None
    if "--shot" in a:
        i = a.index("--shot")
        shot = a[i + 1] if i + 1 < len(a) else "/tmp/hash-security.png"
    return gui(page, shot)


if __name__ == "__main__":
    sys.exit(main())
