        def refresh(self):
            enrolled = totp_enrolled()
            has_tool = bool(shutil.which("google-authenticator"))
            if enrolled:
                self.status.setText("TOTP is enrolled (~/.google_authenticator "
                                    "present). Enable it per-surface from Overview.")
                self.info.setText("Your authenticator secret is set up. The SDDM "
                                  "2FA fork relays the code prompt to the greeter. "
                                  "Re-running setup replaces the secret.")
                self.removeBtn.setEnabled(True)
                self.setupBtn.setText("Re-run setup")
            else:
                self.status.setText("TOTP is not enrolled yet.")
                self.info.setText("Set up a Time-based One-Time Password. You'll "
                                  "scan a QR code with an authenticator app and "
                                  "save the scratch codes shown below.")
                self.removeBtn.setEnabled(False)
                self.setupBtn.setText("Set up TOTP")
            self.setupBtn.setEnabled(has_tool)
            if not has_tool:
                self.info.setText("`google-authenticator` is not installed. "
                                  "Install it (libpam-google-authenticator) to "
                                  "enrol TOTP.")

        def do_setup(self):
            """Run google-authenticator non-interactively; show secret + QR +
            scratch codes in-GUI.  This runs as the USER (writes ~/.google_
            authenticator) — no pkexec needed."""
            tool = shutil.which("google-authenticator")
            if not tool:
                return
            # -t TOTP, -d disallow reuse, -f force write, -r/-R rate limit,
            # -w 3 window, -Q UTF8 emits a terminal QR we capture.
            r = run([tool, "-t", "-d", "-f", "-r", "3", "-R", "30", "-w", "3",
                     "-Q", "UTF8"], timeout=30)
            out = r.stdout or r.stderr
            self.secretBox.setPlainText(out.strip() or "(no output)")
            self.secretBox.show()
            # The UTF8 QR is in `out`; also try to render a PNG QR if qrencode
            # is available for a crisper image.
            self._maybe_png_qr()
            self.refresh()

        def _maybe_png_qr(self):
            # Pull the otpauth:// URL out of ~/.google_authenticator's secret if
            # qrencode exists, render a PNG QR for scanning.
            if not shutil.which("qrencode"):
                return
            secret = ""
            try:
                with open(GA_FILE) as f:
                    secret = f.readline().strip()
            except OSError:
                return
            if not secret:
                return
            url = ("otpauth://totp/%s@%s?secret=%s&issuer=HasH-Arch"
                   % (USER, os.uname().nodename, secret))
            png = "/tmp/hash-security-qr-%d.png" % os.getpid()
            r = run(["qrencode", "-o", png, "-s", "5", "-m", "2", url], timeout=10)
            if r.returncode == 0 and os.path.exists(png):
                pix = QPixmap(png)
                if not pix.isNull():
                    self.qr.setPixmap(pix.scaledToWidth(
                        220, Qt.TransformationMode.SmoothTransformation))
                    self.qr.show()

        def do_remove(self):
            try:
                if os.path.exists(GA_FILE):
                    os.rename(GA_FILE, GA_FILE + ".removed")
            except OSError as e:
                self.status.setText("Could not remove: %s" % e)
            self.secretBox.hide()
            self.qr.hide()
            self.refresh()
            # Also offer to disable TOTP on every surface (handled from Overview)

