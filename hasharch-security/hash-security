#!/usr/bin/env python3
"""HasH-Arch Security Center  (hash-security)

A single dark/rounded settings app to turn on and enroll the HasH-Arch auth
methods — Password, PIN, TOTP 2FA, Face (Howdy), Fingerprint (fprintd) — and
choose WHERE each applies (Login / Lock / Sudo), without ever editing PAM by
hand.

It runs as the user and is read-only by itself: it parses /etc/pam.d/{sddm,
kde,sudo,login}, checks ~/.google_authenticator, fprintd-list and Howdy to show
the current state.  Every PRIVILEGED change (the PAM edits) is delegated to
`hash-security-helper` via pkexec — the GUI never runs as root.

Pages:
  Sign-in    Windows-Hello-style chooser (LANDING): a card per method with
             status + a primary action (Set up / Re-enroll / Remove / Install)
             + per-surface (Login/Lock/Sudo) toggles.  Camera/reader-absent
             cards self-hide.
  Matrix     methods x surfaces grid with toggles + status chips
  Two-Factor TOTP enable / Set up (QR + secret + scratch codes) / Remove
  Face       Howdy: detect camera, offer install (AUR), enroll/re-enroll/clear,
             certainty setting; hidden when no camera
  Fingerprint fprintd: detect reader, offer install, enroll/clear; hidden when
             no reader
  PIN        detect + explain (intentionally not enabled — lockout safety)
  Policy     method order + faillock reset + TTY-fallback / test-first guidance

Usage:
  hash-security                 launch the GUI (Sign-in options)
  hash-security --page signin|overview|totp|face|fingerprint|pin|policy
  hash-security backend status  headless JSON of current methods x surfaces
  hash-security --shot <png>    render the Sign-in page to a PNG and exit

Live enrollment (howdy add / fprintd-enroll) needs real hardware and runs only
through pkexec → hash-security-helper.  Install offers (Howdy via AUR, fprintd
via pacman) also go through the helper.  No PAM file is touched by any of these
— enabling a method in the auth stack stays a separate, explicit toggle that
goes through the helper's atomic+validated enable/disable.  The GUI never runs
as root.
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys

SCRIPT = os.path.realpath(__file__)
HELPER = os.path.join(os.path.dirname(SCRIPT), "hash-security-helper")
if not os.path.exists(HELPER):
    HELPER = shutil.which("hash-security-helper") or HELPER

USER = os.environ.get("USER") or os.environ.get("LOGNAME") or "user"
HOME = os.path.expanduser("~")
GA_FILE = os.path.join(HOME, ".google_authenticator")

# Surface -> PAM service file (mirrors the helper).  login (TTY) is read-only
# here and never toggled.
SURFACE_FILE = {"login": "sddm", "lock": "kde", "sudo": "sudo"}
SURFACES = [("login", "Login"), ("lock", "Lock"), ("sudo", "Sudo")]
METHODS = [("password", "Password"), ("pin", "PIN"), ("totp", "TOTP 2FA"),
           ("face", "Face"), ("fingerprint", "Fingerprint")]
TAG = "# hash-security"


def run(cmd, timeout=20):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        class _R:
            returncode = 1
            stdout = ""
            stderr = str(e)
        return _R()


# ───────────────────────── read-only state detection ─────────────────────────
def read_pam(svc):
    try:
        with open(os.path.join("/etc/pam.d", svc)) as f:
            return f.read()
    except OSError:
        return ""


def managed_methods(text):
    """Methods currently enabled via our tagged lines in a PAM file."""
    out = set()
    for ln in text.splitlines():
        if TAG not in ln:
            continue
        low = ln.lower()
        if "pam_howdy" in low:
            out.add("face")
        elif "pam_fprintd" in low:
            out.add("fingerprint")
        elif "pam_google_authenticator" in low:
            out.add("totp")
    return out


def totp_enrolled():
    return os.path.exists(GA_FILE)


def detect_camera():
    return sorted(glob.glob("/dev/video*"))


def _v4l_name(dev):
    """The kernel's name for a /dev/videoN node (sysfs), lowercased."""
    try:
        with open("/sys/class/video4linux/%s/name" % os.path.basename(dev)) as f:
            return f.read().strip().lower()
    except OSError:
        return ""


def _is_ir_device(dev):
    """True if /dev/videoN is an INFRARED camera — by name ('ir'/'infrared'), or
    by offering only greyscale formats (GREY/Y8/Y10/Y16; RGB webcams expose
    colour formats). HasH face unlock uses ONLY these — a photo can't spoof IR."""
    name = _v4l_name(dev)
    if "infrared" in name or re.search(r"\bir\b", name):
        return True
    if shutil.which("v4l2-ctl"):
        r = run(["v4l2-ctl", "-d", dev, "--list-formats"], timeout=6)
        out = (r.stdout or "").upper()
        if out.strip():
            colour = any(c in out for c in ("YUYV", "MJPG", "MJPEG", "RGB", "NV12", "YUV"))
            grey = any(g in out for g in ("GREY", "Y8 ", "Y8I", "Y10", "Y16"))
            if grey and not colour:
                return True
    return False


def detect_ir_camera():
    """Path of an INFRARED camera node, or None (first match wins)."""
    for dev in detect_camera():
        if _is_ir_device(dev):
            return dev
    return None


def detect_fprint_reader():
    if not shutil.which("fprintd-list"):
        return False
    r = run(["fprintd-list", USER], timeout=8)
    return "no devices" not in (r.stdout + r.stderr).lower()


def fprint_enrolled():
    if not shutil.which("fprintd-list"):
        return False
    r = run(["fprintd-list", USER], timeout=8)
    return "fingerprints for user" in (r.stdout + r.stderr).lower()


def howdy_present():
    return bool(shutil.which("howdy"))


def howdy_enrolled():
    """True if Howdy has at least one model enrolled for this user.

    `howdy list` prints the enrolled models (or a 'no models' message). We treat
    any numbered model row as enrollment. Best-effort and read-only."""
    if not shutil.which("howdy"):
        return False
    r = run(["howdy", "-U", USER, "list"], timeout=8)
    out = (r.stdout + r.stderr).lower()
    if "no face models" in out or "no models" in out:
        return False
    for ln in (r.stdout + r.stderr).splitlines():
        if ln.strip()[:1].isdigit():
            return True
    return False


def aur_helper():
    """Detected AUR helper command, or None."""
    for h in ("yay", "paru"):
        if shutil.which(h):
            return h
    return None


def faillock_count():
    """Number of recent failed attempts for this user (best-effort).  Returns
    int or None if faillock is unavailable."""
    if not shutil.which("faillock"):
        return None
    r = run(["faillock", "--user", USER], timeout=8)
    n = 0
    for ln in r.stdout.splitlines():
        s = ln.strip()
        if s and s[0].isdigit():
            n += 1
    return n


def gather_state():
    """Full read-only snapshot used by Overview + headless `backend status`."""
    cam = detect_camera()
    ir = detect_ir_camera()
    reader = detect_fprint_reader()
    surfaces = {}
    for surf, svc in SURFACE_FILE.items():
        text = read_pam(svc)
        surfaces[surf] = {
            "service": svc,
            "exists": bool(text),
            "enabled": sorted(managed_methods(text)),
        }
    return {
        "user": USER,
        "surfaces": surfaces,
        "hardware": {
            "camera": bool(cam), "camera_devices": cam,
            # IR camera is what matters for face unlock — RGB webcams are refused
            # (a photo can spoof them). face is offered ONLY when this is present.
            "ir_camera": ir is not None, "ir_camera_device": ir or "",
            "howdy": howdy_present(),
            "fprintd": bool(shutil.which("fprintd-list")),
            "fprint_reader": reader,
            "google_authenticator": bool(shutil.which("google-authenticator")),
            "aur_helper": aur_helper(),
            "pkexec": bool(shutil.which("pkexec")),
            "faillock": bool(shutil.which("faillock")),
        },
        "enrollment": {
            "totp": totp_enrolled(),
            "fingerprint": fprint_enrolled(),
            "face": howdy_enrolled(),
        },
        "faillock_count": faillock_count(),
    }


def method_chip(method, state):
    """Return (chip_label, kind) describing a method's status for the matrix.

    kind: 'enrolled' | 'available' | 'nohw' | 'always'
    """
    hw = state["hardware"]
    enr = state["enrollment"]
    if method == "password":
        return "always on", "always"
    if method == "totp":
        if enr["totp"]:
            return "enrolled", "enrolled"
        return ("available", "available") if hw["google_authenticator"] else \
               ("not installed", "nohw")
    if method == "face":
        if not hw["camera"]:
            return "no camera", "nohw"
        if enr["face"]:
            return "enrolled", "enrolled"
        return "available", "available"
    if method == "fingerprint":
        if not hw["fprint_reader"]:
            return "no reader", "nohw"
        if enr["fingerprint"]:
            return "enrolled", "enrolled"
        return "available", "available"
    if method == "pin":
        return "detect + explain", "nohw"
    return "", "available"


# ─────────────────────────────── headless CLI ────────────────────────────────
def cli(a):
    if a and a[0] == "status":
        print(json.dumps(gather_state(), indent=2))
        return 0
    print("usage: hash-security backend status", file=sys.stderr)
    return 2


# ════════════════════════════════════ GUI ════════════════════════════════════
def gui(start_page="signin", shot=None):
    from PyQt6.QtCore import (Qt, QProcess, QSize, QProcessEnvironment, QTimer)
    from PyQt6.QtGui import (QPainter, QColor, QPainterPath, QIcon, QCursor,
                             QKeySequence, QShortcut, QPixmap, QImage)
    from PyQt6.QtWidgets import (
        QApplication, QWidget, QLabel, QPushButton, QLineEdit, QTextEdit,
        QStackedWidget, QHBoxLayout, QVBoxLayout, QGridLayout, QFrame,
        QScrollArea, QSizePolicy)

    ACCENT, DANGER, OK = "#56c5d8", "#e06c75", "#7fd6a0"
    WARN = "#e0c46c"

    def btn_qss(a=ACCENT):
        return f"""
            QPushButton{{ background:rgba(255,255,255,0.07); color:#e8eef0;
                border:1px solid rgba(255,255,255,0.10); border-radius:9px;
                padding:7px 16px; font-size:13px; }}
            QPushButton:hover{{ background:rgba(255,255,255,0.13); }}
            QPushButton#primary{{ background:{a}; color:#06222a; font-weight:600; border:none; }}
            QPushButton#primary:hover{{ background:#6fd6e7; }}
            QPushButton#danger{{ background:{DANGER}; color:#2a0a0c; font-weight:600; border:none; }}
            QPushButton:disabled{{ color:#7f8a8d; background:rgba(255,255,255,0.05); }}
        """

    def qenv(d):
        qe = QProcessEnvironment()
        for k, v in d.items():
            qe.insert(k, v)
        return qe

    CHIP_COLORS = {
        "enrolled": (OK, "#0c2418"),
        "available": (ACCENT, "#06222a"),
        "always": ("#9fb8bd", "#0d1419"),
        "nohw": ("#6b7679", "#15191c"),
    }

    def chip(label, kind):
        lab = QLabel(label)
        fg, bg = CHIP_COLORS.get(kind, CHIP_COLORS["available"])
        lab.setStyleSheet(
            f"QLabel{{ color:{fg}; background:{bg}; border:1px solid {fg};"
            f"border-radius:9px; padding:2px 9px; font-size:11px; font-weight:700; }}")
        lab.setAlignment(Qt.AlignmentFlag.AlignCenter)
        return lab

    # ── transaction window (mirrors hash-store) ──────────────────────────────
    class Transaction(QWidget):
        def __init__(self, parent, title, argv, on_done):
            super().__init__(parent, Qt.WindowType.Window
                             | Qt.WindowType.FramelessWindowHint)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
            self.setObjectName("txwin")
            self.resize(620, 380)
            self.on_done = on_done
            v = QVBoxLayout(self)
            v.setContentsMargins(18, 16, 18, 16)
            t = QLabel(title)
            t.setObjectName("txtitle")
            self.log = QTextEdit(readOnly=True)
            self.log.setObjectName("txlog")
            self.btn = QPushButton("Please wait…")
            self.btn.setEnabled(False)
            self.btn.setObjectName("primary")
            self.btn.clicked.connect(self.close)
            v.addWidget(t)
            v.addWidget(self.log, 1)
            v.addWidget(self.btn)
            self.setStyleSheet("""
                #txwin{ background:#14161d; border:1px solid rgba(255,255,255,0.12);
                        border-radius:16px; }
                #txtitle{ color:#fff; font-size:15px; font-weight:600; }
                #txlog{ background:#0b0d12; color:#cfe9ee; border:1px solid #222;
                        border-radius:10px; font-family:monospace; font-size:12px; }
            """ + btn_qss())
            self.p = QProcess(self)
            self.p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.p.setProcessEnvironment(qenv(dict(os.environ)))
            self.p.readyReadStandardOutput.connect(self._read)
            self.p.finished.connect(self._fin)
            self._append("$ " + " ".join(argv) + "\n\n")
            self.p.start(argv[0], argv[1:])

        def _read(self):
            self._append(bytes(self.p.readAllStandardOutput()).decode(errors="ignore"))

        def _append(self, s):
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)
            self.log.insertPlainText(s)
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)

        def _fin(self, code, _st):
            ok = code == 0
            self._append("\n" + ("✓ Done." if ok else "✗ Failed (exit %d)." % code) + "\n")
            self.btn.setText("Close")
            self.btn.setEnabled(True)
            if self.on_done:
                self.on_done(ok)

        def keyPressEvent(self, e):
            if e.key() == Qt.Key.Key_Escape and self.btn.isEnabled():
                self.close()
            else:
                super().keyPressEvent(e)

    class TitleBar(QWidget):
        def __init__(self, win):
            super().__init__(win)
            self.win, self._off = win, None
            self.setFixedHeight(46)
            h = QHBoxLayout(self)
            h.setContentsMargins(18, 0, 12, 0)
            ttl = QLabel("  HasH Security Center")
            ttl.setObjectName("apptitle")
            mn, cl = QPushButton("—"), QPushButton("✕")
            for b in (mn, cl):
                b.setFixedSize(30, 30)
                b.setObjectName("winbtn")
            mn.clicked.connect(win.showMinimized)
            cl.clicked.connect(win.close)
            h.addWidget(ttl)
            h.addStretch(1)
            h.addWidget(mn)
            h.addWidget(cl)

        def mousePressEvent(self, e):
            if e.button() == Qt.MouseButton.LeftButton:
                self._off = e.globalPosition().toPoint() - self.win.frameGeometry().topLeft()

        def mouseMoveEvent(self, e):
            if self._off is not None and (e.buttons() & Qt.MouseButton.LeftButton):
                self.win.move(e.globalPosition().toPoint() - self._off)

        def mouseReleaseEvent(self, e):
            self._off = None

    class Toggle(QPushButton):
        """A compact on/off pill toggle for one method x surface cell."""
        def __init__(self, on, enabled=True):
            super().__init__("On" if on else "Off")
            self.setCheckable(True)
            self.setChecked(on)
            self.setEnabled(enabled)
            self.setCursor(Qt.CursorShape.PointingHandCursor)
            self.setFixedSize(58, 30)
            self._sync()
            self.toggled.connect(lambda _: self._sync())

        def _sync(self):
            self.setText("On" if self.isChecked() else "Off")
            on = self.isChecked()
            self.setStyleSheet(
                "QPushButton{ border-radius:15px; font-size:12px; font-weight:700;"
                + ("background:%s; color:#06222a; border:none;" % ACCENT if on else
                   "background:rgba(255,255,255,0.06); color:#9fb0b4;"
                   "border:1px solid rgba(255,255,255,0.12);")
                + "} QPushButton:disabled{ background:rgba(255,255,255,0.03);"
                  "color:#566; border:1px solid rgba(255,255,255,0.05); }")

    # ── Overview matrix page ─────────────────────────────────────────────────
    class OverviewPage(QWidget):
        def __init__(self, win):
            super().__init__()
            self.win = win
            self.state = None
            outer = QVBoxLayout(self)
            outer.setContentsMargins(4, 2, 4, 4)
            outer.setSpacing(12)
            hdr = QLabel("Security Overview")
            hdr.setObjectName("pagetitle")
            sub = QLabel("Methods × where they apply. Toggles edit PAM through a "
                         "root helper (pkexec). TTY login stays password-only.")
            sub.setObjectName("subtle")
            sub.setWordWrap(True)
            outer.addWidget(hdr)
            outer.addWidget(sub)

            self.card = QFrame()
            self.card.setObjectName("card")
            self.grid = QGridLayout(self.card)
            self.grid.setContentsMargins(20, 20, 20, 20)
            self.grid.setHorizontalSpacing(18)
            self.grid.setVerticalSpacing(14)
            outer.addWidget(self.card)
            outer.addStretch(1)
            self.refresh()

        def _clear(self):
            while self.grid.count():
                it = self.grid.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()

        def refresh(self):
            self.state = gather_state()
            self._clear()
            # header row
            self.grid.addWidget(self._h("Method"), 0, 0)
            self.grid.addWidget(self._h("Status"), 0, 1)
            for c, (_skey, slabel) in enumerate(SURFACES):
                self.grid.addWidget(self._h(slabel), 0, 2 + c,
                                    alignment=Qt.AlignmentFlag.AlignCenter)
            row = 1
            for mkey, mlabel in METHODS:
                name = QLabel(mlabel)
                name.setObjectName("mname")
                self.grid.addWidget(name, row, 0)
                clabel, kind = method_chip(mkey, self.state)
                self.grid.addWidget(chip(clabel, kind), row, 1)
                for c, (skey, _sl) in enumerate(SURFACES):
                    self.grid.addWidget(self._cell(mkey, skey, kind), row, 2 + c,
                                        alignment=Qt.AlignmentFlag.AlignCenter)
                row += 1

        def _h(self, t):
            l = QLabel(t)
            l.setObjectName("colhead")
            return l

        def _cell(self, mkey, skey, kind):
            surf = self.state["surfaces"].get(skey, {})
            enabled_methods = surf.get("enabled", [])
            on = mkey in enabled_methods
            if mkey == "password":
                # always on, not toggleable
                return chip("✓", "always")
            toggleable = kind in ("enrolled", "available") and mkey != "pin"
            if mkey == "totp":
                toggleable = self.state["enrollment"]["totp"]  # must enrol first
            t = Toggle(on, enabled=toggleable)
            t.clicked.connect(lambda _=False, m=mkey, s=skey, tg=t: self._toggle(m, s, tg))
            return t

        def _toggle(self, method, surface, tg):
            want_on = tg.isChecked()
            sub = "enable" if want_on else "disable"
            self.win.run_helper(
                "%s %s on %s" % (sub.title(), method, surface),
                ["pkexec", HELPER, sub, method, surface],
                lambda ok: self.refresh())

    # ── Sign-in options (Windows-Hello-style landing chooser) ────────────────
    class MethodCard(QFrame):
        """One method card: icon + name + status chip + description + a primary
        action (Set up / Re-enroll / Remove / Install) + per-surface toggles."""
        def __init__(self, win, page, mkey, title, glyph, desc):
            super().__init__()
            self.win, self.page, self.mkey = win, page, mkey
            self.setObjectName("hcard")
            v = QVBoxLayout(self)
            v.setContentsMargins(18, 16, 18, 16)
            v.setSpacing(10)

            top = QHBoxLayout()
            top.setSpacing(12)
            ic = QLabel(glyph)
            ic.setObjectName("hicon")
            ic.setFixedWidth(40)
            ic.setAlignment(Qt.AlignmentFlag.AlignTop | Qt.AlignmentFlag.AlignHCenter)
            top.addWidget(ic)

            tcol = QVBoxLayout()
            tcol.setSpacing(2)
            name = QLabel(title)
            name.setObjectName("hname")
            tcol.addWidget(name)
            self.desc = QLabel(desc)
            self.desc.setObjectName("subtle")
            self.desc.setWordWrap(True)
            tcol.addWidget(self.desc)
            top.addLayout(tcol, 1)

            self.chipholder = QHBoxLayout()
            self.chipholder.setContentsMargins(0, 0, 0, 0)
            chw = QWidget()
            chw.setLayout(self.chipholder)
            top.addWidget(chw, 0, Qt.AlignmentFlag.AlignTop)
            v.addLayout(top)

            # action row
            self.actions = QHBoxLayout()
            self.actions.setSpacing(8)
            v.addLayout(self.actions)

            # per-surface toggles row
            self.surfrow = QHBoxLayout()
            self.surfrow.setSpacing(8)
            v.addLayout(self.surfrow)

        def _clear_layout(self, lay):
            while lay.count():
                it = lay.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()

        def render(self, state):
            self._clear_layout(self.chipholder)
            self._clear_layout(self.actions)
            self._clear_layout(self.surfrow)
            clabel, kind = method_chip(self.mkey, state)
            self.chipholder.addWidget(chip(clabel, kind))

            hw = state["hardware"]
            enr = state["enrollment"]
            buttons = []   # list of (text, objname, callback)
            self.surf_enabled = (kind in ("enrolled", "always"))

            if self.mkey == "password":
                pass  # no actions; always-on
            elif self.mkey == "totp":
                if not hw["google_authenticator"]:
                    buttons.append(("Install (google-authenticator)", "primary",
                                    lambda: self.win.go("totp")))
                elif enr["totp"]:
                    buttons.append(("Re-run setup", "", lambda: self.win.go("totp")))
                    buttons.append(("Remove", "danger", lambda: self.win.go("totp")))
                else:
                    buttons.append(("Set up", "primary", lambda: self.win.go("totp")))
            elif self.mkey == "face":
                if not hw["howdy"]:
                    buttons.append(("Install Howdy", "primary", self.win.install_howdy))
                elif enr["face"]:
                    buttons.append(("Re-enroll", "", self.win.howdy_add))
                    buttons.append(("Settings", "", lambda: self.win.go("face")))
                    buttons.append(("Remove", "danger", self.win.howdy_clear))
                else:
                    buttons.append(("Set up", "primary", self.win.howdy_add))
                    buttons.append(("Settings", "", lambda: self.win.go("face")))
            elif self.mkey == "fingerprint":
                if not hw["fprintd"]:
                    buttons.append(("Install fprintd", "primary", self.win.install_fprintd))
                elif enr["fingerprint"]:
                    buttons.append(("Add another", "", self.win.fprint_enroll))
                    buttons.append(("Remove", "danger", self.win.fprint_delete))
                else:
                    buttons.append(("Set up", "primary", self.win.fprint_enroll))
            elif self.mkey == "pin":
                buttons.append(("Why not yet?", "", lambda: self.win.go("pin")))

            for text, oname, cb in buttons:
                b = QPushButton(text)
                if oname:
                    b.setObjectName(oname)
                b.setCursor(Qt.CursorShape.PointingHandCursor)
                b.clicked.connect(lambda _=False, f=cb: f())
                self.actions.addWidget(b)
            self.actions.addStretch(1)

            # per-surface toggles — only meaningful once enrolled (or always-on)
            lab = QLabel("Use for:")
            lab.setObjectName("subtle")
            self.surfrow.addWidget(lab)
            for skey, slabel in SURFACES:
                surf = state["surfaces"].get(skey, {})
                on = self.mkey in surf.get("enabled", [])
                if self.mkey == "password":
                    pill = chip(slabel + " ✓", "always")
                    self.surfrow.addWidget(pill)
                    continue
                box = QVBoxLayout()
                box.setSpacing(2)
