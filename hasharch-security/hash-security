            body.addWidget(self.stack, 1)
            root.addLayout(body, 1)
            self.setStyleSheet(app_qss())

            QShortcut(QKeySequence(Qt.Key.Key_Escape), self, activated=self.close)
            if start_page not in self._visible:
                start_page2 = "signin"
            else:
                start_page2 = start_page
            self.go(start_page2)

        # ── privileged-action wrappers (all via pkexec → helper) ─────────────
        def _enroll_done(self, ok):
            # Re-read state everywhere after any enroll/install/clear.
            for pg in self.pages.values():
                if hasattr(pg, "refresh"):
                    pg.refresh()

        def install_howdy(self):
            self.run_helper("Install Howdy",
                            ["pkexec", HELPER, "install", "howdy"],
                            self._enroll_done)

        def install_fprintd(self):
            self.run_helper("Install fprintd",
                            ["pkexec", HELPER, "install", "fprintd"],
                            self._enroll_done)

        def howdy_add(self):
            self.run_helper("Enroll face (look at the camera)",
                            ["pkexec", HELPER, "howdy-add", USER],
                            self._enroll_done)

        def howdy_clear(self):
            self.run_helper("Clear enrolled faces",
                            ["pkexec", HELPER, "howdy-clear", USER],
                            self._enroll_done)

        def howdy_config(self, key, value):
            self.run_helper("Howdy: set %s = %s" % (key, value),
                            ["pkexec", HELPER, "howdy-config", key, value],
                            self._enroll_done)

        def fprint_enroll(self):
            self.run_helper("Enroll fingerprint (touch the reader)",
                            ["pkexec", HELPER, "fprint-enroll", USER],
                            self._enroll_done)

        def fprint_delete(self):
            self.run_helper("Clear fingerprints",
                            ["pkexec", HELPER, "fprint-delete", USER],
                            self._enroll_done)

        def faillock_reset(self):
            self.run_helper("Reset faillock counter",
                            ["pkexec", HELPER, "faillock-reset", USER],
                            self._enroll_done)

        def toggle_surface(self, method, surface, tg):
            """Enable/disable a method on a surface (shared by Sign-in cards and
            the Matrix). Refreshes all pages so chips/toggles stay in sync."""
            sub = "enable" if tg.isChecked() else "disable"
            self.run_helper(
                "%s %s on %s" % (sub.title(), method, surface),
                ["pkexec", HELPER, sub, method, surface],
                self._enroll_done)

        def go(self, key):
            if key not in self.pages:
                key = "overview"
            self.stack.setCurrentWidget(self.pages[key])
            for k, b in self.nav.items():
                b.setChecked(k == key)
            pg = self.pages[key]
            if hasattr(pg, "refresh"):
                pg.refresh()

        def run_helper(self, title, argv, on_done):
            self._tx = Transaction(self, title, argv, on_done)
            g = self.geometry()
            self._tx.move(g.center().x() - 310, g.center().y() - 190)
            self._tx.show()

        def paintEvent(self, _e):
            p = QPainter(self)
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            path = QPainterPath()
            path.addRoundedRect(0.5, 0.5, self.width() - 1, self.height() - 1, 20, 20)
            p.fillPath(path, QColor(0x12, 0x14, 0x1a))
            p.setPen(QColor(255, 255, 255, 30))
            p.drawPath(path)

