def run(cmd, timeout=60):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        class _R:
            returncode = 1
            stdout = ""
            stderr = str(e)
        return _R()


# ───────────────────────────── rclone remotes ────────────────────────────────
def list_remotes():
    """[{name, type}] of every remote in rclone's config (empty if none)."""
    if not HAS_RCLONE:
        return []
    r = run([RCLONE, "config", "dump"])
    try:
        data = json.loads(r.stdout) if r.stdout.strip() else {}
    except Exception:
        data = {}
    out = [{"name": n, "type": c.get("type", "")} for n, c in data.items()]
    out.sort(key=lambda x: x["name"].lower())
    return out


def remote_names():
    return {r["name"] for r in list_remotes()}


def has_remotes():
    return bool(list_remotes())


def has_backend(backend):
    """True if the installed rclone exposes `backend` (e.g. iclouddrive)."""
    if not HAS_RCLONE:
        return False
    r = run([RCLONE, "config", "providers"], timeout=20)
    try:
        provs = json.loads(r.stdout) if r.stdout.strip() else []
    except Exception:
        provs = []
    if provs:
        return any(isinstance(p, dict) and p.get("Name") == backend for p in provs)
    h = run([RCLONE, "help", "backends"], timeout=20)
    return backend in (h.stdout or "")


def unique_name(base):
    """A remote name not already in use (base, base2, base3, ...)."""
    existing = remote_names()
    if base not in existing:
        return base
    i = 2
    while "%s%d" % (base, i) in existing:
        i += 1
    return "%s%d" % (base, i)


# ───────────────────────── mount point + systemd unit ────────────────────────
def mount_point(provider_key):
    return os.path.join(MOUNT_ROOT, provider_key)


def unit_name(remote):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", remote)
    return "hash-cloud-%s.service" % safe


def unit_path(remote):
    return os.path.join(SYSTEMD_USER, unit_name(remote))


def write_unit(remote, mp):
    """Create the per-remote systemd USER mount unit (auto-mount on login)."""
    os.makedirs(SYSTEMD_USER, exist_ok=True)
    os.makedirs(mp, exist_ok=True)
    fm = (shutil.which("fusermount3") or shutil.which("fusermount")
          or "/usr/bin/fusermount3")
    body = f"""[Unit]
Description=HasH Cloud — mount cloud remote '{remote}' at {mp}
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=-/usr/bin/mkdir -p {mp}
ExecStart={RCLONE} mount {remote}: {mp} \\
    --vfs-cache-mode {VFS_CACHE_MODE} \\
    --vfs-cache-max-size {VFS_CACHE_MAX} \\
    --poll-interval 15s --dir-cache-time 30s --vfs-refresh
ExecStop={fm} -u {mp}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
"""
    with open(unit_path(remote), "w") as f:
        f.write(body)
    run(["systemctl", "--user", "daemon-reload"], timeout=20)
    return unit_path(remote)


def enable_unit(remote):
    """Enable + start the mount unit so it mounts now and on every login."""
    run(["systemctl", "--user", "enable", "--now", unit_name(remote)], timeout=30)


# ──────────────────────── rclone config create argv ──────────────────────────
def config_create_argv(provider, remote, fields):
    """Build the `rclone config create` argv for a provider.

    OAuth providers need NO extra fields — rclone opens the browser and captures
    the token.  WebDAV/iCloud/userpass providers take the credentials collected
    in the form (passwords are handed to rclone, which obscures them on write).
    """
    argv = [RCLONE, "config", "create", remote, provider["backend"]]
    if provider.get("webdav"):
        argv += ["url", fields.get("url", ""),
                 "vendor", provider.get("vendor", "other"),
                 "user", fields.get("user", ""),
                 "pass", fields.get("pass", "")]
    elif provider.get("icloud"):
        argv += ["apple_id", fields.get("user", ""),
                 "password", fields.get("pass", "")]
    elif provider.get("userpass"):
        argv += ["user", fields.get("user", ""),
                 "pass", fields.get("pass", "")]
    return argv


# ─────────────────────────────── headless CLI ────────────────────────────────
def cli(a):
    if a and a[0] == "list":
        print(json.dumps(list_remotes(), indent=2))
        return 0
    print(__doc__)
    return 0


def autostart_should_run():
    """First-login mode: only open if no remote is configured yet."""
    return not has_remotes()


def drop_autostart():
    """Run-once: delete our autostart entry so we never nag again."""
    try:
        os.remove(AUTOSTART)
    except OSError:
        pass


