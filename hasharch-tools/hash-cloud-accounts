#!/usr/bin/env python3
"""HasH Cloud Accounts  (hash-cloud-accounts)

A first-boot wizard to connect your cloud storage and have it auto-mount as a
drive on every login.  Cloud sign-in is OAuth in a browser, so it CAN'T run
during the Calamares install — the installer's "Cloud storage" packagechooser
only installs the tooling (rclone + fuse3 + native KIO helpers).  This wizard
does the actual sign-in afterwards.

Flow
  * A searchable, popularity-ordered provider list (Google Drive, OneDrive,
    iCloud, SharePoint, Dropbox first; then Mega, Nextcloud, Box, pCloud).
  * Picking a provider launches `rclone config create <remote> <backend>`, which
    runs rclone's own interactive / OAuth flow (the browser opens for OAuth
    providers; WebDAV/iCloud collect a URL/Apple-ID in the same terminal pane).
  * On success it writes a per-remote systemd USER mount unit
    (hash-cloud-<remote>.service) that runs `rclone mount` to
    ~/CloudStorage/<provider> and is enabled so it mounts on every login.

Engine : rclone — OAuth sign-in + FUSE mount.  Tokens live in
         ~/.config/rclone/rclone.conf (CONTAINS SECRETS — never commit).
Mounts : rclone mount <remote>: ~/CloudStorage/<provider> --vfs-cache-mode writes
Login  : one systemd USER unit per remote (hash-cloud-<remote>.service).

Usage
    hash-cloud-accounts                 launch the wizard
    hash-cloud-accounts --autostart     first-login mode: open only if NO remotes
                                        are configured yet, then never nag again
    hash-cloud-accounts list            headless: print configured remotes (JSON)
    hash-cloud-accounts --shot <png>    render a screenshot and exit

The Calamares "Cloud storage" packagechooser ships an autostart .desktop
(hash-cloud-accounts.desktop, X-KDE → Exec=hash-cloud-accounts --autostart) that
opens this once on first login if no remote exists, then removes itself.
"""
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
RCLONE = shutil.which("rclone") or "/usr/bin/rclone"
HAS_RCLONE = bool(shutil.which("rclone"))
HAS_FUSE = bool(shutil.which("fusermount3") or shutil.which("fusermount"))
RCLONE_CONF = os.path.join(HOME, ".config", "rclone", "rclone.conf")
SYSTEMD_USER = os.path.join(HOME, ".config", "systemd", "user")
MOUNT_ROOT = os.path.join(HOME, "CloudStorage")
AUTOSTART = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")),
    "autostart", "hash-cloud-accounts.desktop")

VFS_CACHE_MODE = "writes"
VFS_CACHE_MAX = "5G"

