    # ── live process window for `rclone config create` (OAuth / interactive) ──
    class ProcWin(QWidget):
        def __init__(self, parent, title, argv, on_done):
            super().__init__(parent, Qt.WindowType.Window
                             | Qt.WindowType.FramelessWindowHint)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
            self.setObjectName("txwin")
            self.resize(700, 470)
            self._on_done = on_done
            self._done = False
            v = QVBoxLayout(self)
            v.setContentsMargins(18, 16, 18, 16)
            t = QLabel(title)
            t.setObjectName("txtitle")
            t.setWordWrap(True)
            self.log = QTextEdit(readOnly=True)
            self.log.setObjectName("txlog")
            self.btn = QPushButton("Cancel")
            self.btn.setObjectName("primary")
            self.btn.clicked.connect(self._btn)
            v.addWidget(t)
            v.addWidget(self.log, 1)
            v.addWidget(self.btn)
            self.setStyleSheet("""
                #txwin{ background:#14161d;
                        border:1px solid rgba(255,255,255,0.12);
                        border-radius:16px; }
                #txtitle{ color:#fff; font-size:15px; font-weight:600; }
                #txlog{ background:#0b0d12; color:#cfe9ee; border:1px solid #222;
                        border-radius:10px; font-family:monospace;
                        font-size:12px; }
            """ + btn_qss())
            self.p = QProcess(self)
            self.p.setProcessChannelMode(
                QProcess.ProcessChannelMode.MergedChannels)
            # Force rclone to auto-open the browser for OAuth.
            self.p.setProcessEnvironment(qenv({"RCLONE_CONFIG_IS_LOCAL": "true"}))
            self.p.readyReadStandardOutput.connect(self._read)
            self.p.finished.connect(self._fin)
            self._append("$ " + " ".join(self._mask(argv)) + "\n\n")
            self.p.start(argv[0], argv[1:])

        @staticmethod
        def _mask(argv):
            out, mask_next = [], False
            for a in argv:
                if mask_next:
                    out.append("********")
                    mask_next = False
                    continue
                out.append(a)
                if a in ("pass", "password"):
                    mask_next = True
            return out

        def _read(self):
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)
            self.log.insertPlainText(
                bytes(self.p.readAllStandardOutput()).decode(errors="ignore"))
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)

        def _append(self, s):
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)
            self.log.insertPlainText(s)
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)

        def _btn(self):
            if self._done:
                self.close()
            else:
                self.p.kill()
                self.close()

        def _fin(self, code, _st):
            self._done = True
            ok = code == 0
            self._append("\n" + ("OK — connected." if ok
                                 else "Failed (exit %d)." % code) + "\n")
            self.btn.setText("Close")
            if callable(self._on_done):
                self._on_done(ok)

