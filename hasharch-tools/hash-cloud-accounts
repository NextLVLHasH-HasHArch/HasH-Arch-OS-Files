                self.userEdit.setPlaceholderText("Username")
                self.passEdit.setPlaceholderText("Password / app password")
                self.note.setText("Enter your %s WebDAV URL and login." % p["name"])
                self.connectBtn.setText("Connect")
            elif userpass:
                self.userEdit.setPlaceholderText("Email")
                self.passEdit.setPlaceholderText("Password")
                self.note.setText("Enter your %s email and password." % p["name"])
                self.connectBtn.setText("Connect")
            else:  # OAuth
                self.note.setText(
                    "Sign-in opens your browser automatically (OAuth). Approve "
                    "access, then return here — no terminal needed.")
                self.connectBtn.setText("Connect & sign in")
            self.stack.setCurrentIndex(1)

        def _do_connect(self):
            p = self.sel
            name = self.nameEdit.text().strip()
            if not re.match(r"^[A-Za-z0-9_-]+$", name):
                self.toast_msg("Use only letters, numbers, _ and - in the name.")
                return
            if name in remote_names():
                self.toast_msg("An account named '%s' already exists." % name)
                return
            fields = {}
            if p.get("webdav"):
                if not self.urlEdit.text().strip():
                    self.toast_msg("Enter the WebDAV URL.")
                    return
                fields = {"url": self.urlEdit.text().strip(),
                          "user": self.userEdit.text().strip(),
                          "pass": self.passEdit.text()}
            elif p.get("icloud") or p.get("userpass"):
                if not self.userEdit.text().strip() or not self.passEdit.text():
                    self.toast_msg("Enter your username and password.")
                    return
                fields = {"user": self.userEdit.text().strip(),
                          "pass": self.passEdit.text()}
            self._pending = {"provider": p, "name": name,
                             "auto": self.autoChk.isChecked()}
            argv = config_create_argv(p, name, fields)
            title = ("Signing in to %s — approve access in your browser"
                     % p["name"]) if p.get("oauth") else \
                    ("Connecting %s" % p["name"])
            self.proc = ProcWin(self, title, argv, self._connected)
            g = self.geometry()
            self.proc.move(g.center().x() - 350, g.center().y() - 235)
            self.proc.show()

        def _connected(self, ok):
            if not ok:
                self.toast_msg("Sign-in failed or cancelled.")
                return
            d = self._pending
            name = d["name"]
            mp = mount_point(d["provider"]["key"])
            # Re-point this remote's mount at ~/CloudStorage/<provider>.
            if d["auto"]:
                write_unit(name, mp)
                enable_unit(name)
                self.toast_msg("Connected '%s' — mounting at %s" % (name, mp))
            else:
                os.makedirs(mp, exist_ok=True)
                self.toast_msg("Connected '%s'." % name)
            self._refresh_list()
            self.stack.setCurrentIndex(0)

    app = QApplication(sys.argv[:1])
    app.setApplicationName("HasH Cloud Accounts")
    app.setDesktopFileName("hash-cloud-accounts")
    app.setWindowIcon(QIcon.fromTheme("hash-accounts"))
    w = Window()
    w.show()
    # First-login mode: once the wizard is open, retire the autostart entry so
    # it never nags again (whether or not the user finishes connecting).
    if autostart:
        drop_autostart()
    if shot:
        def _grab():
            w.grab().save(shot)
            os._exit(0)
        QTimer.singleShot(2200, _grab)
    return app.exec()


def main():
    a = sys.argv[1:]
    if a and a[0] in ("list",):
        return cli(a)
    autostart = "--autostart" in a
    shot = None
    if "--shot" in a:
        i = a.index("--shot")
        shot = a[i + 1] if i + 1 < len(a) else "/tmp/hash-cloud-accounts-shot.png"
    return gui(autostart=autostart, shot=shot)


if __name__ == "__main__":
    sys.exit(main())
