#!/usr/bin/env python3
"""HasH Search — the web-search runner for HasH Runner (KRunner).

Adds a "search the internet" result for ANY query you type into HasH Runner:
a web search and a news search (like the web/news results Windows Search shows),
opening the result in your default browser. Registered as a KRunner D-Bus runner
(org.kde.krunner1) and started on demand via D-Bus activation — no daemon.
"""
import subprocess
import urllib.parse

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

BUS_NAME = "com.hash.search"
OBJ_PATH = "/com/hash/search"
IFACE = "org.kde.krunner1"

# Default engines (web + news). "real google search" per the brief; swap here to
# change the provider distro-wide.
WEB_URL = "https://www.google.com/search?q="
NEWS_URL = "https://news.google.com/search?q="


class HashSearchRunner(dbus.service.Object):
    @dbus.service.method(IFACE, in_signature="s", out_signature="a(sssida{sv})")
    def Match(self, query):
        q = (query or "").strip()
        if len(q) < 2:
            return []
        e = urllib.parse.quote(q)
        # (data, display text, icon, type, relevance, properties)
        return [
            ("web:" + e, 'Search the web for “%s”' % q, "globe", 100, 1.0,
             {"subtext": dbus.String("HasH Search · web", variant_level=1)}),
            ("news:" + e, 'Search news for “%s”' % q, "news-subscribe", 100, 0.8,
             {"subtext": dbus.String("HasH Search · news", variant_level=1)}),
        ]

    @dbus.service.method(IFACE, out_signature="a(sss)")
    def Actions(self):
        return []

    @dbus.service.method(IFACE, in_signature="ss", out_signature="")
    def Run(self, data, action_id):
        kind, enc = data.split(":", 1)
        url = (NEWS_URL if kind == "news" else WEB_URL) + enc
        subprocess.Popen(["xdg-open", url],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    @dbus.service.method(IFACE, out_signature="a{sv}")
    def Config(self):
        return {"MinLetterCount": dbus.Int32(2)}


def main():
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    bus.request_name(BUS_NAME)
    HashSearchRunner(bus, OBJ_PATH)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
