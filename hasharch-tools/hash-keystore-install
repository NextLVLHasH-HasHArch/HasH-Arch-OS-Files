#!/bin/bash
# hash-keystore-install — provision the TPM-sealed key vault at install time.
#
# Invoked by Calamares (shellprocess@keystore) inside the freshly-installed target.
# It NEVER aborts the install: a missing partition, Secure-Boot-off or no TPM2 only
# logs guidance, so the machine still installs cleanly and the vault can be enabled
# later with `sudo hash-keystore init`.
#
# The vault is TPM2-sealed with NO recovery key (reset = reinstall, by design — a
# recovery key is the backdoor that defeats the objective). A PIN can only be
# chosen interactively, so it is set on FIRST BOOT via `hash-keystore set-pin`
# (the hash-security first-run wizard prompts for it).
set -uo pipefail
log() { printf '[hash-keystore] %s\n' "$*"; }

command -v hash-keystore >/dev/null 2>&1 || { log "hash-keystore not installed; skipping."; exit 0; }

dev="/dev/disk/by-partlabel/HASH-KEYSTORE"
if [ ! -e "$dev" ]; then
    log "No HASH-KEYSTORE partition found — skipping vault setup."
    log "Add a 2 GiB partition (GPT name HASH-KEYSTORE) and run 'sudo hash-keystore init' to enable it."
    exit 0
fi

# The no-recovery vault can ONLY be opened by TPM (+ PIN), so it needs Secure Boot
# ON and a TPM2 present. If they aren't ready yet, skip cleanly — the user enables
# Secure Boot, then runs init + set-pin on first boot.
if ! hash-keystore require-secureboot >/dev/null 2>&1; then
    log "Secure Boot is OFF — deferring the key vault (it is TPM-sealed with NO recovery key)."
    log "Enable Secure Boot in firmware, then on first boot run:"
    log "  sudo hash-keystore init && sudo hash-keystore set-pin"
    exit 0
fi

log "Provisioning the TPM-sealed key vault on $dev (NO recovery key — reset is reinstall)…"
if hash-keystore init --device "$dev" 2>&1; then
    log "Key vault sealed to TPM2/PCR7. FINISH SETUP ON FIRST BOOT:"
    log "  set your keystore PIN with:  sudo hash-keystore set-pin"
    log "WARNING: there is NO recovery key and NO backdoor. Forget the PIN or lose the"
    log "TPM (firmware reset / Secure Boot off / new board) and the ONLY reset is a reinstall."
else
    log "Vault init reported a problem (non-fatal). Retry on first boot: sudo hash-keystore init"
fi
exit 0
