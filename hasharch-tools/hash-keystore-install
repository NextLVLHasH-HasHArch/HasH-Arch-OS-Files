#!/bin/bash
# hash-keystore-install — provision the Secure-Boot/TPM2 key vault at install time.
#
# Invoked by Calamares (shellprocess@keystore) inside the freshly-installed target.
# It NEVER aborts the install: a missing partition or Secure-Boot-off only logs
# guidance, so a machine without the keystore (or without SB yet) still installs
# cleanly and the vault can be enabled later with `sudo hash-keystore init`.
set -uo pipefail
log() { printf '[hash-keystore] %s\n' "$*"; }

command -v hash-keystore >/dev/null 2>&1 || { log "hash-keystore not installed; skipping."; exit 0; }

# Secure Boot posture — informational only (don't brick an install over firmware).
if hash-keystore require-secureboot >/dev/null 2>&1; then
    log "Secure Boot is enabled — the vault's unlock key will bind to TPM2 + PCR7."
else
    log "Secure Boot is OFF: the vault will be created with a RECOVERY KEY only."
    log "Enable Secure Boot in firmware, then: sudo hash-keystore init  (to add TPM2 auto-unlock)."
fi

dev="/dev/disk/by-partlabel/HASH-KEYSTORE"
if [ ! -e "$dev" ]; then
    log "No HASH-KEYSTORE partition found — skipping vault setup."
    log "Add a ~1 GiB partition (GPT name HASH-KEYSTORE) and run 'sudo hash-keystore init' to enable it."
    exit 0
fi

rec="/root/hash-keystore-recovery.txt"
log "Provisioning the key vault on $dev (this is the Keystore Table)…"
if hash-keystore init --device "$dev" >"$rec" 2>&1; then
    chmod 600 "$rec" 2>/dev/null || true
    log "Key vault ready. The RECOVERY KEY was written to $rec."
    log "IMPORTANT: copy that recovery key somewhere safe (off this machine), then delete the file."
else
    log "Vault init reported a problem (details in $rec) — non-fatal."
    log "You can retry later with: sudo hash-keystore init"
fi
exit 0
