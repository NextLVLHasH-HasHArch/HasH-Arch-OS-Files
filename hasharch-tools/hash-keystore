#!/usr/bin/env python3
"""hash-keystore — HasH's TPM-sealed key vault & key table (NO recovery, by design).

A dedicated 2 GiB partition (GPT name HASH-KEYSTORE) is LUKS2-encrypted and SEALED
to this machine: its unlock key is enrolled to the TPM2, bound to PCR 7 (the UEFI
Secure Boot state), AND protected by a PIN you set. The vault opens ONLY when:

    * this machine's TPM is present and Secure Boot is unchanged, AND
    * you enter your keystore PIN.

There is deliberately NO recovery key and NO backdoor. A stolen disk, a machine
booted with Secure Boot off / a tampered boot chain, OR a forgotten PIN means the
vault will NOT open — and the ONLY way to reset it is to REINSTALL HasH-Arch. That
is the whole point: nothing but THIS machine plus YOU can ever read it. (This is
why the keystore — not PAM/your login password — is what guards your secrets.)

Inside the unlocked volume lives the KEY TABLE — named entries (browser & system
credentials, KWallet key material, certs, SSH keys, passkey backups…) with a small
JSON index, mounted at /var/lib/hash/keystore (root-only 0700).

Subcommands:
  status                 JSON: SB state, TPM2, LUKS, enrolment, PIN-set, mount, keys
  require-secureboot     exit 0 iff Secure Boot is ENABLED (installer gate)
  init [--device DEV] [--size GiB]
                         (root) LUKS2-format DEV, seal to TPM2/PCR7 (NO recovery),
                         open, mkfs, mount, write crypttab+fstab, create the table.
                         A PIN is added on first boot via `set-pin`.
  set-pin                (root, interactive) set/replace the keystore PIN: enrols a
                         TPM2+PIN slot and wipes any PIN-less slot. Afterwards unlock
                         needs TPM + PIN. THERE IS NO RECOVERY — forget it = reinstall.
  open / close           (root) unlock (TPM2 + PIN) / lock the vault
  put  <name> <file>     (root) store a key entry in the table
  get  <name> [out]      (root) read a key entry (to file or stdout)
  list                   list key-table entries
  remove <name>          (root) delete a key entry

Hard rules: NO recovery key is EVER enrolled (reset = reinstall, by maintainer
mandate — a recovery key is the backdoor that defeats the objective); refuses to
`init` unless Secure Boot is ON and a TPM2 is present (without them a no-recovery
vault could never be opened). Never touches PAM or the login stack.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

LABEL = "HASH-KEYSTORE"                 # GPT partition name + LUKS/FS label
MAPPER = "hashkeystore"                 # /dev/mapper/hashkeystore
MOUNT = "/var/lib/hash/keystore"
TABLE = os.path.join(MOUNT, "table")    # the key table (named entries)
INDEX = os.path.join(MOUNT, "index.json")
PCRS = "7"                              # PCR 7 = UEFI Secure Boot state
DEFAULT_SIZE_GIB = 2

# Shown before any irreversible keystore step (init / set-pin) and by the
# installer. The whole posture is no-recovery-by-design (maintainer mandate).
WARNING = (
    "\n=================== READ THIS — NO RECOVERY ===================\n"
    "Your HasH keystore protects your saved passwords and keys. It is sealed to\n"
    "THIS machine's TPM (Secure Boot) and to a PIN you set. There is NO recovery\n"
    "key and NO backdoor, by design.\n\n"
    "If you FORGET your PIN, or the TPM is lost/reset (firmware change, Secure\n"
    "Boot disabled, motherboard replaced), your saved passwords and keys are\n"
    "GONE FOR GOOD — and the ONLY way to reset the keystore is to REINSTALL\n"
    "HasH-Arch. Keep your PIN safe.\n"
    "===============================================================\n")


def die(msg, code=1):
    sys.stderr.write(msg.rstrip() + "\n")
    sys.exit(code)


def must_root():
    if os.geteuid() != 0:
        die("hash-keystore: this needs root (run via the installer or sudo).", 87)


def which(cmd):
    return shutil.which(cmd) is not None


def run(argv, **kw):
    return subprocess.run(argv, capture_output=True, text=True, **kw)


def run_tty(argv):
    """Run inheriting this process's stdio so systemd-cryptenroll / -cryptsetup can
    prompt the user for the keystore PIN on the terminal (capture would hide it)."""
    return subprocess.run(argv)


# ───────────────────────────── detection (read-only) ─────────────────────────
def secure_boot_state():
    """'on' | 'off' | 'unsupported' — EFI SecureBoot var, mokutil fallback."""
    try:
        base = "/sys/firmware/efi/efivars"
        for fn in os.listdir(base):
            if fn.startswith("SecureBoot-"):
                with open(os.path.join(base, fn), "rb") as f:
                    data = f.read()
                return "on" if data and data[-1] == 1 else "off"
    except (FileNotFoundError, NotADirectoryError, PermissionError):
        pass
    if which("mokutil"):
        out = (run(["mokutil", "--sb-state"]).stdout or "").lower()
        if "enabled" in out:
            return "on"
        if "disabled" in out:
            return "off"
    return "unsupported" if not os.path.exists("/sys/firmware/efi") else "off"


def tpm2_present():
    return (os.path.exists("/dev/tpmrm0") or os.path.exists("/dev/tpm0")
            or os.path.isdir("/sys/class/tpm/tpm0"))


def keystore_device():
    """Path of the HASH-KEYSTORE partition — by GPT partition name (how the
    installer creates it) or LUKS/FS label, else None."""
    for p in ("/dev/disk/by-partlabel/" + LABEL, "/dev/disk/by-label/" + LABEL):
        if os.path.exists(p):
            return os.path.realpath(p)
    if which("blkid"):
        r = run(["blkid", "-L", LABEL])
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    return None


def is_luks(dev):
    return bool(dev) and which("cryptsetup") and \
        run(["cryptsetup", "isLuks", dev]).returncode == 0


def tpm2_enrolled(dev):
    """True if a TPM2 token is enrolled on the LUKS device."""
    if not (dev and which("cryptsetup")):
        return False
    out = (run(["cryptsetup", "luksDump", dev]).stdout or "").lower()
    return "systemd-tpm2" in out or "tpm2" in out


def mapper_open():
    return os.path.exists("/dev/mapper/" + MAPPER)


def is_mounted(path):
    try:
        with open("/proc/mounts") as f:
            return any((" " + path + " ") in (" " + ln + " ") for ln in f)
    except OSError:
        return False


def table_keys():
    if not os.path.isdir(TABLE):
        return []
    return sorted(n for n in os.listdir(TABLE)
                  if os.path.isfile(os.path.join(TABLE, n)))


# ─────────────────────────────── status / gate ───────────────────────────────
def cmd_status():
    dev = keystore_device()
    sb = secure_boot_state()
    luks = is_luks(dev)
    out = {
        "secure_boot": sb,
        "tpm2": tpm2_present(),
        "partition": dev,
        "luks": luks,
        "tpm2_enrolled": tpm2_enrolled(dev) if luks else False,
        "pin_set": (_read_index().get("pin_set", False)
                    if is_mounted(MOUNT) else None),
        "unlocked": mapper_open(),
        "mounted": is_mounted(MOUNT),
        "mountpoint": MOUNT,
        "keys": table_keys(),
        "ready": bool(dev and luks and mapper_open() and is_mounted(MOUNT)),
        "note": "Vault is LUKS2 sealed to TPM2/PCR7 (Secure Boot) + a PIN. NO "
                "recovery key, by design — reset is reinstall only. `set-pin` adds "
                "the PIN on first boot.",
    }
    print(json.dumps(out, indent=2))
    return 0


def cmd_require_secureboot():
    sb = secure_boot_state()
    if sb == "on":
        print("Secure Boot: enabled.")
        return 0
    die("Secure Boot is %s — the HasH key vault requires Secure Boot ENABLED so "
        "its TPM2/PCR7-sealed unlock key is tamper-evident. Enable Secure Boot in "
        "firmware (and enrol keys), then retry." % sb, 3)


def _valid_name(name):
    return bool(name) and re.fullmatch(r"[A-Za-z0-9._-]{1,64}", name) is not None


# ──────────────────────────────── init (root) ────────────────────────────────
def cmd_init(device=None, size_gib=DEFAULT_SIZE_GIB):
    must_root()
    for tool in ("cryptsetup", "mkfs.ext4", "systemd-cryptenroll"):
        if not which(tool):
            die("required tool missing: %s" % tool, 4)
    dev = device or keystore_device()
    if not dev or not os.path.exists(dev):
        die("No HASH-KEYSTORE partition found. Create a ~%d GiB partition (GPT name "
            "%s) and pass --device /dev/XYZ — the installer does this for you."
            % (size_gib, LABEL), 4)
    if is_luks(dev):
        die("%s is already a LUKS volume — refusing to reformat (would destroy "
            "keys). There is no reset but REINSTALL, by design." % dev, 6)

    # No-recovery vault: it can ONLY ever be opened by TPM (+ PIN), so REQUIRE a
    # working TPM2 + Secure Boot NOW — otherwise we'd build a vault nothing could
    # ever open.  (With the old recovery-key model this was optional; it isn't now.)
    sb = secure_boot_state()
    if sb != "on":
        die("Secure Boot is %s. The keystore is TPM-sealed with NO recovery key, so "
            "it REQUIRES Secure Boot ENABLED. Turn Secure Boot on in firmware, then "
            "run `hash-keystore init` (e.g. on first boot)." % sb, 3)
    if not tpm2_present():
        die("No TPM2 device found. The keystore is TPM-sealed with NO recovery key "
            "and cannot be created without a TPM2.", 3)

    sys.stderr.write(WARNING)

    # 1) LUKS2-format with a throwaway initial key, then seal to the TPM2.
    import tempfile
    tmpd = tempfile.mkdtemp(prefix="hash-ks-")
    ikey = os.path.join(tmpd, "init.key")
    try:
        with open(ikey, "wb") as f:
            f.write(os.urandom(64))
        os.chmod(ikey, 0o600)
        print("LUKS2-formatting %s …" % dev)
        if run(["cryptsetup", "luksFormat", "--type", "luks2", "--batch-mode",
                "--label", LABEL, dev, ikey]).returncode != 0:
            die("luksFormat failed.", 5)

        # 2) OPEN now, while the throwaway key is still valid (we remove its slot
        #    last; removing a keyslot does NOT close an already-active mapping).
        if not mapper_open():
            if run(["cryptsetup", "open", "--key-file=" + ikey, dev, MAPPER]).returncode != 0:
                die("could not open the new volume.", 5)

        # 3) Seal to TPM2 + PCR7 (Secure Boot). NO recovery key is enrolled. The
        #    PIN is added on first boot (`set-pin`); until then the EMPTY vault
        #    opens via the TPM so the first-boot wizard can reach it to set the PIN.
        print("Sealing to TPM2 (bound to PCR%s / Secure Boot)…" % PCRS)
        if run(["systemd-cryptenroll", "--unlock-key-file=" + ikey,
                "--tpm2-device=auto", "--tpm2-pcrs=" + PCRS, dev]).returncode != 0:
            die("TPM2 enrolment failed — cannot create a no-recovery vault without a "
                "working TPM2 seal. (Is the TPM2 usable and Secure Boot on?)", 5)

        # 4) remove the throwaway key so ONLY the TPM2 seal remains — no recovery
        #    slot exists. The volume stays open (step 2), so mkfs/mount still work.
        run(["cryptsetup", "luksRemoveKey", dev, ikey])
    finally:
        try:
            os.remove(ikey)
        except OSError:
            pass
        shutil.rmtree(tmpd, ignore_errors=True)

    mp = "/dev/mapper/" + MAPPER
    print("Creating filesystem…")
    if run(["mkfs.ext4", "-q", "-F", "-L", LABEL, mp]).returncode != 0:
        die("mkfs.ext4 failed.", 5)
    os.makedirs(MOUNT, exist_ok=True)
    os.chmod(MOUNT, 0o700)
    if not is_mounted(MOUNT) and run(["mount", mp, MOUNT]).returncode != 0:
        die("could not mount the vault.", 5)
    os.chmod(MOUNT, 0o700)
    os.makedirs(TABLE, exist_ok=True)
    os.chmod(TABLE, 0o700)
    if not os.path.exists(INDEX):
        _write_index({"created": int(time.time()), "pin_set": False, "entries": {}})
    _persist(dev)
    print("Key vault ready: LUKS2 on %s, TPM2-sealed (NO recovery), mounted at %s.\n"
          "Set your PIN now:  sudo hash-keystore set-pin\n"
          "Until you do, the vault is NOT PIN-protected." % (dev, MOUNT))
    return 0


def _luks_keyslots(dev):
    """Sorted active LUKS2 keyslot numbers (JSON metadata, text-dump fallback)."""
    r = run(["cryptsetup", "luksDump", "--dump-json-metadata", dev])
    if r.returncode == 0 and r.stdout.strip():
        try:
            return sorted(int(k) for k in json.loads(r.stdout).get("keyslots", {}))
        except Exception:
            pass
    slots, in_ks = [], False
    for ln in (run(["cryptsetup", "luksDump", dev]).stdout or "").splitlines():
        if ln.startswith("Keyslots:"):
            in_ks = True
            continue
        if in_ks:
            m = re.match(r"\s+(\d+):\s", ln)
            if m:
                slots.append(int(m.group(1)))
            elif ln and not ln[0].isspace():
                break
    return sorted(slots)


def cmd_set_pin():
    """First-boot / change: enrol a TPM2+PIN slot and wipe any PIN-less slot, so
    unlock henceforth needs TPM + PIN. Interactive (prompts for the new PIN).
    NO recovery key is ever added — forget the PIN and the only reset is reinstall."""
    must_root()
    dev = keystore_device()
    if not dev or not is_luks(dev):
        die("no LUKS key vault found — run `hash-keystore init` first.", 4)
    if secure_boot_state() != "on" or not tpm2_present():
        die("Secure Boot must be ON and a TPM2 present to set the keystore PIN.", 3)
    if not which("systemd-cryptenroll"):
        die("systemd-cryptenroll is required.", 4)
    sys.stderr.write(WARNING)
    before = set(_luks_keyslots(dev))
    print("Choose your keystore PIN when prompted (you'll confirm it).")
    # Unlock for enrolment via the existing TPM2 slot, then add a TPM2+PIN slot.
    rc = run_tty(["systemd-cryptenroll", "--unlock-tpm2-device=auto",
                  "--tpm2-device=auto", "--tpm2-pcrs=" + PCRS,
                  "--tpm2-with-pin=yes", dev]).returncode
    if rc != 0:
        die("PIN enrolment failed (no changes kept).", 5)
    # Wipe every slot that existed BEFORE — i.e. the old PIN-less TPM2 slot — so
    # only the new TPM2+PIN slot remains. (Never wipes the slot we just added.)
    for slot in sorted(before):
        run(["systemd-cryptenroll", "--wipe-slot=" + str(slot), dev])
    if is_mounted(MOUNT):
        idx = _read_index()
        idx["pin_set"] = True
        _write_index(idx)
    print("Keystore PIN set. Unlock now requires TPM + PIN. There is NO recovery — "
          "forget the PIN or lose the TPM and the only reset is REINSTALL.")
    return 0


def _persist(dev):
    """crypttab (TPM2 + PIN unlock) + fstab (nofail) so the vault returns on boot.
    systemd prompts for the PIN at boot once a PIN slot exists; there is no
    recovery key in the stack — by design."""
    cry = "%s  PARTLABEL=%s  -  tpm2-device=auto,nofail\n" % (MAPPER, LABEL)
    _append_unique("/etc/crypttab", MAPPER, cry,
                   "# HasH key vault — TPM2/PCR7 + PIN unlock (NO recovery key; reset = reinstall)")
    fst = "/dev/mapper/%s  %s  ext4  defaults,nofail,nosuid,nodev  0 2\n" % (MAPPER, MOUNT)
    _append_unique("/etc/fstab", MOUNT, fst, "# HasH key vault")


def _append_unique(path, needle, line, comment):
    try:
        cur = open(path).read()
    except OSError:
        cur = ""
    if needle in cur:
        return
    with open(path, "a") as f:
        if cur and not cur.endswith("\n"):
            f.write("\n")
        f.write(comment + "\n" + line)


# ──────────────────────────── open / close (root) ────────────────────────────
def cmd_open():
    must_root()
    if mapper_open():
        print("vault already open.")
    else:
        dev = keystore_device()
        if not dev or not is_luks(dev):
            die("no LUKS key vault found (run `init`).", 4)
        # TPM2 (+ PIN, if set) unlock. systemd prompts for the PIN on the terminal;
        # there is NO recovery key — a changed TPM or forgotten PIN cannot be opened.
        if run_tty(["systemd-cryptsetup", "attach", MAPPER, dev]).returncode != 0:
            die("could not open the vault. TPM2/PIN unlock failed and there is NO "
                "recovery key — if the TPM changed or the PIN is lost, the only "
                "reset is to reinstall.", 5)
    os.makedirs(MOUNT, exist_ok=True)
    if not is_mounted(MOUNT):
        run(["mount", "/dev/mapper/" + MAPPER, MOUNT])
    return 0


def cmd_close():
    must_root()
    if is_mounted(MOUNT):
        run(["umount", MOUNT])
    if mapper_open():
        run(["cryptsetup", "close", MAPPER])
    print("vault closed.")
    return 0


# ──────────────────────────── key table (root) ───────────────────────────────
def _read_index():
    try:
        return json.load(open(INDEX))
    except Exception:
        return {"entries": {}}


def _write_index(idx):
    tmp = INDEX + ".tmp"
    with open(tmp, "w") as f:
        json.dump(idx, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, INDEX)


def _need_mounted():
    if not is_mounted(MOUNT):
        die("key vault is not unlocked/mounted — run `hash-keystore open`.", 4)


def cmd_put(name, infile):
    must_root()
    if not _valid_name(name):
        die("invalid key name: %r (A-Z a-z 0-9 . _ -)" % name, 2)
    if not os.path.isfile(infile):
        die("input file not found: %s" % infile, 4)
    _need_mounted()
    os.makedirs(TABLE, exist_ok=True)
    dest = os.path.join(TABLE, name)
    shutil.copyfile(infile, dest)
    os.chmod(dest, 0o600)
    idx = _read_index()
    idx.setdefault("entries", {})[name] = {
        "added": int(time.time()), "size": os.path.getsize(dest)}
    _write_index(idx)
    print("Stored key %r in the table." % name)
    return 0


def cmd_get(name, outfile=None):
    must_root()
    if not _valid_name(name):
        die("invalid key name: %r" % name, 2)
    _need_mounted()
    src = os.path.join(TABLE, name)
    if not os.path.isfile(src):
        die("no key named %r in the table." % name, 4)
    if outfile:
        shutil.copyfile(src, outfile)
        os.chmod(outfile, 0o600)
        print("Wrote %r -> %s" % (name, outfile))
    else:
        sys.stdout.write(open(src).read())
    return 0


def cmd_list():
    if not is_mounted(MOUNT):
        print("(key vault not unlocked)")
        return 0
    keys = table_keys()
    if not keys:
        print("(key table is empty)")
        return 0
    idx = _read_index().get("entries", {})
    for k in keys:
        meta = idx.get(k, {})
        print("%-32s %s bytes" % (k, meta.get("size", "?")))
    return 0


def cmd_remove(name):
    must_root()
    if not _valid_name(name):
        die("invalid key name: %r" % name, 2)
    _need_mounted()
    p = os.path.join(TABLE, name)
    if not os.path.isfile(p):
        die("no key named %r." % name, 4)
    os.remove(p)
    idx = _read_index()
    idx.get("entries", {}).pop(name, None)
    _write_index(idx)
    print("Removed key %r from the table." % name)
    return 0


USAGE = __doc__


def main(argv):
    if not argv:
        sys.stderr.write(USAGE)
        return 2
    cmd, a = argv[0], argv[1:]
    if cmd == "status":
        return cmd_status()
    if cmd == "require-secureboot":
        return cmd_require_secureboot()
    if cmd == "list":
        return cmd_list()
    try:
        if cmd == "init":
            dev = a[a.index("--device") + 1] if "--device" in a else None
            size = int(a[a.index("--size") + 1]) if "--size" in a else DEFAULT_SIZE_GIB
            return cmd_init(dev, size)
        if cmd == "set-pin":
            return cmd_set_pin()
        if cmd == "open":
            return cmd_open()
        if cmd == "close":
            return cmd_close()
        if cmd == "put":
            return cmd_put(a[0], a[1])
        if cmd == "get":
            return cmd_get(a[0], a[1] if len(a) > 1 else None)
        if cmd == "remove":
            return cmd_remove(a[0])
    except IndexError:
        die("missing arguments for %r\n\n%s" % (cmd, USAGE), 2)
    die("unknown subcommand: %r\n\n%s" % (cmd, USAGE), 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
