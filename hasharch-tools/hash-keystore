#!/usr/bin/env python3
"""hash-keystore — HasH's Secure-Boot-gated key vault & key table.

A dedicated ~1 GiB partition (GPT name HASH-KEYSTORE) is LUKS2-encrypted and its
unlock key is enrolled to the TPM2, bound to PCR 7 (the UEFI Secure Boot state).
So the vault auto-unlocks at boot ONLY when:

    * this machine's TPM is present, AND
    * Secure Boot is enabled and the firmware / boot chain is unchanged.

A stolen disk, or a machine booted with Secure Boot off / a tampered boot chain,
gets a vault that will not open. A printed RECOVERY KEY is enrolled too, as the
never-lock-out fallback (TPM/PCR7 unlock breaks legitimately on firmware updates).

Inside the unlocked volume lives the KEY TABLE — named key entries (LUKS keys,
identity/credential material, certs, SSH keys, passkey backups…) with a small
JSON index, mounted at /var/lib/hash/keystore (root-only 0700).

Subcommands:
  status                 JSON: SB state, TPM2, LUKS, enrolment, mount, key count
  require-secureboot     exit 0 iff Secure Boot is ENABLED (installer gate)
  init [--device DEV] [--size GiB]
                         (root) LUKS2-format DEV, enrol TPM2+PCR7 + a recovery key,
                         open, mkfs, mount, write crypttab+fstab, create the table
  open / close           (root) unlock / lock the vault (TPM2, else recovery key)
  put  <name> <file>     (root) store a key entry in the table
  get  <name> [out]      (root) read a key entry (to file or stdout)
  list                   list key-table entries
  remove <name>          (root) delete a key entry

Hard rules: never weakens the LUKS fallback (a recovery key is always enrolled
alongside TPM2, so you can't be permanently locked out); refuses TPM2 enrolment
when Secure Boot is OFF (the PCR7 binding would be meaningless).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

LABEL = "HASH-KEYSTORE"                 # GPT partition name + LUKS/FS label
MAPPER = "hashkeystore"                 # /dev/mapper/hashkeystore
MOUNT = "/var/lib/hash/keystore"
TABLE = os.path.join(MOUNT, "table")    # the key table (named entries)
INDEX = os.path.join(MOUNT, "index.json")
PCRS = "7"                              # PCR 7 = UEFI Secure Boot state
DEFAULT_SIZE_GIB = 1


def die(msg, code=1):
    sys.stderr.write(msg.rstrip() + "\n")
    sys.exit(code)


def must_root():
    if os.geteuid() != 0:
        die("hash-keystore: this needs root (run via the installer or sudo).", 87)


def which(cmd):
    return shutil.which(cmd) is not None


def run(argv, **kw):
    return subprocess.run(argv, capture_output=True, text=True, **kw)


# ───────────────────────────── detection (read-only) ─────────────────────────
def secure_boot_state():
    """'on' | 'off' | 'unsupported' — EFI SecureBoot var, mokutil fallback."""
    try:
        base = "/sys/firmware/efi/efivars"
        for fn in os.listdir(base):
            if fn.startswith("SecureBoot-"):
                with open(os.path.join(base, fn), "rb") as f:
                    data = f.read()
                return "on" if data and data[-1] == 1 else "off"
    except (FileNotFoundError, NotADirectoryError, PermissionError):
        pass
    if which("mokutil"):
        out = (run(["mokutil", "--sb-state"]).stdout or "").lower()
        if "enabled" in out:
            return "on"
        if "disabled" in out:
            return "off"
    return "unsupported" if not os.path.exists("/sys/firmware/efi") else "off"


def tpm2_present():
    return (os.path.exists("/dev/tpmrm0") or os.path.exists("/dev/tpm0")
            or os.path.isdir("/sys/class/tpm/tpm0"))


def keystore_device():
    """Path of the HASH-KEYSTORE partition — by GPT partition name (how the
    installer creates it) or LUKS/FS label, else None."""
    for p in ("/dev/disk/by-partlabel/" + LABEL, "/dev/disk/by-label/" + LABEL):
        if os.path.exists(p):
            return os.path.realpath(p)
    if which("blkid"):
        r = run(["blkid", "-L", LABEL])
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    return None


def is_luks(dev):
    return bool(dev) and which("cryptsetup") and \
        run(["cryptsetup", "isLuks", dev]).returncode == 0


def tpm2_enrolled(dev):
    """True if a TPM2 token is enrolled on the LUKS device."""
    if not (dev and which("cryptsetup")):
        return False
    out = (run(["cryptsetup", "luksDump", dev]).stdout or "").lower()
    return "systemd-tpm2" in out or "tpm2" in out


def mapper_open():
    return os.path.exists("/dev/mapper/" + MAPPER)


def is_mounted(path):
    try:
        with open("/proc/mounts") as f:
            return any((" " + path + " ") in (" " + ln + " ") for ln in f)
    except OSError:
        return False


def table_keys():
    if not os.path.isdir(TABLE):
        return []
    return sorted(n for n in os.listdir(TABLE)
                  if os.path.isfile(os.path.join(TABLE, n)))


# ─────────────────────────────── status / gate ───────────────────────────────
def cmd_status():
    dev = keystore_device()
    sb = secure_boot_state()
    luks = is_luks(dev)
    out = {
        "secure_boot": sb,
        "tpm2": tpm2_present(),
        "partition": dev,
        "luks": luks,
        "tpm2_enrolled": tpm2_enrolled(dev) if luks else False,
        "unlocked": mapper_open(),
        "mounted": is_mounted(MOUNT),
        "mountpoint": MOUNT,
        "keys": table_keys(),
        "ready": bool(dev and luks and mapper_open() and is_mounted(MOUNT)),
        "note": "Vault is LUKS2 + TPM2/PCR7 (Secure Boot). A recovery key is the "
                "fallback. TPM2 enrolment needs Secure Boot ON.",
    }
    print(json.dumps(out, indent=2))
    return 0


def cmd_require_secureboot():
    sb = secure_boot_state()
    if sb == "on":
        print("Secure Boot: enabled.")
        return 0
    die("Secure Boot is %s — the HasH key vault requires Secure Boot ENABLED so "
        "its TPM2/PCR7-sealed unlock key is tamper-evident. Enable Secure Boot in "
        "firmware (and enrol keys), then retry." % sb, 3)


def _valid_name(name):
    return bool(name) and re.fullmatch(r"[A-Za-z0-9._-]{1,64}", name) is not None


# ──────────────────────────────── init (root) ────────────────────────────────
def cmd_init(device=None, size_gib=DEFAULT_SIZE_GIB):
    must_root()
    for tool in ("cryptsetup", "mkfs.ext4", "systemd-cryptenroll"):
        if not which(tool):
            die("required tool missing: %s" % tool, 4)
    dev = device or keystore_device()
    if not dev or not os.path.exists(dev):
        die("No HASH-KEYSTORE partition found. Create a ~%d GiB partition (GPT name "
            "%s) and pass --device /dev/XYZ — the installer does this for you."
            % (size_gib, LABEL), 4)
    if is_luks(dev):
        die("%s is already a LUKS volume — refusing to reformat (would destroy "
            "keys). Use `open`. To start over, wipe it manually first." % dev, 6)

    # 1) LUKS2-format with a throwaway initial key, then enrol the real slots.
    import tempfile
    tmpd = tempfile.mkdtemp(prefix="hash-ks-")
    ikey = os.path.join(tmpd, "init.key")
    try:
        with open(ikey, "wb") as f:
            f.write(os.urandom(64))
        os.chmod(ikey, 0o600)
        print("LUKS2-formatting %s …" % dev)
        if run(["cryptsetup", "luksFormat", "--type", "luks2", "--batch-mode",
                "--label", LABEL, dev, ikey]).returncode != 0:
            die("luksFormat failed.", 5)

        # 2) OPEN now, while the throwaway key is still valid (we remove its slot
        #    last; removing a keyslot does NOT close an already-active mapping).
        if not mapper_open():
            if run(["cryptsetup", "open", "--key-file=" + ikey, dev, MAPPER]).returncode != 0:
                die("could not open the new volume.", 5)

        # 3) recovery key — the never-lock-out fallback (printed for the user).
        print("Enrolling a recovery key (SAVE THIS — it's your fallback):")
        r = run(["systemd-cryptenroll", "--unlock-key-file=" + ikey,
                 "--recovery-key", dev])
        if r.returncode != 0:
            die("recovery-key enrolment failed: %s" % (r.stderr or r.stdout), 5)
        sys.stdout.write(r.stdout)        # the recovery key is on stdout

        # 4) TPM2 + PCR7 (Secure Boot) — auto-unlock, only if SB is on.
        if secure_boot_state() == "on" and tpm2_present():
            print("Enrolling TPM2 (bound to PCR%s / Secure Boot)…" % PCRS)
            if run(["systemd-cryptenroll", "--unlock-key-file=" + ikey,
                    "--tpm2-device=auto", "--tpm2-pcrs=" + PCRS, dev]).returncode != 0:
                print("WARNING: TPM2 enrolment failed — vault still opens with the "
                      "recovery key. Re-run `hash-keystore init` once Secure Boot/TPM "
                      "are ready, or enrol later.")
        else:
            print("NOTE: Secure Boot is off / no TPM2 — skipping TPM2 auto-unlock. "
                  "The recovery key works now; enrol TPM2 later with Secure Boot on.")

        # 5) remove the throwaway key so only recovery-key (+ TPM2) remain. The
        #    volume stays open (step 2), so mkfs/mount below still work.
        run(["cryptsetup", "luksRemoveKey", dev, ikey])
    finally:
        try:
            os.remove(ikey)
        except OSError:
            pass
        shutil.rmtree(tmpd, ignore_errors=True)

    mp = "/dev/mapper/" + MAPPER
    print("Creating filesystem…")
    if run(["mkfs.ext4", "-q", "-F", "-L", LABEL, mp]).returncode != 0:
        die("mkfs.ext4 failed.", 5)
    os.makedirs(MOUNT, exist_ok=True)
    os.chmod(MOUNT, 0o700)
    if not is_mounted(MOUNT) and run(["mount", mp, MOUNT]).returncode != 0:
        die("could not mount the vault.", 5)
    os.chmod(MOUNT, 0o700)
    os.makedirs(TABLE, exist_ok=True)
    os.chmod(TABLE, 0o700)
    if not os.path.exists(INDEX):
        _write_index({"created": int(time.time()), "entries": {}})
    _persist(dev)
    print("Key vault ready: LUKS2 on %s, mounted at %s. Keep the recovery key safe."
          % (dev, MOUNT))
    return 0


def _persist(dev):
    """crypttab (TPM2 auto-unlock) + fstab (nofail) so the vault returns on boot."""
    cry = "%s  PARTLABEL=%s  -  tpm2-device=auto,nofail\n" % (MAPPER, LABEL)
    _append_unique("/etc/crypttab", MAPPER, cry,
                   "# HasH key vault — TPM2/PCR7 auto-unlock (recovery key is the fallback)")
    fst = "/dev/mapper/%s  %s  ext4  defaults,nofail,nosuid,nodev  0 2\n" % (MAPPER, MOUNT)
    _append_unique("/etc/fstab", MOUNT, fst, "# HasH key vault")


def _append_unique(path, needle, line, comment):
    try:
        cur = open(path).read()
    except OSError:
        cur = ""
    if needle in cur:
        return
    with open(path, "a") as f:
        if cur and not cur.endswith("\n"):
            f.write("\n")
        f.write(comment + "\n" + line)


# ──────────────────────────── open / close (root) ────────────────────────────
def cmd_open():
    must_root()
    if mapper_open():
        print("vault already open.")
    else:
        dev = keystore_device()
        if not dev or not is_luks(dev):
            die("no LUKS key vault found (run `init`).", 4)
        # systemd handles tpm2 unlock via crypttab at boot; manual open tries tpm2
        # then prompts for the recovery key.
        if run(["systemd-cryptsetup", "attach", MAPPER, dev]).returncode != 0:
            if run(["cryptsetup", "open", dev, MAPPER]).returncode != 0:
                die("could not open the vault (TPM2 unlock failed; recovery key?).", 5)
    os.makedirs(MOUNT, exist_ok=True)
    if not is_mounted(MOUNT):
        run(["mount", "/dev/mapper/" + MAPPER, MOUNT])
    return 0


def cmd_close():
    must_root()
    if is_mounted(MOUNT):
        run(["umount", MOUNT])
    if mapper_open():
        run(["cryptsetup", "close", MAPPER])
    print("vault closed.")
    return 0


# ──────────────────────────── key table (root) ───────────────────────────────
def _read_index():
    try:
        return json.load(open(INDEX))
    except Exception:
        return {"entries": {}}


def _write_index(idx):
    tmp = INDEX + ".tmp"
    with open(tmp, "w") as f:
        json.dump(idx, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, INDEX)


def _need_mounted():
    if not is_mounted(MOUNT):
        die("key vault is not unlocked/mounted — run `hash-keystore open`.", 4)


def cmd_put(name, infile):
    must_root()
    if not _valid_name(name):
        die("invalid key name: %r (A-Z a-z 0-9 . _ -)" % name, 2)
    if not os.path.isfile(infile):
        die("input file not found: %s" % infile, 4)
    _need_mounted()
    os.makedirs(TABLE, exist_ok=True)
    dest = os.path.join(TABLE, name)
    shutil.copyfile(infile, dest)
    os.chmod(dest, 0o600)
    idx = _read_index()
    idx.setdefault("entries", {})[name] = {
        "added": int(time.time()), "size": os.path.getsize(dest)}
    _write_index(idx)
    print("Stored key %r in the table." % name)
    return 0


def cmd_get(name, outfile=None):
    must_root()
    if not _valid_name(name):
        die("invalid key name: %r" % name, 2)
    _need_mounted()
    src = os.path.join(TABLE, name)
    if not os.path.isfile(src):
        die("no key named %r in the table." % name, 4)
    if outfile:
        shutil.copyfile(src, outfile)
        os.chmod(outfile, 0o600)
        print("Wrote %r -> %s" % (name, outfile))
    else:
        sys.stdout.write(open(src).read())
    return 0


def cmd_list():
    if not is_mounted(MOUNT):
        print("(key vault not unlocked)")
        return 0
    keys = table_keys()
    if not keys:
        print("(key table is empty)")
        return 0
    idx = _read_index().get("entries", {})
    for k in keys:
        meta = idx.get(k, {})
        print("%-32s %s bytes" % (k, meta.get("size", "?")))
    return 0


def cmd_remove(name):
    must_root()
    if not _valid_name(name):
        die("invalid key name: %r" % name, 2)
    _need_mounted()
    p = os.path.join(TABLE, name)
    if not os.path.isfile(p):
        die("no key named %r." % name, 4)
    os.remove(p)
    idx = _read_index()
    idx.get("entries", {}).pop(name, None)
    _write_index(idx)
    print("Removed key %r from the table." % name)
    return 0


USAGE = __doc__


def main(argv):
    if not argv:
        sys.stderr.write(USAGE)
        return 2
    cmd, a = argv[0], argv[1:]
    if cmd == "status":
        return cmd_status()
    if cmd == "require-secureboot":
        return cmd_require_secureboot()
    if cmd == "list":
        return cmd_list()
    try:
        if cmd == "init":
            dev = a[a.index("--device") + 1] if "--device" in a else None
            size = int(a[a.index("--size") + 1]) if "--size" in a else DEFAULT_SIZE_GIB
            return cmd_init(dev, size)
        if cmd == "open":
            return cmd_open()
        if cmd == "close":
            return cmd_close()
        if cmd == "put":
            return cmd_put(a[0], a[1])
        if cmd == "get":
            return cmd_get(a[0], a[1] if len(a) > 1 else None)
        if cmd == "remove":
            return cmd_remove(a[0])
    except IndexError:
        die("missing arguments for %r\n\n%s" % (cmd, USAGE), 2)
    die("unknown subcommand: %r\n\n%s" % (cmd, USAGE), 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
