        def show_app(self, it):
            """Populate the page for `it` and kick off async description +
            screenshot loads. Safe to call repeatedly (re-uses cached data)."""
            self.item = dict(it)
            name = it.get("name", it.get("pkg", ""))
            self.header.title.setText(name)
            self.header.set_can_back(self.win.router.can_back())
