#!/usr/bin/env python3
"""HasH-Arch Software Center  (hash-store)

A graphical package manager for HasH-Arch — browse a Discover-style app catalog,
search, install, update and remove software, and add your own repositories,
all without touching the terminal.

Sources : official repos (pacman) + AUR (yay) + flatpak (removal). App catalog
          is built from AppStream metadata (the same data KDE Discover uses).
Privilege: transactions run through `yay` with a GRAPHICAL password prompt
          (sudo -A + SUDO_ASKPASS=ksshaskpass); editing repositories writes
          /etc/pacman.conf via pkexec (polkit). No terminal, ever.

Usage:
    hash-store                 launch the GUI (Discover catalog)
    hash-store --updates       launch on the Updates page
    hash-store --sources       launch on the Sources/Repositories page
    hash-store backend <cmd>   headless JSON: updates|search <t>|installed|info <p>|catalog|storefront|repos
    hash-store _writeconf <f>  (internal, run via pkexec) install <f> as /etc/pacman.conf
"""
import gzip
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

SCRIPT = os.path.realpath(__file__)
ASKPASS = "/usr/bin/ksshaskpass" if os.path.exists("/usr/bin/ksshaskpass") else ""
HAS_YAY = bool(shutil.which("yay"))
HAS_FLATPAK = bool(shutil.which("flatpak"))
PACCONF = "/etc/pacman.conf"

SWCAT_XML = "/usr/share/swcatalog/xml"
SWCAT_ICONS = "/usr/share/swcatalog/icons"
ORIGIN = {"core": "archlinux-arch-core", "extra": "archlinux-arch-extra",
          "multilib": "archlinux-arch-multilib"}
# (AppStream category, friendly label) shown in the Discover category picker
CATEGORIES = [("All", "All apps"), ("Game", "Games"), ("AudioVideo", "Multimedia"),
              ("Development", "Development"), ("Graphics", "Graphics"),
              ("Network", "Internet"), ("Office", "Office"), ("System", "System"),
              ("Utility", "Utilities"), ("Education", "Education"), ("Science", "Science")]


def run(cmd, timeout=90):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        class _R:
            returncode = 1
            stdout = ""
            stderr = str(e)
        return _R()


# ───────────────────────────── read-only backend ─────────────────────────────
def get_updates():
    repo = []
    for ln in run(["checkupdates"]).stdout.splitlines():
        p = ln.split()
        if len(p) >= 4 and p[2] == "->":
            repo.append({"name": p[0], "old": p[1], "new": p[3], "src": "repo"})
    aur = []
    if HAS_YAY:
        for ln in run(["yay", "-Qua"], timeout=60).stdout.splitlines():
            p = ln.split()
            if len(p) >= 4 and p[2] == "->":
                aur.append({"name": p[0], "old": p[1], "new": p[3], "src": "aur"})
    return {"repo": repo, "aur": aur}


def search_repos(term):
    out = []
    if not term.strip():
        return out
    lines = run(["pacman", "-Ss", term]).stdout.splitlines()
    i = 0
    while i < len(lines):
        head = lines[i]
        if head and not head.startswith(" ") and "/" in head.split(" ")[0]:
            try:
                repopart, rest = head.split("/", 1)
                toks = rest.split()
                name, ver = toks[0], (toks[1] if len(toks) > 1 else "")
            except Exception:
                i += 1
                continue
            desc = ""
            if i + 1 < len(lines) and lines[i + 1].startswith(" "):
                desc = lines[i + 1].strip()
                i += 1
            out.append({"name": name, "repo": repopart, "version": ver,
                        "summary": desc, "installed": "[installed" in head, "src": "repo"})
        i += 1
    return out


def search_aur(term):
    out = []
    if not (HAS_YAY and term.strip()):
        return out
    lines = run(["yay", "-Ssa", term], timeout=60).stdout.splitlines()
    i = 0
    while i < len(lines):
        head = lines[i]
        if head.startswith("aur/"):
            toks = head[4:].split()
            name, ver = toks[0], (toks[1] if len(toks) > 1 else "")
            desc = ""
            if i + 1 < len(lines) and lines[i + 1].startswith(" "):
                desc = lines[i + 1].strip()
                i += 1
            out.append({"name": name, "repo": "aur", "version": ver,
                        "summary": desc, "installed": "(Installed)" in head, "src": "aur"})
        i += 1
    return out


def list_installed():
    out = []
    foreign = set(run(["pacman", "-Qmq"]).stdout.split())
    for ln in run(["pacman", "-Qe"]).stdout.splitlines():
        p = ln.split()
        if p:
            out.append({"name": p[0], "version": p[1] if len(p) > 1 else "",
                        "installed": True, "src": "aur" if p[0] in foreign else "repo"})
    if HAS_FLATPAK:
        for ln in run(["flatpak", "list", "--app",
                       "--columns=application,name,version"]).stdout.splitlines():
            c = ln.split("\t")
            if c and c[0]:
                out.append({"name": (c[1] if len(c) > 1 and c[1] else c[0]),
                            "appid": c[0], "version": c[2] if len(c) > 2 else "",
                            "installed": True, "src": "flatpak"})
    return out


def pkg_info(name, src="repo"):
    if src == "flatpak" and HAS_FLATPAK:
        return {"raw": run(["flatpak", "info", name]).stdout.strip()}
    r = run(["pacman", "-Qi", name])
    if r.returncode != 0 or not r.stdout.strip():
        r = run(["pacman", "-Si", name])
    info = {}
    for ln in r.stdout.splitlines():
        if " : " in ln:
            k, v = ln.split(" : ", 1)
            info[k.strip()] = v.strip()
    return info


def _icon_path(origin, fname):
    for sz in ("64x64", "128x128", "48x48"):
        p = os.path.join(SWCAT_ICONS, origin, sz, fname)
        if os.path.exists(p):
            return p
    return ""


# Locale selection for AppStream's translated text (<name>/<summary>/<description>).
# We must always show the user's language, preferring English (incl. the
# unlabelled upstream "C" source) over any random foreign-language variant.
#
# Detect the user's locale from the environment with correct POSIX precedence:
#   LC_ALL > LC_MESSAGES > LANG  (e.g. "en_GB.UTF-8" -> "en_GB", lang "en").
_XMLLANG = "{http://www.w3.org/XML/1998/namespace}lang"
# Sentinel for AppStream elements with NO xml:lang attribute.  In AppStream /
# MetaInfo the unlabelled text is the upstream C / English source string, so we
# treat it as English and rank it just below the explicit "en" variants.
_NOLANG = "\0nolang"


def _detect_locale():
    raw = (os.environ.get("LC_ALL")
           or os.environ.get("LC_MESSAGES")
           or os.environ.get("LANG")
           or "en_US")
    # strip codeset/modifier: "en_GB.UTF-8@euro" -> "en_GB"
    loc = raw.split(".")[0].split("@")[0].strip()
    if not loc or loc in ("C", "POSIX"):
        loc = "en_US"
    return loc


def _norm_lang(lang):
    """Normalise a locale/xml:lang to lower-case underscore form for matching.

    AppStream xml:lang uses BCP-47 hyphens ("en-GB", "pt-BR", "zh-Hans-CN")
    while POSIX env locales use underscores ("en_GB").  Normalising both to
    "en_gb" / "pt_br" lets us compare them directly.
    """
    return lang.replace("-", "_").lower()


_loc = _detect_locale()
_lang = _loc.split("_")[0]
_loc_n = _norm_lang(_loc)          # e.g. "en_gb"
_lang_n = _loc_n.split("_")[0]     # e.g. "en"


def _lang_rank(lang):
    """Rank a candidate's xml:lang (None == _NOLANG sentinel here).

    Lower is better.  Order: exact locale, language-only, en_US, any other
    en_*, then the unlabelled C/English source, then everything else.  This
    guarantees an English (or no-lang upstream) string always beats a foreign
    translation when no exact/language match exists.  Comparisons are done on
    the normalised (hyphen->underscore, lower-case) form so BCP-47 "en-GB"
    matches a POSIX "en_GB" locale.
    """
    if lang == _NOLANG:                    # 4. unlabelled upstream C/English
        return 4
    n = _norm_lang(lang)
    if n == _loc_n:                        # 1. exact locale, e.g. en_gb
        return 0
    if n == _lang_n:                       # 2. language only, e.g. en
        return 1
    if n == "en_us":                       # 3a. en_US
        return 2
    if n == "en" or n.startswith("en_"):   # 3b. any other en_*
        return 3
    return 99                              # 5. unrelated foreign language


def _best_lang(langs):
    """Pick the best xml:lang key from an iterable (None -> _NOLANG sentinel).

    Returns the chosen key (possibly _NOLANG), or None if `langs` is empty.
    Stable: ties keep first-seen order.
    """
    best = None
    best_rank = None
    for i, raw in enumerate(langs):
        lang = _NOLANG if raw is None else raw
        r = _lang_rank(lang)
        if best is None or r < best_rank:
            best, best_rank = lang, r
    return best


def _localized(comp, tag):
    """Best-locale text for a (possibly translated) AppStream field."""
    by_lang = {}        # lang-key (incl. _NOLANG) -> first text seen
    order = []
    for el in comp.findall(tag):
        lang = _NOLANG if el.get(_XMLLANG) is None else el.get(_XMLLANG)
        if lang not in by_lang:
            by_lang[lang] = el.text
            order.append(lang)
    if not order:
        return None
    return by_lang[_best_lang(order)]


_catalog = None


def get_catalog():
    """AppStream desktop apps: [{name, pkg, summary, cats, icon, src}] (cached)."""
    global _catalog
    if _catalog is not None:
        return _catalog
    seen, apps = set(), []
    for gz in sorted(glob.glob(os.path.join(SWCAT_XML, "*.xml.gz"))):
        repo = os.path.basename(gz).split(".")[0]
        origin = ORIGIN.get(repo, "")
        try:
            with gzip.open(gz, "rt", encoding="utf-8", errors="ignore") as f:
                root = ET.fromstring(f.read())
        except Exception:
            continue
        for comp in root.findall("component"):
            if comp.get("type") != "desktop-application":
                continue
            pkg = comp.findtext("pkgname")
            name = _localized(comp, "name")
            if not pkg or not name or pkg in seen:
                continue
            seen.add(pkg)
            icon = ""
            for i in comp.findall("icon"):
                if i.get("type") == "cached":
                    icon = _icon_path(origin, i.text)
                    if icon:
                        break
            apps.append({"name": name, "pkg": pkg, "name_lc": name.lower(),
                         "summary": _localized(comp, "summary") or "",
                         "cats": [c.text for c in comp.findall("categories/category")],
                         "icon": icon, "src": "repo"})
    apps.sort(key=lambda a: a["name_lc"])
    _catalog = apps
    return apps


def _desc_to_text(el):
    """Flatten an AppStream <description> element into plain paragraphs.

    AppStream descriptions are rich (<p>/<ul>/<ol>/<li>) and often carry
    per-element translations via xml:lang. We pick the best locale (user's
    language, then English, then the untranslated default) so we never show a
    random foreign language when a matching one is present, then render to
    plain text so a QLabel can display it without a full HTML widget.
    """
    if el is None:
        return ""
    # Which langs are present? Choose ONE preferred lang for the whole block,
    # ranking the unlabelled upstream (C/English) text just below explicit en.
    present = []
    for child in el:
        present.append(child.get(_XMLLANG))
    chosen = _best_lang(present)          # _NOLANG sentinel, a lang, or None

    parts = []
    for child in el:
        clang = _NOLANG if child.get(_XMLLANG) is None else child.get(_XMLLANG)
        if clang != chosen:
            continue
        tag = child.tag.split("}")[-1]
        if tag == "p":
            txt = "".join(child.itertext()).strip()
            if txt:
                parts.append(txt)
        elif tag in ("ul", "ol"):
            for li in child:
                if li.tag.split("}")[-1] == "li":
                    txt = "".join(li.itertext()).strip()
                    if txt:
                        parts.append("  •  " + txt)
    return "\n\n".join(parts)


def _best_description(comp):
    """Pick the best-locale <description> element from a component.

    AppStream catalogs emit ONE <description> element per language as siblings
    (each with its own <p>/<ul>/<li> children), e.g. <description xml:lang="ru">
    ... </description> next to an unlabelled (C/English) <description>.  The old
    code used comp.find("description") which returns the FIRST sibling in
    document order — a foreign language (Bulgarian/Russian/...) — regardless of
    the user's locale.  Here we rank the siblings by xml:lang and return the
    best, treating the unlabelled one as the C/English source.  (Some catalogs
    instead put per-<p> xml:lang inside a single <description>; _desc_to_text
    still handles that case after we pick the element.)
    """
    descs = comp.findall("description")
    if not descs:
        return None
    langs = [d.get(_XMLLANG) for d in descs]
    chosen = _best_lang(langs)
    for d in descs:
        dlang = _NOLANG if d.get(_XMLLANG) is None else d.get(_XMLLANG)
        if dlang == chosen:
            return d
    return descs[0]


_details_cache = {}


def appstream_details(pkg):
    """Rich AppStream data for one package (cached) for the App Detail page.

    Returns {description, license, url, screenshots:[urls]} parsed straight
    from the swcatalog XML. Screenshots prefer a thumbnail image, falling back
    to the full-size 'source' image. Returns empty fields when the package has
    no AppStream component (e.g. most AUR/CLI packages) so callers degrade
    gracefully (no screenshots -> hide the strip).
    """
    if pkg in _details_cache:
        return _details_cache[pkg]
    out = {"description": "", "license": "", "url": "", "screenshots": []}
    for gz in sorted(glob.glob(os.path.join(SWCAT_XML, "*.xml.gz"))):
        try:
            with gzip.open(gz, "rt", encoding="utf-8", errors="ignore") as f:
                root = ET.fromstring(f.read())
        except Exception:
            continue
        comp = None
        for c in root.findall("component"):
            if c.get("type") == "desktop-application" and c.findtext("pkgname") == pkg:
                comp = c
                break
        if comp is None:
            continue
        out["description"] = _desc_to_text(_best_description(comp))
        out["license"] = (comp.findtext("project_license") or "").strip()
        for u in comp.findall("url"):
            if u.get("type") == "homepage" and u.text:
                out["url"] = u.text.strip()
                break
        ss = comp.find("screenshots")
        if ss is not None:
            for shot in ss.findall("screenshot"):
                imgs = shot.findall("image")
                if not imgs:
                    continue
                # prefer a moderately-sized thumbnail; else the source image
                thumb = None
                source = None
                best_thumb_w = -1
                for img in imgs:
                    t = img.get("type")
                    url = (img.text or "").strip()
                    if not url:
                        continue
                    if t == "source":
                        source = url
                    elif t == "thumbnail":
                        try:
                            w = int(img.get("width") or 0)
                        except ValueError:
                            w = 0
                        # aim for ~750px wide thumbnails when offered
                        if w >= 500 and (best_thumb_w < 0 or w < best_thumb_w):
                            best_thumb_w = w
                            thumb = url
                        elif best_thumb_w < 0:
                            thumb = url
                pick = thumb or source
                if pick:
                    out["screenshots"].append(pick)
        break
    _details_cache[pkg] = out
    return out


def installed_set():
    return set(run(["pacman", "-Qq"]).stdout.split())


# ───────────────────────── AUR RPC (popularity data) ─────────────────────────
# Real "top downloaded / trending" data comes from the AUR RPC v5 metadata
# (Popularity / NumVotes). We hit it with the stdlib only (no new dependency)
# and always degrade gracefully — every caller falls back to a curated list if
# the network is unavailable so the storefront never looks empty/broken.
AUR_RPC = "https://aur.archlinux.org/rpc/v5"

# Curated "Editor's Picks" — great, broadly-loved apps. Also the offline
# fallback for every storefront shelf. Filtered to ones actually available.
EDITORS_PICKS = ["firefox", "vlc", "gimp", "blender", "krita", "obs-studio",
                 "libreoffice-fresh", "code", "steam", "discord", "thunderbird",
                 "inkscape", "audacity", "kdenlive", "neovim", "telegram-desktop",
                 "spotify", "chromium", "qbittorrent", "mpv"]

# Seed terms used to discover popular/trending AUR packages via search.
_POPULAR_SEEDS = ["firefox", "chrome", "code", "discord", "spotify", "steam",
                  "vlc", "obs", "git", "editor", "browser", "player", "video",
                  "game", "office", "image", "terminal", "music"]


def _aur_get(endpoint, params):
    """GET an AUR RPC endpoint -> parsed JSON dict (or {} on any failure)."""
    url = AUR_RPC + endpoint + "?" + urllib.parse.urlencode(params, doseq=True)
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "hash-store/1"})
        with urllib.request.urlopen(req, timeout=12) as r:
            return json.loads(r.read().decode("utf-8", "ignore"))
    except Exception:
        return {}


def aur_search(term):
    """AUR RPC search by name-desc -> list of result dicts (or [])."""
    data = _aur_get("/search", {"by": "name-desc", "arg": term})
    if isinstance(data, dict) and data.get("type") == "search":
        return data.get("results", []) or []
    return []


def aur_info(names):
    """AUR RPC info for explicit package names -> list of result dicts."""
    if not names:
        return []
    data = _aur_get("/info", {"arg[]": list(names)})
    if isinstance(data, dict):
        return data.get("results", []) or []
    return []


def _aur_to_item(r):
    """Normalise an AUR RPC result into the catalog item shape used by the UI."""
    return {"name": r.get("Name", ""), "pkg": r.get("Name", ""),
            "name_lc": r.get("Name", "").lower(),
            "summary": (r.get("Description") or "") or "",
            "cats": [], "icon": "", "src": "aur",
            "version": r.get("Version", ""),
            "popularity": float(r.get("Popularity") or 0.0),
            "votes": int(r.get("NumVotes") or 0),
            "last_modified": int(r.get("LastModified") or 0)}


def _pop_pool():
    """Gather a pool of AUR packages (via several seed searches) for ranking."""
    pool, seen = [], set()
    for seed in _POPULAR_SEEDS:
        for r in aur_search(seed):
            n = r.get("Name", "")
            if n and n not in seen:
                seen.add(n)
                pool.append(r)
    return pool


def storefront_data():
    """Build the Discover storefront shelves.

    Returns {hero, top, trending, picks}. "top"/"trending" use real AUR
    popularity (Popularity / recent NumVotes); on any network failure every
    shelf degrades to the curated Editor's Picks so the page is never empty.
    """
    cat = get_catalog()
    by_pkg = {a["pkg"]: a for a in cat}
    inst = installed_set()

    def from_repo(pkg):
        """Prefer the rich AppStream catalog entry (real icon) when present."""
        a = by_pkg.get(pkg)
        if a:
            a = dict(a)
            a["installed"] = pkg in inst
            return a
        return None

    # ---- Editor's Picks: curated, filtered to what's actually installable ----
    picks = []
    for pkg in EDITORS_PICKS:
        a = from_repo(pkg)
        if a:
            picks.append(a)
    # fill any gap from the broad catalog so the shelf is never tiny
    if len(picks) < 8:
        have = {p["pkg"] for p in picks}
        for a in cat:
            if a["pkg"] not in have:
                b = dict(a)
                b["installed"] = a["pkg"] in inst
                picks.append(b)
            if len(picks) >= 12:
                break

    # ---- Top Downloaded / Trending: real AUR popularity, else fall back ----
    pool = _pop_pool()
    top, trending = [], []
    if pool:
        items = [_aur_to_item(r) for r in pool]
        for it in items:
            it["installed"] = it["pkg"] in inst
            # use the AppStream icon if this AUR name is also a repo app
            rep = by_pkg.get(it["pkg"])
            if rep and rep.get("icon"):
                it["icon"] = rep["icon"]
        by_pop = sorted(items, key=lambda x: x["popularity"], reverse=True)
        top = by_pop[:14]
        by_trend = sorted(items, key=lambda x: (x["last_modified"], x["votes"]),
                          reverse=True)
        # trending = recently-updated with real traction, distinct from "top"
        top_names = {x["pkg"] for x in top}
        trending = [x for x in by_trend if x["votes"] >= 5][:20]
        trending = [x for x in trending if x["pkg"] not in top_names][:14] or by_trend[:14]
    else:
        top = list(picks)
        trending = list(reversed(picks))

    hero = picks[0] if picks else (top[0] if top else None)
    return {"hero": hero, "top": top, "trending": trending, "picks": picks}


# ──────────────────────────── repositories (sources) ─────────────────────────
def read_repos(text=None):
    """Parse pacman.conf repos -> [{name, enabled, server, include}]."""
    if text is None:
        try:
            text = open(PACCONF).read()
        except Exception:
            text = ""
    repos, cur = [], None
    for ln in text.splitlines():
        s = ln.strip()
        m = re.match(r"^(#?)\s*\[([^\]]+)\]\s*$", s)
        if m:
            if m.group(2) == "options":
                cur = None
                continue
            cur = {"name": m.group(2), "enabled": m.group(1) == "", "server": "", "include": ""}
            repos.append(cur)
            continue
        if cur is not None:
            m2 = re.match(r"^#?\s*(Server|Include)\s*=\s*(.+)$", s)
            if m2:
                cur["server" if m2.group(1) == "Server" else "include"] = m2.group(2).strip()
    # drop pacman.conf's documentation-example placeholder block
    return [r for r in repos if r["name"] != "repo-name"
            and r["server"] != "ServerName" and r["include"] != "IncludePath"]


def conf_add(text, name, kind, value, siglevel):
    block = "\n[%s]\n" % name
    if siglevel:
        block += "SigLevel = %s\n" % siglevel
    block += "%s = %s\n" % ("Server" if kind == "server" else "Include", value)
    return text.rstrip("\n") + "\n" + block


def _edit_block(text, name, mode):
    """mode: 'enable' | 'disable' | 'remove' applied to repo [name]'s block."""
    lines = text.split("\n")
    hdr = re.compile(r"^(\s*)#?\s*\[%s\]\s*$" % re.escape(name))
    body = re.compile(r"^(\s*)#?\s*(Server|Include|SigLevel)\s*=")
    out, i, n = [], 0, len(lines)
    while i < n:
        ln = lines[i]
        if hdr.match(ln):
            ind = re.match(r"^(\s*)", ln).group(1)
            if mode == "enable":
                out.append("%s[%s]" % (ind, name))
            elif mode == "disable":
                out.append("%s#[%s]" % (ind, name))
            i += 1
            while i < n and lines[i].strip() != "" and not re.match(r"^\s*#?\s*\[", lines[i]):
                b = lines[i]
                if body.match(b):
                    bind = re.match(r"^(\s*)", b).group(1)
                    content = re.sub(r"^\s*#?\s*", "", b)
                    if mode == "enable":
                        out.append(bind + content)
                    elif mode == "disable":
                        out.append(bind + "#" + content)
                    # remove -> drop the line
                elif mode != "remove":
                    out.append(b)
                i += 1
        else:
            out.append(ln)
            i += 1
    return "\n".join(out)


def writeconf(src):
    """(root, via pkexec) back up & install <src> as /etc/pacman.conf, then -Sy."""
    if not os.path.exists(src):
        sys.stderr.write("source not found\n")
        return 2
    txt = open(src).read()
    if "[options]" not in txt or "[core]" not in txt:
        sys.stderr.write("refusing: does not look like a valid pacman.conf\n")
        return 3
    bak = "/etc/pacman.conf.hashbak-%d" % int(time.time())
    shutil.copy2(PACCONF, bak)
    shutil.copy2(src, PACCONF)
    print("Backed up old config to %s" % bak)
    print("Refreshing package databases…\n")
    r = subprocess.run(["pacman", "-Sy"])
    return 0 if r.returncode == 0 else r.returncode


