        def refresh_lists(self):
            """After an install/remove from the App Detail page, refresh the
            catalog/installed pages so their installed-ticks stay correct."""
            for key in ("discover", "installed"):
                pg = self.router.widget(key)
                if pg is not None and getattr(pg, "items", None):
                    pg.reload()

        def go_back(self):
            self.router.back()

        def on_escape(self):
            # if a search field has focus, drop focus to the list first
            fw = QApplication.focusWidget()
            if isinstance(fw, QLineEdit) and fw.text():
                fw.clear()
                return
            # on Discover, Esc from the browse view returns to the storefront
            pg = self.router.widget(self.router.current_key())
            if getattr(pg, "mode", None) == "discover" and \
                    getattr(pg, "disc_stack", None) and \
                    pg.disc_stack.currentIndex() == 1:
                pg.go_storefront()
                return
            if self.router.can_back():
                self.router.back()
            else:
                self.close()

        def _on_navigated(self, key):
            for k, b in self.nav.items():
                b.setChecked(k == key)
            pg = self.router.widget(key)
            if pg is None:
                return
            if hasattr(pg, "header"):
                pg.header.set_can_back(self.router.can_back())
            if isinstance(pg, SourcesPage):
                if pg.working is None:
                    pg.reload()
            elif isinstance(pg, AppDetailPage):
                pass            # already populated by open_app(); nothing to load
            elif not getattr(pg, "items", None):
                pg.reload()
            # keep the Discover Back button correct for its storefront/browse state
            if getattr(pg, "mode", None) == "discover" and \
                    hasattr(pg, "_sync_disc_view"):
                pg._sync_disc_view()
            if hasattr(pg, "focus_default"):
                QTimer.singleShot(0, pg.focus_default)

        def run_txn(self, title, argv, on_done):
            self._tx = Transaction(self, title, argv, tx_env())
            self._tx.finishedOk.connect(on_done)
            g = self.geometry()
            self._tx.move(g.center().x() - 330, g.center().y() - 230)
            self._tx.show()

        def paintEvent(self, _e):
            p = QPainter(self)
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            path = QPainterPath()
            path.addRoundedRect(0.5, 0.5, self.width() - 1, self.height() - 1, 20, 20)
            p.fillPath(path, QColor(0x12, 0x14, 0x1a))
            p.setPen(QColor(255, 255, 255, 30))
            p.drawPath(path)

