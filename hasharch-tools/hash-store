                self.catL.addWidget(Chip(c))
            self.catL.addStretch(1)

            # async: pacman/AUR info (size/license/version) for the meta row
            self._iw = Worker(pkg_info, it.get("pkg", it["name"]),
                              it.get("src", "repo"))
            self._iw.done.connect(self._got_info)
            self._iw.start()
            # async: AppStream rich data (long description + screenshot URLs)
            self._dw = Worker(appstream_details, it.get("pkg", it["name"]))
            self._dw.done.connect(self._got_details)
            self._dw.start()

        def _refresh_action(self):
            it = self.item or {}
            installed = bool(it.get("installed"))
            if installed:
                self.action.setText("Remove")
                self.action.setObjectName("danger")
            else:
                self.action.setText("Install")
                self.action.setObjectName("primary")
            self.action.setStyleSheet(btn_qss())

        def _got_info(self, info):
            if not isinstance(info, dict) or "_error" in info:
                return
            it = self.item or {}
            chips = []
            ver = info.get("Version") or it.get("version")
            if ver:
                chips.append("v" + ver)
                self.source.setText(self.source.text().split("·")[0].rstrip()
                                    + "  ·  v" + ver)
            for label, key in (("Size", "Installed Size"),
                               ("Download", "Download Size"),
                               ("License", "License")):
                v = info.get(key)
                if v and v != "None":
                    chips.append("%s: %s" % (label, v))
            if it.get("votes"):
                chips.append("★ %d votes" % it["votes"])
            if it.get("popularity"):
                chips.append("▲ %.1f popularity" % it["popularity"])
            self._clear_layout(self.metaL)
            for c in chips:
                self.metaL.addWidget(Chip(c))
            self.metaL.addStretch(1)
            # if AppStream gave no long description, fall back to pacman's
            if self.desc.text() in ("Loading description…", ""):
                d = info.get("Description") or it.get("summary") or ""
                if d:
                    self.desc.setText(d)

        def _got_details(self, det):
            if not isinstance(det, dict) or "_error" in det:
                det = {}
            it = self.item or {}
            long_desc = det.get("description") or ""
            if long_desc:
                self.desc.setText(long_desc)
            elif self.desc.text() == "Loading description…":
                self.desc.setText(it.get("summary", "")
                                  or "No description available.")
            if det.get("license"):
                self.metaL.insertWidget(0, Chip("License: " + det["license"]))
            shots = det.get("screenshots") or []
            self._load_shots(shots)

        def _load_shots(self, urls):
            self._clear_layout(self.shotL)
            self._shot_slots = {}
            if not urls:
                # graceful degradation: no screenshots -> hide the strip, the
                # big app icon already stands in at the top of the page.
                self.shotTitle.hide()
                self.shotScroll.hide()
                return
            self.shotTitle.show()
            self.shotScroll.show()
            self._shot_workers = []
            for url in urls[:8]:
                slot = ShotThumb()
                self._shot_slots[url] = slot
                self.shotL.addWidget(slot)
                w = ImgWorker(url)
                w.loaded.connect(self._shot_ready)
                self._shot_workers.append(w)
                w.start()
            self.shotL.addStretch(1)

        def _shot_ready(self, url, data):
            slot = self._shot_slots.get(url)
            if slot is None:
                return
            pm = QPixmap()
            if data:
                img = QImage.fromData(data)
                if not img.isNull():
                    pm = QPixmap.fromImage(img)
            if pm.isNull():
                # this screenshot failed -> drop the slot so no broken image
                slot.hide()
                slot.deleteLater()
                self._shot_slots.pop(url, None)
                if not any(s.isVisible() for s in self._shot_slots.values()) \
                        and not self._shot_slots:
                    self.shotTitle.hide()
                    self.shotScroll.hide()
                return
            slot.set_pixmap(pm)

        def do_action(self):
            it = self.item
            if not it:
                return
            if self.action.text() == "Remove":
                self.win.run_txn("Removing %s" % it["name"],
                                 cmd_remove(it), self._after)
            else:
                self.win.run_txn("Installing %s" % it["name"],
                                 cmd_install(it), self._after)

        def _after(self, ok):
            if ok and self.item:
                # flip installed state + refresh the action button in place
                self.item["installed"] = not self.item.get("installed")
                self._refresh_action()
                self.win.refresh_lists()

