        def focus_default(self):
            self.fName.setFocus()

        def reload(self):
            try:
                self.working = open(PACCONF).read()
            except Exception:
                self.working = ""
            self.applyBtn.setEnabled(False)
            self.status.setText("")
            self._render()

        def _dirty(self):
            self.applyBtn.setEnabled(True)
            self.status.setText("Unsaved changes")

        def _render(self):
            while self.repoBox.count():
                w = self.repoBox.takeAt(0).widget()
                if w:
                    w.deleteLater()
            for r in read_repos(self.working):
                self.repoBox.addWidget(self._row(r))
            self.repoBox.addStretch(1)

        def _row(self, r):
            row = QFrame()
            row.setObjectName("reporow")
            h = QHBoxLayout(row)
            h.setContentsMargins(12, 8, 12, 8)
            chk = QCheckBox()
            chk.setChecked(r["enabled"])
            protected = r["name"] in ("core", "extra", "multilib")
            chk.setEnabled(not protected)
            chk.stateChanged.connect(lambda st, n=r["name"]: self._toggle(n, st))
            lbl = QLabel("<b>%s</b><br><span style='color:#8aa'>%s</span>"
                         % (r["name"], (r["server"] or r["include"] or "")[:80]))
            rm = QPushButton("Remove")
            rm.setObjectName("danger" if not protected else "")
            rm.setEnabled(not protected)
            rm.clicked.connect(lambda _, n=r["name"]: self._remove(n))
            h.addWidget(chk)
            h.addWidget(lbl, 1)
            h.addWidget(rm)
            row.setStyleSheet("#reporow{ background:#0e1117; border:1px solid rgba(255,255,255,0.08);"
                              "border-radius:10px; } QLabel{ color:#dfe9eb; }" + btn_qss())
            return row

        def _toggle(self, name, state):
            from PyQt6.QtCore import Qt as _Qt
            enable = state == _Qt.CheckState.Checked.value
            self.working = _edit_block(self.working, name, "enable" if enable else "disable")
            self._dirty()

        def _remove(self, name):
            self.working = _edit_block(self.working, name, "remove")
            self._dirty()
            self._render()

        def add_repo(self):
            name = self.fName.text().strip()
            value = self.fValue.text().strip()
            if not name or not value:
                self.status.setText("Name and value are required")
                return
            sig = {"Default": "", "Optional TrustAll (unsigned)": "Optional TrustAll",
                   "Never (unsigned)": "Never"}.get(self.fSig.currentText(), "")
            self.working = conf_add(self.working, name, self.fKind.currentData(), value, sig)
            self.fName.clear()
            self.fValue.clear()
            self._dirty()
            self._render()

        def apply(self):
            tmp = "/tmp/pacman.conf.hash-%d" % os.getpid()
            with open(tmp, "w") as f:
                f.write(self.working)
            self.win.run_txn("Saving repositories & refreshing databases",
                             ["pkexec", SCRIPT, "_writeconf", tmp], self._applied)

        def _applied(self, ok):
            if ok:
                self.reload()

