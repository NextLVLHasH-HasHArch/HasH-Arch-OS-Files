def main():
    a = sys.argv[1:]
    if a and a[0] == "backend":
        return cli(a[1:])
    if a and a[0] == "_writeconf":
        return writeconf(a[1] if len(a) > 1 else "")
    start = 0
    if "--updates" in a:
        start = 1
    elif "--installed" in a:
        start = 2
    elif "--sources" in a:
        start = 3
    shot = None
    if "--shot" in a:
        i = a.index("--shot")
        shot = a[i + 1] if i + 1 < len(a) else "/tmp/hash-store-shot.png"
    shot_app = None
    if "--shot-app" in a:
        i = a.index("--shot-app")
        shot_app = a[i + 1] if i + 1 < len(a) else None
    return gui(start, shot, shot_app)


if __name__ == "__main__":
    sys.exit(main())
