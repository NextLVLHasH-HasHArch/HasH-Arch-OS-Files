        def mouseDoubleClickEvent(self, _e):
            self.page.win.show_detail(self.part)

        def _state_text(self):
            if self.part["protected"]:
                return "system"
            if self.part["ro"]:
                return "read-only"
            return "mounted" if self.part["mounted"] else "not mounted"

        def _usage_bar(self):
            try:
                size = float(self.part["fssize"])
                used = float(self.part.get("fsused") or 0)
            except (TypeError, ValueError):
                return None
            if size <= 0:
                return None
            pct = max(0.0, min(1.0, used / size))
            wrap = QWidget()
            wl = QVBoxLayout(wrap)
            wl.setContentsMargins(0, 2, 0, 0)
            wl.setSpacing(3)
            track = QFrame()
            track.setObjectName("bartrack")
            track.setFixedHeight(8)
            tl = QHBoxLayout(track)
            tl.setContentsMargins(0, 0, 0, 0)
            fill = QFrame()
            fill.setObjectName("barfill" if pct < 0.9 else "barfull")
            fill.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
            tl.addWidget(fill, max(1, int(pct * 1000)))
            spacer = QWidget()
            spacer.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
            tl.addWidget(spacer, max(1, int((1 - pct) * 1000)))
            wl.addWidget(track)
            txt = QLabel("%s used of %s  ·  %s free" % (
                _human(used), _human(size),
                _human(self.part.get("fsavail") or (size - used))))
            txt.setObjectName("barlabel")
            wl.addWidget(txt)
            return wrap

    # ─────────────────── shared transaction launcher mixin ────────────────────
    class TxPage(QWidget):
        def __init__(self, win):
            super().__init__()
            self.win = win
            self._tx = None

        def _run(self, title, argv, env=None, after=None):
            def done(ok):
                self.win.refresh_all()
                if after:
                    after(ok)
            self._tx = Transaction(self.win, title, argv, env or dict(os.environ),
                                   on_done=done)
            g = self.win.geometry()
            self._tx.move(g.center().x() - 310, g.center().y() - 190)
            self._tx.show()

    # ───────────────────────────── the Drives page ───────────────────────────
    class DrivesPage(TxPage):
        def __init__(self, win):
            super().__init__(win)
            outer = QVBoxLayout(self)
            outer.setContentsMargins(0, 0, 0, 0)
            outer.setSpacing(10)
            top = QHBoxLayout()
            self.title = QLabel("Drives")
            self.title.setObjectName("pgtitle")
            top.addWidget(self.title)
            top.addStretch(1)
            ref = QPushButton("Refresh")
            ref.clicked.connect(self.reload)
            top.addWidget(ref)
            outer.addLayout(top)

            self.scroll = QScrollArea()
            self.scroll.setObjectName("scroll")
            self.scroll.setWidgetResizable(True)
            self.host = QWidget()
            self.col = QVBoxLayout(self.host)
            self.col.setContentsMargins(2, 2, 8, 2)
            self.col.setSpacing(12)
            self.scroll.setWidget(self.host)
            outer.addWidget(self.scroll, 1)
            self.reload()

        def _clear(self):
            while self.col.count():
                it = self.col.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()

        def reload(self):
            self._clear()
            groups = get_drives()
            shown = 0
            for g in groups:
                parts = [p for p in g["parts"] if p["fstype"] or p["mounted"]]
                if not parts:
                    continue
                disk = g["disk"]
                info = g.get("info", {})
                tag = info.get("model") or ""
                if g.get("is_system"):
                    tag = (tag + "  ·  system disk").strip(" ·")
                hdr = QLabel(disk + (("  ·  " + tag) if tag else ""))
                hdr.setObjectName("diskhdr")
                self.col.addWidget(hdr)
                for p in parts:
                    self.col.addWidget(DriveCard(self, p))
                    shown += 1
            if not shown:
                empty = QLabel("No mountable partitions found.")
                empty.setObjectName("cardmeta")
                self.col.addWidget(empty)
            self.col.addStretch(1)

        # ── actions ──
        def do_mount(self, part):
            if part["removable"] and HAS_UDISKS:
                self._run("Mounting %s" % part["device"], udisks_mount(part["device"]))
                return
            self._mount_at(part)

        def _mount_at(self, part):
            label = part["label"] or part["device"].split("/")[-1]
            options = ["~/Drives/%s" % label, "/mnt/%s" % label]
            choice, ok = QInputDialog.getItem(
                self.win, "Mount point",
                "Where should %s be mounted?" % part["device"], options, 0, True)
            if not ok or not choice:
                return
            mp = os.path.expanduser(choice.strip())
            fstype = part["fstype"] or "auto"
            opts = ""
            if fstype.lower().startswith("ntfs"):
                fstype = "ntfs-3g"
                opts = "rw,uid=%d,gid=%d,umask=022" % (os.getuid(), os.getgid())
            argv = ["pkexec", HELPER, "mount", part["device"], mp, fstype, opts]
            self._run("Mounting %s at %s" % (part["device"], mp), argv, tx_env())

        def do_unmount(self, part):
            if part["removable"] and HAS_UDISKS:
                self._run("Unmounting %s" % part["device"],
                          udisks_unmount(part["device"]))
                return
            argv = ["pkexec", HELPER, "unmount", part["mountpoint"]]
            self._run("Unmounting %s" % part["mountpoint"], argv, tx_env())

        def toggle_boot(self, part, on):
            if not part["uuid"]:
                QMessageBox.warning(self.win, "No UUID",
                                    "This volume has no UUID; cannot add to fstab.")
                return
            label = part["label"] or part["device"].split("/")[-1]
            if on:
                default = part["mountpoint"] or os.path.join(DRIVES_DIR, label)
                mp, ok = QInputDialog.getText(
                    self.win, "Mount on boot",
                    "Mount %s at this path on every boot\n(nofail is always added, "
                    "so a missing drive never blocks boot):" % part["device"],
                    text=default)
                if not ok or not mp.strip():
                    return
                mp = os.path.expanduser(mp.strip())
                fstype = part["fstype"] or "auto"
                opts = "defaults"
                if fstype.lower().startswith("ntfs"):
                    fstype = "ntfs-3g"
                    opts = "uid=%d,gid=%d,umask=022" % (os.getuid(), os.getgid())
                argv = ["pkexec", HELPER, "fstab-add", part["uuid"], mp, fstype, opts]
                self._run("Adding %s to fstab (UUID, nofail)" % part["device"],
                          argv, tx_env())
            else:
                argv = ["pkexec", HELPER, "fstab-remove", part["uuid"]]
                self._run("Removing %s from fstab" % part["device"], argv, tx_env())

        def ntfs_fix(self, part):
            if not HAS_NTFS3G:
                if QMessageBox.question(
                        self.win, "ntfs-3g missing",
                        "The 'ntfs-3g' package is needed to make NTFS drives "
                        "writable.\n\nOpen HasH Software Center to install it?"
                        ) == QMessageBox.StandardButton.Yes:
                    subprocess.Popen(["hash-store"]) if shutil.which("hash-store") else None
                return
            label = part["label"] or part["device"].split("/")[-1]
            mp = part["mountpoint"] or os.path.join(DRIVES_DIR, label)
            argv = ["pkexec", HELPER, "ntfs-fix", part["device"], mp,
                    str(os.getuid()), str(os.getgid())]
            self._run("Making %s writable as you (ntfs-3g, uid=%d)"
                      % (part["device"], os.getuid()), argv, tx_env())

