HELPER = os.path.join(os.path.dirname(SCRIPT), "hash-disks-helper")
ASKPASS = "/usr/bin/ksshaskpass" if os.path.exists("/usr/bin/ksshaskpass") else ""
HAS_UDISKS = bool(shutil.which("udisksctl"))
HAS_NTFS3G = bool(shutil.which("mount.ntfs-3g") or shutil.which("ntfs-3g"))
HAS_SMART = bool(shutil.which("smartctl"))
HAS_CIFS = bool(shutil.which("mount.cifs"))
HAS_NFS = bool(shutil.which("mount.nfs") or shutil.which("mount.nfs4"))
HOME = os.path.expanduser("~")
DRIVES_DIR = os.path.join(HOME, "Drives")
CRED_DIR = "/etc/hash-disks/creds"


def run(cmd, timeout=30):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        class _R:
            returncode = 1
            stdout = ""
            stderr = str(e)
        return _R()


# ───────────────────────────── enumeration backend ───────────────────────────
PROTECTED_MOUNTS = {"/", "/boot", "/boot/efi", "/efi"}
DATA_FS = {"ext2", "ext3", "ext4", "btrfs", "xfs", "f2fs", "jfs", "reiserfs",
           "ntfs", "ntfs3", "vfat", "exfat", "fat", "fat32", "msdos", "hfsplus",
           "udf", "iso9660"}
# Filesystems the Format dialog can create (user-facing name -> helper token).
FORMAT_FS = [("NTFS (Windows, recommended for media)", "ntfs"),
             ("exFAT (cross-platform, large files)", "exfat"),
             ("ext4 (Linux)", "ext4"),
             ("FAT32 (universal, <4 GB files)", "fat32"),
             ("Btrfs (Linux, snapshots)", "btrfs")]


def _human(n):
    try:
        n = float(n)
    except (TypeError, ValueError):
        return ""
    for unit in ("B", "KB", "MB", "GB", "TB", "PB"):
        if n < 1024 or unit == "PB":
            return ("%.0f %s" if unit == "B" or n >= 100 else "%.1f %s") % (n, unit)
        n /= 1024.0
    return ""


def _blkid_uuid_map():
    out = {}
    r = run(["blkid", "-o", "export"])
    if r.returncode != 0:
        return out
    dev = uuid = None
    for line in r.stdout.splitlines():
        if line.startswith("DEVNAME="):
            dev = line.split("=", 1)[1]
        elif line.startswith("UUID="):
            uuid = line.split("=", 1)[1]
        elif line == "":
            if dev and uuid:
                out[dev] = uuid
            dev = uuid = None
    if dev and uuid:
        out[dev] = uuid
    return out


def _fstab_uuids():
    managed, present = set(), set()
    try:
        with open("/etc/fstab") as f:
            for line in f:
                s = line.strip()
                if not s or s.startswith("#"):
                    continue
                if s.startswith("UUID="):
                    u = s.split()[0].split("=", 1)[1]
                    present.add(u)
                    if "# hash-disks" in line:
                        managed.add(u)
    except OSError:
        pass
    return present, managed


def system_disks():
    """The whole-disk device(s) backing /, /boot, /boot/efi — never offered for
    destructive ops in the GUI (the helper enforces this independently too)."""
    disks = set()
    for tgt in ("/", "/boot", "/boot/efi"):
        r = run(["findmnt", "-n", "-o", "SOURCE", "--target", tgt])
        src = r.stdout.strip().splitlines()[0].strip() if r.stdout.strip() else ""
        if not src:
            continue
        if src.startswith("UUID="):
            rr = run(["blkid", "-U", src.split("=", 1)[1]])
            src = rr.stdout.strip() or src
        if not src.startswith("/dev/"):
            continue
        real = os.path.realpath(src)
        rs = run(["lsblk", "-s", "-no", "NAME,TYPE", real])
        found = False
        if rs.returncode == 0:
            for ln in rs.stdout.splitlines():
                f = ln.split()
                if len(f) >= 2 and f[1] == "disk":
                    disks.add("/dev/" + f[0].lstrip("`|-\\ ").strip())
                    found = True
        if not found:
            rp = run(["lsblk", "-no", "PKNAME", real])
            pk = rp.stdout.strip().splitlines()
            if pk and pk[0].strip():
                disks.add("/dev/" + pk[0].strip())
    return disks


def _walk(node, parent_disk, rows):
    name = node.get("name", "")
    dev = "/dev/" + name if name and not name.startswith("/dev/") else name
    typ = node.get("type", "")
    fstype = node.get("fstype") or ""
    mountpoint = node.get("mountpoint") or ""
    mountpoints = node.get("mountpoints") or []
    if not mountpoint:
        mountpoint = next((m for m in mountpoints if m), "") or ""
    label = node.get("label") or node.get("partlabel") or ""
    size = node.get("size")
    uuid = node.get("uuid") or ""
    fsavail = node.get("fsavail")
    fsused = node.get("fsused")
    fssize = node.get("fssize")
    fsuse_pct = node.get("fsuse%") or ""
    rm = bool(node.get("rm")) or bool(node.get("hotplug"))
    ro = bool(node.get("ro"))
    partn = node.get("partn") or node.get("partnum") or ""

    if typ in ("part", "crypt", "lvm", "rom", "loop") or (typ == "disk" and fstype):
        row = {
            "device": dev, "name": name, "type": typ, "fstype": fstype,
            "label": label, "size": size, "size_h": _human(size),
            "mountpoint": mountpoint, "uuid": uuid, "removable": rm, "ro": ro,
            "fsavail": fsavail, "fsused": fsused, "fssize": fssize,
            "fsuse_pct": fsuse_pct, "model": node.get("model") or "",
            "serial": node.get("serial") or "", "ptype": node.get("pttype") or "",
            "parttype": node.get("parttype") or "", "partn": partn,
            "parent": parent_disk,
            "protected": os.path.normpath(mountpoint) in PROTECTED_MOUNTS,
            "mounted": bool(mountpoint),
            "is_data": fstype.lower() in DATA_FS,
        }
        rows.append(row)
    for ch in node.get("children", []) or []:
        _walk(ch, parent_disk if typ != "disk" else dev, rows)


def get_drives():
    """Enumerate partitions/volumes from `lsblk -J -O`, enriched with blkid UUIDs,
    fstab state and the parent disk's model/serial/size/table-type."""
    r = run(["lsblk", "-b", "-J", "-O"])
    data = {}
    if r.returncode == 0 and r.stdout.strip():
        try:
            data = json.loads(r.stdout)
        except json.JSONDecodeError:
            data = {}
    rows = []
    diskinfo = {}
    for dev in data.get("blockdevices", []) or []:
        dname = "/dev/" + dev.get("name", "")
        diskinfo[dname] = {
            "model": dev.get("model") or "", "serial": dev.get("serial") or "",
            "size": dev.get("size"), "size_h": _human(dev.get("size")),
            "ptype": dev.get("pttype") or "", "removable": bool(dev.get("rm")) or bool(dev.get("hotplug")),
            "rota": dev.get("rota"), "tran": dev.get("tran") or "",
        }
        _walk(dev, dname, rows)

    uuid_map = _blkid_uuid_map()
    present, managed = _fstab_uuids()
    sysd = system_disks()
    disks = {}
    for row in rows:
        if not row["uuid"]:
            row["uuid"] = uuid_map.get(row["device"], "")
        row["in_fstab"] = row["uuid"] in present
        row["fstab_managed"] = row["uuid"] in managed
        disk = row["parent"]
        row["on_system_disk"] = disk in sysd
        disks.setdefault(disk, {"disk": disk, "parts": [],
                                "info": diskinfo.get(disk, {}),
                                "is_system": disk in sysd})
        disks[disk]["parts"].append(row)
    return list(disks.values())


def flat_drives():
    out = []
    for d in get_drives():
        for p in d["parts"]:
            out.append(p)
    return out


# ──────────────────────── runtime mount/unmount (udisks) ──────────────────────
def udisks_mount(device):
    return ["udisksctl", "mount", "-b", device]


def udisks_unmount(device):
    return ["udisksctl", "unmount", "-b", device]


# ─────────────────────────────── headless CLI ────────────────────────────────
def cli(a):
    if a and a[0] == "drives":
        print(json.dumps(get_drives(), indent=2))
        return 0
    if a and a[0] == "system-disks":
        print(json.dumps(sorted(system_disks()), indent=2))
        return 0
    print("unknown backend command", file=sys.stderr)
    return 2


