#!/usr/bin/env python3
"""HasH-Arch Disks  (hash-disks)

A comprehensive disk-management tool for HasH-Arch — mount and manage drives,
partitions and USB sticks, inspect per-device detail and SMART health, format
and (re)partition non-system disks, relabel and power-off removable media,
make NTFS drives writable as you, and mount SMB/NFS network shares — all in the
HasH dark/rounded style, without ever touching `fstab` or `udisksctl` by hand.

Engine:
  udisks2 (`udisksctl mount/unmount/power-off`) for on-demand, no-root removable
  media; `lsblk -O` to enumerate; `blkid`/UUID for stable identifiers;
  `smartctl` for health. Every PRIVILEGED or DESTRUCTIVE op goes through
  `hash-disks-helper` via `pkexec` (backed up + validated; the helper
  INDEPENDENTLY refuses the disk backing / or /boot). The GUI is NEVER run as root.

Usage:
  hash-disks                 launch the GUI
  hash-disks backend drives  headless JSON dump of enumerated drives
  hash-disks --shot <png>    launch, grab a screenshot to <png>, exit
  hash-disks --page <n>      launch on page n (0 Drives .. 4 Shares)
"""
import json
import os
import shutil
import subprocess
import sys

