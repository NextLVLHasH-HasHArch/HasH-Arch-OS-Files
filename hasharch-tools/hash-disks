        def scan_to(self, disk):
            self.win.go(3)

        def _disk_card(self, disk, info):
            card = QFrame()
            card.setObjectName("card")
            v = QVBoxLayout(card)
            v.setContentsMargins(16, 13, 16, 14)
            head = QHBoxLayout()
            name = QLabel("%s  ·  %s" % (disk, info.get("model") or "disk"))
            name.setObjectName("cardname")
            head.addWidget(name)
            head.addStretch(1)
            b = QPushButton("Check health")
            b.setObjectName("primary")
            out = QTextEdit(readOnly=True)
            out.setObjectName("smartout")
            out.setVisible(False)
            out.setMinimumHeight(150)
            summary = QLabel("")
            summary.setObjectName("badgeOff")
            summary.setVisible(False)
            b.clicked.connect(lambda: self._check(disk, out, summary, b))
            head.addWidget(b)
            v.addLayout(head)
            v.addWidget(summary)
            v.addWidget(out)
            return card

        def _check(self, disk, out, summary, btn):
            btn.setEnabled(False)
            btn.setText("Checking…")
            r = run(["pkexec", HELPER, "smart", disk], timeout=40)
            btn.setEnabled(True)
            btn.setText("Re-check")
            text = (r.stdout or "") + (("\n" + r.stderr) if r.stderr else "")
            out.setVisible(True)
            out.setPlainText(text.strip() or "No SMART data returned.")
            self._summarise(text, summary)

        def _summarise(self, text, summary):
            health = "UNKNOWN"
            temp = poh = realloc = ""
            for ln in text.splitlines():
                low = ln.lower()
                if "overall-health" in low or "smart health status" in low:
                    if "passed" in low or ": ok" in low:
                        health = "PASSED"
                    elif "failed" in low:
                        health = "FAILED"
                if "temperature_celsius" in low or "airflow_temperature" in low \
                        or low.startswith("temperature:"):
                    nums = [w for w in ln.replace("(", " ").split() if w.isdigit()]
                    if nums:
                        temp = nums[-1] + " °C"
                if "power_on_hours" in low:
                    nums = [w for w in ln.split() if w.isdigit()]
                    if nums:
                        poh = nums[-1] + " h"
                if "reallocated_sector" in low:
                    nums = [w for w in ln.split() if w.isdigit()]
                    if nums:
                        realloc = nums[-1]
            bits = ["Health: " + health]
            if temp:
                bits.append("Temp " + temp)
            if poh:
                bits.append("On " + poh)
            if realloc:
                bits.append("Reallocated " + realloc)
            summary.setText("   ".join(bits))
            summary.setObjectName("badgeOn" if health == "PASSED" else
                                  ("badgeBad" if health == "FAILED" else "badgeOff"))
            summary.setVisible(True)
            summary.style().unpolish(summary)
            summary.style().polish(summary)

    # ───────────────────────────── Network shares page ────────────────────────
    class SharesPage(TxPage):
        def __init__(self, win):
            super().__init__(win)
            outer = QVBoxLayout(self)
            outer.setContentsMargins(0, 0, 0, 0)
            outer.setSpacing(10)
            top = QHBoxLayout()
            self.title = QLabel("Network shares")
            self.title.setObjectName("pgtitle")
            top.addWidget(self.title)
            top.addStretch(1)
            add = QPushButton("Add a share")
            add.setObjectName("primary")
            add.clicked.connect(self.add_share)
            top.addWidget(add)
            outer.addLayout(top)
            self.scroll = QScrollArea()
            self.scroll.setObjectName("scroll")
            self.scroll.setWidgetResizable(True)
            self.host = QWidget()
            self.col = QVBoxLayout(self.host)
            self.col.setContentsMargins(2, 2, 8, 2)
            self.col.setSpacing(12)
            self.scroll.setWidget(self.host)
            outer.addWidget(self.scroll, 1)
            self.reload()

        def _clear(self):
            while self.col.count():
                it = self.col.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()

        def reload(self):
            self._clear()
            avail = []
            if HAS_CIFS:
                avail.append("SMB/CIFS")
            if HAS_NFS:
                avail.append("NFS")
            if avail:
                note = QLabel("Mount SMB/Windows or NFS shares. Credentials are "
                              "saved root-only with 600 permissions. fstab entries "
                              "get nofail + _netdev so a missing network never "
                              "blocks boot.\n\nAvailable: " + ", ".join(avail))
            else:
                note = QLabel("Install 'cifs-utils' (SMB) and/or 'nfs-utils' (NFS) "
                              "to mount network shares.")
            note.setObjectName("cardmeta")
            note.setWordWrap(True)
            self.col.addWidget(note)
            if not avail and shutil.which("hash-store"):
                b = QPushButton("Open Software Center…")
                b.setObjectName("primary")
                b.clicked.connect(lambda: subprocess.Popen(["hash-store"]))
                self.col.addWidget(b, 0, Qt.AlignmentFlag.AlignLeft)
            # show currently-mounted network filesystems
            for src, mp, fstype in self._mounted_net():
                card = QFrame()
                card.setObjectName("card")
                h = QHBoxLayout(card)
                h.setContentsMargins(16, 12, 16, 12)
                h.addWidget(QLabel("%s\n%s · mounted at %s" % (src, fstype.upper(), mp)))
                h.addStretch(1)
                um = QPushButton("Unmount")
                um.clicked.connect(lambda _, m=mp: self._run(
                    "Unmounting %s" % m, ["pkexec", HELPER, "unmount", m],
                    tx_env(), after=lambda ok: self.reload()))
                h.addWidget(um)
                self.col.addWidget(card)
            self.col.addStretch(1)

        def _mounted_net(self):
            out = []
            try:
                with open("/proc/mounts") as f:
                    for ln in f:
                        p = ln.split()
                        if len(p) >= 3 and p[2] in ("cifs", "smb3", "nfs", "nfs4"):
                            out.append((p[0], p[1], p[2]))
            except OSError:
                pass
            return out

        def add_share(self):
            d = QDialog(self.win)
            d.setWindowTitle("Add a network share")
            d.setStyleSheet(dlg_qss())
            d.setMinimumWidth(460)
            v = QVBoxLayout(d)
            v.setContentsMargins(20, 18, 20, 18)
            v.setSpacing(8)
            t = QLabel("Add a network share")
            t.setObjectName("dlgtitle")
            v.addWidget(t)
            form = QFormLayout()
            kind = QComboBox()
            if HAS_CIFS:
                kind.addItem("SMB / Windows (cifs)", "cifs")
            if HAS_NFS:
                kind.addItem("NFS", "nfs")
            if kind.count() == 0:
                kind.addItem("SMB / Windows (cifs)", "cifs")
                kind.addItem("NFS", "nfs")
            remote = QLineEdit()
            remote.setPlaceholderText("//server/share  or  server:/export")
            mp = QLineEdit(os.path.join(HOME, "Network"))
            user = QLineEdit()
            pw = QLineEdit()
            pw.setEchoMode(QLineEdit.EchoMode.Password)
            persist = QCheckBox("Also mount on boot (fstab, nofail + _netdev)")
            form.addRow("Type:", kind)
            form.addRow("Remote:", remote)
            form.addRow("Mount at:", mp)
            form.addRow("Username:", user)
            form.addRow("Password:", pw)
            v.addLayout(form)
            v.addWidget(persist)

            def upd():
                cifs = kind.currentData() == "cifs"
                user.setEnabled(cifs)
                pw.setEnabled(cifs)
                remote.setPlaceholderText("//server/share" if cifs else "server:/export")
            kind.currentIndexChanged.connect(upd)
            upd()
            bb = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok |
                                  QDialogButtonBox.StandardButton.Cancel)
            v.addWidget(bb)
            bb.accepted.connect(d.accept)
            bb.rejected.connect(d.reject)
            if d.exec() != QDialog.DialogCode.Accepted:
                return
            ktok = kind.currentData()
            rem = remote.text().strip()
            mpath = os.path.expanduser(mp.text().strip())
            if not rem or not mpath:
                QMessageBox.warning(self.win, "Missing", "Remote and mount point "
                                    "are required.")
                return
            opts = ""
            credfile = ""
            if ktok == "cifs" and user.text().strip():
                # Save creds via helper to a root-only 600 file, then mount.
                safe = "".join(c for c in rem if c.isalnum())[:40] or "share"
                credfile = os.path.join(CRED_DIR, safe + ".cred")
                self._run("Saving credentials (600, root-only)",
                          ["pkexec", HELPER, "save-creds", credfile,
                           user.text().strip(), pw.text(), ""], tx_env(),
                          after=lambda ok: self._do_mount(ktok, rem, mpath, opts,
                                                          credfile, persist.isChecked()))
                return
            self._do_mount(ktok, rem, mpath, opts, credfile, persist.isChecked())

        def _do_mount(self, ktok, rem, mpath, opts, credfile, persist):
            argv = ["pkexec", HELPER, "net-mount", ktok, rem, mpath, opts, credfile]
            def after(ok):
                self.reload()
                if ok and persist:
                    fopts = ("credentials=%s" % credfile) if credfile else ""
                    self._run("Saving %s to fstab (_netdev, nofail)" % rem,
                              ["pkexec", HELPER, "net-fstab-add", ktok, rem,
                               mpath, fopts], tx_env(), after=lambda o: self.reload())
            self._run("Mounting %s at %s" % (rem, mpath), argv, tx_env(), after=after)

