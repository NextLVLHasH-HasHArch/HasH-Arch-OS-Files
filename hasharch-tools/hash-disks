def main():
    a = sys.argv[1:]
    if a and a[0] == "backend":
        return cli(a[1:])
    shot = None
    page = 0
    if "--shot" in a:
        i = a.index("--shot")
        shot = a[i + 1] if i + 1 < len(a) else "/tmp/hash-disks-shot.png"
    if "--page" in a:
        i = a.index("--page")
        try:
            page = int(a[i + 1])
        except (IndexError, ValueError):
            page = 0
    return gui(shot, page)


if __name__ == "__main__":
    sys.exit(main())
