        def refresh_all(self):
            self.drives.reload()
            self.format_page.reload()
            self.shares_page.reload()
            if self.detail_page.part:
                # refresh the detail view against fresh data if still showing it
                if self.stack.currentIndex() == 1:
                    for p in flat_drives():
                        if p["device"] == self.detail_page.part["device"]:
                            self.detail_page.show(p)
                            break

        def paintEvent(self, _e):
            p = QPainter(self)
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            path = QPainterPath()
            path.addRoundedRect(0.5, 0.5, self.width() - 1, self.height() - 1, 20, 20)
            p.fillPath(path, QColor(0x12, 0x14, 0x1a))
            p.setPen(QColor(255, 255, 255, 30))
            p.drawPath(path)

