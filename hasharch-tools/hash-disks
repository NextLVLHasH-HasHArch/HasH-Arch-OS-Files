    # ────────────────── transaction window (pkexec / udisks) ─────────────────
    class Transaction(QWidget):
        def __init__(self, parent, title, argv, env, on_done=None):
            super().__init__(None)
            self.on_done = on_done
            self.setObjectName("txwin")
            self.setWindowFlags(Qt.WindowType.Dialog | Qt.WindowType.FramelessWindowHint)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
            self.resize(620, 380)
            v = QVBoxLayout(self)
            v.setContentsMargins(18, 16, 18, 16)
            t = QLabel(title)
            t.setObjectName("txtitle")
            self.log = QTextEdit(readOnly=True)
            self.log.setObjectName("txlog")
            self.btn = QPushButton("Please wait…")
            self.btn.setEnabled(False)
            self.btn.setObjectName("primary")
            self.btn.clicked.connect(self.close)
            v.addWidget(t)
            v.addWidget(self.log, 1)
            v.addWidget(self.btn)
            self.setStyleSheet("""
                #txwin{ background:#14161d; border:1px solid rgba(255,255,255,0.12);
                        border-radius:16px; }
                #txtitle{ color:#fff; font-size:15px; font-weight:600; }
                #txlog{ background:#0b0d12; color:#cfe9ee; border:1px solid #222;
                        border-radius:10px; font-family:monospace; font-size:12px; }
            """ + btn_qss())
            self.p = QProcess(self)
            self.p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.p.setProcessEnvironment(qenv(env))
            self.p.readyReadStandardOutput.connect(self._read)
            self.p.finished.connect(self._fin)
            self._append("$ " + " ".join(argv) + "\n\n")
            self.p.start(argv[0], argv[1:])

        def _read(self):
            self._append(bytes(self.p.readAllStandardOutput()).decode(errors="ignore"))

        def _append(self, s):
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)
            self.log.insertPlainText(s)
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)

        def _fin(self, code, _st):
            ok = code == 0
            self._append("\n" + ("✓ Done." if ok else "✗ Failed (exit %d)." % code) + "\n")
            self.btn.setText("Close")
            self.btn.setEnabled(True)
            if self.on_done:
                self.on_done(ok)

