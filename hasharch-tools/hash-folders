#!/usr/bin/env python3
"""Build the iOS-folders manifest so each desktop folder MIRRORS its launcher
category. A folder's apps are exactly the .desktop entries tagged X-HasH-<Slug>
(the same set the launcher's Main tab shows for that group) — so the desktop
folders and the launcher stay interconnected and folders never "lose" apps.

Reads  ~/.local/share/com.hash.kickoff/groups.json   (the launcher categories)
Writes ~/.local/share/com.hash.iosfolders/folders.json
"""
import glob
import json
import os
import re

HOME = os.path.expanduser("~")
GROUPS = os.path.join(HOME, ".local/share/com.hash.kickoff/groups.json")
OUT_DIR = os.path.join(HOME, ".local/share/com.hash.iosfolders")
OUT = os.path.join(OUT_DIR, "folders.json")
DIRS = ["/usr/share/applications",
        os.path.join(HOME, ".local/share/applications"),
        "/var/lib/flatpak/exports/share/applications",
        os.path.join(HOME, ".var/app/com.valvesoftware.Steam/.local/share/applications"),
        os.path.join(HOME, ".local/share/flatpak/exports/share/applications")]


def parse(p):
    f = {}
    try:
        with open(p, encoding="utf-8", errors="ignore") as fh:
            ine = False
            for ln in fh:
                ln = ln.rstrip("\n")
                if ln.startswith("["):
                    ine = ln.strip() == "[Desktop Entry]"
                    continue
                if ine and "=" in ln:
                    k, v = ln.split("=", 1)
                    f.setdefault(k.strip(), v.strip())
    except OSError:
        return None
    return f


def tag_of(slug):
    return "X-HasH-" + slug.capitalize()


def main():
    os.makedirs(OUT_DIR, exist_ok=True)
    try:
        groups = json.load(open(GROUPS)).get("groups", [])
    except Exception:
        groups = []

    # index every .desktop once: basename -> (fields, path); user dirs override system
    index = {}
    for d in DIRS:
        for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
            f = parse(path)
            if not f or f.get("Type", "Application") != "Application":
                continue
            index[os.path.basename(path)] = (f, path)

    out = []
    for g in groups:
        tag = tag_of(g["slug"])
        items = []
        for base, (f, path) in index.items():
            cats = f.get("Categories", "")
            if tag not in cats:
                continue
            if f.get("NoDisplay", "").lower() == "true":
                continue                      # hidden -> not shown in the launcher either
            items.append({"name": f.get("Name") or base,
                          "icon": f.get("Icon", "application-x-executable"),
                          "file": path, "source": path})
        out.append({"name": g["name"], "slug": g["slug"], "icon": g.get("icon", "folder"),
                    "items": sorted(items, key=lambda x: x["name"].lower())})

    # custom desktop folders (created from All Apps, not tied to a category)
    try:
        custom = json.load(open(os.path.join(OUT_DIR, "custom.json"))).get("folders", [])
    except Exception:
        custom = []
    for f in custom:
        out.append({"name": f["name"], "slug": f.get("slug", ""),
                    "icon": f.get("icon", "folder"),
                    "items": sorted(f.get("items", []), key=lambda x: x["name"].lower())})

    with open(OUT, "w", encoding="utf-8") as fh:
        json.dump({"groups": out}, fh, indent=2)
    print("folders: %d groups -> %s" % (len(out), OUT))
    for g in out:
        print("  %-26s %d apps" % (g["name"], len(g["items"])))


if __name__ == "__main__":
    main()
