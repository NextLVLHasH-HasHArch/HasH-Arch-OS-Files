#!/usr/bin/env python3
"""HasH-Arch Universal Uninstaller — GUI launcher.

Thin wrapper that launches the PyQt6 frontend of `hash-uninstaller`. The backend
and the GUI live together in `hash-uninstaller` (pure-JSON subcommands + a `gui`
subcommand) so they always stay in sync; this script is the desktop entry point.

Usage:
    hash-uninstaller-gui              launch the GUI
    hash-uninstaller-gui --shot FILE  launch, screenshot to FILE, then exit
"""
import importlib.machinery
import importlib.util
import os
import sys

_BACKEND = os.path.join(os.path.dirname(os.path.realpath(__file__)), "hash-uninstaller")


def main():
    # Load the backend module from its hyphenated path and invoke gui().
    spec = importlib.util.spec_from_loader(
        "hash_uninstaller_backend",
        importlib.machinery.SourceFileLoader("hash_uninstaller_backend", _BACKEND))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    shot = "--shot" in sys.argv
    shot_path = None
    if shot:
        i = sys.argv.index("--shot")
        if i + 1 < len(sys.argv):
            shot_path = sys.argv[i + 1]
    return mod.gui(shot, shot_path)


if __name__ == "__main__":
    sys.exit(main())
