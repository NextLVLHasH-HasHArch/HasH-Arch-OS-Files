        def refresh_mount_ui(self):
            mounted = is_mounted(self.rec["name"])
            self.mountBtn.setText("Unmount" if mounted else "Mount")
            self.mountBtn.setObjectName("" if mounted else "primary")
            self.mountBtn.setStyleSheet(btn_qss())
            self.openBtn.setEnabled(mounted)
            self.statusLbl.setText("● Mounted" if mounted else "○ Not mounted")
            self.statusLbl.setStyleSheet("color:%s;" % (OK if mounted else "#94a3a6"))

        def load_quota(self):
            self._qw = Worker(remote_about, self.rec["name"])
            self._qw.done.connect(self._got_quota)
            self._qw.start()

        def _got_quota(self, d):
            if not isinstance(d, dict) or not d.get("ok"):
                err = d.get("error", "") if isinstance(d, dict) else ""
                self.quotaLbl.setText("Quota unavailable" + (" — " + err if err else ""))
                self.bar.setValue(0)
                return
            used, total = d.get("used"), d.get("total")
            if total:
                pct = max(0, min(1000, int(used / total * 1000))) if used else 0
                self.bar.setValue(pct)
                self.quotaLbl.setText("%s of %s used  ·  %s free"
                                      % (d["used_str"], d["total_str"], d["free_str"]))
            else:
                self.bar.setValue(0)
                self.quotaLbl.setText("%s used (no total reported)" % d["used_str"])

        def toggle_mount(self):
            name = self.rec["name"]
            if is_mounted(name):
                ok, msg = do_unmount(name)
            else:
                ok, msg = do_mount(name)
            if not ok:
                self.page.win.toast("Mount error: " + (msg or "")[:120])
            QTimer.singleShot(400, self.refresh_mount_ui)

        def toggle_auto(self, state):
            enabled = state == Qt.CheckState.Checked.value
            set_unit_enabled(self.rec["name"], enabled)
            if enabled:
                add_to_places(self.rec["name"])
            self.page.win.toast(
                ("Auto-mount enabled" if enabled else "Auto-mount disabled")
                + " for " + self.rec["name"])

        def open_files(self):
            QProcess.startDetached("xdg-open", [mount_point(self.rec["name"])])

        def remove(self):
            self.page.win.confirm_remove(self.rec["name"], self.page.reload)

