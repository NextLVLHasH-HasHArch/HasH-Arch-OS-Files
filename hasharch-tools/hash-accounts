#!/usr/bin/env python3
"""HasH-Accounts  (hash-accounts)

A fancy settings page to sign into online services and set up cloud storage with
a guided, few-click flow — so your cloud quota (e.g. Google One 5 TB) shows up as
usable storage on the desktop (a drive in Dolphin), not just a website.

Engine : rclone — handles the OAuth browser sign-in and mounts a remote as a
         FUSE filesystem.  Tokens live in ~/.config/rclone/rclone.conf
         (CONTAINS SECRETS — never commit).
Mounts : rclone mount <remote>: ~/Cloud/<name> --vfs-cache-mode writes --daemon
Login  : one systemd USER unit per remote (hash-cloud-<name>.service).
Places : ~/Cloud/<name> is added to Dolphin Places (user-places.xbel).

Usage:
    hash-accounts                 launch the GUI
    hash-accounts --add           launch on the Add-account wizard
    hash-accounts --settings      launch on the Settings page
    hash-accounts backend <cmd>   headless JSON: remotes|about <r>|mounts|providers
    hash-accounts --shot <png>    render a screenshot and exit
"""
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
RCLONE = shutil.which("rclone") or "/usr/bin/rclone"
HAS_RCLONE = bool(shutil.which("rclone"))
HAS_FUSE = bool(shutil.which("fusermount3") or shutil.which("fusermount"))
RCLONE_CONF = os.path.join(HOME, ".config", "rclone", "rclone.conf")
SYSTEMD_USER = os.path.join(HOME, ".config", "systemd", "user")
PLACES = os.path.join(HOME, ".local", "share", "user-places.xbel")
CONFIG = os.path.join(HOME, ".config", "hash-accounts.json")
ASKPASS = "/usr/bin/ksshaskpass" if os.path.exists("/usr/bin/ksshaskpass") else ""

# Providers offered by the wizard.  `rtype` is the rclone backend `type`.
# `oauth` means rclone needs the browser-OAuth dance (config create handles it).
PROVIDERS = [
    {"key": "drive",     "name": "Google Drive",  "rtype": "drive",
     "icon": "folder-google-drive", "oauth": True,
     "blurb": "Google Drive / Google One — your full cloud quota as a drive."},
    {"key": "onedrive",  "name": "OneDrive",      "rtype": "onedrive",
     "icon": "folder-onedrive", "oauth": True,
     "blurb": "Microsoft OneDrive — personal or business."},
    {"key": "dropbox",   "name": "Dropbox",       "rtype": "dropbox",
     "icon": "folder-dropbox", "oauth": True,
     "blurb": "Dropbox cloud storage."},
    {"key": "nextcloud", "name": "Nextcloud",     "rtype": "webdav",
     "icon": "folder-cloud", "oauth": False,
     "blurb": "Nextcloud / ownCloud via WebDAV (URL + login)."},
    {"key": "icloud",    "name": "iCloud Drive",  "rtype": "iclouddrive",
     "icon": "com.apple.iCloud", "oauth": False, "icloud": True,
     "blurb": "Apple iCloud Drive — sign in with your Apple ID (needs 2FA). "
              "Requires rclone ≥ 1.66 with the iclouddrive backend."},
]
PROV_BY_RTYPE = {p["rtype"]: p for p in PROVIDERS}


def has_backend(rtype):
    """True if the installed rclone exposes backend `rtype` (e.g. iclouddrive).

    rclone >= 1.66 ships the iclouddrive backend.  We ask rclone itself rather
    than hard-coding a version so it works on any build.
    """
    if not HAS_RCLONE:
        return False
    r = run([RCLONE, "config", "providers"], timeout=20)
    try:
        provs = json.loads(r.stdout) if r.stdout.strip() else []
    except Exception:
        provs = []
    if provs:
        return any(isinstance(p, dict) and p.get("Name") == rtype for p in provs)
    # Fallback: older rclone may not have `config providers` as JSON — try help.
    h = run([RCLONE, "help", "backends"], timeout=20)
    return rtype in (h.stdout or "")

DEFAULTS = {
    "mount_root": os.path.join(HOME, "Cloud"),
    "vfs_cache_max": "5G",
    "vfs_cache_mode": "writes",
    "auto_mount": True,
}


def run(cmd, timeout=60, env=None):
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout, env=env)
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        class _R:
            returncode = 1
            stdout = ""
            stderr = str(e)
        return _R()


# ───────────────────────────── settings persistence ──────────────────────────
def load_settings():
    s = dict(DEFAULTS)
    try:
        with open(CONFIG) as f:
            s.update(json.load(f))
    except Exception:
        pass
    return s


def save_settings(s):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w") as f:
        json.dump(s, f, indent=2)


def mount_root():
    return load_settings().get("mount_root") or DEFAULTS["mount_root"]


def mount_point(name):
    return os.path.join(mount_root(), name)


# ───────────────────────────── rclone remotes/info ───────────────────────────
def list_remotes():
    """[{name, type, provider, icon}] from rclone config."""
    if not HAS_RCLONE:
        return []
    r = run([RCLONE, "config", "dump"])
    out = []
    try:
        data = json.loads(r.stdout) if r.stdout.strip() else {}
    except Exception:
        data = {}
    for name, conf in data.items():
        rtype = conf.get("type", "")
        prov = PROV_BY_RTYPE.get(rtype)
        out.append({
            "name": name,
            "type": rtype,
            "provider": prov["name"] if prov else rtype or "Remote",
            "icon": prov["icon"] if prov else "folder-cloud",
        })
    out.sort(key=lambda x: x["name"].lower())
    return out


def remote_about(name):
    """{used, total, free, used_str, total_str, ok} via `rclone about`."""
    if not HAS_RCLONE:
        return {"ok": False, "error": "rclone not installed"}
    r = run([RCLONE, "about", name + ":", "--json"], timeout=30)
    if r.returncode != 0:
        return {"ok": False, "error": (r.stderr or "").strip()[:200]}
    try:
        d = json.loads(r.stdout)
    except Exception:
        return {"ok": False, "error": "bad about output"}
    used = d.get("used")
    total = d.get("total")
    free = d.get("free")
    return {
        "ok": True, "used": used, "total": total, "free": free,
        "used_str": human(used), "total_str": human(total), "free_str": human(free),
    }


def human(n):
    if n is None:
        return "—"
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB", "PB"):
        if abs(n) < 1024.0:
            return ("%.0f %s" if unit == "B" else "%.1f %s") % (n, unit)
        n /= 1024.0
    return "%.1f EB" % n


def is_mounted(name):
    """True if our mount point for <name> is an active fuse mount."""
    mp = mount_point(name)
    try:
        with open("/proc/mounts") as f:
            for ln in f:
                parts = ln.split()
                if len(parts) >= 2 and parts[1] == mp.replace(" ", "\\040"):
                    return True
                if len(parts) >= 2 and parts[1] == mp:
                    return True
    except Exception:
        pass
    # fallback: os.path.ismount
    try:
        return os.path.ismount(mp)
    except Exception:
        return False


# ───────────────────────────── iCloud Drive config ───────────────────────────
# rclone's iclouddrive backend (>= 1.66) signs in with an Apple ID + password
# and then prompts for the 6-digit two-factor code, storing a trust token.
# rclone obscures the password itself; we never persist any plaintext secret.
ICLOUD_2FA_RE = re.compile(
    r"(two[- ]?factor|2fa|verification code|enter the code|2-factor|"
    r"please enter.*code|trust)", re.IGNORECASE)


def icloud_config_argv(name, apple_id):
    """Interactive `rclone config create` for an iCloud Drive remote.

    Password is passed inline (rclone obscures it on write); the 2FA code is
    answered on stdin by the GUI when rclone prompts for it.  We omit
    --non-interactive precisely so rclone *can* prompt for the 2FA code.
    """
    return [RCLONE, "config", "create", name, "iclouddrive",
            "apple_id", apple_id, "password", "__PASS__"]


# ───────────────────────────── mount / unmount ───────────────────────────────
def mount_cmd(name):
    s = load_settings()
    mp = mount_point(name)
    os.makedirs(mp, exist_ok=True)
    return [RCLONE, "mount", name + ":", mp,
            "--vfs-cache-mode", s.get("vfs_cache_mode", "writes"),
            "--vfs-cache-max-size", s.get("vfs_cache_max", "5G"),
            # show the LATEST files/info when the drive is opened: poll the remote
            # for changes (Drive/OneDrive notify), keep dir listings short-lived,
            # and pre-warm the whole tree at mount.
            "--poll-interval", "15s",
            "--dir-cache-time", "30s",
            "--vfs-refresh",
            "--daemon"]


def unmount_cmd(name):
    mp = mount_point(name)
    fm = shutil.which("fusermount3") or shutil.which("fusermount") or "fusermount"
    return [fm, "-u", mp]


def do_mount(name):
    r = run(mount_cmd(name), timeout=30)
    return r.returncode == 0, (r.stderr or r.stdout)


def do_unmount(name):
    r = run(unmount_cmd(name), timeout=20)
    return r.returncode == 0, (r.stderr or r.stdout)


# ───────────────────────────── systemd user units ────────────────────────────
def unit_name(name):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", name)
    return "hash-cloud-%s.service" % safe


def unit_path(name):
    return os.path.join(SYSTEMD_USER, unit_name(name))


def write_unit(name):
    """Create the per-remote systemd user unit (auto-mount on login)."""
    s = load_settings()
    mp = mount_point(name)
    os.makedirs(SYSTEMD_USER, exist_ok=True)
    os.makedirs(mp, exist_ok=True)
    fm = shutil.which("fusermount3") or shutil.which("fusermount") or "/usr/bin/fusermount3"
    body = f"""[Unit]
Description=HasH Accounts — mount cloud remote '{name}' at {mp}
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=-/usr/bin/mkdir -p {mp}
ExecStart={RCLONE} mount {name}: {mp} \\
    --vfs-cache-mode {s.get('vfs_cache_mode', 'writes')} \\
    --vfs-cache-max-size {s.get('vfs_cache_max', '5G')} \\
    --poll-interval 15s --dir-cache-time 30s --vfs-refresh
ExecStop={fm} -u {mp}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
"""
    with open(unit_path(name), "w") as f:
        f.write(body)
    run(["systemctl", "--user", "daemon-reload"], timeout=20)
    return unit_path(name)


def unit_enabled(name):
    r = run(["systemctl", "--user", "is-enabled", unit_name(name)], timeout=15)
    return r.stdout.strip() == "enabled"


def set_unit_enabled(name, enabled):
    if enabled:
        write_unit(name)
        run(["systemctl", "--user", "enable", unit_name(name)], timeout=20)
    else:
        run(["systemctl", "--user", "disable", unit_name(name)], timeout=20)
    return True


def remove_unit(name):
    run(["systemctl", "--user", "disable", "--now", unit_name(name)], timeout=20)
    try:
        os.remove(unit_path(name))
    except OSError:
        pass
    run(["systemctl", "--user", "daemon-reload"], timeout=20)


# ───────────────────────────── Dolphin Places ────────────────────────────────
def places_has(href):
    try:
        with open(PLACES, encoding="utf-8") as f:
            return ('href="%s"' % href) in f.read()
    except Exception:
        return False


def add_to_places(name):
    """Add file://<mountpoint> to KDE/Dolphin Places (idempotent)."""
    mp = mount_point(name)
    href = "file://" + mp
    if places_has(href):
        return False
    block = f""" <bookmark href="{href}">
  <title>{name} (Cloud)</title>
  <info>
   <metadata owner="http://freedesktop.org">
    <bookmark:icon name="folder-cloud"/>
   </metadata>
   <metadata owner="http://www.kde.org">
    <isSystemItem>false</isSystemItem>
   </metadata>
  </info>
 </bookmark>
"""
    try:
        with open(PLACES, encoding="utf-8") as f:
            txt = f.read()
        if "</xbel>" not in txt:
            return False
        txt = txt.replace("</xbel>", block + "</xbel>")
        with open(PLACES, "w", encoding="utf-8") as f:
            f.write(txt)
        return True
    except Exception:
        # No places file yet — create a minimal one.
        os.makedirs(os.path.dirname(PLACES), exist_ok=True)
        with open(PLACES, "w", encoding="utf-8") as f:
            f.write('<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE xbel>\n'
                    '<xbel xmlns:bookmark="http://www.freedesktop.org/standards/'
                    'desktop-bookmarks" xmlns:mime="http://www.freedesktop.org/'
                    'standards/shared-mime-info">\n' + block + "</xbel>\n")
        return True


def remove_from_places(name):
    href = "file://" + mount_point(name)
    try:
        with open(PLACES, encoding="utf-8") as f:
            txt = f.read()
    except Exception:
        return False
    pat = re.compile(r' <bookmark href="%s">.*?</bookmark>\n' % re.escape(href),
                     re.DOTALL)
    new = pat.sub("", txt)
    if new != txt:
        with open(PLACES, "w", encoding="utf-8") as f:
            f.write(new)
        return True
    return False


# ───────────────────────────── remove account ────────────────────────────────
def remove_remote(name):
    if is_mounted(name):
        do_unmount(name)
    remove_unit(name)
    remove_from_places(name)
    if HAS_RCLONE:
        run([RCLONE, "config", "delete", name], timeout=20)
    return True


# ─────────────────────────────── headless CLI ────────────────────────────────
def cli(a):
    if not a:
        print(__doc__)
        return 0
    c = a[0]
    if c == "remotes":
        rows = list_remotes()
        for r in rows:
            r["mounted"] = is_mounted(r["name"])
            r["autostart"] = unit_enabled(r["name"])
        print(json.dumps(rows, indent=2))
    elif c == "about":
        print(json.dumps(remote_about(a[1]) if len(a) > 1 else
                         {"ok": False, "error": "need remote"}, indent=2))
    elif c == "mounts":
        print(json.dumps({r["name"]: is_mounted(r["name"])
                          for r in list_remotes()}, indent=2))
    elif c == "providers":
        out = []
        for p in PROVIDERS:
            q = dict(p)
            q["available"] = has_backend(p["rtype"]) if HAS_RCLONE else False
            out.append(q)
        print(json.dumps(out, indent=2))
    else:
        print("unknown:", c, file=sys.stderr)
        return 2
    return 0


