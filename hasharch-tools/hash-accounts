    # ── toast / confirm ──
    class Toast(QLabel):
        def __init__(self, win):
            super().__init__(win)
            self.setObjectName("toast")
            self.hide()
            self.setStyleSheet(
                "#toast{ background:#1b2730; color:#dff0f3; border:1px solid %s;"
                " border-radius:10px; padding:9px 16px; font-size:13px; }" % ACCENT)
            self._t = QTimer(self)
            self._t.setSingleShot(True)
            self._t.timeout.connect(self.hide)

        def show_msg(self, txt):
            self.setText(txt)
            self.adjustSize()
            pw = self.parent().width()
            self.move((pw - self.width()) // 2, self.parent().height() - self.height() - 28)
            self.show()
            self.raise_()
            self._t.start(3200)

    class TwoFactorDialog(QWidget):
        """Collects the Apple 2-factor code and hands it back to IcloudWin."""
        def __init__(self, parent, on_submit, on_cancel):
            super().__init__(parent, Qt.WindowType.Window
                             | Qt.WindowType.FramelessWindowHint)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
            self.setObjectName("txwin")
            self.resize(360, 200)
            self._on_submit, self._on_cancel = on_submit, on_cancel
            v = QVBoxLayout(self)
            v.setContentsMargins(22, 20, 22, 18)
            v.setSpacing(12)
            t = QLabel("Apple two-factor code")
            t.setObjectName("txtitle")
            d = QLabel("Apple sent a 6-digit verification code to your trusted "
                       "devices. Enter it to finish signing in to iCloud Drive.")
            d.setObjectName("cardsub")
            d.setWordWrap(True)
            self.code = QLineEdit()
            self.code.setPlaceholderText("123456")
            self.code.setMaxLength(8)
            self.code.returnPressed.connect(self._go)
            row = QHBoxLayout()
            cancel = QPushButton("Cancel")
            cancel.clicked.connect(self._cancel)
            ok = QPushButton("Verify")
            ok.setObjectName("primary")
            ok.clicked.connect(self._go)
            row.addStretch(1)
            row.addWidget(cancel)
            row.addWidget(ok)
            v.addWidget(t)
            v.addWidget(d)
            v.addWidget(self.code)
            v.addLayout(row)
            self.setStyleSheet("""
                #txwin{ background:#14161d; border:1px solid rgba(255,255,255,0.12);
                        border-radius:16px; }
                #txtitle{ color:#fff; font-size:16px; font-weight:700; }
                #cardsub{ color:#94a3a6; font-size:12px; }
            """ + btn_qss())
            self.code.setFocus()

        def _go(self):
            c = self.code.text().strip()
            if not re.match(r"^\d{4,8}$", c):
                self.code.setStyleSheet("border:1px solid %s;" % DANGER)
                return
            self._on_submit(c)
            self.close()

        def _cancel(self):
            self._on_cancel()
            self.close()

