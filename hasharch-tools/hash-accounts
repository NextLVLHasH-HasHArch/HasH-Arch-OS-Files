    class Worker(QThread):
        done = pyqtSignal(object)

        def __init__(self, fn, *a):
            super().__init__()
            self.fn, self.a = fn, a

        def run(self):
            try:
                self.done.emit(self.fn(*self.a))
            except Exception as e:
                self.done.emit({"_error": str(e)})

    # ── live process log window (used for OAuth/config create) ──
    class ProcWin(QWidget):
        finishedOk = pyqtSignal(bool)

        def __init__(self, parent, title, argv, env=None):
            super().__init__(parent, Qt.WindowType.Window
                             | Qt.WindowType.FramelessWindowHint)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
            self.setObjectName("txwin")
            self.resize(680, 460)
            v = QVBoxLayout(self)
            v.setContentsMargins(18, 16, 18, 16)
            t = QLabel(title)
            t.setObjectName("txtitle")
            self.log = QTextEdit(readOnly=True)
            self.log.setObjectName("txlog")
            self.btn = QPushButton("Cancel")
            self.btn.setObjectName("primary")
            self.btn.clicked.connect(self._btn)
            v.addWidget(t)
            v.addWidget(self.log, 1)
            v.addWidget(self.btn)
            self.setStyleSheet("""
                #txwin{ background:#14161d; border:1px solid rgba(255,255,255,0.12);
                        border-radius:16px; }
                #txtitle{ color:#fff; font-size:15px; font-weight:600; }
                #txlog{ background:#0b0d12; color:#cfe9ee; border:1px solid #222;
                        border-radius:10px; font-family:monospace; font-size:12px; }
            """ + btn_qss())
            self._done = False
            self.p = QProcess(self)
            self.p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            if env:
                self.p.setProcessEnvironment(qenv(env))
            self.p.readyReadStandardOutput.connect(self._read)
            self.p.finished.connect(self._fin)
            self._append("$ " + " ".join(argv) + "\n\n")
            self.p.start(argv[0], argv[1:])

        def _read(self):
            self._append(bytes(self.p.readAllStandardOutput()).decode(errors="ignore"))

        def _append(self, s):
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)
            self.log.insertPlainText(s)
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)

        def _btn(self):
            if self._done:
                self.close()
            else:
                self.p.kill()
                self.close()

        def _fin(self, code, _st):
            self._done = True
            ok = code == 0
            self._append("\n" + ("✓ Done." if ok else "✗ Failed (exit %d)." % code) + "\n")
            self.btn.setText("Close")
            self.finishedOk.emit(ok)

    # ── iCloud Drive sign-in: Apple ID + password, then an in-GUI 2FA prompt ──
    # rclone's iclouddrive `config create` runs interactively; when Apple sends
    # the 6-digit two-factor code we detect rclone's prompt on stdout and pop a
    # dialog to collect it, then write it to the process's stdin.  The password
    # is supplied to rclone (which obscures it) but is NEVER shown in the log.
    class IcloudWin(ProcWin):
        def __init__(self, parent, title, argv, password):
            # Build the real argv (with the password) and a masked one for display.
            self._password = password
            self._asked_2fa = False
            self._buf = ""
            real_argv = [a if a != "__PASS__" else password for a in argv]
            # Initialise the QWidget chrome exactly like ProcWin, but start the
            # *real* argv while echoing only the masked form.
            QWidget.__init__(self, parent, Qt.WindowType.Window
                             | Qt.WindowType.FramelessWindowHint)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
            self.setObjectName("txwin")
            self.resize(680, 460)
            v = QVBoxLayout(self)
            v.setContentsMargins(18, 16, 18, 16)
            t = QLabel(title)
            t.setObjectName("txtitle")
            self.log = QTextEdit(readOnly=True)
            self.log.setObjectName("txlog")
            self.btn = QPushButton("Cancel")
            self.btn.setObjectName("primary")
            self.btn.clicked.connect(self._btn)
            v.addWidget(t)
            v.addWidget(self.log, 1)
            v.addWidget(self.btn)
            self.setStyleSheet("""
                #txwin{ background:#14161d; border:1px solid rgba(255,255,255,0.12);
                        border-radius:16px; }
                #txtitle{ color:#fff; font-size:15px; font-weight:600; }
                #txlog{ background:#0b0d12; color:#cfe9ee; border:1px solid #222;
                        border-radius:10px; font-family:monospace; font-size:12px; }
            """ + btn_qss())
            self._done = False
            self.p = QProcess(self)
            self.p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.p.readyReadStandardOutput.connect(self._read)
            self.p.finished.connect(self._fin)
            self._append("$ rclone config create … iclouddrive apple_id=… "
                         "password=********\n\n")
            self.p.start(real_argv[0], real_argv[1:])

        def _read(self):
            chunk = bytes(self.p.readAllStandardOutput()).decode(errors="ignore")
            self._append(chunk)
            self._buf += chunk
            # When rclone asks for the two-factor code, collect it from the user.
            if (not self._asked_2fa) and ICLOUD_2FA_RE.search(self._buf) \
                    and ("code" in self._buf.lower()):
                self._asked_2fa = True
                self._ask_2fa()

        def _ask_2fa(self):
            self._dlg = TwoFactorDialog(self, self._submit_2fa, self._cancel_2fa)
            g = self.geometry()
            self._dlg.move(g.center().x() - 180, g.center().y() - 90)
            self._dlg.show()

        def _submit_2fa(self, code):
            self._append("\n[entered 2FA code]\n")
            try:
                self.p.write((code + "\n").encode())
            except Exception:
                pass
            # Allow a second prompt (e.g. "trust this device?") to re-trigger.
            self._buf = ""
            self._asked_2fa = False

        def _cancel_2fa(self):
            self.p.kill()
            self.close()

