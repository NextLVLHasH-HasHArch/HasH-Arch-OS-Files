def main():
    a = sys.argv[1:]
    if a and a[0] == "backend":
        return cli(a[1:])
    start = 0
    if "--add" in a:
        start = 1
    elif "--storage" in a:
        start = 2
    elif "--settings" in a:
        start = 3
    shot = None
    if "--shot" in a:
        i = a.index("--shot")
        shot = a[i + 1] if i + 1 < len(a) else "/tmp/hash-accounts-shot.png"
    return gui(start, shot)


if __name__ == "__main__":
    sys.exit(main())
