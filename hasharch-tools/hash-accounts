        def do_connect(self):
            name = (self.nameEdit.text().strip() or self.nameEdit.placeholderText()).strip()
            if not re.match(r"^[A-Za-z0-9_-]+$", name):
                self.win.toast("Use only letters, numbers, _ and - in the name.")
                return
            if name in {r["name"] for r in list_remotes()}:
                self.win.toast("An account named '%s' already exists." % name)
                return
            p = self.sel
            self._post = {"name": name,
                          "mount": self.mountChk.isChecked(),
                          "auto": self.autoChk.isChecked()}
            # iCloud Drive: Apple ID + password, then a live 2FA-code prompt.
            if p.get("icloud"):
                apple_id = self.icAppleId.text().strip()
                pw = self.icPass.text()
                if not apple_id or not pw:
                    self.win.toast("Enter your Apple ID and password.")
                    return
                self.win.run_icloud(
                    "Signing in to iCloud Drive — Apple may ask for a 2FA code",
                    icloud_config_argv(name, apple_id), pw, self._connected)
                return
            argv = [RCLONE, "config", "create", name, p["rtype"]]
            if not p["oauth"]:
                url = self.wdUrl.text().strip()
                if not url:
                    self.win.toast("Enter the WebDAV/Nextcloud URL.")
                    return
                argv += ["url", url, "vendor", "nextcloud",
                         "user", self.wdUser.text().strip(),
                         "pass", self.wdPass.text()]
            # For OAuth providers, `rclone config create` opens the browser and
            # captures the token automatically (no terminal interaction).
            self.win.run_proc("Connecting %s — approve access in your browser" % p["name"],
                              argv, self._connected)

        def _connected(self, ok):
            if not ok:
                self.win.toast("Sign-in failed or cancelled.")
                return
            d = self._post
            name = d["name"]
            if d["mount"]:
                os.makedirs(mount_point(name), exist_ok=True)
                add_to_places(name)
                do_mount(name)
            if d["auto"]:
                set_unit_enabled(name, True)
            self.win.toast("Connected '%s'." % name)
            self.win.go(0)
            self.win.pages[0].reload()

