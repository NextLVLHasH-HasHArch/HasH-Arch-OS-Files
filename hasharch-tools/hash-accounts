    class Accounts(QWidget):
        def __init__(self):
            super().__init__(None, Qt.WindowType.FramelessWindowHint)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
            self.setWindowTitle("HasH Accounts")
            scr = (QApplication.screenAt(QCursor.pos())
                   or QApplication.primaryScreen()).geometry()
            W = max(880, int(scr.height() * 0.86))
            H = max(560, int(scr.height() * 0.66))
            self.resize(W, H)
            self.move(scr.center().x() - W // 2, scr.center().y() - H // 2)

            root = QVBoxLayout(self)
            root.setContentsMargins(1, 1, 1, 1)
            root.setSpacing(0)
            root.addWidget(TitleBar(self))

            body = QHBoxLayout()
            body.setContentsMargins(14, 4, 14, 14)
            body.setSpacing(14)

            side = QVBoxLayout()
            side.setSpacing(6)
            self.nav, self.pages = [], []
            self.stack = QStackedWidget()
            specs = [("accounts", "Accounts", "user-identity"),
                     ("add", "Add account", "list-add"),
                     ("storage", "Storage", "drive-harddisk"),
                     ("settings", "Settings", "configure")]
            builders = {"accounts": AccountsPage, "add": WizardPage,
                        "storage": StoragePage, "settings": SettingsPage}
            for i, (key, label, icon) in enumerate(specs):
                b = QPushButton("  " + label)
                b.setCheckable(True)
                b.setObjectName("nav")
                b.setIcon(QIcon.fromTheme(icon))
                b.setIconSize(QSize(20, 20))
                b.clicked.connect(lambda _, n=i: self.go(n))
                side.addWidget(b)
                self.nav.append(b)
                pg = builders[key](self)
                self.pages.append(pg)
                self.stack.addWidget(pg)
            side.addStretch(1)
            brand = QLabel("HasH-Arch")
            brand.setObjectName("brand")
            side.addWidget(brand)
            sw = QWidget()
            sw.setObjectName("sidebar")
            sw.setLayout(side)
            sw.setFixedWidth(184)
            body.addWidget(sw)
            body.addWidget(self.stack, 1)
            root.addLayout(body, 1)
            self.setStyleSheet(app_qss())
            self.toaster = Toast(self)
            self.go(start_page)

        def go(self, n):
            for i, b in enumerate(self.nav):
                b.setChecked(i == n)
            self.stack.setCurrentIndex(n)
            pg = self.stack.currentWidget()
            if hasattr(pg, "reload") and not getattr(pg, "_loaded", True):
                pg.reload()
            elif n in (0, 2) and hasattr(pg, "reload"):
                pg.reload()
            elif n == 1 and hasattr(pg, "reload"):
                pg.reload()
            elif n == 3 and hasattr(pg, "reload"):
                pg.reload()

        def toast(self, txt):
            self.toaster.show_msg(txt)

        def confirm_remove(self, name, on_done):
            self._cd = ConfirmDialog(self, name, on_done)
            g = self.geometry()
            self._cd.move(g.center().x() - 210, g.center().y() - 95)
            self._cd.show()

        def run_proc(self, title, argv, on_done):
            self._pw = ProcWin(self, title, argv)
            self._pw.finishedOk.connect(on_done)
            g = self.geometry()
            self._pw.move(g.center().x() - 340, g.center().y() - 230)
            self._pw.show()

        def run_icloud(self, title, argv, password, on_done):
            self._pw = IcloudWin(self, title, argv, password)
            self._pw.finishedOk.connect(on_done)
            g = self.geometry()
            self._pw.move(g.center().x() - 340, g.center().y() - 230)
            self._pw.show()

        def paintEvent(self, _e):
            p = QPainter(self)
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            path = QPainterPath()
            path.addRoundedRect(0.5, 0.5, self.width() - 1, self.height() - 1, 20, 20)
            p.fillPath(path, QColor(0x12, 0x14, 0x1a))
            p.setPen(QColor(255, 255, 255, 30))
            p.drawPath(path)

