        def refresh(self):
            while self.grid.count():
                it = self.grid.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()
            info = system_info()
            rows = [
                ("Distribution", info["distro"]),
                ("Kernel", info["kernel"]),
                ("Architecture", info["arch"]),
                ("Hostname", info["hostname"]),
