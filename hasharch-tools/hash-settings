def _snd_tool():
    if have("pactl"):
        return "pactl"
    if have("wpctl"):
        return "wpctl"
    return None


def sound_available():
    return _snd_tool() is not None


def _pactl_list(kind):
    """kind = 'sinks' or 'sources' -> [{name, desc, default}]."""
    items = []
    default = ""
    rd = _run(["pactl", "get-default-" + kind[:-1]])
    default = rd.stdout.strip()
    r = _run(["pactl", "-f", "json", "list", kind])
    try:
        import json as _json
        data = _json.loads(r.stdout) if r.stdout.strip() else []
        for d in data:
            nm = d.get("name", "")
            desc = d.get("description") or d.get("properties", {}).get(
                "device.description") or nm
            items.append({"name": nm, "desc": desc, "default": nm == default})
    except Exception:
        # textual fallback
        name = desc = None
        for ln in r.stdout.splitlines():
            s = ln.strip()
            if s.startswith("Name:"):
                name = s.split(":", 1)[1].strip()
            elif s.startswith("Description:"):
                desc = s.split(":", 1)[1].strip()
                if name:
                    items.append({"name": name, "desc": desc or name,
                                  "default": name == default})
                    name = desc = None
    return items


def sound_devices(kind):
    """kind = 'sinks' (output) or 'sources' (input)."""
    if have("pactl"):
        return _pactl_list(kind)
    return []


def sound_set_default(kind, name):
    if have("pactl"):
        _run(["pactl", "set-default-" + kind[:-1], name])
        return True
    return False


def sound_volume(kind):
    """Current default volume 0-100 (best-effort)."""
    if have("pactl"):
        tgt = "@DEFAULT_SINK@" if kind == "sinks" else "@DEFAULT_SOURCE@"
        r = _run(["pactl", "get-" + kind[:-1] + "-volume", tgt])
        import re as _re
        m = _re.search(r"(\d+)%", r.stdout)
        if m:
            return int(m.group(1))
    if have("wpctl"):
        tgt = "@DEFAULT_AUDIO_SINK@" if kind == "sinks" else "@DEFAULT_AUDIO_SOURCE@"
        r = _run(["wpctl", "get-volume", tgt])
        import re as _re
        m = _re.search(r"([\d.]+)", r.stdout)
        if m:
            return int(float(m.group(1)) * 100)
    return 0


def sound_set_volume(kind, pct):
    pct = max(0, min(150, int(pct)))
    if have("pactl"):
        tgt = "@DEFAULT_SINK@" if kind == "sinks" else "@DEFAULT_SOURCE@"
        _run(["pactl", "set-" + kind[:-1] + "-volume", tgt, "%d%%" % pct])
        return True
    if have("wpctl"):
        tgt = "@DEFAULT_AUDIO_SINK@" if kind == "sinks" else "@DEFAULT_AUDIO_SOURCE@"
        _run(["wpctl", "set-volume", tgt, "%.2f" % (pct / 100.0)])
        return True
    return False


# ---- Power profiles (powerprofilesctl) ----
def power_available():
    return have("powerprofilesctl")


def power_profiles():
    if not have("powerprofilesctl"):
        return [], ""
    r = _run(["powerprofilesctl", "list"])
    profs, active = [], ""
    for ln in r.stdout.splitlines():
        s = ln.strip()
        if s.startswith("* "):
            name = s[2:].rstrip(":")
            active = name
            profs.append(name)
        elif s.endswith(":") and " " not in s.rstrip(":"):
            profs.append(s.rstrip(":"))
    # de-dup preserve order
    seen, out = set(), []
    for p in profs:
        if p and p not in seen:
            seen.add(p)
            out.append(p)
    if not active:
        ra = _run(["powerprofilesctl", "get"])
        active = ra.stdout.strip()
    return out, active


def power_set_profile(name):
    _run(["powerprofilesctl", "set", name])


