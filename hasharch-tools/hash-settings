def kcm_list():
    """Parse `kcmshell6 --list` -> sorted [{module, name, group, privileged}].

    `kcmshell6 --list` prints lines like:
        kcm_users     - Manage user accounts
    (the separator is a run of spaces then "- "; older builds use a tab).  We
    parse defensively and degrade to [] if the binary is missing or errors,
    so the page just shows "no modules" instead of crashing.
    """
    global _KCM_CACHE
    if _KCM_CACHE is not None:
        return _KCM_CACHE
    out = []
    if HAS_KCMSHELL:
        r = _run([KCMSHELL, "--list"], timeout=20)
        seen = set()
        for ln in r.stdout.splitlines():
            ln = ln.rstrip()
            if not ln or not ln[0].strip():
                # skip headers / blank / indented continuation lines
                continue
            # split "module<spaces>- description" or "module\tdescription"
            mod = desc = ""
            if "\t" in ln:
                parts = ln.split("\t", 1)
                mod, desc = parts[0].strip(), (parts[1].strip()
                                               if len(parts) > 1 else "")
            else:
                import re as _re
                m = _re.match(r"^(\S+)\s+-\s+(.*)$", ln)
                if m:
                    mod, desc = m.group(1).strip(), m.group(2).strip()
                else:
                    parts = ln.split(None, 1)
                    mod = parts[0].strip()
                    desc = parts[1].strip() if len(parts) > 1 else ""
            if not mod or mod in seen or mod.startswith("-"):
                continue
            # ignore obvious non-module header words
            if mod.lower() in ("the", "following", "available", "modules:",
                               "usage:", "options:"):
                continue
            seen.add(mod)
            name = desc or mod
            out.append({"module": mod, "name": name,
                        "group": _group_for(mod, name),
                        "icon": kcm_icon(mod, name),
                        "privileged": _is_privileged(mod)})
        out.sort(key=lambda d: d["name"].lower())
    _KCM_CACHE = out
    return out


def kcm_module_exists(module):
    """Best-effort: is a specific KCM present? (used to wire privileged ones)."""
    mods = {d["module"] for d in kcm_list()}
    if not mods:                       # couldn't enumerate -> assume launchable
        return kcm_launchable()
    if module in mods:
        return True
    # tolerate kcm_ prefix differences (kcm_users vs users)
    base = module[4:] if module.startswith("kcm_") else module
    return any(m == base or m == "kcm_" + base for m in mods)


def tool_argv(name, *args):
    """argv to launch a HasH tool standalone (used for the Software Center
    launch button, which is genuinely its own big app), or None."""
    p = tool_path(name)
    if not p:
        return None
    return [p] + list(args)


# ════════════════════════════════ quick toggles ══════════════════════════════
# Each toggle: backend availability check, read state, set state. If a backend
# is missing the toggle is HIDDEN (never crashes). All run in the user session.
def _run(cmd, timeout=6):
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError) as e:
        class _R:
            returncode = 1
            stdout = ""
            stderr = str(e)
        return _R()


