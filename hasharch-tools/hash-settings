    # ════════════════ embedded HasH-tool panes (native, in-process) ══════════
    # These render a HasH tool's data INSIDE hash-settings by importing the
    # tool as a module and calling its module-level backend functions, plus a
    # button to open the full standalone tool when the user wants the complete
    # experience (wizards, transaction windows, pkexec flows).
    class ToolPaneBase(BasePage):
        TOOL = ""
        LAUNCH_LABEL = "Open full tool"

        def build_body(self, v):
            self.mod = load_tool(self.TOOL)
            head = QHBoxLayout()
            head.addStretch(1)
            self.openBtn = QPushButton(self.LAUNCH_LABEL)
            self.openBtn.setObjectName("primary")
            self.openBtn.setCursor(Qt.CursorShape.PointingHandCursor)
            self.openBtn.clicked.connect(self._open_full)
            ref = QPushButton("Refresh")
            ref.clicked.connect(self.refresh)
            head.addWidget(ref)
            head.addWidget(self.openBtn)
            v.addLayout(head)
            self.listBox = QVBoxLayout()
            self.listBox.setSpacing(10)
            v.addLayout(self.listBox)
            if self.mod is None:
                self.listBox.addWidget(self._note(
                    "%s is not installed." % self.TOOL))
                self.openBtn.setEnabled(False)
            else:
                self.populate()

        def _open_full(self, *a):
            argv = tool_argv(self.TOOL) if tool_path(self.TOOL) else None
            if argv:
                self.win.spawn(argv)

        def _note(self, text):
            l = QLabel(text)
            l.setObjectName("muted")
            l.setWordWrap(True)
            return l

        def _row(self, icon, name, sub, widgets=()):
            f = QFrame()
            f.setObjectName("row")
            h = QHBoxLayout(f)
            h.setContentsMargins(14, 11, 14, 11)
            h.setSpacing(12)
            ic = QLabel()
            ic.setPixmap(QIcon.fromTheme(icon).pixmap(QSize(30, 30)))
            h.addWidget(ic, 0, Qt.AlignmentFlag.AlignTop)
            col = QVBoxLayout()
            col.setSpacing(2)
            nm = QLabel(name)
            nm.setObjectName("rowname")
            col.addWidget(nm)
            if sub:
                sb = QLabel(sub)
                sb.setObjectName("rowsub")
                sb.setWordWrap(True)
                col.addWidget(sb)
            h.addLayout(col, 1)
            for w in widgets:
                h.addWidget(w)
            return f

        def _clear(self):
            while self.listBox.count():
                it = self.listBox.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()

        def refresh(self):
            if self.mod is not None:
                self._clear()
                self.populate()

        def populate(self):
            pass

    class DisksPane(ToolPaneBase):
        TOOL = "hash-disks"
        LAUNCH_LABEL = "Open HasH Disks"

        def __init__(self, win):
            super().__init__(win, "Disks",
                             "Drives, partitions & mounts (HasH Disks)")

        def populate(self):
            try:
                groups = self.mod.get_drives()
            except Exception as e:
                self.listBox.addWidget(self._note("Could not read drives: %s" % e))
                return
            shown = 0
            for g in groups:
                parts = [p for p in g["parts"] if p["fstype"] or p["mounted"]]
                if not parts:
                    continue
                hdr = QLabel(g["disk"] + (
                    "  ·  " + parts[0]["model"] if parts[0].get("model") else ""))
                hdr.setObjectName("muted")
                self.listBox.addWidget(hdr)
                for p in parts:
                    self.listBox.addWidget(self._drive_row(p))
                    shown += 1
            if not shown:
                self.listBox.addWidget(self._note("No mountable partitions found."))

        def _drive_row(self, p):
            label = p["label"] or p["device"].split("/")[-1]
            meta = "%s · %s · %s" % (p["device"], p["fstype"] or "no fs",
                                     p["size_h"] or "?")
            if p["mounted"] and p["mountpoint"]:
                meta += "  ·  mounted at %s" % p["mountpoint"]
            icon = ("media-optical" if p["fstype"].lower() in ("iso9660", "udf")
                    else "drive-removable-media" if p["removable"]
                    else "drive-harddisk")
            badge = QLabel("mounted" if p["mounted"] else "not mounted")
            badge.setObjectName("pill" if p["mounted"] else "rowsub")
            widgets = [badge]
            if not p["protected"]:
                if p["mounted"]:
                    b = QPushButton("Unmount")
                    b.clicked.connect(lambda _=False, part=p: self._unmount(part))
                else:
                    b = QPushButton("Mount")
                    b.setObjectName("primary")
                    b.clicked.connect(lambda _=False, part=p: self._mount(part))
                widgets.append(b)
            return self._row(icon, label, meta, widgets)

        def _mount(self, part):
            # removable + udisks → no-password mount in-process; else open the
            # full tool (which handles the pkexec helper + mount-point dialog).
            if part["removable"] and getattr(self.mod, "HAS_UDISKS", False):
                self.win.status("Mounting %s…" % part["device"])
                r = self.mod.run(self.mod.udisks_mount(part["device"]))
                self.win.status("Mounted." if r.returncode == 0
                                else "Mount failed — opening HasH Disks.")
                if r.returncode != 0:
                    self._open_full()
                QTimer.singleShot(900, self.refresh)
            else:
                self.win.status("Opening HasH Disks for a privileged mount…")
                self._open_full()

        def _unmount(self, part):
            if part["removable"] and getattr(self.mod, "HAS_UDISKS", False):
                self.win.status("Unmounting %s…" % part["device"])
                self.mod.run(self.mod.udisks_unmount(part["device"]))
                QTimer.singleShot(900, self.refresh)
            else:
                self._open_full()

