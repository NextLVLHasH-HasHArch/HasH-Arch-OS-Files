# ---- System / About (distro, kernel, CPU, RAM) ----
def system_info():
    info = {}
    osr = {}
    try:
        for ln in open("/etc/os-release"):
            if "=" in ln:
                k, v = ln.rstrip().split("=", 1)
                osr[k] = v.strip().strip('"')
    except OSError:
        pass
    info["distro"] = osr.get("PRETTY_NAME") or osr.get("NAME") or "Linux"
    u = os.uname()
    info["kernel"] = "%s %s" % (u.sysname, u.release)
    info["arch"] = u.machine
    info["hostname"] = u.nodename
    # CPU model + cores
    cpu, cores = "", 0
    try:
        for ln in open("/proc/cpuinfo"):
            if ln.startswith("model name") and not cpu:
                cpu = ln.split(":", 1)[1].strip()
            if ln.startswith("processor"):
                cores += 1
    except OSError:
        pass
    info["cpu"] = cpu or "Unknown CPU"
    info["cores"] = cores
    # RAM
    memkb = 0
    try:
        for ln in open("/proc/meminfo"):
            if ln.startswith("MemTotal:"):
                memkb = int(ln.split()[1])
                break
    except (OSError, ValueError):
        pass
    info["ram"] = ("%.1f GB" % (memkb / 1024.0 / 1024.0)) if memkb else "Unknown"
    # Desktop / session
    info["desktop"] = (os.environ.get("XDG_CURRENT_DESKTOP")
                       or os.environ.get("DESKTOP_SESSION") or "Unknown")
    info["session"] = os.environ.get("XDG_SESSION_TYPE", "")
    # uptime
    try:
        with open("/proc/uptime") as f:
            secs = float(f.read().split()[0])
        d, rem = divmod(int(secs), 86400)
        h, rem = divmod(rem, 3600)
        m, _ = divmod(rem, 60)
        info["uptime"] = (("%dd " % d if d else "") + "%dh %dm" % (h, m))
    except (OSError, ValueError):
        info["uptime"] = ""
    return info


