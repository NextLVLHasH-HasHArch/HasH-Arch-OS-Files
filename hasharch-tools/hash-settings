        def focus_default(self):
            self.search.setFocus()
            for c in self._toggle_cards:
                c.refresh()

        def _on_search(self, text):
            t = text.lower().strip()
            # clear previous result cards
            while self.resGrid.count():
                w = self.resGrid.takeAt(0).widget()
                if w:
                    w.deleteLater()
            if not t:
                self.resTitle.hide()
                self.resWrap.hide()
                self.catTitle.show()
                self.catWrap.show()
                if self._toggle_cards:
                    self.togTitle.show()
                    self.togRow.show()
                return
            # fuzzy: every search token must appear somewhere in the entry text
            toks = t.split()
            matches = []
            for key, e in all_entries():
                hay = (e["name"] + " " + e.get("comment", "") + " "
                       + e["kind"] + " " + str(e.get("target", ""))).lower()
                if all(tok in hay for tok in toks):
                    matches.append((key, e))
            self.catTitle.hide()
            self.catWrap.hide()
            self.togTitle.hide()
            self.togRow.hide()
            self.resTitle.setText("Results (%d)" % len(matches))
            self.resTitle.show()
            self.resWrap.show()
            if not matches:
                lbl = QLabel("No settings match “%s”." % text)
                lbl.setObjectName("cardsumm")
                self.resGrid.addWidget(lbl, 0, 0)
                return
            col = r = 0
            for key, e in matches:
                self.resGrid.addWidget(EntryCard(self.win, e, key), r, col)
                col += 1
                if col >= 2:
                    col = 0
                    r += 1

