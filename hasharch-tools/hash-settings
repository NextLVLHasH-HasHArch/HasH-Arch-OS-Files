    class KCMPage(BasePage):
        """Lists EVERY KDE setting module discovered via `kcmshell6 --list`,
        grouped under the HasH categories, with instant search.  Each row opens
        the real KCM through kcmshell6 so privileged modules self-elevate via
        polkit.  This makes hash-settings a full System Settings replacement
        without hiding any underlying KDE module."""
        def __init__(self, win):
            super().__init__(win, "More KDE settings",
                             "Every KDE setting module on this system — "
                             "privileged ones ask for a password themselves")

        def build_body(self, v):
            self._mods = kcm_list()
            self.search = QLineEdit()
            self.search.setPlaceholderText("Search KDE modules…")
            self.search.setClearButtonEnabled(True)
            self.search.textChanged.connect(lambda _t: self._render())
            v.addWidget(self.search)
            self.count = QLabel("")
            self.count.setObjectName("muted")
            v.addWidget(self.count)

            if not kcm_launchable():
                v.addWidget(self._note(
                    "Neither kcmshell6 nor systemsettings was found, so KDE "
                    "modules can't be opened on this system."))
                return
            if not self._mods:
                v.addWidget(self._note(
                    "Could not enumerate KDE modules (kcmshell6 --list returned "
                    "nothing). You can still open modules from the category "
                    "pages above."))
                return
            note = QLabel("Open any module to load it embedded inside this "
                          "window. Modules marked ELEVATES raise their own "
                          "polkit password prompt — hash-settings never runs "
                          "as root.")
            note.setObjectName("muted")
            note.setWordWrap(True)
            v.addWidget(note)
            self._wrap = QWidget()
            self._wrapLay = QVBoxLayout(self._wrap)
            self._wrapLay.setContentsMargins(0, 0, 0, 0)
            self._wrapLay.setSpacing(14)
            v.addWidget(self._wrap)
            self._render()

        def _note(self, text):
            l = QLabel(text)
            l.setObjectName("muted")
            l.setWordWrap(True)
            return l

        def _clear(self):
            while self._wrapLay.count():
                it = self._wrapLay.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()

        def _render(self):
            if not getattr(self, "_wrapLay", None):
                return
            self._clear()
            term = self.search.text().lower().strip()
            # bucket modules by group, preserving the HasH category order
            order = [g[0] for g in KCM_GROUPS] + ["other"]
            labels = {g[0]: g[1] for g in KCM_GROUPS}
            labels["other"] = "Other modules"
            buckets = {k: [] for k in order}
            total = 0
            for d in self._mods:
                hay = (d["module"] + " " + d["name"]).lower()
                if term and term not in hay:
                    continue
                buckets.setdefault(d["group"], []).append(d)
                total += 1
            if hasattr(self, "count"):
                if term:
                    self.count.setText("Showing %d of %d modules"
                                       % (total, len(self._mods)))
                else:
                    self.count.setText("%d modules installed" % len(self._mods))
            if total == 0:
                self._wrapLay.addWidget(self._note("No modules match."))
                return
            for gkey in order:
                items = buckets.get(gkey) or []
                if not items:
                    continue
                hdr = QLabel("%s  (%d)" % (labels.get(gkey, gkey), len(items)))
                hdr.setObjectName("h2")
                self._wrapLay.addWidget(hdr)
                for d in items:
                    self._wrapLay.addWidget(self._kcm_row(d))

        def _kcm_row(self, d):
            f = QFrame()
            f.setObjectName("row")
            f.setCursor(Qt.CursorShape.PointingHandCursor)
            h = QHBoxLayout(f)
            h.setContentsMargins(14, 11, 14, 11)
            h.setSpacing(12)
            ic = QLabel()
            ic.setPixmap(QIcon.fromTheme(d.get("icon", "configure"))
                         .pixmap(QSize(26, 26)))
            h.addWidget(ic, 0, Qt.AlignmentFlag.AlignTop)
            col = QVBoxLayout()
            col.setSpacing(2)
            nm = QLabel(d["name"])
            nm.setObjectName("rowname")
            col.addWidget(nm)
            sub = QLabel(d["module"] + ("   ·  asks for a password when needed"
                                        if d["privileged"] else ""))
            sub.setObjectName("rowsub")
            col.addWidget(sub)
            h.addLayout(col, 1)
            if d["privileged"]:
                pill = QLabel("ELEVATES")
                pill.setObjectName("pill")
                h.addWidget(pill)
            btn = QPushButton("Open")
            btn.setObjectName("primary")
            btn.setCursor(Qt.CursorShape.PointingHandCursor)
            _open = lambda d=d: self.win.open_module(
                d["module"], d["name"], d["privileged"])
            btn.clicked.connect(lambda _=False: _open())
            h.addWidget(btn)
            f.mouseReleaseEvent = lambda e: (
                _open() if e.button() == Qt.MouseButton.LeftButton else None)
            return f

