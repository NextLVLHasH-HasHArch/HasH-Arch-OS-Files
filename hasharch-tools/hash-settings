        def refresh(self):
            # Wi-Fi
            if not wifi_available():
                self.wifiToggle.setEnabled(False)
                self.wifiToggle.setText("nmcli not installed")
            else:
                on = wifi_state()
                self.wifiToggle.setText("Wi-Fi: On — turn off" if on
                                        else "Wi-Fi: Off — turn on")
                self._clear(self.wifiList)
                if on:
                    nets = wifi_scan()
                    if not nets:
                        self.wifiList.addWidget(self._note("No networks found."))
                    for n in nets:
                        self.wifiList.addWidget(self._wifi_row(n))
            # Bluetooth
            self.btCard.setVisible(bt_available())
            if bt_available():
                on = bt_state()
                self.btToggle.setText("Bluetooth: On — turn off" if on
                                      else "Bluetooth: Off — turn on")
                self._clear(self.btList)
                if on:
                    devs = bt_devices()
                    if not devs:
                        self.btList.addWidget(self._note(
                            "No known devices. Pair from your device's menu."))
                    for d in devs:
                        self.btList.addWidget(self._bt_row(d))

        def _note(self, text):
            l = QLabel(text)
            l.setObjectName("rowsub")
            return l

        def _row_frame(self, active=False):
            f = QFrame()
            f.setObjectName("row")
            f.setProperty("active", active)
            h = QHBoxLayout(f)
            h.setContentsMargins(14, 10, 14, 10)
            h.setSpacing(12)
            return f, h

        def _wifi_row(self, n):
            f, h = self._row_frame(n["active"])
            ic = QLabel()
            ic.setPixmap(QIcon.fromTheme("network-wireless").pixmap(QSize(24, 24)))
            h.addWidget(ic)
            col = QVBoxLayout()
            col.setSpacing(1)
            nm = QLabel(n["ssid"])
            nm.setObjectName("rowname")
            sub = QLabel("%s%%  ·  %s%s" % (
                n["signal"], n["security"],
                "  ·  saved" if n["known"] else ""))
            sub.setObjectName("rowsub")
            col.addWidget(nm)
            col.addWidget(sub)
            h.addLayout(col, 1)
            if n["active"]:
                st = QLabel("Connected")
                st.setObjectName("pill")
                h.addWidget(st)
                btn = QPushButton("Disconnect")
                btn.clicked.connect(lambda: self._do_wifi_disconnect(n["ssid"]))
                h.addWidget(btn)
            else:
                btn = QPushButton("Connect")
                btn.setObjectName("primary")
                btn.clicked.connect(lambda: self._do_wifi_connect(n))
                h.addWidget(btn)
            return f

        def _do_wifi_connect(self, n):
            pw = None
            secured = n["security"] and n["security"].lower() not in ("", "open", "--")
            if secured and not n["known"]:
                pw, ok = QInputDialog.getText(
                    self.win, "Wi-Fi password",
                    "Password for “%s”:" % n["ssid"],
                    QLineEdit.EchoMode.Password)
                if not ok:
                    return
            self.win.status("Connecting to %s…" % n["ssid"])
            ok, msg = wifi_connect(n["ssid"], pw)
            self.win.status("Connected." if ok else ("Failed: " + msg[:60]))
            QTimer.singleShot(800, self.refresh)

        def _do_wifi_disconnect(self, ssid):
            wifi_disconnect(ssid)
            QTimer.singleShot(500, self.refresh)

        def _toggle_wifi(self):
            wifi_set(not wifi_state())
            QTimer.singleShot(900, self.refresh)

        def _bt_row(self, d):
            f, h = self._row_frame(d["connected"])
            ic = QLabel()
            ic.setPixmap(QIcon.fromTheme("network-bluetooth").pixmap(QSize(24, 24)))
            h.addWidget(ic)
            col = QVBoxLayout()
            col.setSpacing(1)
            nm = QLabel(d["name"])
            nm.setObjectName("rowname")
            sub = QLabel(d["mac"])
            sub.setObjectName("rowsub")
            col.addWidget(nm)
            col.addWidget(sub)
            h.addLayout(col, 1)
            btn = QPushButton("Disconnect" if d["connected"] else "Connect")
            if not d["connected"]:
                btn.setObjectName("primary")
            btn.clicked.connect(lambda: self._do_bt(d["mac"], not d["connected"]))
            h.addWidget(btn)
            return f

        def _do_bt(self, mac, connect):
            self.win.status("Bluetooth: working…")
            ok, msg = bt_connect(mac, connect)
            self.win.status("Done." if ok else ("Failed: " + msg[:60]))
            QTimer.singleShot(900, self.refresh)

        def _toggle_bt(self):
            bt_set(not bt_state())
            QTimer.singleShot(900, self.refresh)

