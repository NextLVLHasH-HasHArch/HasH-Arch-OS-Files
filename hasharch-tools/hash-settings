        for e in entries:
            out.append((key, e))
    return out


# ─────────────────────────────── launch helpers ──────────────────────────────
def launch_kcm(module):
    """Open a KDE KCM in its host.

    We prefer kcmshell6 because that is what lets the *privileged* KCMs (Users,
    Date & Time, Login Screen/SDDM, …) put up their OWN polkit elevation prompt
    when an action needs root — hash-settings itself is never run as root.  We
    fall back to `systemsettings <module>` only when kcmshell isn't present.
    """
    if HAS_KCMSHELL:
        return [KCMSHELL, module]
    return ["systemsettings", module]


# ───────────────────── X11 KCM embedding (reparent into us) ───────────────────
# How we "hook into" the KDE modules: there is no clean, PyQt-callable C++/QML
# host for loading an arbitrary installed KCM by id (org.kde.kcmutils QML only
# ships KCM *authoring* helpers — SimpleKCM/ScrollViewKCM/… — not a loader for
# existing modules; that lives in libKF6KCMUtils' KCModuleLoader, which has no
# Python binding).  The robust, dependency-light route under X11 / XWayland is
# XEmbed-style reparenting: launch `kcmshell6 <module>`, find its top-level
# window by matching _NET_WM_PID against the child process, then host it with
# QWindow.fromWinId() + QWidget.createWindowContainer().  Privileged modules
# still raise their OWN polkit prompt because they run in the kcmshell6 child,
# not in us.  If the platform isn't xcb, xprop is missing, or the window never
# appears, callers fall back to a clearly-labelled "Open in its own window"
# launcher — so embedding degrades gracefully and never blocks the UI.
HAS_XPROP = bool(shutil.which("xprop"))


def _on_x11():
    """True when we can do X11 reparenting (native X11 or XWayland via xcb)."""
    if not HAS_XPROP:
        return False
    plat = os.environ.get("QT_QPA_PLATFORM", "")
    if "wayland" in plat and "xcb" not in plat:
        # forced pure-Wayland: no XEmbed of foreign windows
        return False
    # a DISPLAY means an X server (real or XWayland) is reachable
    return bool(os.environ.get("DISPLAY"))


def _xprop_root_windows():
    """All managed top-level X window ids (ints) via _NET_CLIENT_LIST.

    xprop prints e.g. `_NET_CLIENT_LIST(WINDOW): window id # 0x1e7, 0x2a1`
    (note the `#` separator, not `=`)."""
    if not HAS_XPROP:
        return []
    r = _run(["xprop", "-root", "_NET_CLIENT_LIST"], timeout=4)
    out = []
    tail = ""
    if "#" in r.stdout:
        tail = r.stdout.split("#", 1)[1]
    elif "=" in r.stdout:                       # tolerate alternate formats
        tail = r.stdout.split("=", 1)[1]
    for tok in tail.split(","):
        tok = tok.strip()
        try:
            out.append(int(tok, 16) if tok.lower().startswith("0x")
                       else int(tok))
        except ValueError:
            pass
    return out


def _xprop_window_pid(wid):
    """_NET_WM_PID of a window id, or None."""
    r = _run(["xprop", "-id", hex(wid), "_NET_WM_PID"], timeout=4)
    if "=" in r.stdout:
        try:
            return int(r.stdout.split("=", 1)[1].strip())
        except ValueError:
            return None
    return None


def _descendant_pids(root_pid):
    """root_pid plus its descendants (kcmshell6 may fork its real window)."""
    pids = {root_pid}
    try:
        # build child map from /proc
        children = {}
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                with open("/proc/%s/stat" % entry) as f:
                    fields = f.read().rsplit(")", 1)[1].split()
                ppid = int(fields[1])
            except (OSError, ValueError, IndexError):
                continue
            children.setdefault(ppid, []).append(int(entry))
        stack = [root_pid]
        while stack:
            cur = stack.pop()
            for ch in children.get(cur, []):
                if ch not in pids:
                    pids.add(ch)
                    stack.append(ch)
    except OSError:
        pass
    return pids


def find_kcm_window(child_pid, before):
    """Return the X window id created by `child_pid` (or a descendant) that is
    not in the `before` set, else None."""
    if not HAS_XPROP:
        return None
    pids = _descendant_pids(child_pid)
    for wid in _xprop_root_windows():
        if wid in before:
            continue
        if _xprop_window_pid(wid) in pids:
            return wid
    return None


