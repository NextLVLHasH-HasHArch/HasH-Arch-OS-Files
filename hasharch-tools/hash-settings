    class PageRouter(QWidget):
        """Keyed page container with history + fade transitions (hash-store)."""
        navigated = pyqtSignal(str)

        def __init__(self):
            super().__init__()
            v = QVBoxLayout(self)
            v.setContentsMargins(0, 0, 0, 0)
            self.stack = QStackedWidget()
            v.addWidget(self.stack)
            self._index = {}
            self._keys = {}
            self._history = []
            self._anim = None

        def add_page(self, key, widget):
            self._index[key] = self.stack.addWidget(widget)
            self._keys[key] = widget

        def widget(self, key):
            return self._keys.get(key)

        def current_key(self):
            return self._history[-1] if self._history else None

        def can_back(self):
            return len(self._history) > 1

        def _leave_current(self, going_to):
            cur = self.current_key()
            if cur and cur != going_to:
                w = self._keys.get(cur)
                if w is not None and hasattr(w, "leaving"):
                    try:
                        w.leaving()
                    except Exception:
                        pass

        def navigate(self, key, record=True):
            if key not in self._index:
                return
            self._leave_current(key)
            if record:
                if self._history and self._history[-1] == key:
                    record = False
                else:
                    self._history.append(key)
            self.stack.setCurrentIndex(self._index[key])
            self._fade(self._keys[key])
            self.navigated.emit(key)

        def back(self):
            if not self.can_back():
                return False
            leaving_key = self._history.pop()
            key = self._history[-1]
            w = self._keys.get(leaving_key)
            if w is not None and hasattr(w, "leaving"):
                try:
                    w.leaving()
                except Exception:
                    pass
            self.stack.setCurrentIndex(self._index[key])
            self._fade(self._keys[key])
            self.navigated.emit(key)
            return True

        def _fade(self, w):
            eff = QGraphicsOpacityEffect(w)
            w.setGraphicsEffect(eff)
            self._anim = QPropertyAnimation(eff, b"opacity", self)
            self._anim.setDuration(180)
            self._anim.setStartValue(0.0)
            self._anim.setEndValue(1.0)
            self._anim.setEasingCurve(QEasingCurve.Type.OutCubic)
            self._anim.finished.connect(lambda: w.setGraphicsEffect(None))
            self._anim.start()

