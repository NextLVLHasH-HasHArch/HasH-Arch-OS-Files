#!/usr/bin/env python3
"""HasH-Arch Settings  (hash-settings)

A standalone, dark/rounded System Settings hub for HasH-Arch — a copy of KDE's
System Settings, improved, that unifies the standard KDE KCMs AND the whole HasH
suite (Accounts, Security, Disks, Software Center, Uninstaller, wallpaper /
visualiser tweaks) in one place with a real page system, instant fuzzy search,
a landing Overview, and live quick toggles.

Chrome (frameless rounded #12141a, draggable TitleBar, ACCENT #56c5d8, sidebar,
PageRouter with Back/Exit/Escape) mirrors hash-store exactly.

Every sidebar category opens a real CUSTOM in-app page — nothing is a launcher:
    native pages -> Network, Appearance, Display & Sound, Power, System (built
                    with real controls over nmcli/bluetoothctl/pactl/wpctl/
                    powerprofilesctl/kwriteconfig6/qdbus and /proc).
    embedded HasH panes -> Accounts, Security, Disks, Apps render the HasH
                    tools' own backends inside this window (the tool is imported
                    as a module and its module-level backend functions drive a
                    native pane), with an "Open full tool" button for the rich
                    flows (wizards, pkexec transactions).
KDE modules (KCMs) hook in DEEPLY: opening one loads the real KCM *embedded*
inside this window via X11 reparenting — we launch `kcmshell6 <module>`, locate
its top-level window by matching _NET_WM_PID, and host it with
QWindow.fromWinId() + QWidget.createWindowContainer(), behind a consistent in-app
header with Back.  Privileged modules (Users, clock, SDDM, Plymouth, firewall…)
still raise their OWN polkit prompt because they run in the kcmshell6 child, not
in us (hash-settings is never run as root).  On pure-Wayland sessions, or if the
window can't be embedded, the same in-app "module" page shows a clear launch
panel instead — embedding degrades gracefully and nothing detaches silently.
Every one of the ~96 installed KCMs is reachable, grouped and searchable on the
"More KDE settings" page, each with a real icon.

Entry-list `kind` is informational for the Overview search index only:
    page  -> a native in-app settings page
    hash  -> a pane embedding a HasH tool's backend

Usage:
    hash-settings                 launch the GUI (Overview landing)
    hash-settings --page network  open straight on a category
    hash-settings --shot <png>    (internal) grab a screenshot then exit
"""
import importlib.machinery
import importlib.util
import os
import shutil
import subprocess
import sys

# ──────────────────────────── tool / KCM detection ───────────────────────────
HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local", "bin")


# ──────────────────────── HasH tool backend module loader ────────────────────
# The HasH tools (hash-disks, hash-accounts, hash-security, hash-uninstaller)
# are hyphenated Python scripts with NO .py extension; their GUI widget classes
# are nested inside a gui() function and cannot be imported directly without a
# large refactor of each tool.  Instead we import each tool *as a module* (using
# the same SourceFileLoader pattern hash-uninstaller-gui already uses) and call
# its module-level BACKEND functions to render native, in-app panes that share
# the tools' exact look & feel — fully inside hash-settings, no extra windows.
_TOOL_CACHE = {}


def load_tool(name):
    """Import a hyphenated HasH tool script as a module and cache it.

    Returns the module on success or None if the tool isn't installed / fails
    to import (so a missing tool degrades gracefully instead of crashing)."""
    if name in _TOOL_CACHE:
        return _TOOL_CACHE[name]
    path = tool_path(name)
    mod = None
    if path:
        try:
            modname = "hash_tool_" + name.replace("-", "_")
            spec = importlib.util.spec_from_loader(
                modname, importlib.machinery.SourceFileLoader(modname, path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
        except Exception:
            mod = None
    _TOOL_CACHE[name] = mod
    return mod

HAS_SYSTEMSETTINGS = bool(shutil.which("systemsettings"))
HAS_KCMSHELL = bool(shutil.which("kcmshell6")) or bool(shutil.which("kcmshell5"))
KCMSHELL = shutil.which("kcmshell6") or shutil.which("kcmshell5") or "kcmshell6"


def tool_path(name):
    """Absolute path to a HasH tool if it exists (in ~/.local/bin or PATH)."""
    local = os.path.join(BIN, name)
    if os.path.exists(local):
        return local
    return shutil.which(name)


def have(cmd):
    return bool(shutil.which(cmd))


# A KCM is considered launchable if either systemsettings or kcmshell exists.
# (We can't cheaply prove a specific KCM module is installed without launching
# it, so we gate on the host binary and let the launch fall back gracefully.)
def kcm_launchable():
    return HAS_SYSTEMSETTINGS or HAS_KCMSHELL


