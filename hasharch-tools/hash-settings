    # ════════════════════ embedded KDE module (KCM) host ═════════════════════
    class EmbeddedKCM(QWidget):
        """Hosts a real KDE KCM *inside* this window by launching
        `kcmshell6 <module>` and reparenting its X11 window into a
        QWidget.createWindowContainer.  Emits failed() if it can't embed within
        the timeout (platform not xcb, xprop missing, window never appeared, or
        the process died) so the host page can show a launch fallback."""
        embedded = pyqtSignal()
        failed = pyqtSignal(str)

        def __init__(self, module):
            super().__init__()
            self.module = module
            self.proc = None
            self.container = None
            self.foreign = None
            self._tries = 0
            self._before = set()
            v = QVBoxLayout(self)
            v.setContentsMargins(0, 0, 0, 0)
            v.setSpacing(0)
            self._layout = v
            self._status = QLabel("Loading %s…" % module)
            self._status.setObjectName("muted")
            self._status.setAlignment(Qt.AlignmentFlag.AlignCenter)
            v.addWidget(self._status, 1)

        def start(self):
            if not _on_x11():
                self.failed.emit("not-x11")
                return
            self._before = set(_xprop_root_windows())
            self.proc = QProcess(self)
            self.proc.setProgram(KCMSHELL)
            self.proc.setArguments([self.module])
            self.proc.finished.connect(self._on_proc_done)
            self.proc.start()
            if not self.proc.waitForStarted(3000):
                self.failed.emit("spawn")
                return
            self._tries = 0
            QTimer.singleShot(400, self._poll)

        def _on_proc_done(self, *a):
            # The kcmshell6 launcher can exit early after handing off to an
            # existing instance.  Don't fail immediately — give the poller a few
            # more rounds to spot a new window by PID, then by "newest new
            # window".  Only the poll timeout reports a hard failure.
            self._exited = True

        def _poll(self):
            if self.foreign is not None:
                return
            self._tries += 1
            pid = int(self.proc.processId()) if self.proc else 0
            wid = find_kcm_window(pid, self._before) if pid else None
            # late fallback: if the launcher exited or PID matching keeps
            # missing, accept the newest window that appeared after we started.
            if not wid and (getattr(self, "_exited", False) or self._tries >= 12):
                new = [w for w in _xprop_root_windows() if w not in self._before]
                if new:
                    wid = new[-1]
            if wid:
                self._embed(wid)
                return
            if self._tries >= 40:                 # ~10s @ 250ms
                self.failed.emit("timeout")
                return
            QTimer.singleShot(250, self._poll)

        def _embed(self, wid):
            try:
                self.foreign = QWindow.fromWinId(wid)
                self.container = QWidget.createWindowContainer(
                    self.foreign, self)
                self.container.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
                self._status.hide()
                self._layout.addWidget(self.container, 1)
                self.embedded.emit()
            except Exception as e:
                self.failed.emit("embed:%s" % e)

        def shutdown(self):
            if self.proc is not None:
                try:
                    self.proc.finished.disconnect()
                except Exception:
                    pass
                if self.proc.state() != QProcess.ProcessState.NotRunning:
                    self.proc.terminate()
                    if not self.proc.waitForFinished(1500):
                        self.proc.kill()

    class KCMHostPage(BasePage):
        """Shared in-app page that hosts a single KDE module.  It tries to embed
        the KCM (EmbeddedKCM); if embedding isn't possible it shows a clear
        elevation/launch panel.  Either way the user gets a consistent header
        with Back — never a silently-detached window."""
        def __init__(self, win):
            super().__init__(win, "KDE module", "")
            self._kcm = None

        def build_body(self, v):
            self._body = v
            self._host = QWidget()
            self._host.setSizePolicy(QSizePolicy.Policy.Expanding,
                                     QSizePolicy.Policy.Expanding)
            self._host.setMinimumHeight(420)
            self._hostLay = QVBoxLayout(self._host)
            self._hostLay.setContentsMargins(0, 0, 0, 0)
            # large stretch so the embedded module dominates over BasePage's
            # trailing addStretch(1) and fills the page height.
            v.addWidget(self._host, 100)

        def _clear_host(self):
            if self._kcm is not None:
                self._kcm.shutdown()
                self._kcm = None
            while self._hostLay.count():
                it = self._hostLay.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()

        def load(self, module, label=None, privileged=False):
            """(Re)point this page at a module."""
            self.module = module
            self.header.title.setText(label or module)
            sub = module
            if privileged or _is_privileged(module):
                sub += "   ·   asks for a password itself (polkit)"
            self.header.sub.setText(sub)
            self.header.sub.setVisible(True)
            self._clear_host()
            # try to embed; fall back to a launch panel
            if _on_x11() and kcm_launchable():
                kcm = EmbeddedKCM(module)
                self._kcm = kcm
                kcm.failed.connect(lambda why, m=module: self._fallback(m, why))
                self._hostLay.addWidget(kcm, 1)
                kcm.start()
            else:
                self._fallback(module, "not-x11")

        def _fallback(self, module, why):
            # embedding unavailable — present a tidy in-app launch panel
            self._clear_host()
            panel = QFrame()
            panel.setObjectName("card2")
            pv = QVBoxLayout(panel)
            pv.setContentsMargins(24, 24, 24, 24)
            pv.setSpacing(12)
            ic = QLabel()
            ic.setPixmap(QIcon.fromTheme("configure").pixmap(QSize(48, 48)))
            ic.setAlignment(Qt.AlignmentFlag.AlignCenter)
            pv.addWidget(ic)
            ttl = QLabel(self.header.title.text())
            ttl.setObjectName("big")
            ttl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            pv.addWidget(ttl)
            reason = {
                "not-x11": "This KDE module opens in its own window on "
                           "Wayland sessions.",
                "timeout": "This module took too long to embed; opening it in "
                           "its own window instead.",
                "exited": "This module closed before it could be embedded.",
                "spawn": "Could not start kcmshell6.",
            }.get(why.split(":", 1)[0],
                  "Opening this module in its own window.")
            msg = QLabel(reason)
            msg.setObjectName("muted")
            msg.setWordWrap(True)
            msg.setAlignment(Qt.AlignmentFlag.AlignCenter)
            pv.addWidget(msg)
            if _is_privileged(module):
                pill = QLabel("This module elevates via polkit when needed.")
                pill.setObjectName("muted")
                pill.setAlignment(Qt.AlignmentFlag.AlignCenter)
                pv.addWidget(pill)
            row = QHBoxLayout()
            row.addStretch(1)
            b = QPushButton("Open “%s” in its own window"
                            % self.header.title.text())
            b.setObjectName("primary")
            b.setCursor(Qt.CursorShape.PointingHandCursor)
            b.setEnabled(kcm_launchable())
            b.clicked.connect(lambda: self.win.spawn(launch_kcm(module)))
            row.addWidget(b)
            row.addStretch(1)
            pv.addLayout(row)
            wrap = QWidget()
            wl = QVBoxLayout(wrap)
            wl.addStretch(1)
            wl.addWidget(panel, 0, Qt.AlignmentFlag.AlignCenter)
            wl.addStretch(1)
            self._hostLay.addWidget(wrap, 1)

        def leaving(self):
            # called by the router when we navigate away — tear down the child
            self._clear_host()

