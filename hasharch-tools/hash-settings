    w.show()
    if shot:
        def _grab():
            w.grab().save(shot)
            os._exit(0)
        QTimer.singleShot(2500, _grab)
    return app.exec()


def main():
    a = sys.argv[1:]
    start = "overview"
    if "--page" in a:
        i = a.index("--page")
        if i + 1 < len(a):
            start = a[i + 1]
    shot = None
    if "--shot" in a:
        i = a.index("--shot")
        shot = a[i + 1] if i + 1 < len(a) else "/tmp/hash-settings.png"
    return gui(start, shot)


if __name__ == "__main__":
    sys.exit(main())
