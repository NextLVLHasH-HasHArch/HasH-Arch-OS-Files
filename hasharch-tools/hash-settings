            self.inVol.blockSignals(True)
            self.inVol.setValue(iv)
            self.inVol.blockSignals(False)
            self.inVolLbl.setText("%d%%" % iv)

        def _fill(self, box, devs):
            box.blockSignals(True)
            box.clear()
            cur = 0
            for i, d in enumerate(devs):
                box.addItem(d["desc"], d["name"])
                if d["default"]:
                    cur = i
            box.setCurrentIndex(cur)
            box.blockSignals(False)

        def _set_out(self, _i):
            name = self.outBox.currentData()
            if name:
                sound_set_default("sinks", name)
                QTimer.singleShot(300, self.refresh)

        def _set_in(self, _i):
            name = self.inBox.currentData()
            if name:
                sound_set_default("sources", name)
                QTimer.singleShot(300, self.refresh)

