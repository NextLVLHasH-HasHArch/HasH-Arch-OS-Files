def _kwrite():
    return shutil.which("kwriteconfig6") or shutil.which("kwriteconfig5")


def _kread():
    return shutil.which("kreadconfig6") or shutil.which("kreadconfig5")


def screen_timeout_get():
    """Idle DPMS timeout in seconds (0 = never), best-effort from powerdevil."""
    kr = _kread()
    if not kr:
        return None
    r = _run([kr, "--file", "powerdevilrc", "--group", "AC", "--group",
              "Display", "--key", "TurnOffDisplayIdleTimeoutSec"])
    try:
        return int(r.stdout.strip())
    except ValueError:
        return None


def screen_timeout_set(seconds):
    kw = _kwrite()
    if not kw:
        return False
    for prof in ("AC", "Battery"):
        _run([kw, "--file", "powerdevilrc", "--group", prof, "--group",
              "Display", "--key", "TurnOffDisplayIdleTimeoutSec", str(seconds)])
    # nudge powerdevil to reload (best-effort)
    q = _qdbus()
    if q:
        _run([q, "org.kde.Solid.PowerManagement",
              "/org/kde/Solid/PowerManagement", "refreshStatus"])
    return True


