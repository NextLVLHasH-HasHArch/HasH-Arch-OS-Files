#!/usr/bin/env python3
"""HasH-Arch Update Notifier

A small system-tray watcher (replaces octopi-notifier). It periodically asks the
HasH Software Center backend how many updates are available, shows a tray icon +
desktop notification when there are updates, and opens the Software Center on the
Updates page when clicked. No terminal involved.
"""
import json
import os
import subprocess
import sys

from PyQt6.QtCore import QThread, QTimer, pyqtSignal
from PyQt6.QtGui import QIcon, QAction
from PyQt6.QtWidgets import QApplication, QSystemTrayIcon, QMenu

STORE = os.path.expanduser("~/.local/bin/hash-store")
CHECK_INTERVAL_MS = 3 * 60 * 60 * 1000      # re-check every 3 hours
FIRST_CHECK_MS = 9 * 1000                    # first check ~9s after login


def _icon(*names):
    for n in names:
        ic = QIcon.fromTheme(n)
        if not ic.isNull():
            return ic
    return QIcon.fromTheme("hash-store")


class Checker(QThread):
    result = pyqtSignal(int, int)            # (repo_count, aur_count); -1 on error

    def run(self):
        try:
            out = subprocess.run([STORE, "backend", "updates"],
                                 capture_output=True, text=True, timeout=150).stdout
            d = json.loads(out)
            self.result.emit(len(d.get("repo", [])), len(d.get("aur", [])))
        except Exception:
            self.result.emit(-1, -1)


class Notifier:
    def __init__(self, app):
        self.app = app
        self.last_total = -1
        self.idle = _icon("update-none", "system-software-update", "hash-store")
        self.busy = _icon("software-update-available", "system-software-update-urgent",
                           "system-software-update", "hash-store")
        self.tray = QSystemTrayIcon(self.idle)
        self.tray.setToolTip("HasH-Arch — checking for updates…")
        menu = QMenu()
        a_open = QAction("Open Software Centre", menu)
        a_open.triggered.connect(self.open_store)
        a_upd = QAction("View updates", menu)
        a_upd.triggered.connect(self.open_updates)
        a_chk = QAction("Check for updates now", menu)
        a_chk.triggered.connect(self.check)
        a_quit = QAction("Quit", menu)
        a_quit.triggered.connect(app.quit)
        for a in (a_open, a_upd, a_chk):
            menu.addAction(a)
        menu.addSeparator()
        menu.addAction(a_quit)
        self.tray.setContextMenu(menu)
        self.tray.activated.connect(self._activated)
        self.tray.messageClicked.connect(self.open_updates)
        self.tray.show()

        self.timer = QTimer()
        self.timer.timeout.connect(self.check)
        self.timer.start(CHECK_INTERVAL_MS)
        QTimer.singleShot(FIRST_CHECK_MS, self.check)

    def _activated(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            self.open_updates()

    def open_store(self):
        subprocess.Popen([STORE])

    def open_updates(self):
        subprocess.Popen([STORE, "--updates"])

    def check(self):
        self._chk = Checker()
        self._chk.result.connect(self._update_state)
        self._chk.start()

    def _update_state(self, repo, aur):
        if repo < 0:
            self.tray.setToolTip("HasH-Arch — update check failed")
            return
        total = repo + aur
        if total > 0:
            self.tray.setIcon(self.busy)
            extra = "  (%d AUR)" % aur if aur else ""
            self.tray.setToolTip("HasH-Arch — %d update%s available%s"
                                 % (total, "" if total == 1 else "s", extra))
            if total != self.last_total:
                self.tray.showMessage(
                    "Software updates available",
                    "%d update%s ready to install. Click to open the Software Centre."
                    % (total, "" if total == 1 else "s"),
                    self.busy, 8000)
        else:
            self.tray.setIcon(self.idle)
            self.tray.setToolTip("HasH-Arch — your system is up to date")
        self.last_total = total


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("HasH Update Notifier")
    app.setQuitOnLastWindowClosed(False)
    if not QSystemTrayIcon.isSystemTrayAvailable():
        sys.stderr.write("no system tray available\n")
        return 1
    app._notifier = Notifier(app)   # keep a strong ref or it (and the tray icon) is GC'd
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
