    class Worker(QThread):
        done = pyqtSignal(object)

        def __init__(self, fn, *a):
            super().__init__()
            self.fn, self.a = fn, a

        def run(self):
            try:
                self.done.emit(self.fn(*self.a))
            except Exception as e:
                self.done.emit({"_error": str(e)})

    _shot_cache = {}                     # url -> raw image bytes

    class ImgWorker(QThread):
        """Download one screenshot URL off the UI thread, emit (url, bytes).

        Emits empty bytes on any failure so the view can drop that slot
        without ever showing a broken page. Bytes are cached so revisiting an
        app re-uses them. We pass bytes (not a QPixmap) across the thread
        boundary because QPixmap must be created on the GUI thread."""
        loaded = pyqtSignal(str, object)

        def __init__(self, url):
            super().__init__()
            self.url = url

        def run(self):
            if self.url in _shot_cache:
                self.loaded.emit(self.url, _shot_cache[self.url])
                return
            data = b""
            try:
                req = urllib.request.Request(
                    self.url, headers={"User-Agent": "hash-store/1"})
                with urllib.request.urlopen(req, timeout=15) as r:
                    data = r.read()
            except Exception:
                data = b""
            _shot_cache[self.url] = data
            self.loaded.emit(self.url, data)

