        def _build_storefront(self):
            """Scrollable landing: featured hero + Top/Trending/Picks shelves
            + clickable category chips. Populated by _populate_storefront()."""
            sc = QScrollArea()
            sc.setObjectName("scroll")
            sc.setWidgetResizable(True)
            sc.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
            inner = QWidget()
            iv = QVBoxLayout(inner)
            iv.setContentsMargins(2, 2, 8, 8)
            iv.setSpacing(20)

            self.hero = HeroBanner(self)
            iv.addWidget(self.hero)

            self.sf_top = Shelf("Top Downloaded")
            self.sf_trend = Shelf("Trending")
            self.sf_picks = Shelf("Editor's Picks")
            iv.addWidget(self.sf_top)
            iv.addWidget(self.sf_trend)
            iv.addWidget(self.sf_picks)

            # Categories shelf — clickable chips that drive the category filter.
            cat_t = QLabel("Browse by Category")
            cat_t.setObjectName("shelftitle")
            iv.addWidget(cat_t)
            chips = QWidget()
            from PyQt6.QtWidgets import QGridLayout
            gl = QGridLayout(chips)
            gl.setContentsMargins(2, 0, 2, 0)
            gl.setHorizontalSpacing(12)
            gl.setVerticalSpacing(12)
            col = row = 0
            for key, label in CATEGORIES:
                if key == "All":
                    continue
                gl.addWidget(CatChip(self, key, label), row, col)
                col += 1
                if col >= 4:
                    col = 0
                    row += 1
            iv.addWidget(chips)
            iv.addStretch(1)
            sc.setWidget(inner)
            self._sf_loaded = False
            return sc

        def open_item(self, it):
            """Open the full App Detail PAGE for a card/hero/list row.

            Hands off to the router-registered 'app' page, which loads the
            long description + screenshots and offers Install/Remove/Open. The
            page's Back button returns here (storefront or browse) via router
            history.
            """
            self.win.open_app(it)

        def go_storefront(self):
            """Reset Discover to the storefront landing (clear search/category)."""
            self.search.blockSignals(True)
            self.search.clear()
            self.search.blockSignals(False)
            self.catList.blockSignals(True)
            self.catList.setCurrentRow(0)        # "All"
            self.catList.blockSignals(False)
            self.refilter()                      # re-render + _sync_disc_view -> home
            self.header.set_can_back(self.win.router.can_back())

        def _discover_back(self):
            """Back on Discover: if browsing, return to the storefront; else
            defer to the router's history back (out of Discover)."""
            if getattr(self, "disc_stack", None) and \
                    self.disc_stack.currentIndex() == 1:
                self.go_storefront()
            else:
                self.win.go_back()

        def open_category(self, key):
            """Storefront category chip -> select that category + browse view."""
            self.search.blockSignals(True)
            self.search.clear()
            self.search.blockSignals(False)
            for i in range(self.catList.count()):
                if self.catList.item(i).data(Qt.ItemDataRole.UserRole) == key:
                    self.catList.setCurrentRow(i)
                    break
            self.disc_stack.setCurrentIndex(1)
            self.refilter()

        def _populate_storefront(self, sf):
            """Fill hero + shelves from storefront_data() (called off-thread)."""
            self._sfw_running = False
            if isinstance(sf, dict) and "_error" in sf:
                return
            self.hero.set_item(sf.get("hero"))

            def cards(items):
                return [AppCard(self, it) for it in (items or [])]
            self.sf_top.set_cards(cards(sf.get("top")))
            self.sf_trend.set_cards(cards(sf.get("trending")))
            self.sf_picks.set_cards(cards(sf.get("picks")))
            self._sf_loaded = True

        def focus_default(self):
            """Sensible initial keyboard focus when this page is shown."""
            if self.mode in ("discover", "installed"):
                self.search.setFocus()
            else:
                self.list.setFocus()

        # ---- loading ----
        def reload(self):
            self.list.clear()
            self.items = []
            if self.mode == "updates":
                self.count.setText("Checking for updates…")
                self._w = Worker(get_updates)
                self._w.done.connect(self._got_updates)
                self._w.start()
            elif self.mode == "installed":
                self.list.addItem("Loading…")
                self._w = Worker(list_installed)
                self._w.done.connect(self._got_list)
                self._w.start()
            elif self.mode == "discover":
                self.list.addItem("Loading app catalogue…")
                self._w = Worker(self._load_catalog)
                self._w.done.connect(self._got_catalog)
                self._w.start()
                # Build the fancy storefront shelves off the UI thread. Rebuild
                # when stale (e.g. after an install/remove) so the hero + card
                # install-state stays correct, not just on first load.
                if (not getattr(self, "_sf_loaded", False)
                        or getattr(self, "_sf_stale", False)) \
                        and not getattr(self, "_sfw_running", False):
                    self._sf_stale = False
                    self._sfw_running = True
                    self._sfw = Worker(storefront_data)
                    self._sfw.done.connect(self._populate_storefront)
                    self._sfw.start()

        def _load_catalog(self):
            cat = get_catalog()
            # Always re-query the local pacman db here so the catalogue ticks
            # reflect reality even when packages were installed/removed outside
            # the store (e.g. in a terminal) since the last load.
            inst = installed_set(refresh=True)
            for a in cat:
                if a.get("src") == "flatpak":
                    continue
                a["installed"] = a["pkg"] in inst
            return cat

        def _got_catalog(self, data):
            if isinstance(data, dict) and "_error" in data:
                self.list.clear()
                self.list.addItem("Error: " + data["_error"])
                return
            self._all = data
            self.refilter()

        def _got_updates(self, data):
            self.list.clear()
            self.items = []
            if isinstance(data, dict) and "_error" in data:
                self.count.setText("Error: " + data["_error"])
                return
            rows = data.get("repo", []) + data.get("aur", [])
            self.count.setText("%d update%s available" % (len(rows), "" if len(rows) == 1 else "s"))
            for it in rows:
                self.items.append(it)
                tag = "AUR" if it["src"] == "aur" else "repo"
                qi = QListWidgetItem(it["name"])
                qi.setData(Qt.ItemDataRole.DecorationRole, make_icon(it))
                qi.setData(ROLE_SUM, "%s  →  %s    ·    %s" % (it["old"], it["new"], tag))
                self.list.addItem(qi)
            if not rows:
                self.list.addItem("Your system is up to date ✓")

        def _got_list(self, data):
            if isinstance(data, dict) and "_error" in data:
                self.list.clear()
                self.list.addItem("Error: " + data["_error"])
                return
            self._all = data
            self.refilter()

        # ---- filtering / rendering ----
        def _at_home(self):
            """Discover with no search text and the 'All' category selected ->
            show the storefront landing rather than the browse list."""
            if self.mode != "discover":
                return False
            ci = self.catList.currentItem()
            key = ci.data(Qt.ItemDataRole.UserRole) if ci else "All"
            return key == "All" and not self.search.text().strip()

        def _sync_disc_view(self):
            """Swap the Discover stack between storefront (home) and browse.

            In the browse view the Back button always returns to the storefront,
            so enable it even when the router itself has no history."""
            if self.mode != "discover":
                return
            browsing = not self._at_home()
            self.disc_stack.setCurrentIndex(1 if browsing else 0)
            self.header.set_can_back(browsing or self.win.router.can_back())

        def _typed(self, *_):
            if self.mode != "discover":
                return
            self._sync_disc_view()
            if self.allpkg.isChecked() and self.search.text().strip():
                self._deb.start()
            else:
                self._deb.stop()
                self.refilter()

        def _run_pkg_search(self):
            term = self.search.text().strip()
            if not term:
                return

            def q():
                res = search_repos(term) + search_aur(term)
                return res
            self._sw = Worker(q)
            self._sw.done.connect(self._merge_pkg_search)
            self._sw.start()

        def _merge_pkg_search(self, res):
            if isinstance(res, dict):
                return
            have = {x["name"] for x in self._filtered()}
            extra = [r for r in res if r["name"] not in have]
            self._render(self._filtered() + extra)

        def _filtered(self):
            if self.mode == "discover":
                ci = self.catList.currentItem()
                key = ci.data(Qt.ItemDataRole.UserRole) if ci else "All"
                t = self.search.text().lower().strip()
                out = []
                for a in self._all:
                    if key != "All" and key not in a["cats"]:
                        continue
                    if t and t not in a["name_lc"] and t not in a["summary"].lower() and t not in a["pkg"]:
                        continue
                    out.append(a)
                return out
            if self.mode == "installed":
                t = self.search.text().lower().strip()
                return [x for x in self._all if not t or t in x["name"].lower()]
            return self._all

        def refilter(self, *_):
            self._render(self._filtered())
            self._sync_disc_view()

        def _render(self, data):
            self.list.clear()
            self.items = []
            for it in data:
                self.items.append(it)
                qi = QListWidgetItem(it["name"])
                qi.setData(Qt.ItemDataRole.DecorationRole, make_icon(it))
                if self.mode == "discover":
                    qi.setData(ROLE_SUM, it.get("summary", ""))
                elif it.get("version"):
                    src = {"aur": "AUR", "flatpak": "Flatpak"}.get(it.get("src"))
                    qi.setData(ROLE_SUM, it["version"] + ("  ·  " + src if src else ""))
                qi.setData(ROLE_INST, bool(it.get("installed")))
                self.list.addItem(qi)
            if not data:
                self.list.addItem("No results.")
            if self.mode == "discover":
                self.win.status("%d apps" % len(data))

        def _row_clicked(self, qi):
            """Browse/installed list row click -> open the full App Detail page."""
            row = self.list.row(qi)
            if 0 <= row < len(self.items):
                self.win.open_app(self.items[row])

        # ---- details + actions ----
        def on_select(self, row):
            if row < 0 or row >= len(self.items):
                self.action.hide()
                self.dIcon.clear()
                self.dName.setText("")
                self.dMeta.setText("")
                self.dDesc.setText("Select an app to see details.")
                return
            it = self.items[row]
            self.dIcon.setPixmap(make_icon(it).pixmap(QSize(72, 72)))
            self.dName.setText(it["name"])
            srcname = {"aur": "AUR", "flatpak": "Flatpak"}.get(it.get("src"), "Official repo")
            self.dMeta.setText(srcname + (" · " + it["version"] if it.get("version") else ""))
            self.dDesc.setText(it.get("summary", "") or "Loading…")
            self._iw = Worker(pkg_info, it.get("pkg", it["name"]), it.get("src", "repo"))
            self._iw.done.connect(lambda info, x=it: self._show_info(info, x))
            self._iw.start()
            if self.mode == "updates":
                self.action.hide()
                return
            installed = it.get("installed")
            self.action.setText("Remove" if (self.mode == "installed" or installed) else "Install")
            self.action.setObjectName("danger" if (self.mode == "installed" or installed) else "primary")
            self.action.setStyleSheet(btn_qss())
            self.action.show()

        def _show_info(self, info, it):
            if "_error" in info:
                return
            if "raw" in info:
                self.dDesc.setText(info["raw"][:1400])
                return
            desc = info.get("Description", it.get("summary", ""))
            extra = []
            for k in ("Version", "Installed Size", "Download Size", "URL", "Depends On"):
                v = info.get(k)
                if v and v != "None":
                    extra.append("%s: %s" % (k, v if len(v) < 90 else v[:90] + "…"))
            self.dDesc.setText(desc + ("\n\n" + "\n".join(extra) if extra else ""))

        def _after(self, ok):
            # A transaction changed the system: drop the cached installed set so
            # the next read re-queries pacman, and rebuild the storefront too.
            installed_set(refresh=True)
            if self.mode == "discover":
                self._sf_stale = True
            self.reload()

        def do_action(self):
            row = self.list.currentRow()
            if row < 0 or row >= len(self.items):
                return
            it = self.items[row]
            if self.action.text() == "Remove":
                self.win.run_txn("Removing %s" % it["name"], cmd_remove(it), self._after)
            else:
                threading.Thread(target=hash_track, args=(it.get("pkg") or it.get("name", ""),), daemon=True).start()
                self.win.run_txn("Installing %s" % it["name"], cmd_install(it), self._after)

        def update_all(self):
            self.win.run_txn("Updating your system", cmd_update_all(), lambda ok: self.reload())

    class ShotThumb(QFrame):
        """A rounded, fixed-height screenshot slot.

        Starts as a dim 'Loading…' placeholder; set_pixmap() drops in the real
        image scaled to fit. Slots that fail to load are hidden by the page so
        broken images never appear."""
        H = 240

        def __init__(self):
            super().__init__()
            self.setObjectName("shotthumb")
            self.setFixedHeight(self.H)
            self.setMinimumWidth(160)
            v = QVBoxLayout(self)
