            t.setObjectName("txtitle")
            self.log = QTextEdit(readOnly=True)
            self.log.setObjectName("txlog")
            self.btn = QPushButton("Please wait…")
            self.btn.setEnabled(False)
            self.btn.setObjectName("primary")
            self.btn.clicked.connect(self.close)
            v.addWidget(t)
            v.addWidget(self.log, 1)
            v.addWidget(self.btn)
            self.setStyleSheet(f"""
                #txwin{{ background:{BG1}; border:1px solid rgba(0,255,65,0.22);
                        border-radius:16px; }}
                #txtitle{{ color:{GREEN}; font-size:15px; font-weight:700;
                        font-family:{MONO}; letter-spacing:0.5px; }}
                #txlog{{ background:#05060a; color:{GREEN}; border:1px solid {OUTLINE};
                        border-radius:10px; font-family:{MONO}; font-size:12px;
                        selection-background-color:{GREEN}; selection-color:{ON_GREEN}; }}
            """ + btn_qss())
            self.p = QProcess(self)
            self.p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.p.setProcessEnvironment(qenv(env))
            self.p.readyReadStandardOutput.connect(self._read)
            self.p.finished.connect(self._fin)
            self._argv = list(argv)
            self._retrying = False
            self._fixkeys = []
            self._append("$ " + " ".join(argv) + "\n\n")
            self.p.start(argv[0], argv[1:])

        def _read(self):
            self._append(bytes(self.p.readAllStandardOutput()).decode(errors="ignore"))

        def _append(self, s):
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)
            self.log.insertPlainText(s)
            self.log.moveCursor(self.log.textCursor().MoveOperation.End)

        def _fin(self, code, _st):
            ok = code == 0
            self._append("\n" + ("✓ Done." if ok else "✗ Failed (exit %d)." % code) + "\n")
            self.btn.setEnabled(True)
            if not ok and not self._retrying:
                keys = self._fixable_keys(self.log.toPlainText())
                if keys is not None:        # a known, auto-fixable signing failure
                    self._fixkeys = keys
                    self._append("\n⚠ This update was blocked by an untrusted package-"
                                 "signing key.\n  HasH can fetch & trust it, refresh the "
                                 "keyrings, then retry — no terminal needed.\n")
                    self.btn.setText("Fix signing keys && retry")
                    try: self.btn.clicked.disconnect()
                    except Exception: pass
                    self.btn.clicked.connect(self._fix_and_retry)
                    return                  # wait for the user; don't signal done yet
            self.btn.setText("Close")
            try: self.btn.clicked.disconnect()
            except Exception: pass
            self.btn.clicked.connect(self.close)
            self.finishedOk.emit(ok)

        @staticmethod
        def _fixable_keys(txt):
            """List of signing-key IDs to repair (possibly empty) if the output is a
            known keyring/PGP-trust failure; None if it's some other error."""
            low = txt.lower()
            if not any(s in low for s in (
                    "unknown trust", "invalid or corrupted package (pgp signature)",
                    "marginal trust", "required key", "missing from keyring",
                    "signature from", "key is disabled")):
                return None
            seen = []
            for k in re.findall(r"(?:pgp key|key)\s+\"?([0-9A-Fa-f]{16,40})\"?", txt, re.I):
                if k.upper() not in seen:
                    seen.append(k.upper())
            return seen

        def _fix_and_retry(self):
            try: self.btn.clicked.disconnect()
            except Exception: pass
            self.btn.setEnabled(False)
            self.btn.setText("Fixing keys…")
            self._append("\n$ pkexec hash-store _fixkeys %s\n\n" % " ".join(self._fixkeys))
            self.pf = QProcess(self)
            self.pf.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
            self.pf.readyReadStandardOutput.connect(lambda: self._append(
                bytes(self.pf.readAllStandardOutput()).decode(errors="ignore")))
            self.pf.finished.connect(self._fixed)
            self.pf.start("pkexec", [SCRIPT, "_fixkeys"] + self._fixkeys)

        def _fixed(self, code, _st):
            if code != 0:
                self._append("\n✗ Key repair failed (exit %d). Updating the keyrings "
                             "manually may be needed.\n" % code)
                self.btn.setText("Close"); self.btn.setEnabled(True)
                try: self.btn.clicked.disconnect()
                except Exception: pass
                self.btn.clicked.connect(self.close)
                self.finishedOk.emit(False)
                return
            self._append("\n✓ Keys trusted. Retrying the update…\n\n")
            self._retrying = True
            self.btn.setText("Please wait…"); self.btn.setEnabled(False)
            self._append("$ " + " ".join(self._argv) + "\n\n")
            self.p.start(self._argv[0], self._argv[1:])

        def keyPressEvent(self, e):
            # Esc dismisses the transaction window once it's finished.
            if e.key() == Qt.Key.Key_Escape and self.btn.isEnabled():
                self.close()
            else:
                super().keyPressEvent(e)

