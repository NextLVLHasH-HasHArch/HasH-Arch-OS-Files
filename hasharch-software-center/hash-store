def get_catalog():
    """AppStream desktop apps: [{name, pkg, summary, cats, icon, src}] (cached)."""
    global _catalog
    if _catalog is not None:
        return _catalog
    seen, apps = set(), []
    for gz in sorted(glob.glob(os.path.join(SWCAT_XML, "*.xml.gz"))):
        repo = os.path.basename(gz).split(".")[0]
        origin = ORIGIN.get(repo, "")
        try:
            with gzip.open(gz, "rt", encoding="utf-8", errors="ignore") as f:
                root = ET.fromstring(f.read())
        except Exception:
            continue
        for comp in root.findall("component"):
            if comp.get("type") != "desktop-application":
                continue
            pkg = comp.findtext("pkgname")
            name = _localized(comp, "name")
            if not pkg or not name or pkg in seen:
                continue
            seen.add(pkg)
            icon = ""
            for i in comp.findall("icon"):
                if i.get("type") == "cached":
                    icon = _icon_path(origin, i.text)
                    if icon:
                        break
            apps.append({"name": name, "pkg": pkg, "name_lc": name.lower(),
                         "summary": _localized(comp, "summary") or "",
                         "cats": [c.text for c in comp.findall("categories/category")],
                         "icon": icon, "src": "repo"})
    # Merge the HasH site catalog (the "repo of all apps" from package-manager.json).
    for h in _hash_catalog():
        if h.get("repo") == "hash" and h["pkg"] == "hash-suite":
            apps.append(h)                       # HasH suite apps share one pkg — always list each
        elif h["pkg"] not in seen:
            apps.append(h); seen.add(h["pkg"])   # curated extra not already from AppStream
    apps.sort(key=lambda a: a["name_lc"])
    _catalog = apps
    return apps


def _desc_to_text(el):
    """Flatten an AppStream <description> element into plain paragraphs.

    AppStream descriptions are rich (<p>/<ul>/<ol>/<li>) and often carry
    per-element translations via xml:lang. We pick the best locale (user's
    language, then English, then the untranslated default) so we never show a
    random foreign language when a matching one is present, then render to
    plain text so a QLabel can display it without a full HTML widget.
    """
    if el is None:
        return ""
    # Which langs are present? Choose ONE preferred lang for the whole block,
    # ranking the unlabelled upstream (C/English) text just below explicit en.
    present = []
    for child in el:
        present.append(child.get(_XMLLANG))
    chosen = _best_lang(present)          # _NOLANG sentinel, a lang, or None

    parts = []
    for child in el:
        clang = _NOLANG if child.get(_XMLLANG) is None else child.get(_XMLLANG)
        if clang != chosen:
            continue
        tag = child.tag.split("}")[-1]
        if tag == "p":
            txt = "".join(child.itertext()).strip()
            if txt:
                parts.append(txt)
        elif tag in ("ul", "ol"):
            for li in child:
                if li.tag.split("}")[-1] == "li":
                    txt = "".join(li.itertext()).strip()
                    if txt:
                        parts.append("  •  " + txt)
    return "\n\n".join(parts)


def _best_description(comp):
    """Pick the best-locale <description> element from a component.

    AppStream catalogs emit ONE <description> element per language as siblings
    (each with its own <p>/<ul>/<li> children), e.g. <description xml:lang="ru">
    ... </description> next to an unlabelled (C/English) <description>.  The old
    code used comp.find("description") which returns the FIRST sibling in
    document order — a foreign language (Bulgarian/Russian/...) — regardless of
    the user's locale.  Here we rank the siblings by xml:lang and return the
    best, treating the unlabelled one as the C/English source.  (Some catalogs
    instead put per-<p> xml:lang inside a single <description>; _desc_to_text
    still handles that case after we pick the element.)
    """
    descs = comp.findall("description")
    if not descs:
        return None
    langs = [d.get(_XMLLANG) for d in descs]
    chosen = _best_lang(langs)
    for d in descs:
        dlang = _NOLANG if d.get(_XMLLANG) is None else d.get(_XMLLANG)
        if dlang == chosen:
            return d
    return descs[0]


_details_cache = {}


def appstream_details(pkg):
    """Rich AppStream data for one package (cached) for the App Detail page.

    Returns {description, license, url, screenshots:[urls]} parsed straight
    from the swcatalog XML. Screenshots prefer a thumbnail image, falling back
    to the full-size 'source' image. Returns empty fields when the package has
    no AppStream component (e.g. most AUR/CLI packages) so callers degrade
    gracefully (no screenshots -> hide the strip).
    """
    if pkg in _details_cache:
        return _details_cache[pkg]
    out = {"description": "", "license": "", "url": "", "screenshots": []}
    for gz in sorted(glob.glob(os.path.join(SWCAT_XML, "*.xml.gz"))):
        try:
            with gzip.open(gz, "rt", encoding="utf-8", errors="ignore") as f:
                root = ET.fromstring(f.read())
        except Exception:
            continue
        comp = None
        for c in root.findall("component"):
            if c.get("type") == "desktop-application" and c.findtext("pkgname") == pkg:
                comp = c
                break
        if comp is None:
            continue
        out["description"] = _desc_to_text(_best_description(comp))
        out["license"] = (comp.findtext("project_license") or "").strip()
        for u in comp.findall("url"):
            if u.get("type") == "homepage" and u.text:
                out["url"] = u.text.strip()
                break
        ss = comp.find("screenshots")
        if ss is not None:
            for shot in ss.findall("screenshot"):
                imgs = shot.findall("image")
                if not imgs:
                    continue
                # prefer a moderately-sized thumbnail; else the source image
                thumb = None
                source = None
                best_thumb_w = -1
                for img in imgs:
                    t = img.get("type")
                    url = (img.text or "").strip()
                    if not url:
                        continue
                    if t == "source":
                        source = url
                    elif t == "thumbnail":
                        try:
                            w = int(img.get("width") or 0)
                        except ValueError:
                            w = 0
                        # aim for ~750px wide thumbnails when offered
                        if w >= 500 and (best_thumb_w < 0 or w < best_thumb_w):
                            best_thumb_w = w
                            thumb = url
                        elif best_thumb_w < 0:
                            thumb = url
                pick = thumb or source
                if pick:
                    out["screenshots"].append(pick)
        break
    _details_cache[pkg] = out
    return out


# ───────────────────────── installed-package detection ───────────────────────
# THE source of truth for "is this package installed?".  We query the LOCAL
# pacman database (never the sync/[hash] side) and cache the result for the
# session; callers pass refresh=True after a transaction so ticks update.
#
# `pacman -Qq` lists every installed package by its REAL pkgname (e.g.
# "telegram-desktop", "qbittorrent") — exactly the ids our catalogue stores —
# so the common case is a direct set membership test.  On top of that we fold
# in every name a package PROVIDES/REPLACES (`pacman -Qi` "Provides"/"Replaces"),
# so a catalogue id that is satisfied by a differently-named package (a virtual
# provide, a -git/-bin variant that `Provides` the base name, etc.) is still
# reported as installed.
_inst_cache = None
_inst_provides = None


def _build_installed():
    """Return (names, provides): two sets covering installed packages.

    names     -> exact installed pkgnames from `pacman -Qq`.
    provides  -> every name those packages PROVIDE or REPLACE (version-stripped),
                 so virtual/aliased ids resolve to "installed" too.
    """
    names = set(run(["pacman", "-Qq"]).stdout.split())
    provides = set()
    # `pacman -Qi` prints Provides / Replaces lines for the whole local db in
    # one call; parse them so e.g. a package that Provides "telegram-desktop"
    # also counts.  Strip any "=version" suffix from a provide token.
    qi = run(["pacman", "-Qi"]).stdout
    for ln in qi.splitlines():
        if " : " not in ln:
            continue
        k, v = ln.split(" : ", 1)
        k = k.strip()
        if k in ("Provides", "Replaces"):
            v = v.strip()
            if v in ("None", ""):
                continue
            for tok in v.split():
                provides.add(re.split(r"[<>=]", tok, 1)[0].strip())
    return names, provides


def installed_set(refresh=False):
    """Set of installed package names (cached for the session).

    Pass refresh=True after an install/remove so the next read re-queries the
    local db.  The returned set is the UNION of exact names and provided names,
    so `pkg in installed_set()` reliably answers "is it installed?".
    """
    global _inst_cache, _inst_provides
    if refresh or _inst_cache is None:
        _inst_cache, _inst_provides = _build_installed()
    return _inst_cache | _inst_provides


def is_installed(pkg, src="repo"):
    """Robust single-package check against the LOCAL db.

    Tries the cached set first (exact name or a provide/replace), then falls
    back to an authoritative direct query (`pacman -Qq <pkg>`) which also
    resolves provides for that exact name — so detection never depends on a
    possibly-stale cache for the package the user is actually looking at.
    """
    if not pkg:
        return False
    if src == "flatpak":
        # flatpak app ids are matched by list_installed(); treat the snapshot
        # flag as authoritative for flatpaks (handled where items are built).
        return pkg in installed_set()
    if pkg in installed_set():
        return True
    # authoritative fallback for this one package (handles provides/virtuals)
    r = run(["pacman", "-Qq", pkg], timeout=15)
    return r.returncode == 0 and bool(r.stdout.strip())


# ───────────────────────── AUR RPC (popularity data) ─────────────────────────
# Real "top downloaded / trending" data comes from the AUR RPC v5 metadata
# (Popularity / NumVotes). We hit it with the stdlib only (no new dependency)
# and always degrade gracefully — every caller falls back to a curated list if
# the network is unavailable so the storefront never looks empty/broken.
AUR_RPC = "https://aur.archlinux.org/rpc/v5"

# Curated "Editor's Picks" — great, broadly-loved apps. Also the offline
# fallback for every storefront shelf. Filtered to ones actually available.
EDITORS_PICKS = ["firefox", "vlc", "gimp", "blender", "krita", "obs-studio",
                 "libreoffice-fresh", "code", "steam", "discord", "thunderbird",
                 "inkscape", "audacity", "kdenlive", "neovim", "telegram-desktop",
                 "spotify", "chromium", "qbittorrent", "mpv"]

# Seed terms used to discover popular/trending AUR packages via search.
_POPULAR_SEEDS = ["firefox", "chrome", "code", "discord", "spotify", "steam",
                  "vlc", "obs", "git", "editor", "browser", "player", "video",
                  "game", "office", "image", "terminal", "music"]


def _aur_get(endpoint, params):
    """GET an AUR RPC endpoint -> parsed JSON dict (or {} on any failure)."""
    url = AUR_RPC + endpoint + "?" + urllib.parse.urlencode(params, doseq=True)
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "hash-store/1"})
        with urllib.request.urlopen(req, timeout=12) as r:
            return json.loads(r.read().decode("utf-8", "ignore"))
    except Exception:
        return {}


def aur_search(term):
    """AUR RPC search by name-desc -> list of result dicts (or [])."""
    data = _aur_get("/search", {"by": "name-desc", "arg": term})
    if isinstance(data, dict) and data.get("type") == "search":
        return data.get("results", []) or []
    return []


def aur_info(names):
    """AUR RPC info for explicit package names -> list of result dicts."""
    if not names:
        return []
    data = _aur_get("/info", {"arg[]": list(names)})
    if isinstance(data, dict):
        return data.get("results", []) or []
    return []


def _aur_to_item(r):
    """Normalise an AUR RPC result into the catalog item shape used by the UI."""
    return {"name": r.get("Name", ""), "pkg": r.get("Name", ""),
            "name_lc": r.get("Name", "").lower(),
            "summary": (r.get("Description") or "") or "",
            "cats": [], "icon": "", "src": "aur",
            "version": r.get("Version", ""),
            "popularity": float(r.get("Popularity") or 0.0),
            "votes": int(r.get("NumVotes") or 0),
            "last_modified": int(r.get("LastModified") or 0)}


def _pop_pool():
    """Gather a pool of AUR packages (via several seed searches) for ranking."""
    pool, seen = [], set()
    for seed in _POPULAR_SEEDS:
        for r in aur_search(seed):
            n = r.get("Name", "")
            if n and n not in seen:
                seen.add(n)
                pool.append(r)
    return pool


def storefront_data():
    """Build the Discover storefront shelves.

    Returns {hero, top, trending, picks}. "top"/"trending" use real AUR
    popularity (Popularity / recent NumVotes); on any network failure every
    shelf degrades to the curated Editor's Picks so the page is never empty.
    """
    cat = get_catalog()
    by_pkg = {a["pkg"]: a for a in cat}
    inst = installed_set(refresh=True)   # authoritative live local-db snapshot

    def from_repo(pkg):
        """Prefer the rich AppStream catalog entry (real icon) when present."""
        a = by_pkg.get(pkg)
        if a:
            a = dict(a)
            a["installed"] = pkg in inst
            return a
        return None

    # ---- Editor's Picks: curated, filtered to what's actually installable ----
    picks = []
    for pkg in EDITORS_PICKS:
        a = from_repo(pkg)
        if a:
            picks.append(a)
    # fill any gap from the broad catalog so the shelf is never tiny
    if len(picks) < 8:
        have = {p["pkg"] for p in picks}
        for a in cat:
            if a["pkg"] not in have:
                b = dict(a)
                b["installed"] = a["pkg"] in inst
                picks.append(b)
            if len(picks) >= 12:
                break

    # ---- Top Downloaded: REAL HasH install counts from the server, ranked.
    #      Falls through to AUR popularity, then Editor's Picks. ----
    top, trending = [], []
    counts = hash_downloads()
    if counts:
        ranked = sorted((a for a in cat if counts.get(a["pkg"])),
                        key=lambda a: counts.get(a["pkg"], 0), reverse=True)
        for a in ranked[:14]:
            b = dict(a)
            b["installed"] = a["pkg"] in inst
            b["downloads"] = counts.get(a["pkg"], 0)
            top.append(b)

    pool = _pop_pool()
    if pool:
        items = [_aur_to_item(r) for r in pool]
        for it in items:
            it["installed"] = it["pkg"] in inst
            # use the AppStream icon if this AUR name is also a repo app
            rep = by_pkg.get(it["pkg"])
            if rep and rep.get("icon"):
                it["icon"] = rep["icon"]
        by_pop = sorted(items, key=lambda x: x["popularity"], reverse=True)
        top = top or by_pop[:14]                       # our counts win; AUR fills if empty
        by_trend = sorted(items, key=lambda x: (x["last_modified"], x["votes"]),
                          reverse=True)
        # trending = recently-updated with real traction, distinct from "top"
        top_names = {x["pkg"] for x in top}
        trending = [x for x in by_trend if x["votes"] >= 5][:20]
        trending = [x for x in trending if x["pkg"] not in top_names][:14] or by_trend[:14]
    if not top:
        top = list(picks)
    if not trending:
        trending = list(reversed(picks))

    hero = picks[0] if picks else (top[0] if top else None)
    return {"hero": hero, "top": top, "trending": trending, "picks": picks}


def similar_apps(pkg, cats, limit=12):
    """Apps that share a catalogue category with `pkg` (for the detail view).

    Picks from the same category in the merged catalogue, excludes the app
    itself, prefers entries that have an icon (nicer cards), and tags each with
    its live installed-state. Returns [] when there's nothing meaningful to show.
    """
    cats = set(cats or [])
    cat = get_catalog()
    if not cats:
        # fall back to the category of the catalogue entry for this pkg
        for a in cat:
            if a["pkg"] == pkg:
                cats = set(a.get("cats") or [])
                break
    if not cats:
        return []
    inst = installed_set()
    pool = [a for a in cat
            if a["pkg"] != pkg and (cats & set(a.get("cats") or []))]
    # icon-bearing apps first, then alphabetical, for a tidy, real-looking row
    pool.sort(key=lambda a: (a.get("icon", "") == "", a["name_lc"]))
    out = []
    for a in pool[:limit]:
        b = dict(a)
        b["installed"] = a["pkg"] in inst
        out.append(b)
    return out


# ──────────────────────────── repositories (sources) ─────────────────────────
def read_repos(text=None):
    """Parse pacman.conf repos -> [{name, enabled, server, include}]."""
    if text is None:
        try:
            text = open(PACCONF).read()
        except Exception:
            text = ""
    repos, cur = [], None
    for ln in text.splitlines():
        s = ln.strip()
        m = re.match(r"^(#?)\s*\[([^\]]+)\]\s*$", s)
        if m:
            if m.group(2) == "options":
                cur = None
                continue
            cur = {"name": m.group(2), "enabled": m.group(1) == "", "server": "", "include": ""}
            repos.append(cur)
            continue
        if cur is not None:
            m2 = re.match(r"^#?\s*(Server|Include)\s*=\s*(.+)$", s)
            if m2:
                cur["server" if m2.group(1) == "Server" else "include"] = m2.group(2).strip()
    # drop pacman.conf's documentation-example placeholder block
    return [r for r in repos if r["name"] != "repo-name"
            and r["server"] != "ServerName" and r["include"] != "IncludePath"]


def conf_add(text, name, kind, value, siglevel):
    block = "\n[%s]\n" % name
    if siglevel:
        block += "SigLevel = %s\n" % siglevel
    block += "%s = %s\n" % ("Server" if kind == "server" else "Include", value)
    return text.rstrip("\n") + "\n" + block


def _edit_block(text, name, mode):
    """mode: 'enable' | 'disable' | 'remove' applied to repo [name]'s block."""
    lines = text.split("\n")
    hdr = re.compile(r"^(\s*)#?\s*\[%s\]\s*$" % re.escape(name))
    body = re.compile(r"^(\s*)#?\s*(Server|Include|SigLevel)\s*=")
    out, i, n = [], 0, len(lines)
    while i < n:
        ln = lines[i]
        if hdr.match(ln):
            ind = re.match(r"^(\s*)", ln).group(1)
            if mode == "enable":
                out.append("%s[%s]" % (ind, name))
            elif mode == "disable":
                out.append("%s#[%s]" % (ind, name))
            i += 1
            while i < n and lines[i].strip() != "" and not re.match(r"^\s*#?\s*\[", lines[i]):
                b = lines[i]
                if body.match(b):
                    bind = re.match(r"^(\s*)", b).group(1)
                    content = re.sub(r"^\s*#?\s*", "", b)
                    if mode == "enable":
                        out.append(bind + content)
                    elif mode == "disable":
                        out.append(bind + "#" + content)
                    # remove -> drop the line
                elif mode != "remove":
                    out.append(b)
                i += 1
        else:
            out.append(ln)
            i += 1
    return "\n".join(out)


def writeconf(src):
    """(root, via pkexec) back up & install <src> as /etc/pacman.conf, then -Sy."""
    if not os.path.exists(src):
        sys.stderr.write("source not found\n")
        return 2
    txt = open(src).read()
    if "[options]" not in txt or "[core]" not in txt:
        sys.stderr.write("refusing: does not look like a valid pacman.conf\n")
        return 3
    bak = "/etc/pacman.conf.hashbak-%d" % int(time.time())
    shutil.copy2(PACCONF, bak)
    shutil.copy2(src, PACCONF)
    print("Backed up old config to %s" % bak)
    print("Refreshing package databases…\n")
    r = subprocess.run(["pacman", "-Sy"])
    return 0 if r.returncode == 0 else r.returncode


def fixkeys(keys):
    """(root, via pkexec) Recover from an upgrade that failed on package signing:
    fetch & locally-trust the offending key(s), then refresh the distro keyrings.
    Clears 'unknown trust' / 'invalid or corrupted package (PGP signature)' without
    a terminal — the App Manager calls this then retries the update."""
    keys = [k.upper() for k in keys if re.fullmatch(r"[0-9A-Fa-f]{16,40}", k or "")]
    rc = 0
    for k in keys:
        print("• Receiving key %s …" % k, flush=True)
        if any(subprocess.run(["pacman-key", "--keyserver", ks, "--recv-keys", k]).returncode == 0
               for ks in ("keyserver.ubuntu.com", "keys.openpgp.org")):
            print("• Trusting key %s …" % k, flush=True)
            subprocess.run(["pacman-key", "--lsign-key", k])
        else:
            print("  ! could not fetch %s" % k, flush=True); rc = 1
    # Refresh the keyrings too — covers rotated chaotic-aur / Garuda / BlackArch keys.
    print("\n• Refreshing keyrings …", flush=True)
    for kr in ("archlinux-keyring", "blackarch-keyring", "chaotic-keyring"):
        if subprocess.run(["pacman", "-Qq", kr],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.run(["pacman", "-Sy", "--noconfirm", "--needed", kr])
    subprocess.run(["pacman-key", "--populate"])
    print("\n✓ Key repair complete.", flush=True)
    return rc


