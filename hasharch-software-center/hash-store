        def _clear_layout(self, lay):
            while lay.count():
                w = lay.takeAt(0).widget()
                if w:
                    w.deleteLater()

        def show_app(self, it):
            """Populate the page for `it` and kick off async description +
            screenshot loads. Safe to call repeatedly (re-uses cached data)."""
            self.item = dict(it)
            name = it.get("name", it.get("pkg", ""))
            self.header.title.setText(name)
            self.header.set_can_back(self.win.router.can_back())
            self.bigIcon.setPixmap(make_icon(it).pixmap(QSize(104, 104)))
            self.name.setText(name)
            fade_in(self.name, ms=320)          # smooth reveal on navigation
            srcname = {"aur": "AUR", "flatpak": "Flatpak"}.get(
                it.get("src"), "Official repository")
            ver = it.get("version", "")
            self.source.setText(srcname + ("  ·  v" + ver if ver else ""))
            self.summary.setText(it.get("summary", "") or "")
            self.desc.setText("Loading description…")
            self._refresh_action()

            # reset screenshot strip to a single placeholder while we load
            self._clear_layout(self.shotL)
            self._shot_slots = {}
            self.shotTitle.show()
            self.shotScroll.show()
            self._shot_msg = ShotThumb()
            self.shotL.addWidget(self._shot_msg)
            self.shotL.addStretch(1)

            self._clear_layout(self.metaL)
            self._clear_layout(self.catL)
            for c in it.get("cats", []) or []:
                self.catL.addWidget(Chip(c))
            self.catL.addStretch(1)

            # async: pacman/AUR info (size/license/version) for the meta row
            self._iw = Worker(pkg_info, it.get("pkg", it["name"]),
                              it.get("src", "repo"))
            self._iw.done.connect(self._got_info)
            self._iw.start()
            # async: AppStream rich data (long description + screenshot URLs)
            self._dw = Worker(appstream_details, it.get("pkg", it["name"]))
            self._dw.done.connect(self._got_details)
            self._dw.start()
            # async: AUTHORITATIVE installed check against the local pacman db,
            # so the Install/Remove button is always right even if this item
            # carried a stale snapshot (the original bug: showing "Install" for
            # already-installed packages like qbittorrent / telegram-desktop).
            pkg = it.get("pkg", it["name"])
            self._instw = Worker(is_installed, pkg, it.get("src", "repo"))
            self._instw.done.connect(lambda res, p=pkg: self._got_installed(res, p))
            self._instw.start()
