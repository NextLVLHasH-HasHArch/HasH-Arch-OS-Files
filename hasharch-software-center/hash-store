                f"QFrame#shotthumb{{ background:#05060a;"
                f" border:1px solid {OUTLINE}; border-radius:12px; }}"
                f" QLabel#shotimg{{ color:{MUTED}; font-size:12px;"
                f" font-family:{MONO}; }}")

        def set_pixmap(self, pm):
            scaled = pm.scaledToHeight(
                self.H - 2, Qt.TransformationMode.SmoothTransformation)
