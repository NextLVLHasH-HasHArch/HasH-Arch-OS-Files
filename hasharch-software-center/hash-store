            QScrollBar::handle:vertical{{ background:rgba(0,255,65,0.22);
                border-radius:5px; min-height:30px; }}
            QScrollBar::handle:vertical:hover{{ background:rgba(0,255,65,0.4); }}
            QScrollBar:horizontal{{ background:transparent; height:9px; }}
            QScrollBar::handle:horizontal{{ background:rgba(0,255,65,0.20);
                border-radius:4px; min-width:40px; }}
            QScrollBar::add-line,QScrollBar::sub-line{{ height:0; width:0; }}
        """ + btn_qss()

    # QFrame is referenced in SourcesPage form; ensure imported name available
    from PyQt6.QtWidgets import QFrame  # noqa: F811

    app = QApplication(sys.argv[:1])
    app.setApplicationName("HasH-Arch Software Centre")
    app.setDesktopFileName("hash-store")             # Wayland: associate window with the launcher
    app.setWindowIcon(QIcon.fromTheme("hash-store"))  # branded HasH App Manager icon
    w = Store()
    w.show()
    if shot:
        def _grab():
            if shot_app:
                # drive a real navigation into the App Detail page to prove it
                cat = get_catalog()
                it = next((dict(a) for a in cat if a["pkg"] == shot_app), None)
                if it is None:
                    it = {"name": shot_app, "pkg": shot_app, "src": "repo",
                          "summary": "", "cats": []}
                w.open_app(it)
                # give async screenshots time to download + render
                QTimer.singleShot(7000,
                                  lambda: (w.grab().save(shot), os._exit(0)))
                return
            pg = w.router.stack.currentWidget()
            try:
                if hasattr(pg, "list") and pg.list.count():
                    pg.list.setCurrentRow(0)
            except Exception:
                pass
            QTimer.singleShot(600, lambda: (w.grab().save(shot), os._exit(0)))
        QTimer.singleShot(3500, _grab)
    return app.exec()


def main():
    a = sys.argv[1:]
    if a and a[0] == "backend":
        return cli(a[1:])
    if a and a[0] == "_writeconf":
        return writeconf(a[1] if len(a) > 1 else "")
    if a and a[0] == "_fixkeys":
        return fixkeys(a[1:])
    start = 0
    if "--updates" in a:
        start = 1
    elif "--installed" in a:
        start = 2
    elif "--sources" in a:
        start = 3
    shot = None
    if "--shot" in a:
        i = a.index("--shot")
        shot = a[i + 1] if i + 1 < len(a) else "/tmp/hash-store-shot.png"
    shot_app = None
    if "--shot-app" in a:
        i = a.index("--shot-app")
        shot_app = a[i + 1] if i + 1 < len(a) else None
    return gui(start, shot, shot_app)


if __name__ == "__main__":
    sys.exit(main())
