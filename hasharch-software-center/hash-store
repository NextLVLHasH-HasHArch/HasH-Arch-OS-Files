            fl.addWidget(QLabel("Add a repository (catalogue)"))
            r1 = QHBoxLayout()
            self.fName = QLineEdit()
            self.fName.setPlaceholderText("Name  e.g. chaotic-aur")
            self.fKind = QComboBox()
            self.fKind.addItem("Server URL", "server")
            self.fKind.addItem("Include file", "include")
