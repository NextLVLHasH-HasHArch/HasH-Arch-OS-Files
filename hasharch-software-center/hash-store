            root.addLayout(body, 1)
            self.setStyleSheet(app_qss())

            # Esc = step out / go back / close (never stuck)
            QShortcut(QKeySequence(Qt.Key.Key_Escape), self,
                      activated=self.on_escape)

            start_key = self._order[start_page] if 0 <= start_page < len(self._order) \
                else "discover"
            self.go(start_key)

        def status(self, txt):
            self.statusLbl.setText(txt)

        def go(self, key):
            self.router.navigate(key)

        def open_app(self, it):
            """Populate + navigate to the App Detail page (records history so
            Back returns to wherever the click came from)."""
            self.appPage.show_app(it)
            self.router.navigate("app")

        def refresh_lists(self):
            """After an install/remove, refresh the catalogue/installed pages so
            their installed-ticks (and the storefront hero/cards) stay correct."""
            installed_set(refresh=True)
            for key in ("discover", "installed"):
                pg = self.router.widget(key)
                if pg is None:
                    continue
                # the storefront hero + shelves carry their own snapshot — mark
                # it stale so reload() rebuilds them with fresh install-state
                if getattr(pg, "mode", None) == "discover":
                    pg._sf_stale = True
                if getattr(pg, "items", None):
                    pg.reload()

        def go_back(self):
            self.router.back()

        def on_escape(self):
            # if a search field has focus, drop focus to the list first
            fw = QApplication.focusWidget()
            if isinstance(fw, QLineEdit) and fw.text():
                fw.clear()
                return
            # on Discover, Esc from the browse view returns to the storefront
            pg = self.router.widget(self.router.current_key())
            if getattr(pg, "mode", None) == "discover" and \
                    getattr(pg, "disc_stack", None) and \
                    pg.disc_stack.currentIndex() == 1:
                pg.go_storefront()
                return
            if self.router.can_back():
                self.router.back()
            else:
                self.close()

        def _on_navigated(self, key):
            for k, b in self.nav.items():
                b.setChecked(k == key)
            pg = self.router.widget(key)
            if pg is None:
                return
            if hasattr(pg, "header"):
                pg.header.set_can_back(self.router.can_back())
            if isinstance(pg, SourcesPage):
                if pg.working is None:
                    pg.reload()
            elif isinstance(pg, AppDetailPage):
                pass            # already populated by open_app(); nothing to load
            elif not getattr(pg, "items", None):
                pg.reload()
            # keep the Discover Back button correct for its storefront/browse state
            if getattr(pg, "mode", None) == "discover" and \
                    hasattr(pg, "_sync_disc_view"):
                pg._sync_disc_view()
            if hasattr(pg, "focus_default"):
                QTimer.singleShot(0, pg.focus_default)

        def _toggle_remember(self, on):
            """User flicked the 'Remember password' switch."""
            self.cfg["remember_password"] = bool(on)
            save_config(self.cfg)
            if on:
                # authorise once now (single graphical prompt) + keep it warm
                self.statusLbl.setText("Authorising…")
                self._aw = Worker(SESSION_AUTH.prime)
                self._aw.done.connect(self._primed)
                self._aw.start()
            else:
                SESSION_AUTH.stop()             # forget: drop the cached cred
                self.statusLbl.setText("")

        def _primed(self, ok):
            self.statusLbl.setText("Password remembered ✓" if ok
                                   else "Couldn't remember password")

        def run_txn(self, title, argv, on_done):
            # If the user opted to remember, make sure the session credential is
            # live before the transaction runs so yay doesn't re-prompt.
            if getattr(self, "remember", None) is not None \
                    and self.remember.isChecked() and not SESSION_AUTH.active \
                    and SESSION_AUTH.available():
                SESSION_AUTH.prime()
            self._tx = Transaction(self, title, argv, tx_env())
            self._tx.finishedOk.connect(on_done)
            g = self.geometry()
            self._tx.move(g.center().x() - 330, g.center().y() - 230)
            self._tx.show()

        def closeEvent(self, e):
            # Drop sudo's cached credential when the app quits so it never
            # outlives the session.
            try:
                SESSION_AUTH.stop()
            except Exception:
                pass
            super().closeEvent(e)

        def paintEvent(self, _e):
            p = QPainter(self)
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            path = QPainterPath()
            path.addRoundedRect(0.5, 0.5, self.width() - 1, self.height() - 1, 20, 20)
            p.fillPath(path, QColor(0x0a, 0x0a, 0x0f))   # --cyber-dark
            p.setPen(QColor(0, 255, 65, 45))             # faint matrix-green rim
            p.drawPath(path)

