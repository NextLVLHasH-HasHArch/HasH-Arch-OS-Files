    # ── animation helpers (fancy, smooth, never distracting) ──────────────
    def fade_in(widget, ms=260, delay=0):
        """Fade a widget in with a QGraphicsOpacityEffect (e.g. cards on load)."""
        eff = QGraphicsOpacityEffect(widget)
        widget.setGraphicsEffect(eff)
        anim = QPropertyAnimation(eff, b"opacity", widget)
        anim.setDuration(ms)
        anim.setStartValue(0.0)
        anim.setEndValue(1.0)
        anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        # drop the effect when done so it doesn't tax compositing forever
        anim.finished.connect(lambda: widget.setGraphicsEffect(None))
        # keep a ref so it isn't garbage-collected mid-animation
        widget._fade_anim = anim
        if delay:
            QTimer.singleShot(delay, anim.start)
        else:
            anim.start()

    def make_glow(widget, colour=GREEN, radius=0):
        """Attach a (initially off) matrix-green drop-shadow glow to a widget."""
        g = QGraphicsDropShadowEffect(widget)
        g.setOffset(0, 0)
        g.setBlurRadius(radius)
        c = QColor(colour)
        c.setAlpha(200)
        g.setColor(c)
        widget.setGraphicsEffect(g)
        return g

    def animate_glow(effect, to, ms=180):
        """Animate a drop-shadow's blur radius (hover pulse on app icons)."""
        anim = QPropertyAnimation(effect, b"blurRadius", effect)
        anim.setDuration(ms)
        anim.setEndValue(to)
        anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        anim.start()
        effect._glow_anim = anim

