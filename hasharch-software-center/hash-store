            side = QVBoxLayout()
            side.setSpacing(6)
            self.nav = {}                    # key -> sidebar button
            self.router = PageRouter()
            self.router.navigated.connect(self._on_navigated)
            specs = [("discover", "Discover", "system-software-install"),
                     ("updates", "Updates", "system-software-update"),
                     ("installed", "Installed", "applications-other"),
                     ("sources", "Sources", "folder-remote")]
            self._order = [s[0] for s in specs]
            for key, label, icon in specs:
                b = QPushButton("  " + label)
                b.setCheckable(True)
                b.setObjectName("nav")
                b.setIcon(QIcon.fromTheme(icon))
                b.setIconSize(QSize(20, 20))
                b.setCursor(Qt.CursorShape.PointingHandCursor)
                b.clicked.connect(lambda _, k=key: self.go(k))
                side.addWidget(b)
                self.nav[key] = b
                pg = SourcesPage(self) if key == "sources" else Page(self, key)
                self.router.add_page(key, pg)
            # The App Detail page has no sidebar entry; you reach it by clicking
            # an app and leave it via the header Back button / Escape.
            self.appPage = AppDetailPage(self)
            self.router.add_page("app", self.appPage)
            side.addStretch(1)
            self.statusLbl = QLabel("")
            self.statusLbl.setObjectName("brand")
            side.addWidget(self.statusLbl)

            # "Remember my password this session" — primes sudo once so installs
            # stop re-prompting. We never store the password, only this choice.
            self.cfg = load_config()
            self.remember = QCheckBox("  Remember password")
            self.remember.setObjectName("remember")
            self.remember.setToolTip(
                "Authorise once, then install & remove without re-entering your\n"
                "password for the rest of this session. Nothing secret is saved\n"
                "to disk — only sudo's own short-lived credential is kept warm.")
            self.remember.setChecked(bool(self.cfg.get("remember_password")))
            self.remember.setEnabled(SESSION_AUTH.available())
            self.remember.toggled.connect(self._toggle_remember)
            side.addWidget(self.remember)
            # honour a saved "remember" choice on startup (prime quietly, async)
            if self.remember.isChecked() and SESSION_AUTH.available():
                self._aw = Worker(SESSION_AUTH.prime)
                self._aw.done.connect(self._primed)
                self._aw.start()

            # explicit, always-visible exit control so the user is never stuck
            exitb = QPushButton("  ⏻  Exit")
            exitb.setObjectName("exitbtn")
            exitb.setIcon(QIcon.fromTheme("application-exit"))
            exitb.setIconSize(QSize(18, 18))
            exitb.setCursor(Qt.CursorShape.PointingHandCursor)
            exitb.clicked.connect(self.close)
            side.addWidget(exitb)
