            addBtn.setObjectName("primary")
            addBtn.clicked.connect(self.add_repo)
            fl.addWidget(addBtn)
            note = QLabel("Tip: signed third-party repos also need their key imported "
                          "(pacman-key). Unsigned repos: pick a TrustAll/Never SigLevel.")
            note.setObjectName("ddesc")
            note.setWordWrap(True)
            fl.addWidget(note)
