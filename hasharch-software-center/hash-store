        def _got_installed(self, installed, pkg=None):
            """Apply the authoritative local-db installed result for this app.

            `pkg` guards against a late result from a previous app (the user may
            have navigated on); we only apply it if it's still the current one."""
            if not isinstance(installed, bool):
                return
            if self.item is None:
                return
            if pkg is not None and pkg != self.item.get("pkg", self.item.get("name")):
                return
            self.item["installed"] = installed
            self._refresh_action()

        def _populate_similar(self, it):
            """Load a 'Similar apps' row from the same catalogue category."""
            self.similar.hide()
            self._simw = Worker(similar_apps, it.get("pkg", it.get("name", "")),
                                it.get("cats") or [])
            self._simw.done.connect(self._got_similar)
            self._simw.start()

        def _got_similar(self, items):
            if not isinstance(items, list) or not items:
                self.similar.hide()
                return
            self.similar.set_cards([AppCard(self, x) for x in items])
            self.similar.show()

        def _got_info(self, info):
            if not isinstance(info, dict) or "_error" in info:
                return
            it = self.item or {}
            chips = []
            ver = info.get("Version") or it.get("version")
            if ver:
                chips.append("v" + ver)
                self.source.setText(self.source.text().split("·")[0].rstrip()
                                    + "  ·  v" + ver)
            for label, key in (("Size", "Installed Size"),
                               ("Download", "Download Size"),
                               ("Licence", "License")):
                v = info.get(key)
                if v and v != "None":
                    chips.append("%s: %s" % (label, v))
            if it.get("votes"):
                chips.append("★ %d votes" % it["votes"])
            if it.get("popularity"):
                chips.append("▲ %.1f popularity" % it["popularity"])
            self._clear_layout(self.metaL)
            for c in chips:
                self.metaL.addWidget(Chip(c))
            self.metaL.addStretch(1)
            # if AppStream gave no long description, fall back to pacman's
            if self.desc.text() in ("Loading description…", ""):
                d = info.get("Description") or it.get("summary") or ""
                if d:
                    self.desc.setText(d)

        def _got_details(self, det):
            if not isinstance(det, dict) or "_error" in det:
                det = {}
            it = self.item or {}
            long_desc = det.get("description") or ""
            if long_desc:
                self.desc.setText(long_desc)
            elif self.desc.text() == "Loading description…":
                self.desc.setText(it.get("summary", "")
                                  or "No description available.")
            if det.get("license"):
                self.metaL.insertWidget(0, Chip("Licence: " + det["license"]))
            shots = det.get("screenshots") or []
            self._load_shots(shots)

        def _load_shots(self, urls):
            self._clear_layout(self.shotL)
            self._shot_slots = {}
            if not urls:
                # graceful degradation: no screenshots -> hide the strip, the
                # big app icon already stands in at the top of the page.
                self.shotTitle.hide()
                self.shotScroll.hide()
                return
            self.shotTitle.show()
            self.shotScroll.show()
            self._shot_workers = []
            for url in urls[:8]:
                slot = ShotThumb()
                self._shot_slots[url] = slot
                self.shotL.addWidget(slot)
                w = ImgWorker(url)
                w.loaded.connect(self._shot_ready)
                self._shot_workers.append(w)
                w.start()
            self.shotL.addStretch(1)

        def _shot_ready(self, url, data):
            slot = self._shot_slots.get(url)
            if slot is None:
                return
            pm = QPixmap()
            if data:
                img = QImage.fromData(data)
                if not img.isNull():
                    pm = QPixmap.fromImage(img)
            if pm.isNull():
                # this screenshot failed -> drop the slot so no broken image
                slot.hide()
                slot.deleteLater()
                self._shot_slots.pop(url, None)
                if not any(s.isVisible() for s in self._shot_slots.values()) \
                        and not self._shot_slots:
                    self.shotTitle.hide()
                    self.shotScroll.hide()
                return
            slot.set_pixmap(pm)

        def do_action(self):
            it = self.item
            if not it:
                return
            if self.action.text() == "Remove":
                self.win.run_txn("Removing %s" % it["name"],
                                 cmd_remove(it), self._after)
            else:
                threading.Thread(target=hash_track, args=(it.get("pkg") or it.get("name", ""),), daemon=True).start()
                self.win.run_txn("Installing %s" % it["name"],
                                 cmd_install(it), self._after)

        def _after(self, ok):
            if ok and self.item:
                # Re-query the local db authoritatively rather than blindly
                # flipping, so the button reflects the true post-transaction
                # state (and refresh the catalogue/installed pages + storefront).
                installed_set(refresh=True)
                self._instw = Worker(is_installed, self.item.get("pkg", self.item["name"]),
                                     self.item.get("src", "repo"))
                self._instw.done.connect(self._got_installed)
                self._instw.start()
                self.win.refresh_lists()

