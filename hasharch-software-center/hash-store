# ─────────────────────────── session privilege auth ──────────────────────────
# "Remember my password" done SECURELY: we never store the password. Instead we
# validate sudo ONCE per session (a single graphical prompt via ksshaskpass) and
# keep sudo's own credential timestamp warm with a quiet `sudo -n -v` heartbeat.
# While that heartbeat runs, yay's internal sudo calls find a live timestamp and
# DON'T re-prompt — fixing the "asks for the password every single time" bug.
#
# Implementation detail: a GUI app has no controlling tty, and every elevated
# child we spawn (the priming `sudo`, the heartbeat `sudo`, and yay's `sudo`)
# inherits that same "no tty" context, so they share one sudo timestamp record
# even under Arch's default tty_tickets policy.
class _SessionAuth:
    def __init__(self):
        self.active = False          # have we successfully primed this session?
        self._stop = None            # threading.Event for the heartbeat
        self._thr = None

    def env(self):
        e = dict(os.environ)
        if ASKPASS:
            e["SUDO_ASKPASS"] = ASKPASS
        return e

    def available(self):
        return bool(shutil.which("sudo"))

    def prime(self):
        """Validate sudo once (graphical prompt) and start the keep-alive.

        Returns True if a credential is now cached. Safe to call repeatedly:
        once active it just confirms the timestamp is still valid."""
        if not self.available():
            return False
        if self.active:
            # already remembered: a non-interactive refresh confirms it's live
            if self._validate_quiet():
                return True
        env = self.env()
        # -A => use SUDO_ASKPASS (graphical) if a prompt is actually needed;
        # -v => just refresh/validate the timestamp, run no command.
        flags = ["-A", "-v"] if ASKPASS else ["-v"]
        try:
            r = subprocess.run(["sudo"] + flags, env=env, timeout=120,
                               capture_output=True, text=True)
        except Exception:
            return False
        if r.returncode != 0:
            return False
        self.active = True
        self._start_heartbeat()
        return True

    def _validate_quiet(self):
        try:
            r = subprocess.run(["sudo", "-n", "-v"], timeout=10,
                               capture_output=True, text=True)
            return r.returncode == 0
        except Exception:
            return False

    def _start_heartbeat(self):
        if self._thr and self._thr.is_alive():
            return
        self._stop = threading.Event()

        def beat():
            # Refresh well inside sudo's default 5-min timeout so the cached
            # credential never lapses while the app is open.
            while not self._stop.wait(60):
                try:
                    subprocess.run(["sudo", "-n", "-v"], timeout=10,
                                   capture_output=True, text=True)
                except Exception:
                    pass
        self._thr = threading.Thread(target=beat, daemon=True)
        self._thr.start()

    def stop(self):
        """Drop the cached credential and stop the heartbeat (on quit/forget)."""
        if self._stop:
            self._stop.set()
        self.active = False
        try:
            subprocess.run(["sudo", "-K"], timeout=10,
                           capture_output=True, text=True)
        except Exception:
            pass


SESSION_AUTH = _SessionAuth()


# ───────────────────────── transaction command builders ──────────────────────
def tx_env():
    return SESSION_AUTH.env()


def _sudoflags():
    """sudo flags handed to yay.

    We always pass `-A` (graphical askpass) as a safety net: sudo only invokes
    askpass when there is NO live credential. When "remember password" is on,
    SessionAuth has primed sudo and keeps its timestamp warm, so `-A` never
    actually prompts after the first authorisation — that's the remembering.
    When it's off, the timestamp lapses and each transaction prompts once, as
    before. Either way the user is never left unable to authorise."""
    return ["--sudoflags", "-A"] if ASKPASS else []


def cmd_install(it):
    if it.get("src") == "flatpak":
        return ["flatpak", "install", "-y", it["name"]]
    return ["yay", "-S", "--noconfirm"] + _sudoflags() + [it.get("pkg", it["name"])]


def cmd_remove(it):
    if it.get("src") == "flatpak":
        return ["flatpak", "uninstall", "-y", it.get("appid", it["name"])]
    return ["yay", "-Rns", "--noconfirm"] + _sudoflags() + [it.get("pkg", it["name"])]


def cmd_update_all():
    return ["yay", "-Syu", "--noconfirm"] + _sudoflags()


