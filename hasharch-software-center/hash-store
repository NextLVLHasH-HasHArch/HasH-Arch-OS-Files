            fl.addLayout(r1)
            r2 = QHBoxLayout()
            self.fValue = QLineEdit()
            self.fValue.setPlaceholderText("https://…/$repo/os/$arch   or   /etc/pacman.d/…-mirrorlist")
            self.fSig = QComboBox()
            for s in ["Default", "Optional TrustAll (unsigned)", "Never (unsigned)"]:
                self.fSig.addItem(s)
            r2.addWidget(self.fValue, 1)
            r2.addWidget(self.fSig)
            fl.addLayout(r2)
