def cli(a):
    if not a:
        print(__doc__)
        return 0
    c = a[0]
    if c == "updates":
        print(json.dumps(get_updates(), indent=2))
    elif c == "search":
        print(json.dumps(search_repos(a[1] if len(a) > 1 else ""), indent=2))
    elif c == "installed":
        print(json.dumps(list_installed(), indent=2))
    elif c == "info":
        print(json.dumps(pkg_info(a[1], a[2] if len(a) > 2 else "repo"), indent=2))
    elif c == "catalog":
        cat = get_catalog()
        print(json.dumps({"count": len(cat), "sample": cat[:3]}, indent=2))
    elif c == "storefront":
        sf = storefront_data()
        print(json.dumps({k: (len(v) if isinstance(v, list) else bool(v))
                          for k, v in sf.items()}, indent=2))
    elif c == "repos":
        print(json.dumps(read_repos(), indent=2))
    else:
        print("unknown:", c, file=sys.stderr)
        return 2
    return 0


