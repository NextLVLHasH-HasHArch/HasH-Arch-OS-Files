            h.addWidget(_color_tile(icon, color), 0, Qt.AlignmentFlag.AlignVCenter)
            col = QVBoxLayout()
            col.setSpacing(2)
            col.addStretch(1)
            nm = QLabel(label)
            nm.setObjectName("cardname")
            col.addWidget(nm)
            running = sum(1 for u in units if u["active"] == "active")
            sm = QLabel("%d running · %d total" % (running, len(units)))
            sm.setObjectName("cardsumm")
