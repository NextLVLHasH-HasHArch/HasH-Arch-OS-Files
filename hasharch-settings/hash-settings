def check_updates():
    """(list_of_lines, count, used_checkupdates).

    Prefer `checkupdates` (pacman-contrib) — it's SAFE and needs NO root: it
    syncs to a private temp DB, never the system one.  Lines look like
    `pkg 1.0-1 -> 1.1-1`.  Falls back to `pacman -Qu` (offline, may be stale)."""
    if have("checkupdates"):
        r = _run(["checkupdates"], timeout=60)
        # checkupdates exits 2 when there are simply no updates (empty output)
        lines = [ln for ln in r.stdout.splitlines() if ln.strip()]
        return lines, len(lines), True
    if have("pacman"):
        r = _run(["pacman", "-Qu"], timeout=20)
        lines = [ln for ln in r.stdout.splitlines() if ln.strip()]
        return lines, len(lines), False
    return [], 0, False


