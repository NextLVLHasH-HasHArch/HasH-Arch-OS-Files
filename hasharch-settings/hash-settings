        def _rule_row(self, name, is_port):
            w = QWidget(); row = QHBoxLayout(w); row.setContentsMargins(0, 0, 0, 0)
            row.addWidget(QLabel(("🔌 " if is_port else "🧩 ") + name)); row.addStretch(1)
            rm = QPushButton("Remove")
            rm.clicked.connect(lambda: self._fw(["--remove-port=" + name if is_port else "--remove-service=" + name]))
            row.addWidget(rm); self.rulesBox.addWidget(w)

        def _fw(self, args, permanent=True, reload=True):
            cmds = [["firewall-cmd"] + (["--permanent"] if permanent else []) + args]
            if reload: cmds.append(["firewall-cmd", "--reload"])
            self._run_fw(cmds)

        def _run_fw(self, cmds):
            # Run each firewall-cmd as ARGV via pkexec (NO `sh -c` -> no root command
            # injection). With the auth_admin_keep polkit rule the password is asked
            # ONCE per session and then remembered for the rest of the actions.
            for c in cmds:
                self.cli.echo("# sudo " + " ".join(c))
            ok, err = True, ""
            for c in cmds:
                res = _run(["pkexec", self.FWCMD] + c[1:], timeout=30)
                if getattr(res, "returncode", 1) != 0:
                    ok = False; err = (getattr(res, "stderr", "") or "failed").strip(); break
            self.cli.echo("# ✓ applied" if ok else "# ✗ " + err)
            self.refresh()

        def _preset_cmds(self, preset):
            return [["firewall-cmd"] + a for a in preset["cmds"]] + [["firewall-cmd", "--reload"]]

        def _preview_preset(self, preset):
            cmds = self._preset_cmds(preset)
            self.cli.echo("# preset: %s — %s" % (preset["name"], preset["desc"]))
            for c in cmds:
                self.cli.echo("sudo " + " ".join(c))
            self.cli.echo("# (preview only — not applied)")

        def _apply_preset(self, preset):
            if QMessageBox.question(self, "Apply firewall preset",
                    "Apply the '%s' preset?\n\n%s\n\nThis changes the default zone and its rules."
                    % (preset["name"], preset["desc"])) != QMessageBox.StandardButton.Yes:
                return
            self._run_fw(self._preset_cmds(preset))

        def _preset_clicked(self, preset):
            if self.previewChk.isChecked():
                self._preview_preset(preset)
            else:
                self._apply_preset(preset)

        def _set_zone(self):
            self._fw(["--set-default-zone=" + self.zoneBox.currentText()], permanent=False, reload=False)

        def _add_port(self):
            p = self.portEdit.text().strip()
            if p.isdigit():
                self._fw(["--add-port=%s/%s" % (p, self.protoBox.currentText())]); self.portEdit.clear()

        def _add_service(self):
            self._fw(["--add-service=" + self.svcBox.currentText()])

