def entry_available(e):
    """Is this entry usable on this machine? (else hide/disable it)."""
    k = e["kind"]
    if k == "hash":
        return tool_path(e["target"]) is not None
    # "page" entries are native and always present; the page itself degrades
    # gracefully when a backend (nmcli, pactl, …) is missing.
    return True


def all_entries():
    """Flat list of (section_key, entry) across every category, for search."""
    out = []
    for key, _label, _icon, _page, entries in SECTIONS:
        for e in entries:
            out.append((key, e))
    return out


def tool_argv(name, *args):
    """argv to launch a HasH tool standalone (used for the Software Center
    launch button, which is genuinely its own big app), or None."""
    p = tool_path(name)
    if not p:
        return None
    return [p] + list(args)


# ════════════════════════════════ quick toggles ══════════════════════════════
# Each toggle: backend availability check, read state, set state. If a backend
# is missing the toggle is HIDDEN (never crashes). All run in the user session.
def _run(cmd, timeout=6):
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError) as e:
        class _R:
            returncode = 1
            stdout = ""
            stderr = str(e)
        return _R()


def _shquote(s):
    """shlex.quote a token only when it actually needs quoting (keeps the
    CLI-learn console readable: `sudo systemctl restart sshd`, not a wall of
    quotes), so the displayed command is copy-pasteable into a real shell."""
    import shlex
    return shlex.quote(s)


def _run_pipe_priv(argv, stdin_text, timeout=30):
    """Run `pkexec <argv>` feeding `stdin_text` on STDIN (never raises).

    Used for `chpasswd`: the secret goes in over stdin so it appears in neither
    the process argv nor the CLI-learn console.  Returns a _run-style object."""
    try:
        return subprocess.run(["pkexec"] + list(argv), input=stdin_text,
                              capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError) as e:
        class _R:
            returncode = 1
            stdout = ""
            stderr = str(e)
        return _R()


# ---- Wi-Fi (nmcli radio wifi) ----
def wifi_available():
    return have("nmcli")


def wifi_state():
    r = _run(["nmcli", "radio", "wifi"])
    return "enabled" in r.stdout.lower()


def wifi_set(on):
    _run(["nmcli", "radio", "wifi", "on" if on else "off"])


# ---- Bluetooth (rfkill, fallback bluetoothctl) ----
def bt_available():
    return have("rfkill") or have("bluetoothctl")


def bt_state():
    if have("rfkill"):
        r = _run(["rfkill", "list", "bluetooth"])
        # "Soft blocked: no" means powered/unblocked
        for ln in r.stdout.splitlines():
            if "soft blocked" in ln.lower():
                return "no" in ln.lower().split(":")[-1]
    if have("bluetoothctl"):
        r = _run(["bluetoothctl", "show"])
        for ln in r.stdout.splitlines():
            if "powered" in ln.lower():
                return "yes" in ln.lower()
    return False


def bt_set(on):
    if have("rfkill"):
        _run(["rfkill", "unblock" if on else "block", "bluetooth"])
    if have("bluetoothctl"):
        _run(["bluetoothctl", "power", "on" if on else "off"])


# ---- Night Light (kscreen-doctor, fallback qdbus to KWin) ----
def night_available():
    return have("kscreen-doctor") or have("qdbus") or have("qdbus6")


def _qdbus():
    return shutil.which("qdbus6") or shutil.which("qdbus")


def night_state():
    # KWin's NightLight DBus exposes "running"/"inhibited"; best-effort read.
    q = _qdbus()
    if q:
        for path in ("org.kde.KWin.NightLight", "org.kde.KWin.ColorCorrect"):
            r = _run([q, "org.kde.KWin", "/ColorCorrect",
                      "org.freedesktop.DBus.Properties.Get",
                      path, "running"])
            if r.returncode == 0 and r.stdout.strip():
                return "true" in r.stdout.lower()
    return False


def night_set(on):
    # KWin's NightLight DBus exposes a single toggle() that flips the current
    # state, so only invoke it when the desired state differs from the current.
    q = _qdbus()
    if q and night_state() != on:
        _run([q, "org.kde.KWin", "/ColorCorrect",
              "org.kde.KWin.NightLight.toggle"])


