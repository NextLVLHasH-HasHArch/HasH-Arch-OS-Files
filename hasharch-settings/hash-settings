def power_profiles():
    if not have("powerprofilesctl"):
        return [], ""
    r = _run(["powerprofilesctl", "list"])
    profs, active = [], ""
    for ln in r.stdout.splitlines():
        s = ln.strip()
        if s.startswith("* "):
            name = s[2:].rstrip(":")
            active = name
            profs.append(name)
        elif s.endswith(":") and " " not in s.rstrip(":"):
            profs.append(s.rstrip(":"))
    # de-dup preserve order
    seen, out = set(), []
    for p in profs:
        if p and p not in seen:
            seen.add(p)
            out.append(p)
    if not active:
        ra = _run(["powerprofilesctl", "get"])
        active = ra.stdout.strip()
    return out, active


