            color = self.visBox.currentData()
            show = self.visEnable.isChecked()
            ok = vis_apply(color, show)
            self.win.status("Visualiser updated." if ok
                            else "Could not reach Plasma to update visualiser.")

        @staticmethod
        def _kr(file, group, key):
            try:
                return subprocess.run(["kreadconfig6", "--file", file, "--group",
                                       group, "--key", key], capture_output=True,
                                      text=True, timeout=5).stdout.strip()
            except Exception:
                return ""

        @staticmethod
        def _color_schemes():
            import glob
            names = set()
            for d in ("/usr/share/color-schemes",
                      os.path.expanduser("~/.local/share/color-schemes")):
                for f in glob.glob(d + "/*.colors"):
                    names.add(os.path.basename(f)[:-7])
            return sorted(names)

        @staticmethod
        def _cursor_themes():
            import glob
            names = set()
            for d in ("/usr/share/icons",
                      os.path.expanduser("~/.local/share/icons")):
                for c in glob.glob(d + "/*/cursors"):
                    names.add(os.path.basename(os.path.dirname(c)))
            return sorted(names)

        def _apply_colors(self):
            n = self.colorBox.currentText()
            if n:
                subprocess.Popen(["plasma-apply-colorscheme", n],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.win.status("Colour scheme: %s" % n)

        def _apply_cursor(self):
            n = self.cursorBox.currentText()
            if n:
                subprocess.Popen(["plasma-apply-cursortheme", n],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.win.status("Cursor theme: %s" % n)

        def _pick_wallpaper(self):
            from PyQt6.QtWidgets import QFileDialog
            f, _sel = QFileDialog.getOpenFileName(
                self.win, "Choose wallpaper", os.path.expanduser("~"),
                "Images (*.png *.jpg *.jpeg *.webp *.bmp *.svg)")
            if f:
                subprocess.Popen(["plasma-apply-wallpaperimage", f],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.win.status("Wallpaper set.")

