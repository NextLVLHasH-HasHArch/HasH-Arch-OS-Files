    # ──────────────────────────────── System page ────────────────────────────
    class SystemPage(CliPageMixin, BasePage):
        # System-category settings driven by the declarative engine (REGISTRY).
        # Adding one here is just a new key — the row, read/write and CLI echo
        # are all handled generically.
        ENGINE_KEYS = ["appearance.animation_speed", "appearance.single_click",
                       "input.numlock"]

        def __init__(self, win):
            self._erows = {}     # key -> (Win11Row, control)
            super().__init__(win, "System",
                             "About this computer, and core behaviour")

        def build_body(self, v):
            # Core behaviour — rendered from the engine REGISTRY as Win11Rows.
            self.section(v, "Behaviour")
            ecard, ec = self.card()
            for key in self.ENGINE_KEYS:
                s = REGISTRY.get(key)
                if s is None:
                    continue
                ec.addWidget(self._engine_row(s))
            v.addWidget(ecard)

            self.section(v, "About HasH-Arch")
            self.aboutCard, ac = self.card()
            self.grid = QGridLayout()
            self.grid.setHorizontalSpacing(20)
            self.grid.setVerticalSpacing(8)
            ac.addLayout(self.grid)
            v.addWidget(self.aboutCard)

            self.add_cli_card(v, "CLI — what each control runs (learn it)")
            self._refresh_about()

        def _engine_row(self, s):
            avail = s.backend.available() if s.backend else True
            ctrl = _make_control(s, lambda val, s=s: self._engine_changed(s, val))
            row = Win11Row(s.name, s.comment, s.icon, control=ctrl,
                           enabled=avail)
            if not avail and ctrl is not None:
                ctrl.setEnabled(False)
                row.set_sub((s.comment + "  ·  " if s.comment else "")
                            + "tool not available on this system")
            self._erows[s.key] = (row, ctrl)
            return row

        def _engine_changed(self, s, value):
            if s.backend is None:
                return
            self.cli_echo("$ " + s.backend.describe_write(value))
            try:
                ok = s.backend.write(value)
            except Exception as e:
                self.cli_echo("# ✗ " + str(e))
                ok = False
            else:
                self.cli_echo("# ✓ ok" if ok else "# ✗ failed")
            run_apply(s.apply)
            if s.apply:
                self.cli_echo("# apply: " + apply_describe(s.apply))
            QTimer.singleShot(150, self._refresh_engine)

        def _refresh_engine(self):
            for key in self.ENGINE_KEYS:
                s = REGISTRY.get(key)
                row, ctrl = self._erows.get(key, (None, None))
                if s is None or ctrl is None or s.backend is None:
                    continue
                try:
                    val = s.backend.read()
                except Exception:
                    val = None
                _apply_value(s, ctrl, val)

        def refresh(self):
            # Called on navigation (focus_default): read engine values and the
            # (fast) About grid.  No slow enumeration on the startup path.
            self._refresh_engine()
            self._refresh_about()

        def _refresh_about(self):
            while self.grid.count():
                it = self.grid.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()
            info = system_info()
            rows = [
                ("Distribution", info["distro"]),
                ("Kernel", info["kernel"]),
                ("Architecture", info["arch"]),
                ("Hostname", info["hostname"]),
                ("Desktop", info["desktop"] + (
                    "  (%s)" % info["session"] if info["session"] else "")),
                ("Processor", "%s  (%d cores)" % (info["cpu"], info["cores"])),
                ("Memory", info["ram"]),
                ("Uptime", info["uptime"] or "—"),
            ]
            for r, (k, val) in enumerate(rows):
                kl = QLabel(k)
                kl.setObjectName("muted")
                vl = QLabel(str(val))
                vl.setObjectName("rowname")
                vl.setWordWrap(True)
                self.grid.addWidget(kl, r, 0, Qt.AlignmentFlag.AlignTop)
                self.grid.addWidget(vl, r, 1)
            self.grid.setColumnStretch(1, 1)

