# ---- Wi-Fi scan / connect (nmcli) ----
def wifi_scan():
    """[{ssid, signal, security, active, known}] from `nmcli -t`."""
    if not have("nmcli"):
        return []
    _run(["nmcli", "device", "wifi", "rescan"], timeout=8)
    r = _run(["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL,SECURITY",
              "device", "wifi", "list"], timeout=12)
    known = set()
    rk = _run(["nmcli", "-t", "-f", "NAME", "connection", "show"])
    for ln in rk.stdout.splitlines():
        if ln.strip():
            known.add(ln.strip())
    nets, seen = [], set()
    for ln in r.stdout.splitlines():
        # nmcli -t escapes ':' inside fields as '\:' — split carefully.
        parts = ln.replace("\\:", "\0").split(":")
        parts = [p.replace("\0", ":") for p in parts]
        if len(parts) < 4:
            continue
        active, ssid, signal, sec = parts[0], parts[1], parts[2], parts[3]
        if not ssid or ssid in seen:
            continue
        seen.add(ssid)
        nets.append({
            "ssid": ssid, "signal": signal, "security": sec or "Open",
            "active": active == "yes", "known": ssid in known,
        })
    nets.sort(key=lambda n: (not n["active"], -int(n["signal"] or 0)))
    return nets


def wifi_connect(ssid, password=None):
    if not have("nmcli"):
        return False, "nmcli not installed"
    cmd = ["nmcli", "device", "wifi", "connect", ssid]
    if password:
        cmd += ["password", password]
    r = _run(cmd, timeout=45)
    return r.returncode == 0, (r.stderr or r.stdout).strip()


def wifi_disconnect(ssid):
    r = _run(["nmcli", "connection", "down", ssid], timeout=20)
    return r.returncode == 0, (r.stderr or r.stdout).strip()


# ---- Bluetooth devices (bluetoothctl) ----
def bt_devices():
    """[{mac, name, connected}] of known/paired devices."""
    if not have("bluetoothctl"):
        return []
    out = []
    r = _run(["bluetoothctl", "devices"], timeout=8)
    for ln in r.stdout.splitlines():
        parts = ln.split(" ", 2)
        if len(parts) >= 3 and parts[0] == "Device":
            mac, name = parts[1], parts[2]
            ci = _run(["bluetoothctl", "info", mac], timeout=6)
            conn = "Connected: yes" in ci.stdout
            out.append({"mac": mac, "name": name, "connected": conn})
    return out


def bt_connect(mac, connect=True):
    sub = "connect" if connect else "disconnect"
    r = _run(["bluetoothctl", sub, mac], timeout=20)
    return r.returncode == 0, (r.stderr or r.stdout).strip()


# ---- Sound (pactl preferred, wpctl fallback) ----
def _snd_tool():
    if have("pactl"):
        return "pactl"
    if have("wpctl"):
        return "wpctl"
    return None


def sound_available():
    return _snd_tool() is not None


def _pactl_list(kind):
    """kind = 'sinks' or 'sources' -> [{name, desc, default}]."""
    items = []
    default = ""
    rd = _run(["pactl", "get-default-" + kind[:-1]])
    default = rd.stdout.strip()
    r = _run(["pactl", "-f", "json", "list", kind])
    try:
        import json as _json
        data = _json.loads(r.stdout) if r.stdout.strip() else []
        for d in data:
            nm = d.get("name", "")
            desc = d.get("description") or d.get("properties", {}).get(
                "device.description") or nm
            items.append({"name": nm, "desc": desc, "default": nm == default})
    except Exception:
        # textual fallback
        name = desc = None
        for ln in r.stdout.splitlines():
            s = ln.strip()
            if s.startswith("Name:"):
                name = s.split(":", 1)[1].strip()
            elif s.startswith("Description:"):
                desc = s.split(":", 1)[1].strip()
                if name:
                    items.append({"name": name, "desc": desc or name,
                                  "default": name == default})
                    name = desc = None
    return items


def sound_devices(kind):
    """kind = 'sinks' (output) or 'sources' (input)."""
    if have("pactl"):
        return _pactl_list(kind)
    return []


def sound_set_default(kind, name):
    if have("pactl"):
        _run(["pactl", "set-default-" + kind[:-1], name])
        return True
    return False


def sound_volume(kind):
    """Current default volume 0-100 (best-effort)."""
    if have("pactl"):
        tgt = "@DEFAULT_SINK@" if kind == "sinks" else "@DEFAULT_SOURCE@"
        r = _run(["pactl", "get-" + kind[:-1] + "-volume", tgt])
        import re as _re
        m = _re.search(r"(\d+)%", r.stdout)
        if m:
            return int(m.group(1))
    if have("wpctl"):
        tgt = "@DEFAULT_AUDIO_SINK@" if kind == "sinks" else "@DEFAULT_AUDIO_SOURCE@"
        r = _run(["wpctl", "get-volume", tgt])
        import re as _re
        m = _re.search(r"([\d.]+)", r.stdout)
        if m:
