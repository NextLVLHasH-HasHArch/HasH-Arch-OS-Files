            v.addWidget(_color_tile(icon, CAT_COLORS.get(key, ACCENT)), 0,
                        Qt.AlignmentFlag.AlignVCenter)
            tcol = QVBoxLayout()
            tcol.setSpacing(2)
            tcol.addStretch(1)
            nm = QLabel(label)
            nm.setObjectName("cardname")
            tcol.addWidget(nm)
            desc = "%d item%s" % (navi, "" if navi == 1 else "s")
            sm = QLabel(desc)
            sm.setObjectName("cardsumm")
            tcol.addWidget(sm)
            tcol.addStretch(1)
            v.addLayout(tcol, 1)
            chev = QLabel("›")
            chev.setObjectName("catchev")
            v.addWidget(chev, 0, Qt.AlignmentFlag.AlignVCenter)
            card.setStyleSheet(card_qss())
            _shadow(card)

            def _enter(_e, c=card):
                c.setProperty("hover", True)
                c.setStyleSheet(card_qss())

            def _leave(_e, c=card):
                c.setProperty("hover", False)
                c.setStyleSheet(card_qss())
            card.enterEvent = _enter
            card.leaveEvent = _leave
            card.mouseReleaseEvent = lambda e, k=key: (
                self.win.go(k) if e.button() == Qt.MouseButton.LeftButton else None)
            return card

        def focus_default(self):
            self.search.setFocus()
            for c in self._toggle_cards:
                c.refresh()

        def _on_search(self, text):
            t = text.lower().strip()
            # clear previous result cards
            while self.resGrid.count():
                w = self.resGrid.takeAt(0).widget()
                if w:
                    w.deleteLater()
            if not t:
                self.resTitle.hide()
                self.resWrap.hide()
                self.catTitle.show()
                self.catWrap.show()
                if self._toggle_cards:
                    self.togTitle.show()
                    self.togRow.show()
                return
            # fuzzy: every search token must appear somewhere in the entry text.
            # The index spans both the SECTIONS entries and the declarative
            # REGISTRY (engine settings), so a global search jumps to any setting.
            toks = t.split()
            matches = []
            for key, e in all_entries():
                hay = (e["name"] + " " + e.get("comment", "") + " "
                       + e["kind"] + " " + str(e.get("target", ""))).lower()
                if all(tok in hay for tok in toks):
                    matches.append((key, e))
            for s in registry_entries():
                hay = (s.name + " " + s.comment + " " + s.key).lower()
                if all(tok in hay for tok in toks):
                    matches.append(("system", {
                        "name": s.name, "icon": s.icon or "configure",
                        "comment": s.comment, "kind": "page",
                        "target": "system"}))
            self.catTitle.hide()
            self.catWrap.hide()
            self.togTitle.hide()
            self.togRow.hide()
            self.resTitle.setText("Results (%d)" % len(matches))
            self.resTitle.show()
            self.resWrap.show()
            if not matches:
                lbl = QLabel("No settings match “%s”." % text)
                lbl.setObjectName("cardsumm")
                self.resGrid.addWidget(lbl, 0, 0)
                return
            col = r = 0
            for key, e in matches:
                self.resGrid.addWidget(EntryCard(self.win, e, key), r, col)
                col += 1
                if col >= 2:
                    col = 0
                    r += 1

