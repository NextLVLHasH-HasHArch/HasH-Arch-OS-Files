            self.add_cli_card(v)
            import glob
            themes = sorted({os.path.basename(os.path.dirname(p))
                             for p in glob.glob("/usr/share/sddm/themes/*/metadata.desktop")})
            self.themeBox.addItems(themes or ["hash"])
            try:
                import pwd
                users = sorted(u.pw_name for u in pwd.getpwall()
                               if 1000 <= u.pw_uid < 65000)
            except Exception:
                users = [os.environ.get("USER", "")]
            self.userBox.addItems(users)

        def _kr(self, group, key):
            try:
                return subprocess.run(["kreadconfig6", "--file", self.CONF, "--group",
                                       group, "--key", key], capture_output=True,
                                      text=True, timeout=5).stdout.strip()
            except Exception:
                return ""

        def refresh(self):
            cur = self._kr("Theme", "Current")
            if cur:
                i = self.themeBox.findText(cur)
                if i >= 0:
                    self.themeBox.setCurrentIndex(i)
            au = self._kr("Autologin", "User")
            self.autoTog.blockSignals(True)
            self.autoTog.setChecked(bool(au))
            self.autoTog.blockSignals(False)
            if au:
                i = self.userBox.findText(au)
                if i >= 0:
                    self.userBox.setCurrentIndex(i)
            nl = self._kr("General", "Numlock") or "none"
            i = self.numBox.findText(nl)
            if i >= 0:
                self.numBox.setCurrentIndex(i)

        def _w(self, group, key, val):
            self.run_priv(["kwriteconfig6", "--file", self.CONF, "--group",
                           group, "--key", key, val])

        def _apply_theme(self):
            t = self.themeBox.currentText()
            if t:
                self._w("Theme", "Current", t)

        def _apply_auto(self, *_a):
            on = self.autoTog.isChecked()
            self._w("Autologin", "User", self.userBox.currentText() if on else "")
            QTimer.singleShot(400, self.refresh)

        def _apply_num(self):
            self._w("General", "Numlock", self.numBox.currentText())

