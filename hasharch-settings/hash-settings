    class Settings(QWidget):
        """The Windows-11-style shell: a top bar (brand + global search), a left
        category rail with an account header on top, and a main pane that is a
        NavStack (Breadcrumb + Back + pushed pages).  Selecting a category resets
        the stack to that category's root page; drill-in rows push sub-pages."""
        def __init__(self):
            super().__init__(None, Qt.WindowType.FramelessWindowHint)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
            self.setWindowTitle("HasH Settings")
            scr = (QApplication.screenAt(QCursor.pos())
                   or QApplication.primaryScreen()).geometry()
            W = max(900, int(scr.height() * 0.92))
            H = max(580, int(scr.height() * 0.72))
            self.resize(W, H)
            self.move(scr.center().x() - W // 2, scr.center().y() - H // 2)

            root = QVBoxLayout(self)
            root.setContentsMargins(1, 1, 1, 1)
            root.setSpacing(0)
            root.addWidget(TitleBar(self))

            # top bar: brand + global search
            topbar = QHBoxLayout()
            topbar.setContentsMargins(18, 0, 18, 6)
            topbar.setSpacing(12)
            self.globalSearch = QLineEdit()
            self.globalSearch.setObjectName("globalsearch")
            self.globalSearch.setPlaceholderText("⌕  Search settings…")
            self.globalSearch.setClearButtonEnabled(True)
            self.globalSearch.textChanged.connect(self._global_search)
            self.globalSearch.setMaximumWidth(420)
            topbar.addStretch(1)
            topbar.addWidget(self.globalSearch, 0)
            root.addLayout(topbar)

            body = QHBoxLayout()
            body.setContentsMargins(14, 4, 14, 14)
            body.setSpacing(14)

            # ── left rail: account header + category list + exit ──
            side = QVBoxLayout()
            side.setSpacing(6)
            side.addWidget(AccountHeader(self))
            self.nav = {}
            self.pages = {}            # section key -> page widget (built once)
            self.labels = {}           # section key -> rail label
            self.stack = NavStack()
            for key, label, icon, page_key, entries in SECTIONS:
                b = QPushButton("  " + label)
                b.setCheckable(True)
                b.setObjectName("nav")
                b.setIcon(QIcon.fromTheme(icon))
                b.setIconSize(QSize(20, 20))
                b.setCursor(Qt.CursorShape.PointingHandCursor)
                b.clicked.connect(lambda _, k=key: self.go(k))
                side.addWidget(b)
                self.nav[key] = b
                self.labels[key] = label
                if key == "overview":
                    pg = OverviewPage(self)
                else:
                    builder = PAGE_BUILDERS.get(page_key)
                    if builder is None:
                        # SECTIONS row points nowhere yet → harmless stub so the
                        # category still opens (no crash).
                        pg = SchemaPage(self, label, [],
                                        "Coming soon.",
                                        note="This category is part of a later "
                                             "phase of the rebuild.")
                    else:
                        pg = builder(self)
                self.pages[key] = pg
            side.addStretch(1)
            self.statusLbl = QLabel("")
            self.statusLbl.setObjectName("brand")
            side.addWidget(self.statusLbl)
            exitb = QPushButton("  ⏻  Exit")
            exitb.setObjectName("exitbtn")
            exitb.setIcon(QIcon.fromTheme("application-exit"))
            exitb.setIconSize(QSize(18, 18))
            exitb.setCursor(Qt.CursorShape.PointingHandCursor)
            exitb.clicked.connect(self.close)
            side.addWidget(exitb)
            brand = QLabel("HasH-Arch")
            brand.setObjectName("brand")
            side.addWidget(brand)
            sw = QWidget()
            sw.setObjectName("sidebar")
            sw.setLayout(side)
            sw.setFixedWidth(196)
            body.addWidget(sw)
            body.addWidget(self.stack, 1)
            root.addLayout(body, 1)
            self.setStyleSheet(app_qss())

            QShortcut(QKeySequence(Qt.Key.Key_Escape), self,
                      activated=self.on_escape)

            self.go(start_key if start_key in self.nav else "overview")

        def go(self, key):
            """Select a category: reset the nav stack to its root page."""
            pg = self.pages.get(key)
            if pg is None:
                return
            for k, b in self.nav.items():
                b.setChecked(k == key)
            self.stack.reset(pg, self.labels.get(key, key))

        def go_back(self):
            self.stack.back()

        def spawn(self, argv):
            """Launch an external process detached (the few standalone HasH
            tools — Software Center, Uninstaller GUI — that are their own apps)."""
            if not argv:
                self.status("Unavailable")
                return
            QProcess.startDetached(argv[0], argv[1:])

        def status(self, text):
            if hasattr(self, "statusLbl"):
                self.statusLbl.setText(text or "")

        def _global_search(self, text):
            """Forward the top-bar query into the Overview page's search (which
            indexes both SECTIONS entries and the REGISTRY), jumping there.

            We keep the caret in the top-bar box: go() schedules the Overview's
            focus_default (which would grab its own search) via singleShot(0);
            scheduling our refocus afterwards (FIFO) wins so typing isn't
            interrupted."""
            ov = self.pages.get("overview")
            if ov is None:
                return
            if self.stack.current() is not ov:
                self.go("overview")
            ov.search.blockSignals(True)
            ov.search.setText(text)
            ov.search.blockSignals(False)
            ov._on_search(text)
            QTimer.singleShot(0, self.globalSearch.setFocus)

        def on_escape(self):
            fw = QApplication.focusWidget()
            if isinstance(fw, QLineEdit) and fw.text():
                fw.clear()
                return
            if self.stack.can_back():
                self.stack.back()
            else:
                self.close()

        def paintEvent(self, _e):
            p = QPainter(self)
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            path = QPainterPath()
            path.addRoundedRect(0.5, 0.5, self.width() - 1,
                                self.height() - 1, 20, 20)
            p.fillPath(path, QColor(0x12, 0x14, 0x1a))
            p.setPen(QColor(255, 255, 255, 30))
            p.drawPath(path)

    app = QApplication(sys.argv[:1])
    app.setApplicationName("HasH Settings")
    app.setDesktopFileName("hash-settings")
    app.setWindowIcon(QIcon.fromTheme("hash-settings"))
    app.setApplicationDisplayName("HasH Settings")
    w = Settings()
    w.show()

    if shot:
        def _grab():
            w.grab().save(shot)
            os._exit(0)
        QTimer.singleShot(2500, _grab)
    return app.exec()


def main():
    a = sys.argv[1:]
    # ── headless CLI (no Qt): drive the declarative REGISTRY directly so AI
    #    agents / scripts can read & write settings without a display ──
    if a and a[0] == "get":
        if len(a) < 2:
            sys.stderr.write("usage: hash-settings get <key>\n")
            return 2
        return cli_get(a[1])
    if a and a[0] == "set":
        if len(a) < 3:
            sys.stderr.write("usage: hash-settings set <key> <value>\n")
            return 2
        return cli_set(a[1], a[2])
    if a and a[0] in ("list", "--list-settings"):
        return cli_list()
    start = "overview"
    if "--page" in a:
        i = a.index("--page")
        if i + 1 < len(a):
            start = a[i + 1]
    shot = None
    if "--shot" in a:
        i = a.index("--shot")
        shot = a[i + 1] if i + 1 < len(a) else "/tmp/hash-settings.png"
    return gui(start, shot)


if __name__ == "__main__":
    sys.exit(main())
