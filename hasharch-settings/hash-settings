        def refresh(self):
            installed = onct = 0
            for bin_, _n, fl in self.BROWSERS:
                if not have(bin_):
                    continue
                installed += 1
                p = os.path.expanduser("~/.config/" + fl)
                try:
                    if os.path.exists(p) and "--password-store=" in open(p).read():
                        onct += 1
                except Exception:
                    pass
            self.walletTog.blockSignals(True)
            self.walletTog.setChecked(installed > 0 and onct == installed)
            self.walletTog.setEnabled(installed > 0)
            self.walletTog.blockSignals(False)
            kw = "running" if subprocess.run(["pgrep", "-x", "kwalletd6"],
                                             capture_output=True).returncode == 0 \
                else "not running"
            pam = "manual unlock"
            try:
                if "pam_kwallet" in open("/etc/pam.d/sddm").read():
                    pam = "auto-unlocked by your login (PAM)"
            except Exception:
                pass
            self.kwStatus.setText("System wallet (KWallet): %s · %s · %d of %d "
                                  "Chromium browsers using it." % (kw, pam, onct, installed))

        def _set_wallet(self, on):
            for bin_, _n, fl in self.BROWSERS:
                if not have(bin_):
                    continue
                p = os.path.expanduser("~/.config/" + fl)
                lines = []
                if os.path.exists(p):
                    lines = [l for l in open(p).read().splitlines()
                             if not l.startswith("--password-store=")]
                if on:
                    lines.append("--password-store=kwallet6")
                os.makedirs(os.path.dirname(p), exist_ok=True)
                with open(p, "w") as fh:
                    fh.write("\n".join(lines) + "\n")
            self.cli_echo("# browser password-store -> %s (restart the browser to apply)"
                          % ("kwallet6 — system wallet" if on else "default"))
            self.win.status("Browser passwords %s the system wallet."
                            % ("now use" if on else "no longer use"))
            QTimer.singleShot(200, self.refresh)

        def _setup_identity(self, label, pkg):
            # Azure / Entra ID is fully wired: collect the tenant and run the
            # helper's `azure setup` (installs himmelblau, writes the tenant conf,
            # wires pam_himmelblau on login+lock — never the TTY — keeping the
            # password fallback). The other methods stay informational for now.
            if pkg == "himmelblau":
                return self._setup_azure(label)
            QMessageBox.information(
                self.win, "Set up " + label,
                "%s\n\nThis is an advanced sign-in method. It installs the PAM "
                "module '%s' and is set up to ALWAYS keep your password as a "
                "fallback, so you can never be locked out.\n\nInstall it with:\n"
                "    sudo pacman -S %s   (or build from the AUR)\n\n"
                "Phone-unlock requires the matching app on your phone "
                "(Microsoft Authenticator / Duo Mobile)." % (label, pkg, pkg))

        def _setup_azure(self, label):
            """Collect the Entra ID tenant and run `hash-security-helper azure
            setup` (elevated). Domain is required; App ID / allowed groups are
            optional. Output streams to the CLI console below."""
            from PyQt6.QtWidgets import (QDialog, QFormLayout, QDialogButtonBox,
                                         QLineEdit, QLabel)
            helper = tool_path("hash-security-helper")
            if not helper:
                QMessageBox.warning(self.win, "Set up " + label,
                                    "hash-security-helper is not installed.")
                return
            dlg = QDialog(self.win)
            dlg.setWindowTitle("Sign in with Microsoft (Entra ID / Azure AD)")
            dlg.setStyleSheet(app_qss())
            form = QFormLayout(dlg)
            intro = QLabel("Enter your organisation's primary domain. Your password "
                           "always stays as a fallback and the TTY console is never "
                           "touched, so you can't be locked out. First sign-in "
                           "registers this device with your tenant.")
            intro.setWordWrap(True)
            form.addRow(intro)
            domain = QLineEdit(); domain.setPlaceholderText("contoso.onmicrosoft.com")
            appid = QLineEdit(); appid.setPlaceholderText("optional — application (client) ID (GUID)")
            groups = QLineEdit(); groups.setPlaceholderText("optional — allowed group Object IDs, comma-separated")
            form.addRow("Tenant domain", domain)
            form.addRow("App ID", appid)
            form.addRow("Allowed groups", groups)
            bb = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok
                                  | QDialogButtonBox.StandardButton.Cancel)
            bb.accepted.connect(dlg.accept)
            bb.rejected.connect(dlg.reject)
            form.addRow(bb)
            if dlg.exec() != QDialog.DialogCode.Accepted:
                return
            dom = domain.text().strip()
            if not dom:
                self.win.status("Entra ID setup cancelled — a tenant domain is required.")
                return
            argv = [helper, "azure", "setup", dom]
            if appid.text().strip():
                argv += ["--app-id", appid.text().strip()]
            if groups.text().strip():
                argv += ["--allow-groups", groups.text().strip().replace(" ", "")]
            self.cli_echo("# Entra ID setup for %s — installs himmelblau, writes the "
                          "tenant, wires sign-in on login+lock (password kept)." % dom)
            self.run_priv(argv, timeout=900)
            self.win.status("Entra ID setup ran for %s — sign in as you@%s and "
                            "test in a new session before relying on it." % (dom, dom))

