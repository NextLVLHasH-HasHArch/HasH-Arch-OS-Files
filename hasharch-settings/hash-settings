        def _do_bt(self, mac, connect, btn=None):
            # bt_connect blocks up to ~20s on the UI thread; disable + show
            # working state and paint it before the blocking call.
            if btn is not None:
                btn.setEnabled(False)
                btn.setText("Working…")
            self.win.status("Bluetooth: working…")
            QApplication.processEvents()
            ok, msg = bt_connect(mac, connect)
            self.win.status("Done." if ok else ("Failed: " + msg[:60]))
            QTimer.singleShot(900, self.refresh)

