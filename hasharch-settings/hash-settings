                    lambda _=False, prog=p: self._uninstall(prog))
                icon = {"pacman": "package-x-generic", "flatpak": "flatpak",
                        "appimage": "application-x-executable"}.get(
                            src, "applications-other")
                self.listBox.addWidget(self._row(icon, p["name"], sub,
                                                 [pill, btn]))
                shown += 1
            if not shown:
                self.listBox.addWidget(self._note("No programs match."))

        def _uninstall(self, prog):
            # Removal involves a review + pkexec for system paths; that flow
            # lives in the full uninstaller GUI. Open it focused on this program.
            if QMessageBox.question(
                    self.win, "Uninstall %s" % prog["name"],
                    "Map and remove “%s”?\n\nThis opens the HasH Uninstaller, "
                    "which reviews every file and asks again before deleting "
                    "anything (system paths via a graphical password prompt)."
                    % prog["name"]) != QMessageBox.StandardButton.Yes:
                return
            self._open_full()

        def _autostart_entries(self):
            import glob, configparser
            udir = os.path.expanduser("~/.config/autostart")
            out, seen = [], set()
            for d in (udir, "/etc/xdg/autostart"):
                for f in sorted(glob.glob(d + "/*.desktop")):
                    base = os.path.basename(f)
                    if base in seen:
                        continue
                    seen.add(base)
                    name, icon, hidden, nodisplay = (base[:-8],
                                                     "application-x-executable",
                                                     False, False)
                    try:
                        cp = configparser.ConfigParser(interpolation=None, strict=False)
                        cp.read(f)
                        if cp.has_section("Desktop Entry"):
                            de = cp["Desktop Entry"]
                            name = de.get("Name", name)
                            icon = de.get("Icon", icon)
                            hidden = de.get("Hidden", "false").lower() == "true"
                            nodisplay = de.get("NoDisplay", "false").lower() == "true"
                    except Exception:
                        pass
                    if nodisplay:
                        continue
                    out.append({"base": base, "name": name, "icon": icon,
                                "system": d != udir, "enabled": not hidden})
            return out

        def _load_startup(self):
            while self.startBox.count():
                it = self.startBox.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()
            entries = self._autostart_entries()
            if not entries:
                self.startBox.addWidget(self._note("No startup apps."))
                return
            for e in entries:
                tog = Toggle()
                tog.setChecked(e["enabled"])
                tog.toggled.connect(lambda on, b=e["base"]: self._set_startup(b, on))
                self.startBox.addWidget(self._row(
                    e["icon"], e["name"], "system" if e["system"] else "you", [tog]))

        def _set_startup(self, base, on):
            udir = os.path.expanduser("~/.config/autostart")
            os.makedirs(udir, exist_ok=True)
            target = os.path.join(udir, base)
            if on:
                if not os.path.exists(target):
                    src = "/etc/xdg/autostart/" + base
                    if os.path.exists(src):
                        import shutil as _sh
                        _sh.copy2(src, target)
                self._set_hidden(target, False)
            else:
                if not os.path.exists(target):
                    with open(target, "w") as fh:
                        fh.write("[Desktop Entry]\nType=Application\nHidden=true\n")
                else:
                    self._set_hidden(target, True)

        @staticmethod
        def _set_hidden(path, hidden):
            if not os.path.exists(path):
                return
            subprocess.run(["kwriteconfig6", "--file", path, "--group",
                            "Desktop Entry", "--key", "Hidden",
                            "true" if hidden else "false"])

