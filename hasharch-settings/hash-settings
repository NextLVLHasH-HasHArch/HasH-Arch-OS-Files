    def _user_face_pixmap(size):
        """A round avatar for the rail header: the user's ~/.face if present,
        else a themed user icon, else a painted ACCENT disc with the initial."""
        from PyQt6.QtGui import QPixmap, QBrush
        import getpass
        # Prefer the REAL account image set in KDE/AccountsService, then ~/.face*.
        candidates = ["/var/lib/AccountsService/icons/" + getpass.getuser(),
                      os.path.join(HOME, ".face.icon"),
                      os.path.join(HOME, ".face")]
        for face in candidates:
            if not os.path.exists(face):
                continue
            src = QPixmap(face)
            if src.isNull():
                continue
            src = src.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                             Qt.TransformationMode.SmoothTransformation)
            out = QPixmap(size, size)
            out.fill(Qt.GlobalColor.transparent)
            p = QPainter(out)
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            path = QPainterPath()
            path.addEllipse(0, 0, size, size)
            p.setClipPath(path)
            p.drawPixmap(0, 0, src)
            p.end()
            return out
        ic = QIcon.fromTheme("user-identity")
        if ic.isNull():
            ic = QIcon.fromTheme("system-users")
        if not ic.isNull():
            px = ic.pixmap(QSize(size, size))
            if not px.isNull():
                return px
        # painted fallback disc with the user's initial
        out = QPixmap(size, size)
        out.fill(Qt.GlobalColor.transparent)
        p = QPainter(out)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QBrush(QColor(ACCENT)))
        p.drawEllipse(0, 0, size, size)
        try:
            initial = (getpass.getuser() or "?")[0].upper()
        except Exception:
            initial = "?"
        p.setPen(QColor("#06222a"))
        f = p.font()
        f.setBold(True)
        f.setPixelSize(int(size * 0.5))
        p.setFont(f)
        p.drawText(out.rect(), Qt.AlignmentFlag.AlignCenter, initial)
        p.end()
        return out

