    class Breadcrumb(QWidget):
        """A clickable path (e.g. System › Display › Advanced).  Each crumb is a
        flat button; clicking crumb i tells the NavStack to pop back to depth i.
        Driven by NavStack via set_path([(title, depth_index), …])."""
        def __init__(self, on_crumb):
            super().__init__()
            self._on_crumb = on_crumb
            self._h = QHBoxLayout(self)
            self._h.setContentsMargins(2, 0, 2, 0)
            self._h.setSpacing(4)
            self._h.addStretch(1)

        def set_path(self, titles):
            while self._h.count():
                it = self._h.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()
            for i, title in enumerate(titles):
                last = i == len(titles) - 1
                b = QPushButton(title)
                b.setObjectName("crumblast" if last else "crumb")
                b.setFlat(True)
                b.setCursor(Qt.CursorShape.PointingHandCursor)
                b.clicked.connect(lambda _=False, d=i: self._on_crumb(d))
                self._h.addWidget(b)
                if not last:
                    sep = QLabel("›")
                    sep.setObjectName("crumbsep")
                    self._h.addWidget(sep)
            self._h.addStretch(1)

    class NavStack(QWidget):
        """The main pane: a Back button + Breadcrumb on top of a QStackedWidget
        that pages push onto / pop off of.  `push(widget, title)` adds a level;
        `pop()`/`back()` removes the top one; `reset(widget, title)` clears the
        stack to a single root page (used when a category is selected in the
        rail).  Calls `focus_default()` on a page when it becomes current."""
        def __init__(self):
            super().__init__()
            v = QVBoxLayout(self)
            v.setContentsMargins(0, 0, 0, 0)
            v.setSpacing(10)
            bar = QHBoxLayout()
            bar.setSpacing(10)
            self.backBtn = QPushButton("←  Back")
            self.backBtn.setObjectName("backbtn")
            self.backBtn.setCursor(Qt.CursorShape.PointingHandCursor)
            self.backBtn.clicked.connect(self.back)
            bar.addWidget(self.backBtn, 0)
            self.crumb = Breadcrumb(self._crumb_to)
            bar.addWidget(self.crumb, 1)
            v.addLayout(bar)
            self.stack = QStackedWidget()
            v.addWidget(self.stack, 1)
            self._levels = []      # list of (widget, title)

        def _sync(self):
            self.crumb.set_path([t for _w, t in self._levels])
            self.backBtn.setEnabled(len(self._levels) > 1)
            if self._levels:
                w = self._levels[-1][0]
                self.stack.setCurrentWidget(w)
                if hasattr(w, "focus_default"):
                    QTimer.singleShot(0, w.focus_default)

        def _ensure(self, widget):
            if self.stack.indexOf(widget) < 0:
                self.stack.addWidget(widget)
            # the NavStack bar owns Back/Breadcrumb — hide a page's own header
            # Back so there's never a duplicate control.
            if hasattr(widget, "header") and hasattr(widget.header, "back"):
                widget.header.back.hide()

        def reset(self, widget, title):
            # tear down deeper pushed levels, keep the new root
            for w, _t in self._levels:
                if hasattr(w, "leaving"):
                    try:
                        w.leaving()
                    except Exception:
                        pass
            self._levels = []
            self._ensure(widget)
            self._levels.append((widget, title))
            self._sync()

        def push(self, widget, title):
            self._ensure(widget)
            self._levels.append((widget, title))
            self._sync()

        def back(self):
            if len(self._levels) <= 1:
                return False
            w, _t = self._levels.pop()
            if hasattr(w, "leaving"):
                try:
                    w.leaving()
                except Exception:
                    pass
            self._sync()
            return True

        def _crumb_to(self, depth):
            while len(self._levels) > depth + 1:
                self.back()

        def can_back(self):
            return len(self._levels) > 1

        def current(self):
            return self._levels[-1][0] if self._levels else None

    # ════════════════════ declarative-engine page (SchemaPage) ═══════════════
    def _make_control(setting, on_change):
        """Build the right-aligned inline control widget for a Setting from its
        `control` kind, wiring `on_change(value)` to user edits.  Returns the
        widget (or None for drill/action rows, handled by the caller)."""
        kind = setting.control
        if kind == "toggle":
            t = Toggle(False)
            t.toggled.connect(lambda v: on_change(bool(v)))
            return t
        if kind == "combo":
            cb = QComboBox()
            cb.setMinimumWidth(180)
            for item in setting.kw.get("options", []):
                if isinstance(item, (list, tuple)):
                    cb.addItem(str(item[1]), item[0])
                else:
                    cb.addItem(str(item), item)
            cb.activated.connect(
                lambda _i: on_change(cb.currentData()
                                     if cb.currentData() is not None
                                     else cb.currentText()))
            return cb
        if kind == "slider":
            # `scale` lets the human-facing slider position differ from the
            # stored value: stored = position / scale (e.g. an animation factor
            # 0.00–3.00 shown as 0–300 with scale=100).  suffix is cosmetic.
            scale = float(setting.kw.get("scale", 1) or 1)
            suffix = setting.kw.get("suffix", "")
            box = QWidget()
            hb = QHBoxLayout(box)
            hb.setContentsMargins(0, 0, 0, 0)
            hb.setSpacing(8)
            s = QSlider(Qt.Orientation.Horizontal)
            s.setMinimumWidth(170)
            s.setRange(int(setting.kw.get("min", 0)),
                       int(setting.kw.get("max", 100)))
            lbl = QLabel("")
            lbl.setObjectName("muted")
            s.valueChanged.connect(lambda x: lbl.setText(str(x) + suffix))
            s.sliderReleased.connect(
                lambda: on_change(s.value() / scale if scale != 1
                                  else s.value()))
            hb.addWidget(s, 1)
            hb.addWidget(lbl, 0)
            box._slider = s
            box._lbl = lbl
            box._scale = scale
            box._suffix = suffix
            return box
        if kind == "text":
            e = QLineEdit()
            e.setMinimumWidth(200)
            e.editingFinished.connect(lambda: on_change(e.text()))
            return e
        if kind == "action":
            b = QPushButton(setting.kw.get("button", "Run"))
            b.setObjectName("primary")
            b.setCursor(Qt.CursorShape.PointingHandCursor)
            b.clicked.connect(lambda: on_change(True))
            return b
        return None

    def _apply_value(setting, ctrl, value):
        """Push a freshly-read backend `value` into an inline control built by
        _make_control, with signals blocked so it doesn't echo a spurious write.
        Shared by SchemaPage and any native page hosting engine rows."""
        if ctrl is None:
            return
        ctrl.blockSignals(True)
        try:
            if setting.control == "toggle":
                ctrl.setChecked(_truthy(value))
            elif setting.control == "combo":
                idx = ctrl.findData(value)
                if idx < 0:
                    idx = ctrl.findText("" if value is None else str(value))
                if idx >= 0:
                    ctrl.setCurrentIndex(idx)
            elif setting.control == "slider":
                scale = getattr(ctrl, "_scale", 1) or 1
                try:
                    iv = int(round(float(value) * scale))
                except (TypeError, ValueError):
                    iv = ctrl._slider.minimum()
                iv = max(ctrl._slider.minimum(),
                         min(ctrl._slider.maximum(), iv))
                ctrl._slider.setValue(iv)
                ctrl._lbl.setText(str(iv) + getattr(ctrl, "_suffix", ""))
            elif setting.control == "text":
                ctrl.setText("" if value is None else str(value))
        finally:
            ctrl.blockSignals(False)

    class SchemaPage(CliPageMixin, BasePage):
        """Renders a list of declarative `Setting`s into Win11Rows.  Inline
        controls read their current value in refresh() and write it back through
        the Setting's backend on user change, then run the named `apply` hook.
        A drill Setting becomes a chevron row that pushes a child SchemaPage.
        The exact shell command for each setting is echoed into the shared
        CliConsole (CliPageMixin) so the surface stays learnable/scriptable.
        Missing tools disable the row and show a muted note."""
        def __init__(self, win, title, settings, subtitle="", note=""):
            self._settings = settings
            self._note = note
            self._rows = {}            # key -> (Win11Row, control)
            super().__init__(win, title, subtitle)

        def build_body(self, v):
            cardf, cc = self.card()
            if self._note:
                n = QLabel(self._note)
                n.setObjectName("muted")
                n.setWordWrap(True)
                cc.addWidget(n)
            if not self._settings:
                ph = QLabel("Coming soon — these settings arrive in a later "
                            "phase of the rebuild.")
                ph.setObjectName("muted")
                ph.setWordWrap(True)
                cc.addWidget(ph)
            for s in self._settings:
                cc.addWidget(self._build_row(s))
            v.addWidget(cardf)
            self.add_cli_card(v, "CLI — what each control runs (learn it)")

        def _build_row(self, s):
            if s.control == "drill":
                row = Win11Row(s.name, s.comment, s.icon,
                               on_click=lambda s=s: self._drill(s))
                self._rows[s.key] = (row, None)
                return row
            avail = s.backend.available() if s.backend else True
            ctrl = _make_control(
                s, lambda val, s=s: self._changed(s, val))
            row = Win11Row(s.name, s.comment, s.icon, control=ctrl,
                           enabled=avail)
            if not avail:
                if ctrl is not None:
                    ctrl.setEnabled(False)
                row.set_sub((s.comment + "  ·  " if s.comment else "")
                            + "tool not available on this system")
            self._rows[s.key] = (row, ctrl)
            return row

        def _drill(self, s):
            child = SchemaPage(self.win, s.name, s.kw.get("detail", []),
                               s.comment)
            self.win.stack.push(child, s.name)

        def refresh(self):
            for s in self._settings:
                row, ctrl = self._rows.get(s.key, (None, None))
                if ctrl is None or s.backend is None:
                    continue
                try:
                    val = s.backend.read()
                except Exception:
                    val = None
                _apply_value(s, ctrl, val)

        def _changed(self, s, value):
            if s.backend is None:
                return
            self.cli_echo("$ " + s.backend.describe_write(value))
            try:
                ok = s.backend.write(value)
            except Exception as e:
                self.cli_echo("# ✗ " + str(e))
                ok = False
            else:
                self.cli_echo("# ✓ ok" if ok else "# ✗ failed")
            run_apply(s.apply)
            if s.apply:
                self.cli_echo("# apply: " + apply_describe(s.apply))
            # re-read so the control reflects what actually stuck
            QTimer.singleShot(150, self.refresh)

    # ─────────────────────────────── Network page ────────────────────────────
    class NetworkPage(BasePage):
