                bt_set(on)
                QTimer.singleShot(900, self.refresh)

        # ── Connections — per-app network monitor ──
        def _refresh_conns(self):
            if not have("ss"):
                self.connCount.setText("ss not found (iproute2 required)")
                return
            argv = (["pkexec", "ss", "-tunaupH"] if self.connAll.isChecked()
                    else ["ss", "-tunaupH"])
            self.win.status("Reading connections…")
            QApplication.processEvents()
            try:
                out = subprocess.run(argv, capture_output=True, text=True,
                                     timeout=25).stdout
            except Exception:
                out = ""
            self.win.status("")
            self._conns = self._parse_ss(out)
            self._render_conns()

        @staticmethod
        def _parse_ss(text):
            import re
            rx = re.compile(r'\("([^"]+)",pid=(\d+)')
            rows = []
            for line in text.splitlines():
                t = line.split()
                if len(t) < 6:
                    continue
                m = rx.search(" ".join(t[6:]))
                rows.append({"proto": t[0], "state": t[1], "local": t[4],
                             "peer": t[5], "app": m.group(1) if m else "—",
                             "pid": m.group(2) if m else ""})
            return rows

        def _render_conns(self):
            self._clear(self.connList)
            term = self.connSearch.text().lower().strip()
            cap, shown, matched = 200, 0, 0
            for c in sorted(self._conns, key=lambda x: (x["app"].lower(), x["proto"])):
                hay = (c["app"] + " " + c["local"] + " " + c["peer"] + " "
                       + c["proto"]).lower()
                if term and term not in hay:
                    continue
                matched += 1
                if shown >= cap:
                    continue
                self.connList.addWidget(self._conn_row(c))
                shown += 1
            if matched == 0:
                self.connList.addWidget(self._note(
                    "No active connections." if not term else "No matches."))
            total = len(self._conns)
            self.connCount.setText(("%d connections" % total) if not term
                                   else ("Showing %d of %d" % (min(matched, cap), total)))

        def _conn_row(self, c):
            est = c["state"] in ("ESTAB", "ESTABLISHED")
            f, h = self._row_frame(est)
            ic = QLabel()
            ic.setPixmap(QIcon.fromTheme("network-server").pixmap(QSize(22, 22)))
            h.addWidget(ic)
            col = QVBoxLayout()
            col.setSpacing(1)
            nm = QLabel(c["app"] + ("  ·  pid %s" % c["pid"] if c["pid"] else ""))
            nm.setObjectName("rowname")
            col.addWidget(nm)
            sub = QLabel("%s   %s → %s" % (c["proto"], c["local"], c["peer"]))
            sub.setObjectName("rowsub")
            col.addWidget(sub)
            h.addLayout(col, 1)
            st = QLabel(c["state"])
            st.setObjectName("pill" if est else "rowsub")
            h.addWidget(st)
            return f

        # ── SSH keys (create + copy public key for RunPod / servers) ──
        def _refresh_ssh(self):
            import glob
            self._clear(self.sshList)
            pubs = sorted(glob.glob(os.path.expanduser("~/.ssh/*.pub")))
            if not pubs:
                self.sshList.addWidget(self._note(
                    "No SSH keys yet — create one to SSH into servers / RunPod pods."))
                return
            for p in pubs:
                self.sshList.addWidget(self._ssh_row(p))

        def _ssh_row(self, path):
            f, h = self._row_frame(False)
            ic = QLabel()
            ic.setPixmap(QIcon.fromTheme("network-server").pixmap(QSize(22, 22)))
            h.addWidget(ic)
            try:
                content = open(path).read().strip()
            except Exception:
                content = ""
            parts = content.split()
            ktype = parts[0] if parts else "key"
            comment = parts[2] if len(parts) > 2 else os.path.basename(path)
            col = QVBoxLayout()
            col.setSpacing(1)
            nm = QLabel(os.path.basename(path)[:-4])
            nm.setObjectName("rowname")
            col.addWidget(nm)
            sub = QLabel("%s  ·  %s" % (ktype, comment))
            sub.setObjectName("rowsub")
            col.addWidget(sub)
            h.addLayout(col, 1)
            cp = QPushButton("Copy public key")
            cp.setObjectName("primary")
            cp.clicked.connect(lambda _=False, c=content: self._copy_pub(c))
            h.addWidget(cp)
            return f

        def _copy_pub(self, content):
            QApplication.clipboard().setText(content)
            self.win.status("Public key copied — paste it into RunPod / your "
                            "server account.")

        def _create_ssh(self):
            import getpass
            from PyQt6.QtWidgets import QDialog, QFormLayout, QDialogButtonBox
            dlg = QDialog(self.win)
            dlg.setWindowTitle("Create SSH key")
            dlg.setStyleSheet(app_qss())
            form = QFormLayout(dlg)
            typ = QComboBox()
            typ.addItems(["ed25519 (recommended)", "rsa (4096-bit)"])
            try:
                host = os.uname().nodename
            except Exception:
                host = "hash"
            fname = QLineEdit("id_ed25519")
            typ.currentIndexChanged.connect(
                lambda i: fname.setText("id_ed25519" if i == 0 else "id_rsa"))
            addEmail = QCheckBox("Add an email address to this key")
            email = QLineEdit()
            email.setPlaceholderText("you@example.com")
            email.setEnabled(False)
            addEmail.toggled.connect(email.setEnabled)
            passp = QLineEdit()
            passp.setEchoMode(QLineEdit.EchoMode.Password)
            passp.setPlaceholderText("optional")
            form.addRow("Type", typ)
            form.addRow("File name", fname)
            form.addRow(addEmail)
            form.addRow("Email", email)
            form.addRow("Passphrase", passp)
            bb = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok
                                  | QDialogButtonBox.StandardButton.Cancel)
            bb.accepted.connect(dlg.accept)
            bb.rejected.connect(dlg.reject)
            form.addRow(bb)
            if dlg.exec() != QDialog.DialogCode.Accepted:
                return
            t = "ed25519" if typ.currentIndex() == 0 else "rsa"
            sshdir = os.path.expanduser("~/.ssh")
            os.makedirs(sshdir, exist_ok=True)
            try:
                os.chmod(sshdir, 0o700)
            except Exception:
                pass
            path = os.path.join(sshdir, (fname.text().strip() or ("id_" + t)))
            argv = ["ssh-keygen", "-t", t]
            if t == "rsa":
                argv += ["-b", "4096"]
            cmt = email.text().strip() if addEmail.isChecked() else ""
            if cmt:
                argv += ["-C", cmt]
            argv += ["-f", path, "-N", passp.text()]
            self.win.status("Generating SSH key…")
            QApplication.processEvents()
            r = subprocess.run(argv, capture_output=True, text=True)
            if r.returncode == 0:
                self.win.status("SSH key created — public key copied to clipboard.")
                self._refresh_ssh()
                try:
                    self._copy_pub(open(path + ".pub").read().strip())
                except Exception:
                    pass
            else:
                self.win.status("ssh-keygen failed: " + (r.stderr or "")[:80])

        # ── Deep packet inspection ──
        def _launch_wireshark(self):
            try:
                subprocess.Popen(["wireshark"], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
                self.dpiNote.setText("Wireshark launched — pick an interface to "
                                     "capture (you're in the 'wireshark' group).")
            except Exception as e:
                self.dpiNote.setText("Could not launch Wireshark: %s" % e)

        def _launch_mitm(self):
            try:
                subprocess.Popen(["mitmweb"], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
                subprocess.Popen(["xdg-open", "http://127.0.0.1:8081"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.dpiNote.setText(
                    "mitmweb started — proxy 127.0.0.1:8080, web UI 127.0.0.1:8081. "
                    "Point your browser/system proxy at it and install the cert "
                    "(visit mitm.it) to decrypt HTTPS.")
            except Exception as e:
                self.dpiNote.setText("Could not launch mitmweb: %s" % e)

