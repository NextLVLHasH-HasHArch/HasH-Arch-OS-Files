# ═══════════════════════════ declarative settings engine ═════════════════════
# Each setting is DATA (a `Setting`) rendered by one generic page (SchemaPage,
# in the GUI).  A setting's value is read/written through a small BACKEND:
#   KConfig  — kreadconfig6 / kwriteconfig6 (most KDE/Plasma config keys)
#   Cmd      — argv read/write (timedatectl, nmcli, …); pkexec when priv=True
#   Info     — read-only display (argv stdout)
# This makes settings cheap to add AND yields a headless `get`/`set` CLI plus a
# searchable index for free.  Backends are plain dataclasses; they NEVER build a
# shell string — argv lists only — so there is no command injection.
def _truthy(v):
    """Interpret a backend value (str/bool/int) as a boolean."""
    if isinstance(v, bool):
        return v
    if v is None:
        return False
    return str(v).strip().lower() in ("1", "true", "yes", "on")


def _bool_to_kde(v):
    """A Python bool -> the lowercase 'true'/'false' KConfig stores."""
    return "true" if _truthy(v) else "false"


@dataclasses.dataclass
class KConfig:
    """A KDE config key, read/written via kreadconfig6/kwriteconfig6.

    `group` may be a single group name or a list of nested groups (each becomes
    a repeated --group …).  `type` is informational ('bool'|'int'|'string') and
    drives light coercion of the value shown/stored."""
    file: str
    group: object
    key: str
    type: str = "string"
    default: object = None

    def _groups(self):
        return self.group if isinstance(self.group, (list, tuple)) \
            else [self.group]

    def _group_args(self):
        out = []
        for g in self._groups():
            out += ["--group", g]
        return out

    def available(self):
        return bool(_kread()) and bool(_kwrite())

    def read_argv(self):
        argv = [_kread() or "kreadconfig6", "--file", self.file]
        argv += self._group_args() + ["--key", self.key]
        if self.default is not None:
            argv += ["--default", _coerce_out(self.type, self.default)]
        return argv

    def write_argv(self, value):
        argv = [_kwrite() or "kwriteconfig6", "--file", self.file]
        if self.type in ("bool", "int"):
            argv += ["--type", self.type if self.type == "bool" else "int"]
        argv += self._group_args() + ["--key", self.key,
                                      _coerce_out(self.type, value)]
        return argv

    def read(self):
        if not _kread():
            return self.default
        r = _run(self.read_argv())
        out = r.stdout.strip()
        if out == "" and self.default is not None:
            return self.default
        return out

    def write(self, value):
        if not _kwrite():
            return False
        r = _run(self.write_argv(value))
        return getattr(r, "returncode", 1) == 0

    def describe_write(self, value):
        return " ".join(_shquote(c) for c in self.write_argv(value))

    def describe_read(self):
        return " ".join(_shquote(c) for c in self.read_argv())


def _coerce_out(typ, value):
    """Render a Python value as the string a backend expects on the CLI."""
    if typ == "bool":
        return _bool_to_kde(value)
    if typ == "int":
        try:
            return str(int(float(value)))
        except (TypeError, ValueError):
            return "0"
    return "" if value is None else str(value)


class Cmd:
    """Read/write a setting through argv commands (no shell).

    `read` is an argv list whose stripped stdout is the value (or None for
    write-only).  `write` is an argv list containing the literal token
    "{value}" wherever the new value goes; it is substituted and run.
    `priv=True` runs the write via pkexec (argv only).  Plain class (not a
    @dataclass) so the public method names read()/write() don't collide with
    the constructor's read=/write= argv parameters."""
    def __init__(self, read=None, write=None, priv=False):
        self._read = read
        self._write = write
        self.priv = priv

    def available(self):
        argv = self._read or self._write
        if not argv:
            return False
        return have(argv[0]) or (self.priv and have("pkexec"))

    def write_argv(self, value):
        sub = [(str(value) if tok == "{value}" else tok)
               for tok in (self._write or [])]
        return (["pkexec"] + sub) if self.priv else sub

    def read(self):
        if not self._read:
            return None
        return _run(list(self._read)).stdout.strip()

    def write(self, value):
        if not self._write:
            return False
        r = _run(self.write_argv(value), timeout=60)
        return getattr(r, "returncode", 1) == 0

    def describe_write(self, value):
        argv = self.write_argv(value)
        if self.priv:
            argv = ["sudo"] + argv[1:]
        return " ".join(_shquote(c) for c in argv)

    def describe_read(self):
        return " ".join(_shquote(c) for c in (self._read or []))


@dataclasses.dataclass
class Info:
    """Read-only value for display — stdout of an argv command."""
    cmd: object = None

    def available(self):
        return bool(self.cmd) and have(self.cmd[0])

    def read(self):
        if not self.cmd:
            return ""
        return _run(list(self.cmd)).stdout.strip()

    def write(self, value):
        return False

    def describe_write(self, value):
        return "(read-only)"

    def describe_read(self):
        return " ".join(_shquote(c) for c in (self.cmd or []))


class Setting:
    """One settings row, as data.

    control ∈ {toggle, combo, slider, text, action, drill}.  `backend` is a
    KConfig/Cmd/Info (or None for pure drill rows).  `apply` names a post-write
    hook (see APPLY_HOOKS).  Extra control params (combo `options`, slider
    `min`/`max`, action `button`, drill `detail`) go in **kw.

    Plain class (not a @dataclass) because the trailing **kw keyword bag is
    cleaner than a positional dict field for the data-row authoring style."""
    def __init__(self, key, name, icon="", comment="", control="toggle",
                 backend=None, apply="", **kw):
        self.key = key
        self.name = name
        self.icon = icon
        self.comment = comment
        self.control = control
        self.backend = backend
        self.apply = apply
        self.kw = kw


# ── apply hooks (run AFTER a successful write to make the change take effect) ─
def _kwin_reconfigure():
    q = _qdbus()
    if not q:
        return
    _run([q, "org.kde.KWin", "/KWin", "reconfigure"], timeout=8)


def _plasma_reconfigure():
    q = _qdbus()
    if not q:
        return
    _run([q, "org.kde.plasmashell", "/PlasmaShell",
          "org.kde.PlasmaShell.refresh"], timeout=8)


APPLY_HOOKS = {
    "kwin_reconfigure": (_kwin_reconfigure,
                         "qdbus org.kde.KWin /KWin reconfigure"),
    "plasma_reconfigure": (_plasma_reconfigure,
                           "qdbus org.kde.plasmashell /PlasmaShell refresh"),
}


def run_apply(name):
    """Run a named apply hook; safe no-op if unknown or its tool is absent."""
    hook = APPLY_HOOKS.get(name or "")
    if hook:
        try:
            hook[0]()
        except Exception:
            pass


def apply_describe(name):
    hook = APPLY_HOOKS.get(name or "")
    return hook[1] if hook else (name or "")


