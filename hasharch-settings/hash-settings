            self._clear()
            term = self.search.text().lower().strip()
            shown = 0
            for p in self._progs:
                if term and term not in p["name"].lower() \
                        and term not in p.get("source", "").lower():
                    continue
                if shown >= 200:
                    break
                src = p.get("source", "")
                ver = p.get("version", "")
                sub = src + (("  ·  " + ver) if ver else "")
                pill = QLabel(src.upper())
                pill.setObjectName("pill")
                btn = QPushButton("Uninstall…")
                btn.setObjectName("danger")
