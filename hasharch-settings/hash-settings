        def _do_wifi_connect(self, n, btn=None):
            pw = None
            secured = n["security"] and n["security"].lower() not in ("", "open", "--")
            if secured and not n["known"]:
                pw, ok = QInputDialog.getText(
                    self.win, "Wi-Fi password",
                    "Password for “%s”:" % n["ssid"],
                    QLineEdit.EchoMode.Password)
                if not ok:
                    return
            # wifi_connect blocks up to 45s on the UI thread; disable the button
            # and paint a "working…" state before the call so the UI isn't dead.
            if btn is not None:
                btn.setEnabled(False)
                btn.setText("Connecting…")
            self.win.status("Connecting to %s…" % n["ssid"])
            QApplication.processEvents()
            ok, msg = wifi_connect(n["ssid"], pw)
            self.win.status("Connected." if ok else ("Failed: " + msg[:60]))
            QTimer.singleShot(800, self.refresh)

