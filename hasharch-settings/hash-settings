        sys.stderr.write("hash-settings: unknown setting '%s'\n" % key)
        return 2
    if s.backend is None:
        sys.stderr.write("hash-settings: '%s' has no readable backend\n" % key)
        return 2
    val = s.backend.read()
    sys.stdout.write(("" if val is None else str(val)) + "\n")
    return 0


def cli_set(key, value):
    """Headless: write a setting, run its apply hook.  Returns an exit code."""
    s = REGISTRY.get(key)
    if s is None:
        sys.stderr.write("hash-settings: unknown setting '%s'\n" % key)
        return 2
    if s.backend is None or s.control in ("drill", "action"):
        sys.stderr.write("hash-settings: '%s' is not writable\n" % key)
        return 2
    ok = s.backend.write(value)
    run_apply(s.apply)
    if not ok:
        sys.stderr.write("hash-settings: failed to set '%s'\n" % key)
        return 1
    return 0


def cli_list():
    """Headless: list every settable key with its current value."""
    for key in sorted(REGISTRY):
        s = REGISTRY[key]
        val = ""
        if s.backend is not None:
            try:
                val = s.backend.read()
            except Exception:
                val = ""
        sys.stdout.write("%-32s %s\n" % (key, "" if val is None else val))
    return 0


