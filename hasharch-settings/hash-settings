            head.addWidget(self.openBtn)
            v.addLayout(head)
            self.listBox = QVBoxLayout()
            self.listBox.setSpacing(10)
            v.addLayout(self.listBox)
            if self.mod is None:
                self.listBox.addWidget(self._note(
                    "%s is not installed." % self.TOOL))
                self.openBtn.setEnabled(False)
            else:
                self.populate()

        def _open_full(self, *a):
            argv = tool_argv(self.TOOL) if tool_path(self.TOOL) else None
            if argv:
                self.win.spawn(argv)

        def _note(self, text):
            l = QLabel(text)
            l.setObjectName("muted")
            l.setWordWrap(True)
            return l

        def _row(self, icon, name, sub, widgets=()):
            f = QFrame()
            f.setObjectName("row")
            h = QHBoxLayout(f)
            h.setContentsMargins(14, 11, 14, 11)
            h.setSpacing(12)
