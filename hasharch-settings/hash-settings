            col.addStretch(1)
            h.addLayout(col, 1)
            chev = QLabel("›")
            chev.setObjectName("catchev")
            h.addWidget(chev, 0, Qt.AlignmentFlag.AlignVCenter)
            card.setStyleSheet(card_qss())
            _shadow(card)

            def _enter(_e, c=card):
                c.setProperty("hover", True)
                c.setStyleSheet(card_qss())

            def _leave(_e, c=card):
                c.setProperty("hover", False)
                c.setStyleSheet(card_qss())
            card.enterEvent = _enter
            card.leaveEvent = _leave
            card.mouseReleaseEvent = lambda e, l=label, us=units: (
                self._open_group(l, us) if e.button() == Qt.MouseButton.LeftButton else None)
            return card

        def _open_group(self, label, units):
            sub = BasePage(self.win, label,
                           "%d service%s" % (len(units), "" if len(units) == 1 else "s"))
            for u in units:
                sub.body.insertWidget(sub.body.count() - 1, self._svc_row(u))
            self.win.stack.push(sub, label)

        def _svc_row(self, u):
            f = QFrame()
            f.setObjectName("row")
            f.setProperty("active", u["active"] == "active")
            h = QHBoxLayout(f)
            h.setContentsMargins(14, 10, 14, 10)
            h.setSpacing(10)
            ic = QLabel()
            ic.setPixmap(QIcon.fromTheme("system-run").pixmap(QSize(22, 22)))
            h.addWidget(ic, 0, Qt.AlignmentFlag.AlignTop)
            col = QVBoxLayout()
            col.setSpacing(1)
            nm = QLabel(u["unit"])
            nm.setObjectName("rowname")
            col.addWidget(nm)
            sub = QLabel("%s · %s%s" % (
                u["active"], u["sub"],
                ("  ·  " + u["desc"]) if u["desc"] else ""))
            sub.setObjectName("rowsub")
            col.addWidget(sub)
            h.addLayout(col, 1)

            running = u["active"] == "active"
            st = QLabel("running" if running else (u["active"] or "inactive"))
            st.setObjectName("pill" if running else "rowsub")
            h.addWidget(st)
            en = u["enabled"]
            if en:
                eb = QLabel(en)
                eb.setObjectName("pill" if en == "enabled" else "rowsub")
                h.addWidget(eb)

            unit = u["unit"]
            if running:
                b = QPushButton("Stop")
                b.clicked.connect(lambda _=False, n=unit: self._do("stop", n))
                h.addWidget(b)
                rb = QPushButton("Restart")
                rb.clicked.connect(lambda _=False, n=unit: self._do("restart", n))
                h.addWidget(rb)
            else:
                b = QPushButton("Start")
                b.setObjectName("primary")
                b.clicked.connect(lambda _=False, n=unit: self._do("start", n))
                h.addWidget(b)
            if en == "enabled":
                db = QPushButton("Disable")
                db.clicked.connect(lambda _=False, n=unit: self._do("disable", n))
                h.addWidget(db)
            else:
                enb = QPushButton("Enable")
                enb.clicked.connect(lambda _=False, n=unit: self._do("enable", n))
                h.addWidget(enb)
            return f

        def _do(self, action, unit):
            user = self.userChk.isChecked()
            argv = service_action_argv(action, unit, user)
            self.win.status("systemctl %s %s…" % (action, unit))
            QApplication.processEvents()
            if user:
                self.run_user(argv)
            else:
                # argv already starts with "systemctl"; run_priv prepends pkexec
                self.run_priv(argv)
            self.win.status("")
            QTimer.singleShot(600, self.refresh)

