def journal_argv(lines=500, priority="", unit="", when="boot"):
    """Build a journalctl ARGV for the Event-Viewer reader."""
    argv = ["journalctl", "--no-pager", "-n", str(int(lines)),
            "-o", "short-iso"]
    if priority != "":
        argv += ["-p", str(priority)]
    if unit:
        argv += ["-u", unit]
    if when == "boot":
        argv += ["-b"]
    elif when == "today":
        argv += ["--since", "today"]
    elif when:
        argv += ["--since", when]
    return argv


def journal_read(lines=500, priority="", unit="", when="boot"):
    """Run journalctl and return (argv, text)."""
    argv = journal_argv(lines, priority, unit, when)
    r = _run(argv, timeout=20)
    txt = r.stdout if r.stdout.strip() else (r.stderr or "(no log entries)")
    return argv, txt


# ---- Users & Groups (lusrmgr.msc -> getent / useradd / usermod) ----
def users_available():
    return have("getent")


def list_users(human_only=True):
    """[{name, uid, gid, gecos, home, shell, locked, groups}] from getent.

    human_only keeps real login accounts (UID >= 1000, excluding nobody)."""
    if not have("getent"):
        return []
    out = []
    # group membership map: gid -> primary, plus supplementary from group file
    grp_by_gid = {}
    supp = {}
    rg = _run(["getent", "group"], timeout=8)
    for ln in rg.stdout.splitlines():
        f = ln.split(":")
        if len(f) >= 4:
            gname, _pw, gid, members = f[0], f[1], f[2], f[3]
            grp_by_gid[gid] = gname
            for m in members.split(","):
                m = m.strip()
                if m:
                    supp.setdefault(m, []).append(gname)
    rp = _run(["getent", "passwd"], timeout=8)
    for ln in rp.stdout.splitlines():
        f = ln.split(":")
        if len(f) < 7:
            continue
        name, _pw, uid, gid, gecos, home, shell = f[:7]
        try:
            uidn = int(uid)
        except ValueError:
            continue
        if human_only and (uidn < 1000 or uidn >= 65534):
            continue
        groups = []
        primary = grp_by_gid.get(gid)
        if primary:
            groups.append(primary)
        for g in supp.get(name, []):
            if g not in groups:
                groups.append(g)
        out.append({"name": name, "uid": uidn, "gid": gid,
                    "gecos": (gecos.split(",")[0] if gecos else ""),
                    "home": home, "shell": shell,
                    "locked": user_is_locked(name), "groups": groups})
    out.sort(key=lambda d: d["uid"])
    return out


def user_is_locked(name):
    """True if the account password is locked (passwd -S => 'L'). Best-effort;
    needs root to read shadow, so falsey when unreadable."""
    r = _run(["passwd", "-S", name], timeout=6)
    parts = r.stdout.split()
    if len(parts) >= 2:
        return parts[1].startswith("L") or parts[1] == "LK"
    return False


def list_all_groups():
    """Sorted group names from getent group."""
    if not have("getent"):
        return []
    r = _run(["getent", "group"], timeout=8)
    names = []
    for ln in r.stdout.splitlines():
        f = ln.split(":")
        if f and f[0]:
            names.append(f[0])
    names.sort(key=str.lower)
    return names


