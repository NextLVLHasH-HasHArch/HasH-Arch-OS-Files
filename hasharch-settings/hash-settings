    # ════════════════ CLI-learn console + run helpers (shared) ═══════════════
    # The signature HasH-Arch "learn the Linux CLI" surface: every privileged or
    # state-changing action echoes the EXACT command into a read-only monospace
    # console (#7fe0a0 on the card background) and then appends ✓ / ✗ with the
    # result — so a Windows admin sees, e.g., `sudo systemctl restart sshd`
    # alongside the GUI button.  CliConsole is the widget; CliPageMixin gives any
    # BasePage a `self.cli` plus `run_priv(argv)` / `run_user(argv)` that echo,
    # run (pkexec for system actions), and report.
    class CliConsole(QPlainTextEdit):
        """Read-only, monospace command log.  `append(cmd, result)` prints the
        command (a string or an argv list, rendered shell-quoted) and, if a
        `_run`-style result object is given, a ✓/✗ status line."""
        def __init__(self):
            super().__init__()
            self.setReadOnly(True)
            self.setObjectName("cli")
            self.setMinimumHeight(120)
            self.setMaximumBlockCount(400)
            self.setLineWrapMode(QPlainTextEdit.LineWrapMode.NoWrap)
            self.setStyleSheet(
                "QPlainTextEdit#cli{ background:#070a0e; color:#8becb0;"
                " border:1px solid rgba(86,197,216,0.22); border-radius:12px;"
                " font-family:'JetBrains Mono','DejaVu Sans Mono',monospace;"
                " font-size:12px; padding:12px 14px;"
                " selection-background-color:#56c5d8; selection-color:#06222a; }")
            self.setPlainText("hash@HasH-Arch:~$ # commands run here are shown — "
                              "learn the Linux CLI as you go")

        @staticmethod
        def _fmt(cmd):
            if isinstance(cmd, (list, tuple)):
                return " ".join(_shquote(str(c)) for c in cmd)
            return str(cmd)

        def echo(self, line):
            """Append a raw line (e.g. a comment) to the console."""
            self.appendPlainText(line)
            self._scroll()

        def append(self, cmd, result=None, prompt="$"):
            """Echo `prompt cmd`; if `result` (a _run-style obj) is given, also
            append a ✓/✗ line.  `cmd` may be a string or an argv list."""
            self.appendPlainText("%s %s" % (prompt, self._fmt(cmd)))
            if result is not None:
                self.result_line(result)
            self._scroll()

        def result_line(self, result):
            """Append just the ✓/✗ status line for a _run-style result."""
            rc = getattr(result, "returncode", 1)
            if rc == 0:
                self.appendPlainText("# ✓ ok")
            else:
                err = (getattr(result, "stderr", "")
                       or getattr(result, "stdout", "")
                       or "failed").strip().splitlines()
                self.appendPlainText("# ✗ " + (err[-1] if err else "failed"))
            self._scroll()

        def _scroll(self):
            sb = self.verticalScrollBar()
            sb.setValue(sb.maximum())

    class CliPageMixin:
        """Mixin for BasePage subclasses that want the CLI-learn console.  Call
        `self.add_cli_card(v)` from build_body to create `self.cli`, then drive
        actions through `run_user(argv)` (user session) or `run_priv(argv)`
        (system, via pkexec).  Both echo the command, run it with `_run` (which
        never raises) and append the ✓/✗ result; `run_priv` shows it as
        `sudo …` (the friendly equivalent) but executes pkexec with ARGV — never
        a shell string, so there is no root command injection."""
        def add_cli_card(self, v, title="CLI — what this runs (learn it)"):
            cf, cc = self.card()
            cc.addWidget(QLabel("<b>%s</b>" % title))
            self.cli = CliConsole()
            cc.addWidget(self.cli)
            v.addWidget(cf)
            return cf

        def cli_echo(self, line):
            if getattr(self, "cli", None) is not None:
                self.cli.echo(line)

        def run_user(self, argv, timeout=20, echo=None):
            """Run `argv` in the user session; echo the command, run it, append
            the ✓/✗ status, and return the result.  `echo` overrides the
            *displayed* command (e.g. to mask a secret) but never what runs."""
            cli = getattr(self, "cli", None)
            if cli is not None:
                cli.appendPlainText("$ " + CliConsole._fmt(echo or argv))
            res = _run(list(argv), timeout=timeout)
            if cli is not None:
                cli.result_line(res)
            return res

        def run_priv(self, argv, timeout=60, echo=None):
            """Run `argv` as root via pkexec (ARGV, never a shell string); show
            it as the friendly `sudo …` form and append ✓/✗.  `echo` overrides
            the *displayed* argv (used to mask passwords) but never what runs."""
            cli = getattr(self, "cli", None)
            shown = echo if echo is not None else (["sudo"] + list(argv))
            if cli is not None:
                cli.appendPlainText("# " + CliConsole._fmt(shown)
                                    if not isinstance(shown, str)
                                    else "# " + shown)
            res = _run(["pkexec"] + list(argv), timeout=timeout)
            if cli is not None:
                cli.result_line(res)
            return res

    # ════════════════ Windows-11 chrome: Toggle / Win11Row / Breadcrumb ══════
    class Toggle(QCheckBox):
        """A pill switch styled to ACCENT — used as the inline control for
        boolean settings.  Drop-in QCheckBox so isChecked()/toggled work; the
        groove + knob are painted so it reads as a Win11 toggle."""
        def __init__(self, on=False):
            super().__init__()
            self.setChecked(on)
            self.setCursor(Qt.CursorShape.PointingHandCursor)
            self.setFixedSize(46, 26)

        def paintEvent(self, _e):
            p = QPainter(self)
            p.setRenderHint(QPainter.RenderHint.Antialiasing)
            on = self.isChecked()
            r = self.rect().adjusted(1, 3, -1, -3)
            groove = QColor(ACCENT) if on else QColor(255, 255, 255, 38)
            if not self.isEnabled():
                groove = QColor(255, 255, 255, 20)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(groove)
            p.drawRoundedRect(r, r.height() / 2, r.height() / 2)
            d = r.height() - 6
            kx = (r.right() - d - 2) if on else (r.left() + 3)
            p.setBrush(QColor("#06222a") if on else QColor("#e8eef0"))
            p.drawEllipse(int(kx), int(r.top() + 3), int(d), int(d))

    class Win11Row(QFrame):
        """A Windows-11-style card row.  Two flavours:

        * drill-in  — label (+ optional sub-text) and a chevron ‘›’ on the
          right; clicking the whole row calls `on_click` (the host pushes a
          sub-page onto the NavStack).
        * inline    — label (+ optional sub-text) and a right-aligned control
          widget (a Toggle / QComboBox / QSlider / QLineEdit / QPushButton).

        Pass exactly one of `on_click` (drill) or `control` (inline)."""
        def __init__(self, name, sub="", icon="", control=None,
                     on_click=None, enabled=True, color=ACCENT):
            super().__init__()
            self.setObjectName("row")
            self._click = on_click
            self._enabled_row = enabled
            h = QHBoxLayout(self)
            h.setContentsMargins(14, 11, 14, 11)
            h.setSpacing(13)
            if icon:
                h.addWidget(_color_tile(icon, color, tile=40, ipx=23), 0,
                            Qt.AlignmentFlag.AlignVCenter)
            col = QVBoxLayout()
            col.setSpacing(2)
            nm = QLabel(name)
            nm.setObjectName("rowname")
            col.addWidget(nm)
            self.subLbl = QLabel(sub)
            self.subLbl.setObjectName("rowsub")
            self.subLbl.setWordWrap(True)
            self.subLbl.setVisible(bool(sub))
            col.addWidget(self.subLbl)
            h.addLayout(col, 1)
            self.control = control
            if control is not None:
                h.addWidget(control, 0, Qt.AlignmentFlag.AlignVCenter)
            if on_click is not None:
                chev = QLabel("›")
                chev.setObjectName("chev")
                h.addWidget(chev, 0, Qt.AlignmentFlag.AlignVCenter)
                self.setCursor(Qt.CursorShape.PointingHandCursor)

        def set_sub(self, text):
