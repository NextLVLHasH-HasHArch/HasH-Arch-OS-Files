# IMPORTANT: only ever switch the COLOUR SCHEME (the palette), never the
# look-and-feel. Applying a look-and-feel (plasma-apply-lookandfeel) REWRITES
# kwinrc/kdeglobals/decoration/layout to that package's defaults — and the old
# code applied STOCK BREEZE (org.kde.breeze*.desktop), which wiped the entire
# HasH look (Sweet colours, Sweet-Dark Aurorae, HasHTop theme, splash) and
# re-broke window rounding. We keep HasHTop intact and only swap the palette.
HASH_DARK_SCHEME = "HasH"        # the HasH dark palette (ships with hash-theme)
HASH_LIGHT_SCHEME = "HasH-Light"  # light variant of the HasH dark scheme (same hues/accents)


def theme_available():
    return have("plasma-apply-colorscheme") or have("kwriteconfig6") \
        or have("kwriteconfig5")


def theme_is_dark():
    # Read the current colour scheme from kdeglobals if readable.
    rc = os.path.join(HOME, ".config", "kdeglobals")
    try:
        txt = open(rc).read().lower()
        for ln in txt.splitlines():
            if ln.startswith("colorscheme="):
                # *Light schemes -> light; everything else (Sweet, *Dark) -> dark
                return "light" not in ln
    except OSError:
        pass
    return True  # default assumption: HasH is a dark distro


def theme_set_dark(dark):
    scheme = HASH_DARK_SCHEME if dark else HASH_LIGHT_SCHEME
    if have("plasma-apply-colorscheme"):
        _run(["plasma-apply-colorscheme", scheme], timeout=20)
        return
    kw = shutil.which("kwriteconfig6") or shutil.which("kwriteconfig5")
    if kw:
        # palette only — never touch LookAndFeelPackage
        _run([kw, "--file", "kdeglobals", "--group", "General",
              "--key", "ColorScheme", scheme])
        _run([kw, "--file", "kdeglobals", "--group", "KDE",
              "--key", "ColorScheme", scheme])


