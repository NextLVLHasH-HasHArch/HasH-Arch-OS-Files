    class UsersPage(CliPageMixin, BasePage):
        """Windows Local Users & Groups for Linux.  Create accounts, set/lock
        passwords, manage group membership and delete users — every change shows
        the exact command (passwords are masked in the console).  All edits run
        via pkexec with ARGV."""
        def __init__(self, win):
            super().__init__(win, "Users & Groups",
                             "Add, remove & edit local user accounts and their "
                             "groups — Windows lusrmgr.msc")
            self._users = []

        def build_body(self, v):
            top, tc = self.card()
            hdr = QHBoxLayout()
            hdr.addWidget(QLabel("<b>Local users</b>"), 1)
            self.addBtn = QPushButton("Add user…")
            self.addBtn.setObjectName("primary")
            self.addBtn.clicked.connect(self._add_user)
            hdr.addWidget(self.addBtn)
            ref = QPushButton("Refresh")
            ref.clicked.connect(self.refresh)
            hdr.addWidget(ref)
            tc.addLayout(hdr)
            self.listBox = QVBoxLayout()
            self.listBox.setSpacing(8)
            tc.addLayout(self.listBox)
            v.addWidget(top)

            self.add_cli_card(v)
            if not users_available():
                self.addBtn.setEnabled(False)
                self.cli_echo("# getent not found — cannot enumerate accounts")
            if not have("useradd"):
                self.addBtn.setEnabled(False)
            # lazy: the account list (getent + per-user passwd -S) is gathered on
            # first navigation via focus_default(), keeping startup snappy.

        def _clear(self):
            while self.listBox.count():
                it = self.listBox.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()

        def refresh(self):
            self._clear()
            if not users_available():
                self.listBox.addWidget(self._lbl(
                    "getent not available on this system.", True))
                return
            self.win.status("Loading users…")
            QApplication.processEvents()
            self._users = list_users(human_only=True)
            self.win.status("")
            if not self._users:
                self.listBox.addWidget(self._lbl(
                    "No human user accounts (UID >= 1000) found.", True))
                return
            for u in self._users:
                self.listBox.addWidget(self._user_row(u))

        def _user_row(self, u):
            f = QFrame()
            f.setObjectName("row")
            h = QHBoxLayout(f)
            h.setContentsMargins(14, 10, 14, 10)
            h.setSpacing(10)
            ic = QLabel()
            ic.setPixmap(QIcon.fromTheme("system-users").pixmap(QSize(26, 26)))
            h.addWidget(ic, 0, Qt.AlignmentFlag.AlignTop)
            col = QVBoxLayout()
            col.setSpacing(1)
            title = u["name"] + (("  (%s)" % u["gecos"]) if u["gecos"] else "")
            nm = QLabel(title)
            nm.setObjectName("rowname")
            col.addWidget(nm)
            sub = QLabel("uid %d · %s%s" % (
                u["uid"], u["home"],
                ("  ·  " + ", ".join(u["groups"][:6])) if u["groups"] else ""))
            sub.setObjectName("rowsub")
            sub.setWordWrap(True)
            col.addWidget(sub)
            h.addLayout(col, 1)
            if u["locked"]:
                lk = QLabel("locked")
                lk.setObjectName("rowsub")
                h.addWidget(lk)
            name = u["name"]
            pw = QPushButton("Password…")
            pw.clicked.connect(lambda _=False, n=name: self._set_password(n))
            h.addWidget(pw)
            grp = QPushButton("Groups…")
            grp.clicked.connect(lambda _=False, n=name: self._edit_groups(n))
            h.addWidget(grp)
            lockb = QPushButton("Unlock" if u["locked"] else "Lock")
            lockb.clicked.connect(
                lambda _=False, n=name, lk=u["locked"]: self._lock(n, not lk))
            h.addWidget(lockb)
            delb = QPushButton("Delete…")
            delb.setObjectName("danger")
            delb.clicked.connect(lambda _=False, n=name: self._delete(n))
            h.addWidget(delb)
            return f

        def _add_user(self):
            name, ok = QInputDialog.getText(
                self.win, "Add user", "New username (lowercase, no spaces):")
            name = (name or "").strip()
            if not ok or not name:
                return
            if not name.isascii() or not all(
                    c.isalnum() or c in "_-" for c in name) \
                    or not (name[0].islower() or name[0] == "_"):
                QMessageBox.warning(self.win, "Invalid username",
                                    "Usernames must be lowercase letters, "
                                    "digits, '-' or '_', starting with a "
                                    "letter or underscore.")
                return
            admin = QMessageBox.question(
                self.win, "Administrator?",
                "Make “%s” an administrator (add to the 'wheel' group, so they "
                "can use sudo)?" % name) == QMessageBox.StandardButton.Yes
            argv = ["useradd", "-m"]
            if admin:
                argv += ["-G", "wheel"]
            argv.append(name)
            res = self.run_priv(argv)
            if getattr(res, "returncode", 1) == 0:
                self.win.status("Created %s." % name)
                # offer to set an initial password right away
                self._set_password(name)
            QTimer.singleShot(400, self.refresh)

        def _set_password(self, name):
            pwd, ok = QInputDialog.getText(
                self.win, "Set password",
                "New password for “%s”:" % name,
                QLineEdit.EchoMode.Password)
            if not ok or not pwd:
                return
            pwd2, ok2 = QInputDialog.getText(
                self.win, "Set password",
                "Confirm password for “%s”:" % name,
                QLineEdit.EchoMode.Password)
            if not ok2:
                return
            if pwd != pwd2:
                QMessageBox.warning(self.win, "Passwords differ",
                                    "The two passwords did not match.")
                return
            # NEVER echo the real password into the CLI console — mask it. We run
            # `chpasswd` reading the secret from STDIN so it never appears in the
            # process argv either.
            self.cli_echo("$ printf '%%s:%%s' %s '********' | sudo chpasswd"
                          % name)
            r = _run_pipe_priv(["chpasswd"], "%s:%s\n" % (name, pwd))
            if getattr(self, "cli", None) is not None:
                self.cli.result_line(r)
            self.win.status("Password updated." if getattr(r, "returncode", 1)
                            == 0 else "Could not set password.")

        def _lock(self, name, lock):
            argv = ["usermod", "-L" if lock else "-U", name]
            self.run_priv(argv)
            self.win.status(("Locked " if lock else "Unlocked ") + name + ".")
            QTimer.singleShot(400, self.refresh)

        def _edit_groups(self, name):
            cur = next((u["groups"] for u in self._users
                        if u["name"] == name), [])
            allg = list_all_groups()
            grp, ok = QInputDialog.getItem(
                self.win, "Group membership",
                "Add “%s” to, or remove from, a group:" % name,
                allg, 0, False)
            if not ok or not grp:
                return
            if grp in cur:
                if QMessageBox.question(
                        self.win, "Remove from group",
                        "Remove “%s” from the '%s' group?" % (name, grp)) \
                        != QMessageBox.StandardButton.Yes:
                    return
                self.run_priv(["gpasswd", "-d", name, grp])
            else:
                self.run_priv(["gpasswd", "-a", name, grp])
            self.win.status("Group membership updated.")
            QTimer.singleShot(400, self.refresh)

        def _delete(self, name):
            if QMessageBox.question(
                    self.win, "Delete user",
                    "Delete the account “%s” AND its home directory?\n\nThis "
                    "cannot be undone." % name,
                    QMessageBox.StandardButton.Yes
                    | QMessageBox.StandardButton.No,
                    QMessageBox.StandardButton.No) \
                    != QMessageBox.StandardButton.Yes:
                return
            self.run_priv(["userdel", "-r", name])
            self.win.status("Deleted %s." % name)
            QTimer.singleShot(400, self.refresh)

    # ─────────────────── Updates (Windows Update -> pacman) ───────────────────
    class UpdatesPage(CliPageMixin, BasePage):
        """Windows Update for Linux.  Lists available package updates safely
        (checkupdates needs NO root) and installs them all via `pkexec pacman
        -Syu` behind a clear confirm.  The CLI is shown throughout."""
        def __init__(self, win):
            super().__init__(win, "Updates",
                             "Available system & package updates (pacman) — "
                             "Windows Update")
            self._lines = []

        def build_body(self, v):
            top, tc = self.card()
            hdr = QHBoxLayout()
            self.summary = QLabel("…")
            self.summary.setObjectName("big")
            hdr.addWidget(self.summary, 1)
            self.checkBtn = QPushButton("Check again")
            self.checkBtn.clicked.connect(self.refresh)
            hdr.addWidget(self.checkBtn)
            self.installBtn = QPushButton("Install all updates")
            self.installBtn.setObjectName("primary")
            self.installBtn.clicked.connect(self._install_all)
            hdr.addWidget(self.installBtn)
            tc.addLayout(hdr)
            self.note = QLabel("")
            self.note.setObjectName("muted")
            self.note.setWordWrap(True)
            tc.addWidget(self.note)
            v.addWidget(top)

            self.section(v, "Available updates")
            self.listBox = QVBoxLayout()
            self.listBox.setSpacing(6)
            lc = QWidget()
            lc.setLayout(self.listBox)
            v.addWidget(lc)

            self.add_cli_card(v)
            if not updates_available_tool():
                self.checkBtn.setEnabled(False)
                self.installBtn.setEnabled(False)
                self.summary.setText("pacman not found")
                self.note.setText("This system isn't pacman-based, so package "
                                  "updates can't be managed here.")
                self.cli_echo("# pacman not found")
                return
            if not have("checkupdates"):
                self.note.setText("Tip: install 'pacman-contrib' for a safe, "
                                  "no-root update check (checkupdates). Falling "
                                  "back to 'pacman -Qu', which can be stale.")
            self.summary.setText("Press “Check again” to look for updates")
            # lazy: checkupdates can take seconds (syncs a temp DB), so the check
            # runs on first navigation via focus_default(), never at startup.

        def _clear(self):
            while self.listBox.count():
                it = self.listBox.takeAt(0)
                w = it.widget()
                if w:
                    w.deleteLater()

        def refresh(self):
            if not updates_available_tool():
                return
            self._clear()
            self.checkBtn.setEnabled(False)
            self.win.status("Checking for updates…")
            self.summary.setText("Checking…")
            QApplication.processEvents()
            try:
                lines, count, used_cu = check_updates()
            finally:
                self.checkBtn.setEnabled(True)
                self.win.status("")
            self._lines = lines
            self.cli_echo("$ " + ("checkupdates" if used_cu else "pacman -Qu"))
            if count == 0:
                self.summary.setText("Your system is up to date")
                self.installBtn.setEnabled(False)
                self.listBox.addWidget(self._lbl(
                    "No package updates available.", True))
                return
            self.summary.setText("%d update%s available"
                                 % (count, "" if count == 1 else "s"))
            self.installBtn.setEnabled(have("pacman"))
            for ln in lines[:400]:
                row = QLabel(ln)
                row.setObjectName("rowsub")
                row.setStyleSheet("font-family: monospace;")
                self.listBox.addWidget(row)
            if count > 400:
                self.listBox.addWidget(self._lbl(
                    "…and %d more." % (count - 400), True))

        def _install_all(self):
            if not have("pacman"):
                return
            if QMessageBox.question(
                    self.win, "Install all updates",
                    "Install ALL %d available updates now?\n\nThis runs "
                    "`sudo pacman -Syu` and may take a while. A graphical "
                    "password prompt will appear."
                    % len(self._lines),
                    QMessageBox.StandardButton.Yes
                    | QMessageBox.StandardButton.No,
                    QMessageBox.StandardButton.No) \
                    != QMessageBox.StandardButton.Yes:
                return
            self.installBtn.setEnabled(False)
            self.win.status("Installing updates… (this can take a while)")
            QApplication.processEvents()
            # --noconfirm so the non-interactive pkexec child doesn't block on a
            # y/N prompt it can't show; argv only (no shell string).
            r = self.run_priv(["pacman", "-Syu", "--noconfirm"], timeout=1800)
            self.win.status("Updates installed." if getattr(r, "returncode", 1)
                            == 0 else "Update failed — see the CLI output.")
            self.installBtn.setEnabled(True)
            QTimer.singleShot(600, self.refresh)

    class DateTimePage(CliPageMixin, BasePage):
        """Date, time & timezone — native, timedatectl-backed (replaces kcm_clock)."""
        def __init__(self, win):
            super().__init__(win, "Date & Time",
                             "Clock, timezone & automatic sync — timedatectl")
            self._tzs = []

        def build_body(self, v):
            if not have("timedatectl"):
                v.addWidget(self._lbl("timedatectl not found — systemd is required.", True))
                self.add_cli_card(v)
                return
            card, c = self.card()
            self.nowLbl = QLabel("")
            self.nowLbl.setObjectName("big")
            c.addWidget(self.nowLbl)
            ntpRow = QHBoxLayout()
            ntpRow.addWidget(self._lbl("Set time automatically (NTP)"), 1)
            self.ntpTog = Toggle()
            self.ntpTog.toggled.connect(self._set_ntp)
            ntpRow.addWidget(self.ntpTog, 0)
            c.addLayout(ntpRow)
            tzRow = QHBoxLayout()
            tzRow.addWidget(self._lbl("Time zone"), 0)
            self.tzCombo = QComboBox()
            self.tzCombo.setEditable(True)
            self.tzCombo.setInsertPolicy(QComboBox.InsertPolicy.NoInsert)
            tzRow.addWidget(self.tzCombo, 1)
            tzBtn = QPushButton("Set")
            tzBtn.clicked.connect(self._set_tz)
            tzRow.addWidget(tzBtn, 0)
            c.addLayout(tzRow)
            v.addWidget(card)
            self.add_cli_card(v)
            try:
                self._tzs = subprocess.run(["timedatectl", "list-timezones"],
                                           capture_output=True, text=True,
                                           timeout=10).stdout.split()
            except Exception:
                self._tzs = []
            self.tzCombo.addItems(self._tzs)
            self._timer = QTimer(self)
            self._timer.timeout.connect(self._tick)
            self._timer.start(1000)
            self._tick()

        def _tick(self):
            import datetime
            try:
                self.nowLbl.setText(datetime.datetime.now()
                                    .strftime("%A %d %B %Y   ·   %H:%M:%S"))
            except Exception:
                pass

        def refresh(self):
            if not have("timedatectl"):
                return
            try:
                out = subprocess.run(["timedatectl", "show"], capture_output=True,
                                     text=True, timeout=10).stdout
            except Exception:
                out = ""
            d = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
            self.ntpTog.blockSignals(True)
            self.ntpTog.setChecked(d.get("NTP", "no") == "yes")
            self.ntpTog.blockSignals(False)
            tz = d.get("Timezone", "")
            if tz:
                i = self.tzCombo.findText(tz)
                if i >= 0:
                    self.tzCombo.setCurrentIndex(i)
                else:
                    self.tzCombo.setEditText(tz)

        def _set_ntp(self, on):
            self.run_priv(["timedatectl", "set-ntp", "true" if on else "false"])
            QTimer.singleShot(600, self.refresh)

        def _set_tz(self):
            tz = self.tzCombo.currentText().strip()
            if tz:
                self.run_priv(["timedatectl", "set-timezone", tz])
                QTimer.singleShot(400, self.refresh)

