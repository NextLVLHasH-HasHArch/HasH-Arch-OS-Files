        def _render(self):
            self._clear()
            term = self.search.text().lower().strip()
            scope = "user" if self.userChk.isChecked() else "system"
            buckets, matched = {}, 0
            for u in self._units:
                if term and term not in (u["unit"] + " " + u.get("desc", "")).lower():
                    continue
                matched += 1
                buckets.setdefault(self._group_for(u), []).append(u)
            order = [g[0] for g in self.GROUPS] + ["other"]
            meta = {g[0]: (g[1], g[2], g[3]) for g in self.GROUPS}
            meta["other"] = ("Other", "application-x-executable", "#9aa0b5")
            total = len(self._units)

            if term:                       # search → flat list of matching services
                for key in order:
                    for u in buckets.get(key, []):
                        self.listBox.addWidget(self._svc_row(u))
                if matched == 0:
                    self.listBox.addWidget(self._lbl("No %s services match." % scope, True))
                self.countLbl.setText("Showing %d of %d %s services" % (matched, total, scope))
                return

            # default → a GRID of group tiles; click one to drill into its services
            wrap = QWidget()
