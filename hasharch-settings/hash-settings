# ---- System / About (distro, kernel, CPU, RAM) ----
def system_info():
    info = {}
    osr = {}
    try:
        for ln in open("/etc/os-release"):
            if "=" in ln:
                k, v = ln.rstrip().split("=", 1)
                osr[k] = v.strip().strip('"')
    except OSError:
        pass
    info["distro"] = osr.get("PRETTY_NAME") or osr.get("NAME") or "Linux"
    u = os.uname()
    info["kernel"] = "%s %s" % (u.sysname, u.release)
    info["arch"] = u.machine
    info["hostname"] = u.nodename
    # CPU model + cores
    cpu, cores = "", 0
    try:
        for ln in open("/proc/cpuinfo"):
            if ln.startswith("model name") and not cpu:
                cpu = ln.split(":", 1)[1].strip()
            if ln.startswith("processor"):
                cores += 1
    except OSError:
        pass
    info["cpu"] = cpu or "Unknown CPU"
    info["cores"] = cores
    # RAM
    memkb = 0
    try:
        for ln in open("/proc/meminfo"):
            if ln.startswith("MemTotal:"):
                memkb = int(ln.split()[1])
                break
    except (OSError, ValueError):
        pass
    info["ram"] = ("%.1f GB" % (memkb / 1024.0 / 1024.0)) if memkb else "Unknown"
    # Desktop / session
    info["desktop"] = (os.environ.get("XDG_CURRENT_DESKTOP")
                       or os.environ.get("DESKTOP_SESSION") or "Unknown")
    info["session"] = os.environ.get("XDG_SESSION_TYPE", "")
    # uptime
    try:
        with open("/proc/uptime") as f:
            secs = float(f.read().split()[0])
        d, rem = divmod(int(secs), 86400)
        h, rem = divmod(rem, 3600)
        m, _ = divmod(rem, 60)
        info["uptime"] = (("%dd " % d if d else "") + "%dh %dm" % (h, m))
    except (OSError, ValueError):
        info["uptime"] = ""
    return info


# ════════════════ Windows-admin backends (systemd / journald / ═══════════════
# ════════════════ users & groups / pacman) — all best-effort ═════════════════
# These map familiar Windows admin tools onto Linux equivalents.  Every function
# uses _run (never raises) and is gated by have(); the pages disable controls and
# show a one-line note when the underlying tool is missing.  Privileged actions
# are issued by the PAGES via pkexec with ARGV, never assembled as shell strings.

# ---- Services (services.msc -> systemd units) ----
def services_available():
    return have("systemctl")


def _systemctl_base(user):
    return ["systemctl", "--user"] if user else ["systemctl"]


def service_units(user=False):
    """[{unit, load, active, sub, desc, enabled}] for every .service unit.

    Combines `list-units --all` (runtime state) with `list-unit-files` (the
    enabled/disabled/static "startup type"), like the Services console's
    Status + Startup-type columns."""
    if not have("systemctl"):
        return []
    base = _systemctl_base(user)
    enabled = {}
    rf = _run(base + ["list-unit-files", "--type=service", "--no-legend",
                      "--plain", "--no-pager"], timeout=15)
    for ln in rf.stdout.splitlines():
        parts = ln.split()
        if len(parts) >= 2 and parts[0].endswith(".service"):
            enabled[parts[0]] = parts[1]
    out = []
    r = _run(base + ["list-units", "--type=service", "--all", "--no-legend",
                     "--plain", "--no-pager"], timeout=15)
    seen = set()
    for ln in r.stdout.splitlines():
        parts = ln.split(None, 4)
        if len(parts) < 4 or not parts[0].endswith(".service"):
            continue
        unit, load, active, sub = parts[0], parts[1], parts[2], parts[3]
        desc = parts[4] if len(parts) > 4 else ""
        seen.add(unit)
        out.append({"unit": unit, "load": load, "active": active, "sub": sub,
                    "desc": desc, "enabled": enabled.get(unit, "")})
    # include unit files that have no runtime unit (e.g. disabled, never run)
    for unit, state in enabled.items():
        if unit in seen:
            continue
        out.append({"unit": unit, "load": "", "active": "inactive",
                    "sub": "dead", "desc": "", "enabled": state})
    out.sort(key=lambda d: d["unit"].lower())
    return out


def service_action_argv(action, unit, user=False):
    """ARGV for a systemctl verb on a unit (for pkexec/user execution).
    `action` is start|stop|restart|enable|disable (enable/disable get --now)."""
    base = _systemctl_base(user)
    if action in ("enable", "disable"):
        return base + [action, "--now", unit]
    return base + [action, unit]


