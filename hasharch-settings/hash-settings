HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local", "bin")


# ──────────────────────── HasH tool backend module loader ────────────────────
# The HasH tools (hash-disks, hash-accounts, hash-security, hash-uninstaller)
# are hyphenated Python scripts with NO .py extension; their GUI widget classes
# are nested inside a gui() function and cannot be imported directly without a
# large refactor of each tool.  Instead we import each tool *as a module* (using
# the same SourceFileLoader pattern hash-uninstaller-gui already uses) and call
# its module-level BACKEND functions to render native, in-app panes that share
# the tools' exact look & feel — fully inside hash-settings, no extra windows.
_TOOL_CACHE = {}


def load_tool(name):
    """Import a hyphenated HasH tool script as a module and cache it.

    Returns the module on success or None if the tool isn't installed / fails
    to import (so a missing tool degrades gracefully instead of crashing)."""
    if name in _TOOL_CACHE:
        return _TOOL_CACHE[name]
    path = tool_path(name)
    mod = None
    if path:
        try:
            modname = "hash_tool_" + name.replace("-", "_")
            spec = importlib.util.spec_from_loader(
                modname, importlib.machinery.SourceFileLoader(modname, path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
        except Exception:
            mod = None
    _TOOL_CACHE[name] = mod
    return mod


def tool_path(name):
    """Absolute path to a HasH tool if it exists (in ~/.local/bin or PATH)."""
    local = os.path.join(BIN, name)
    if os.path.exists(local):
        return local
    return shutil.which(name)


def have(cmd):
    return bool(shutil.which(cmd))


